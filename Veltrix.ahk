        nq := DllCall(VxNatNF, "Ptr", pCaptureBits, "Int", W, "Int", H, "Int", tB, "Int", tG, "Int", tR, "Int", ftol
            , "Int", fneed, "Int", fwmax, "Int", edgeM, "Int", barA, "Int", barB, "Ptr", &nfo, "Int", 1024, "Int")
        Loop, % nq
            nf++, fX[nf] := NumGet(nfo, (A_Index - 1) * 4, "Int")
    } else {
