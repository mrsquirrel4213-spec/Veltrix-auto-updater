        WinWaitActive, ahk_id %RobloxHwnd%, , % TA("aqfocusto", 3)
        Sleep, % Tm(TA("aqfocus", 350))
    }
    if (!AqPanelSure()) {
        AqTap(AqNavX, AqNavY)
        AqWaitPanel(1)
    }
    if (!AqPanelSure())
        AqRecoverRow()
    if (!AqPanelSure()) {
        AqLastResult := "could not find the fish food panel"
        WhEvent("Aquarium: did not open", "Could not find the fish food panel. Next try in " . Round(AquariumEveryMin) . " min.", "warn")
        AqStatus := "failed"
        MouseMove, %AqSaveX%, %AqSaveY%, 0
        VxTip(8, "")
        AqNextTick := A_TickCount + Round(AquariumEveryMin) * 60000
        AqBusy := false
        SetBatchLines, -1
        return
    }
    AqStatus := "feeding"
    AqCap := Max(10, Round(AquariumFoodCount))
    VxTip(8, "Action: Scroll To Start")
    AqMeasurePitch()
    AqUseOnly := false
    Gosub, AquariumSweep
    if (AqBuys > 0 && MacroRunning) {
        ; second pass uses the food that was just bought
        VxTip(8, "Action: Use New Fish Food")
        AqUseOnly := true
        Gosub, AquariumSweep
    }
    VxTip(8, "Action: Back To Start")
    AqScrollHome()
    AqLastResult := "bought " AqBuys ", used " AqUses
    WhEvent("Aquarium: fed", "Bought " . AqBuys . ", used " . AqUses . " fish food. Next trip in " . Round(AquariumEveryMin) . " min.", "good")
    AqStatus := "done"
    ; falls through into AquariumClose
AquariumClose:
    VxTip(8, "Action: Close Aquariums")
    if (AqPanelSure()) {
        AqTap(AqNavX, AqNavY)
        AqWaitPanel(0)
    }
    MouseMove, %AqSaveX%, %AqSaveY%, 0
    VxTip(8, "")
    AqNextTick := A_TickCount + Round(AquariumEveryMin) * 60000
    AqBusy := false
    SetBatchLines, -1
    return
AquariumSweep:
    AqDone := 0
    AqHitShop := false
    AqScrollHome()
    AqShiftAcc := 0
    AqSeenMax := -999999
    AqHalf := Max(20, AqCardPitch // 2)
    AqStep := 1
    AqStall := 0
    AqGuard := 0
    AqScan()
    Loop {
        AqGuard += 1
        if (AqGuard > 60 || !MacroRunning || AqDone >= AqCap)
            break
        Gosub, AquariumHandleNew
        if (AqHitShop)
            break
        AqPrevLeft := AqLeftX()
        AqOldX := []
        AqOldN := AqBtnN
        Loop, %AqOldN%
            AqOldX.Push(AqBtnCX[A_Index])
        VxTip(8, "Action: Next Fish Food")
        if (!AqWheel(AqStep, 1))
            break
        if (AqScan() < 1) {
            ; ran past the end: step back until cards show again
            AqBack := 0
            while (AqBack < AqStep + 3) {
                AqBack += 1
                if (!AqWheel(1, -1))
                    break
                if (AqScan() >= 1)
                    break
            }
            if (AqBtnN >= 1) {
                AqShiftAcc += AqShiftBetween(AqOldX, AqOldN, AqBtnCX, AqBtnN, AqCardPitch)
                Gosub, AquariumHandleNew
            }
            break
        }
        if (AqLeftX() = AqPrevLeft) {
            AqStall += 1
            if (AqStall >= 5)
                break
        } else {
            AqStall := 0
        }
        AqMoved := AqShiftBetween(AqOldX, AqOldN, AqBtnCX, AqBtnN, AqCardPitch)
        AqShiftAcc += AqMoved
    }
    return
AquariumHandleNew:
    AqLstX := []
    AqLstY := []
    AqLstK := []
    AqLstN := AqBtnN
    Loop, %AqLstN% {
        AqLstX.Push(AqBtnCX[A_Index])
        AqLstY.Push(AqBtnCY[A_Index])
        AqLstK.Push(AqBtnKind[A_Index])
    }
    AqI := 0
    while (AqI < AqLstN) {
        AqI += 1
        if (!MacroRunning || AqDone >= AqCap)
            break
        AqCx := AqLstX[AqI]
        AqCy := AqLstY[AqI]
        AqKind := AqLstK[AqI]
        AqContentX := AqCx + AqShiftAcc
        if (AqContentX <= AqSeenMax + AqHalf)
            continue
        AqSeenMax := AqContentX
        if (AqKind = "buy") {
            if (AqUseOnly) {
                AqHitShop := true
                break
            }
            if (AqBuys >= AquariumMaxBuys)
                continue
        }
        AqDone += 1
        if (AqKind = "buy") {
            VxTip(8, "Action: Buy Fish Food")
            AqBuys += 1
        } else {
            VxTip(8, "Action: Use Fish Food")
            AqUses += 1
        }
        AqTap(AqCx, AqCy)
        Sleep, % Tm(AquariumStepDelay)
        AqScan()
    }
    AqScan()
    return
StopSweep:
StopSweepTicks += 1
Loop, 10
