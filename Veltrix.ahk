AqRegion() {
    global WindowWidth, WindowHeight, AqX0, AqY0, AqW, AqH
    global hAqScreenDC, hAqMemDC, hAqBM, pAqBits
    rx := Round(WindowWidth * 0.04)
    ry := Round(WindowHeight * 0.33)
    rw := Round(WindowWidth * 0.92)
    rh := Round(WindowHeight * 0.65)
    if (rw < 120 || rh < 60)
        return false
    if (hAqMemDC && rw = AqW && rh = AqH && rx = AqX0 && ry = AqY0)
        return true
    if (hAqMemDC) {
        DllCall("gdi32\DeleteObject", "Ptr", hAqBM)
        DllCall("gdi32\DeleteDC", "Ptr", hAqMemDC)
        DllCall("user32\ReleaseDC", "Ptr", 0, "Ptr", hAqScreenDC)
        hAqMemDC := 0
    }
    AqX0 := rx, AqY0 := ry, AqW := rw, AqH := rh
    hAqScreenDC := DllCall("user32\GetDC", "Ptr", 0, "Ptr")
    hAqMemDC := DllCall("gdi32\CreateCompatibleDC", "Ptr", hAqScreenDC, "Ptr")
    VarSetCapacity(bmi, 40, 0)
    NumPut(40, bmi, 0, "UInt")
    NumPut(AqW, bmi, 4, "Int")
    NumPut(-AqH, bmi, 8, "Int")
    NumPut(1, bmi, 12, "UShort")
    NumPut(32, bmi, 14, "UShort")
    pAqBits := 0
    hAqBM := DllCall("gdi32\CreateDIBSection", "Ptr", hAqMemDC, "Ptr", &bmi, "UInt", 0
        , "Ptr*", pAqBits, "Ptr", 0, "UInt", 0, "Ptr")
    if (!hAqBM) {
        hAqMemDC := 0
        return false
    }
    DllCall("gdi32\SelectObject", "Ptr", hAqMemDC, "Ptr", hAqBM)
    return true
}
AqGrab() {
    global hAqMemDC, hAqScreenDC, AqW, AqH, AqX0, AqY0, RobloxHwnd, VxBlt
    if (!AqRegion() || !RobloxHwnd)
        return false
    RobloxClientRect(RobloxHwnd, awx, awy)
    DllCall(VxBlt, "Ptr", hAqMemDC, "Int", 0, "Int", 0, "Int", AqW, "Int", AqH
        , "Ptr", hAqScreenDC, "Int", awx + AqX0, "Int", awy + AqY0, "UInt", 0x00CC0020)
    return true
}
AqEdge(ry, x) {
    global pAqBits, AqW, AqH
    if (ry < 0 || ry >= AqH || x < 0 || x >= AqW)
        return false
    px := NumGet(pAqBits + 0, (ry * AqW + x) * 4, "UInt")
    vb := px & 0xFF, vg := (px >> 8) & 0xFF
    return (vg >= 240 && vb >= 100 && vb <= 160)
}
AqRowRuns(ry, minW, ByRef starts, ByRef ends) {
    global AqW
    starts := [], ends := []
    inRun := false
    x := 0
    while (x <= AqW) {
        hit := (x < AqW) ? AqEdge(ry, x) : false
        if (hit && !inRun) {
            inRun := true
            rs := x
        } else if (!hit && inRun) {
            inRun := false
            if (x - rs >= minW)
                starts.Push(rs), ends.Push(x)
        }
        x++
    }
    return starts.Length()
}
AqFindAll() {
    global pAqBits, AqW, AqH, AqX0, AqY0
    global AqBtnN, AqBtnCX, AqBtnCY, AqBtnKind, AqBtnW, AqBtnH
    AqBtnN := 0
    AqBtnCX := [], AqBtnCY := [], AqBtnKind := []
    AqBtnW := 0, AqBtnH := 0
    if (!pAqBits || AqW < 120 || AqH < 60)
        return 0
    minW := 55
    maxW := Round(AqW * 0.45)
    minH := 16
    maxH := 96

    cand := []
    Loop % AqH {
        y := A_Index - 1
        base := y * AqW * 4
        hits := 0
        x := 0
        while (x < AqW) {
            px := NumGet(pAqBits + 0, base + x * 4, "UInt")
            vb := px & 0xFF, vg := (px >> 8) & 0xFF
            if (vb >= 100 && vb <= 160 && vg >= 240)
                hits++
            x += 8
        }
        if (hits >= 6)
            cand.Push(y)
    }
    if (cand.Length() < 1)
        return 0

    lines := []
    prev := -1000
    for _, cy in cand {
        if (cy - prev > 2)
            lines.Push(cy)
        prev := cy
    }

    seen := {}
    nL := lines.Length()
    Loop % nL {
        ia := A_Index
        ya := lines[ia]
        AqRowRuns(ya, minW, sa, ea)
        ib := ia + 1
        while (ib <= nL) {
            yb := lines[ib]
            gap := yb - ya
            ib++
            if (gap < minH)
                continue
            if (gap > maxH)
                break
            AqRowRuns(yb, minW, sb, eb)
            for i, s1 in sa {
                wA := ea[i] - s1
                if (wA > maxW)
                    continue
                for j, s2 in sb {
                    if (Abs(s1 - s2) <= 6 && Abs(ea[i] - eb[j]) <= 6) {
                        key := Round((s1 + ea[i]) / 2) "_" ya
                        if !seen.HasKey(key) {
                            seen[key] := 1
                            AqAddBtn(s1, ea[i], ya, yb)
                        }
                    }
                }
            }
        }
    }
    AqSortBtns()
    return AqBtnN
}
AqRemember() {
    global AqBtnN, AqBtnCX, AqBtnCY, AqHoverX, AqHoverY, AqHoverOk
    if (AqBtnN >= 1) {
        AqHoverX := AqBtnCX[1]
        AqHoverY := AqBtnCY[1]
        AqHoverOk := true
    }
}
AqShiftBetween(ox, on, nx, nn, pitch) {
    if (on < 1 || nn < 1 || pitch < 20)
        return 0
    lo := 3
    hi := Round(pitch * 0.92)
    diffs := []
    Loop % on {
        oldX := ox[A_Index]
        Loop % nn {
            d := oldX - nx[A_Index]
            if (d >= lo && d <= hi)
                diffs.Push(d)
        }
    }
    cnt := diffs.Length()
    if (cnt < 1)
        return pitch // 4
    i := 2
    while (i <= cnt) {
        v := diffs[i]
        j := i - 1
        while (j >= 1 && diffs[j] > v) {
            diffs[j + 1] := diffs[j]
            j--
        }
        diffs[j + 1] := v
        i++
    }
    return diffs[cnt // 2 + 1]
}
AqAddBtn(s, e, ya, yb) {
    global pAqBits, AqW, AqX0, AqY0
    global AqBtnN, AqBtnCX, AqBtnCY, AqBtnKind, AqBtnW, AqBtnH
    sg := 0, sn := 0
    base := ya * AqW * 4
    x := s
    while (x < e) {
        px := NumGet(pAqBits + 0, base + x * 4, "UInt")
        vb := px & 0xFF, vg := (px >> 8) & 0xFF, vr := (px >> 16) & 0xFF
        if (vg >= 240 && vb >= 100 && vb <= 160) {
            sg += vg - vr
            sn++
        }
        x++
    }
    if (sn < 12)
        return
    gr := sg // sn
    AqBtnN += 1
    AqBtnCX.Push(AqX0 + (s + e) // 2)
    AqBtnCY.Push(AqY0 + (ya + yb) // 2)
    AqBtnKind.Push(gr > 60 ? "buy" : "use")
    if (e - s > AqBtnW)
        AqBtnW := e - s
    if (yb - ya > AqBtnH)
        AqBtnH := yb - ya
}
AqSortBtns() {
    global AqBtnN, AqBtnCX, AqBtnCY, AqBtnKind
    i := 2
    while (i <= AqBtnN) {
        j := i
        while (j > 1 && AqBtnCX[j - 1] > AqBtnCX[j]) {
            t := AqBtnCX[j], AqBtnCX[j] := AqBtnCX[j - 1], AqBtnCX[j - 1] := t
            t := AqBtnCY[j], AqBtnCY[j] := AqBtnCY[j - 1], AqBtnCY[j - 1] := t
            t := AqBtnKind[j], AqBtnKind[j] := AqBtnKind[j - 1], AqBtnKind[j - 1] := t
            j--
        }
        i++
    }
}
AqScan() {
    global AqBtnN
    if !AqGrab()
        return 0
    AqFindAll()
    AqRemember()
    return AqBtnN
}
AqPanelOpen() {
