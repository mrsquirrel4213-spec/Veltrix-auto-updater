RodColTip := "Leave empty if the rod already works. Only for screens where detection never picks it up.`nType the colour code as 0x followed by the code.`nThe rod's own detection still runs and these are added to it. Empty = nothing changes."
RodTolTip := "How closely a pixel has to match one of the extra colours.`nHigher is more forgiving, too high lets scenery match."
SwColTip := "Filled in with the rod's own colour. Only change it if it is not picked up.`nUse Pick from screen in the Color Manager.`nEmpty the box to go back to normal."
SwTolTip := RodTolTip
SwColsNormalDef := "0x55446D|26|0xAFDAE8|22|0xFFFFFF|30"
SwColsOuijaDef := "0x959088|14|0xD4C5A4|40|0xE8E1C5|30"
SwColsToothlyDef := "0x7832C8|45|0xF0B4DC|22|0xFFFFFF|30"
SwColsKittyDef := "0xE1D7E6|40|0xF0EAF1|22|0xFFFFFF|30"
SwPresetCur := SwPreset

; i. move old zodiac colours aside when a skin preset is active
for mg_i, mg_m in [["Toothly Interstellar", "SwColsToothly", SwColsToothlyDef], ["Kitty Keys", "SwColsKitty", SwColsKittyDef]]
{
    mg_v := mg_m[2]
    if (SwPreset = mg_m[1] && %mg_v% = "" && SubStr(SwColsGet(), 1, 8) = "0x55446D")
    {
        if (SwColsNormal = "")
            SwColsNormal := SwColsGet()
        SwColsSet(mg_m[3])
    }
}
if (SwPreset = "Ominous Ouija" && SwColsOuija = "" && (SwColsNormal = "" || SubStr(SwColsNormal, 1, 8) = "0x959088"))
{
    if (SwColsNormal = "" && SubStr(SwColsGet(), 1, 8) != "0x959088")
        SwColsNormal := SwColsGet()
    else
        SwColsNormal := SwColsNormalDef
    if (SubStr(SwColsGet(), 1, 8) != "0x959088")
        SwColsSet(SwColsOuijaDef)
    SwColsOuija := SwColsGet()
}

