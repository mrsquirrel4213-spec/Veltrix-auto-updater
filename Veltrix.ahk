        if (l < 0)
            l := ColorListFirstX(lList, tol, row, lx - 70, lx + 70)
    }
    if (LastBarR >= 0) {
        rx := Round(LastBarR - FishBarLeft)
        if (IsObject(rLive))
            r := ColorListLastX(rLive, adTol, row, rx - 70, rx + 70)
        if (r < 0)
            r := ColorListLastX(rList, tol, row, rx - 70, rx + 70)
    }
    if (l < 0)
        l := ColorListFirstX(lList, tol, row, 0, W - 1)
    if (r < 0)
        r := ColorListLastX(rList, tol, row, 0, W - 1)
    if (l < 0 || r < 0) {
        Loop 3 {
            y2 := Floor(H * (2 * A_Index - 1) / 6)
            if (l < 0)
                l := ColorListFirstX(lList, tol, y2, 0, W - 1)
            if (r < 0)
                r := ColorListLastX(rList, tol, y2, 0, W - 1)
            if (l >= 0 && r >= 0)
                break
        }
    }

    tcUsed := false
    refW := BarColRef()
    tcNow := 0
    DllCall("QueryPerformanceCounter", "Int64*", tcNow)
    ; recently-known width says the edges are too close: try the track contrast
    if (MgInPlay && refW > 8 && BarColT != 0 && (tcNow - BarColT) / QpcFreq <= 3.0) {
        curW := (l >= 0 && r > l) ? r - l + 1 : 0
        tcL := -1, tcW := 0
        if (curW < 0.90 * refW && BarByTrackContrast(row, tcL, tcW) && Abs(tcW - refW) <= 0.25 * refW) {
            l := tcL
            r := tcL + tcW - 1
            tcUsed := true
        }
    }
    ; colour continues past an edge: the bar may be wider than found
    if (!tcUsed && l >= 0 && r > l) {
