    W := CaptureW
    if (row < 0 || row >= CaptureH)
        return false
    xo := x + 10 * dir
    xi := x - 18 * dir
    if (xo < 0 || xo > W - 1 || xi < 0 || xi > W - 1)
        return false
    po := NumGet(pCaptureBits + (row * W + xo) * 4, "UInt")
    pi := NumGet(pCaptureBits + (row * W + xi) * 4, "UInt")
    Loop 3 {
        sh := (A_Index - 1) * 8
        if (Abs(((po >> sh) & 0xFF) - ((pi >> sh) & 0xFF)) > 40)
            return false
    }
    return true
}
BarColRef() {
	global BarColRing
