	AdvCtrls.Push(hC)
	ThemedCtrls.Push(hC)
	Gui, Font, s8 Norm c%ColorMuted%, Segoe UI
	AdvDef := (e[2] = "L") ? AdvUL[1] . "  (def " . e[4] . ")" : AdvUL[1]
	Gui, Add, Text, x668 y%AdvY% w90 h20 +0x200 HwndhC, %AdvDef%
	AdvCtrls.Push(hC)
	SpecialBrushes[hC] := {brush: hBrushBG, text: ColorMutedBGR}
	AdvY += 24
	}
