BarByTrackContrast(row, ByRef bl, ByRef bw) {
    global CaptureH, FishBarLeft
    bl := -1, bw := 0
    s0 := -1, e0 := -1
    if !TrackRunAt(row, s0, e0)
        return false
    w0 := e0 - s0 + 1
    slack := Max(6, Round(0.06 * w0))
    dy := Max(2, Round(0.15 * CaptureH))
    for _, sgn in [-1, 1] {
        ry := row + sgn * dy
        if (ry < 1)
            ry := 1
        if (ry > CaptureH - 2)
            ry := CaptureH - 2
        if (ry = row)
            continue
        s1 := -1, e1 := -1
        if !TrackRunAt(ry, s1, e1)
            return false
        if (Abs(s1 - s0) > slack || Abs(e1 - e0) > slack)
            return false
    }
    bl := FishBarLeft + s0
    bw := w0
    return true
}
TrackRunAt(row, ByRef rs, ByRef re) {
    global pCaptureBits, CaptureW, CaptureH
    rs := -1, re := -1
    W := CaptureW
    if (row < 0 || row >= CaptureH || W < 40)
        return false
    rowP := pCaptureBits + row * W * 4
    hist := []
    Loop 64
        hist[A_Index - 1] := 0
    lum := []
    Loop % W {
        x := A_Index - 1
        P := NumGet(rowP + x * 4, "UInt")
        L := ((P & 0xFF) + ((P >> 8) & 0xFF) + ((P >> 16) & 0xFF)) // 3
        lum[x] := L
        hist[L // 4] += 1
    }
    half := W // 2
    med := 0, acc := 0
    Loop 64 {
        acc += hist[A_Index - 1]
        if (acc >= half) {
            med := 4 * (A_Index - 1) + 2
            break
        }
    }
    thr := 2 * med
    if (thr < med + 15)
        thr := med + 15
    runS := -1, runE := -1, bestS := -1, bestLen := 0
    x := 0
    while (x <= W) {
        if (x < W && lum[x] > thr) {
            if (runS < 0)
                runS := x
            runE := x
        } else if (runS >= 0 && ((x - runE) > 20 || x = W)) {
            if (runE - runS + 1 > bestLen)
                bestS := runS, bestLen := runE - runS + 1
            runS := -1
        }
        x++
    }
    if (bestS < 0 || bestLen < 40)
        return false
    rs := bestS
    re := bestS + bestLen - 1
    return true
}
BarEndInside(row, x, dir) {
