VxVersionNewer(a, b) {
    pa := StrSplit(a, ".")
    pb := StrSplit(b, ".")
    Loop, 4 {
        x := pa[A_Index]
        y := pb[A_Index]
        if (x = "")
            x := 0
        if (y = "")
            y := 0
        x += 0
        y += 0
        if (x > y)
            return true
        if (x < y)
            return false
    }
    return false
}
