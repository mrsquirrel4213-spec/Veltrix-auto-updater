ColStats(x, ys, ByRef m, ByRef sd) {
    global pCaptureBits, CaptureW
    vals := []
    total := 0
    for _, y in ys {
        P := NumGet(pCaptureBits + (y * CaptureW + x) * 4, "UInt")
        L := ((P & 0xFF) + ((P >> 8) & 0xFF) + ((P >> 16) & 0xFF)) // 3
        vals.Push(L)
        total += L
    }
    cnt := vals.Length()
    m := total / cnt
    sq := 0
    for _, L in vals
        sq := sq + (L - m) ** 2
    sd := Sqrt(sq / cnt)
}
FindFishBand(xFrom, xTo, barKnown) {
    global CaptureW, CaptureH, FishBarLeft, LastFishX, RunLeft, RunWidth
    W := CaptureW, H := CaptureH
    rows := []
    Loop 7 {
        y := Floor(H * (2 * A_Index - 1) / 14)
        rows.Push(y > H - 1 ? H - 1 : y)
    }
    off := Max(10, Round(0.025 * W))
    xFrom := Max(xFrom, off)
    xTo := Min(xTo, W - off - 1)
    if (xFrom > xTo)
        return -1
    means := [], sds := []
    x := xFrom - off
    while (x <= xTo + off) {
        ColStats(x, rows, cm, csd)
        means[x] := cm, sds[x] := csd
        x++
    }
    bandStart := -1, bestC := -1, bestScore := ""
    x := xFrom
    while (x <= xTo + 1) {
        ok := false
        if (x <= xTo && sds[x] <= 25) {
            dl := means[x] - means[x - off]
            dr := means[x] - means[x + off]
            if (Min(Abs(dl), Abs(dr)) >= 8 && ((dl > 0 && dr > 0) || (dl <= 0 && dr <= 0)))
                ok := true
        }
        if (ok) {
            if (bandStart < 0)
                bandStart := x
        } else if (bandStart >= 0) {
            w := x - bandStart
            if (w >= 5 && w <= 14) {
                c := Round(bandStart + w / 2)
                peak := Min(Abs(means[c] - means[c - off]), Abs(means[c] - means[c + off]))
                score := (LastFishX >= 0) ? 100000 - Abs(FishBarLeft + c - LastFishX) : peak
                if (bestC < 0 || score > bestScore)
                    bestC := c, bestScore := score
            }
            bandStart := -1
        }
        x++
    }
    if (bestC < 0)
        return -1
    return FishBarLeft + bestC
}
StripHasFishLine() {
    global CaptureW, CaptureH, BarScanRow
    W := CaptureW, H := CaptureH
    off := Max(10, Round(0.025 * W))
    rows := []
    Loop 5 {
        y := Floor(H * (2 * A_Index - 1) / 10)
        rows.Push(y > H - 1 ? H - 1 : y)
    }
    x := off
    while (x <= W - off - 1) {
        if IsDarkNotch(x, BarScanRow, off) {
            votes := 0
            for _, y in rows
                if IsDarkNotch(x, y, off)
                    votes++
            if (votes >= 3)
                return true
        }
        x++
    }
    return false
}
FindColorCenter(targetBGR, tol) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft
    W := CaptureW, H := CaptureH
    ; note: the low byte is treated as red and the high byte as blue
    tB := (targetBGR >> 16) & 0xFF
    tG := (targetBGR >> 8) & 0xFF
    tR := targetBGR & 0xFF
    Loop 5 {
        y := Floor(H * (2 * A_Index - 1) / 10)
        if (y < 0)
            y := 0
        if (y > H - 1)
            y := H - 1
        rowP := pCaptureBits + y * W * 4
        runStart := -1, runEnd := -1
        Loop % W {
            x := A_Index - 1
            P := NumGet(rowP + x * 4, "UInt")
            if (Abs(((P >> 16) & 0xFF) - tR) <= tol && Abs(((P >> 8) & 0xFF) - tG) <= tol
                && Abs((P & 0xFF) - tB) <= tol) {
                if (runStart < 0)
                    runStart := x
                runEnd := x
            } else if (runStart >= 0 && x - runEnd > 4) {
                break
            }
        }
        if (runStart >= 0)
            return FishBarLeft + (runStart + runEnd) / 2
    }
    return -1
}
GetFishPosBase() {
    global SpecialRod, ControlMode, RelLock, FishColor, FishBarColorTolerance, BarScanRow, LastFishX
    global CaptureW, CaptureH, FishBarLeft
    global SwFishX, SwFishHeld, CastFishX, HaliFishX, NoiseFishX, RemTargetX, MiguFishX, TryFishX
    global LineFishX, PinFishX, DoomFishX
    rod := SpecialRod
    if (rod = "Stellarwave Melody") {
        SwScan()
        return SwFishHeld ? -1 : SwFishX
    }
    if (rod = "Castbound") {
        CastboundScan()
        return CastFishX
    }
    if (rod = "Halibut Harpoon")
        return HalibutBarScan() ? HaliFishX : -1
    if (rod = "Doomsekkar") {
        DoomScan()
        return DoomFishX
    }
    if (rod = "Oppressor")
        return OppTarget()
    if (rod = "Noiseform") {
        NoiseScan()
        return NoiseFishX
    }
    if (rod = "Remembrance")
        return RemembranceScan() ? RemTargetX : -1
    if (rod = "MiguRod")
        return MiguScan() ? MiguFishX : -1
    if (rod = "Tryhard Rod") {
        TryhardScan()
        return TryFishX
    }
    if (ControlMode = "Lines") {
        LineScan()
        if (LineFishX >= 0) {
            if (rod = "Verdant Oath")
                LastFishX := LineFishX
            return LineFishX
        }
    }
    if (rod = "Verdant Oath")
        return VerdantFishX()
    if (rod = "Pinions Aria") {
        PinionScan()
        if (PinFishX >= 0)
            return PinFishX
    }
    if (RelLock = 1) {
        rfx := FindFishRelative()
        if (rfx >= 0)
            return rfx
    }
    W := CaptureW, H := CaptureH
    fList := ColorListParse(FishColor)
    tol := FishBarColorTolerance
    row := BarScanRow
    if (row < 0 || row >= H)
        row := H // 2
    if (LastFishX >= 0) {
        lx := Round(LastFishX - FishBarLeft)
        fx := ColorListCenterX(fList, tol, row, lx - 55, lx + 55)
        if (fx >= 0) {
            LastFishX := fx
            return fx
        }
    }
    fx := ColorListCenterX(fList, tol, row, 0, W - 1)
    if (fx >= 0) {
        LastFishX := fx
        return fx
    }
    Loop 3 {
        y2 := Floor(H * (2 * A_Index - 1) / 6)
        fx := ColorListCenterX(fList, tol, y2, 0, W - 1)
        if (fx >= 0) {
            LastFishX := fx
            return fx
        }
    }
    fx := FindFishBand(0, W - 1, true)
    if (fx >= 0) {
        LastFishX := fx
        return fx
    }
    return LastFishX
}
GetFishX() {
    global CaptureW, CaptureH, FishBarLeft, BarScanRow, RunLeft, RunWidth, LastFishX
    scanY := BarScanRow
    if (scanY < 0 || scanY >= CaptureH)
        scanY := CaptureH // 2
    gap := Round(0.025 * CaptureW)
    if (gap < 10)
        gap := 10
    if (LastFishX >= 0)
        refX := LastFishX
    else
        refX := RunLeft + RunWidth / 2
    ; five vote rows at 10/30/50/70/90 percent of the capture height
    voteRows := []
    Loop 5
    {
        vy := Floor(CaptureH * (2 * A_Index - 1) / 10)
        if (vy < 0)
            vy := 0
        if (vy > CaptureH - 1)
            vy := CaptureH - 1
        voteRows.Push(vy)
    }
    bestX := -1
    bestDist := 999999
    px := gap
    while (px < CaptureW - gap)
    {
        if IsDarkNotch(px, scanY, gap)
        {
            agree := 0
            for _, vy in voteRows
                if IsDarkNotch(px, vy, gap)
                    agree++
            if (agree >= 3)
            {
                absX := FishBarLeft + px
                dist := Abs(absX - refX)
                if (dist < bestDist)
                {
                    bestDist := dist
                    bestX := absX
                }
            }
        }
        px++
    }
    if (bestX < 0)
        return -1
    LastFishX := bestX
    return bestX
}
IsDarkNotch(x, y, off) {
    global pCaptureBits, CaptureW, CaptureH
    if (y < 0 || y >= CaptureH || x < off || x >= CaptureW - off)
        return false
    rowPtr := pCaptureBits + y * CaptureW * 4
    mid := NumGet(rowPtr + x * 4, 0, "UInt")
    lft := NumGet(rowPtr + (x - off) * 4, 0, "UInt")
    rgt := NumGet(rowPtr + (x + off) * 4, 0, "UInt")
    c := Floor(((mid & 0xFF) + ((mid >> 8) & 0xFF) + ((mid >> 16) & 0xFF)) / 3)
    lN := Floor(((lft & 0xFF) + ((lft >> 8) & 0xFF) + ((lft >> 16) & 0xFF)) / 3)
    rN := Floor(((rgt & 0xFF) + ((rgt >> 8) & 0xFF) + ((rgt >> 16) & 0xFF)) / 3)
    navg := Floor((lN + rN) / 2)
    margin := Round(0.25 * navg)
    if (margin < 8)
        margin := 8
    return (lN - c >= margin && rN - c >= margin)
}
FindColorX(targetHex, tol) {
