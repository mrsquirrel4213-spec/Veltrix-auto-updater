    tB := (fbgr >> 16) & 255, tG := (fbgr >> 8) & 255, tR := fbgr & 255
    ftol := Max(6, FishBarColorTolerance)
    frow := H // 2
    fneed := (NoiseZOK || NoiseZoneTgt >= 0) ? 3 : 4
    fwmax := Max(8, Round(0.028 * W))
    edgeM := Max(10, Round(0.016 * W))
