    global CastboundBarColors, CastboundBarTol, CastboundFishColors, CastboundFishTol
    global CastboundTrackColors, CastboundTrackTol
    global CbxKey, CbxR, CbxG, CbxB, CbxBuf
    global CastScanned, CastFound, CastBarL, CastBarW, CastFishX
    key := CastboundBarColors "|" CastboundBarTol "|" CastboundFishColors "|" CastboundFishTol
        . "|" CastboundTrackColors "|" CastboundTrackTol
    if (key != CbxKey) {
        CbxKey := key
        RodLut(CbxR, CbxG, CbxB, CastboundBarColors, CastboundBarTol, CastboundSwordX(), CastboundFishTol
            , CastboundTrackColors, CastboundTrackTol)
        VarSetCapacity(CbxBuf, 768 * 4, 0)
        Loop 256 {
            v := A_Index - 1
            NumPut(CbxR[v], CbxBuf, v * 4, "UInt")
            NumPut(CbxG[v], CbxBuf, (256 + v) * 4, "UInt")
            NumPut(CbxB[v], CbxBuf, (512 + v) * 4, "UInt")
        }
