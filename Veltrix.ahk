; hex digits (no prefix) -> number; a "0x" string built inside an expression is not numeric in AHK v1 math
VxHexNum(h) {
    h := "0x" h
    return h + 0
}
ColNorm(v) {
    s := Trim(v)
    if (s = "")
        return -1
    hasPrefix := false
    if (SubStr(s, 1, 1) = "#")
    {
        s := SubStr(s, 2)
        hasPrefix := true
    }
    else if (SubStr(s, 1, 2) = "0x")    ; case-insensitive, so 0X too
    {
        s := SubStr(s, 3)
        hasPrefix := true
    }
    if RegExMatch(s, "^[0-9A-Fa-f]{6}$")
        return VxHexNum(s)
    if (!hasPrefix && RegExMatch(s, "^[0-9]{1,8}$"))
    {
        dec := s + 0
        if (dec <= 0xFFFFFF)
            return dec
    }
    return -1
}
ColListToArray(str) {
    out := []
    str := RegExReplace(str, "\s*-\s*", "-")
    Loop, Parse, str, `,;|%A_Space%, %A_Space%%A_Tab%
    {
        ; a gradient stays one item, as text
        if (InStr(A_LoopField, "-"))
        {
            g := ColGradNorm(A_LoopField)
            if (g != "")
                out.Push(g)
            continue
        }
        c := ColNorm(A_LoopField)
        if (c >= 0)
            out.Push(c)
    }
    return out
}
ColArrayToList(arr) {
	out := ""
	for _i, v in arr
		out .= (out != "" ? ", " : "") . ColItemText(v)
	return out
}

ColListAdd(str, hex) {
    list := ColListToArray(str)
    c := InStr(hex, "-") ? ColGradNorm(hex) : ColNorm(hex)
    if (c = "" || c < 0)
        return ColArrayToList(list)
    for i, have in list
        if (have = c)
            return ColArrayToList(list)
    if (list.MaxIndex() >= 9)
        return ColArrayToList(list)
    list.Push(c)
    return ColArrayToList(list)
}
ColListRemoveAt(str, idx) {
    items := ColListToArray(str)
    top := items.MaxIndex()
    ; out of range: just hand back the normalised list
    if (idx < 1 || !top || idx > top)
        return ColArrayToList(items)
    items.RemoveAt(idx)
    return ColArrayToList(items)
}
