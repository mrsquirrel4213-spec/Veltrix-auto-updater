	dG := Abs(((px >> 8) & 0xFF) - ((po >> 8) & 0xFF))
	dB := Abs((px & 0xFF) - (po & 0xFF))
	if (dR <= tol && dG <= tol && dB <= tol)
		return -1
	return px
}

BarOneColor(px) {
