SwTplMaskRead(k, ByRef m, ByRef kn) {
    global VxNatSS, SwNoNat, SwTplFBuf, pCaptureBits, CaptureW, CaptureH, SwS, SwSB, SwFrTop
    global SwBarL, SwBarW, SwFishX, FishBarLeft, SwGrad, SwGradOk, SwGradDef, SwGradW
    global SwDarkR, SwDarkG, SwDarkB

    m := "", kn := ""
    barLeft := Round(FishBarLeft)
    cx := Round(SwSlotX(k)) - barLeft
    sz := 64 * SwSB
    x0 := cx - sz / 2
    y0 := SwFrTop + 11 * SwSB
    cell := sz / 16
    L := SwBarL - barLeft
    w := (SwGradOk && SwGradW > 0 && SwBarW < 0.97 * SwGradW) ? SwGradW : SwBarW
    c := L + w / 2
    fx := (SwFishX >= 0) ? SwFishX - barLeft : -9999
    pG := SwGradOk ? &SwGrad : &SwGradDef

    if (VxNatSS && !SwNoNat) {
        VarSetCapacity(outBuf, 96, 0)
        pTpl := (VarSetCapacity(SwTplFBuf) >= 24576) ? &SwTplFBuf : SwTplFBuf
        n := DllCall(VxNatSS, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH
            , "Double", x0, "Double", y0, "Double", cell, "Double", L, "Double", w, "Double", fx
            , "Double", SwSB, "Ptr", pG, "Int", SwDarkR, "Int", SwDarkG, "Int", SwDarkB
            , "Ptr", pTpl, "Ptr", &outBuf, "Int")
        if (n < 96)
            return
        sc := {}
        Loop 12
            sc[A_Index - 1] := NumGet(outBuf, (A_Index - 1) * 8, "Double")
        m := {nat: 1}
        kn := {Sc: sc, TpCnt: n}
        return
    }

    mm := [], kk := []
    Loop 256
        mm.Push(0), kk.Push(0)
    total := 0
    rowOff := [0.25, 0.75]
    Loop 16 {
        j := A_Index - 1
        Loop 16 {
            i := A_Index - 1
            hit := 0, kc := 0
            for _, oy in rowOff {
                y := Round(y0 + cell * (j + oy))
                if (y < 0 || y >= CaptureH)
                    continue
                p := pCaptureBits + y * CaptureW * 4
                for _, ox in rowOff {
                    x := Round(x0 + cell * (i + ox))
                    if (x < 0 || x >= CaptureW)
                        continue
                    u := (x - L) / (w - 1)
                    ; skip the bar centre band and the fish marker
                    if (Abs(x - c) <= 30 * SwSB || Abs(x - fx) <= 10 * SwSB)
                        continue
                    ; skip the bar edge bands
                    if ((u < 0.03 && x >= L - 8 * SwSB) || (u > 0.97 && x <= L + w - 1 + 8 * SwSB))
                        continue
                    if (u >= 0.03 && u <= 0.97) {
                        bin := Floor(64 * u)
                        if (bin > 63)
                            bin := 63
                        eb := NumGet(pG + bin * 3, 0, "UChar")
                        eg := NumGet(pG + bin * 3, 1, "UChar")
                        er := NumGet(pG + bin * 3, 2, "UChar")
                    } else {
                        eb := SwDarkB, eg := SwDarkG, er := SwDarkR
                    }
                    px := NumGet(p + x * 4, 0, "UInt")
                    db := Abs((px & 0xFF) - eb)
                    dg := Abs(((px >> 8) & 0xFF) - eg)
                    dr := Abs(((px >> 16) & 0xFF) - er)
                    d := (db > dg) ? db : dg
                    if (dr > d)
                        d := dr
                    kc += 1
                    if (d >= 40)
                        hit += 1
                }
            }
            if (kc >= 2) {
                idx := j * 16 + i + 1
                mm[idx] := hit / kc
                kk[idx] := 1
                total += 1
            }
        }
    }
    if (total < 96)
        return
    m := mm
    kn := kk
}
SwTplScore(m, kn, z) {
    global SwTplF, SwTplFBuf
    if (IsObject(kn) && kn.HasKey("Sc"))
        return kn.Sc[z]
    if (!kn.HasKey("TpCnt"))
        SwTplPrep(m, kn)
    n := kn.TpCnt
    if (n < 16)
        return -9
    sa := kn.TpSumA
    saa := kn.TpSumAA
    best := -9
    varA := saa - sa * sa / n

    if (kn.HasKey("TpPV") && kn.HasKey("TpPO")) {
        VarSetCapacity(sums, 216, 0)
        pTpl := (VarSetCapacity(SwTplFBuf) >= 24576) ? &SwTplFBuf : SwTplFBuf
        DllCall(SwTplSumFn(), "Ptr", kn.TpPV, "Ptr", kn.TpPO, "Int", n, "Ptr", pTpl + z * 2048, "Ptr", &sums)
        Loop 9 {
            o := (A_Index - 1) * 24
            sb := NumGet(sums, o, "Double")
            sbb := NumGet(sums, o + 8, "Double")
            sab := NumGet(sums, o + 16, "Double")
            den := varA * (sbb - sb * sb / n)
            if (den <= 0.000001)
                continue
            sc := (sab - sa * sb / n) / Sqrt(den)
            if (sc > best)
                best := sc
        }
        return best
    }

    cv := kn.TpVals
    base := z * 256 + 1
    Loop 9 {
        offs := kn.TpOffs[A_Index]
        sb := 0, sbb := 0, sab := 0
        Loop % n {
            vb := SwTplF[base + offs[A_Index]]
            sb += vb
            sbb += vb * vb
            sab += cv[A_Index] * vb
        }
        den := varA * (sbb - sb * sb / n)
        if (den <= 0.000001)
            continue
        sc := (sab - sa * sb / n) / Sqrt(den)
        if (sc > best)
            best := sc
    }
    return best
}
SwTplPrep(m, kn) {
    cv := [], cj := [], ci := []
    n := 0, sa := 0, saa := 0
    Loop 16 {
        j := A_Index - 1
        Loop 16 {
            i := A_Index - 1
            idx := j * 16 + i + 1
            if (!kn[idx])
                continue
            va := m[idx]
            n += 1
            sa += va
            saa += va * va
            cv.Push(va), cj.Push(j), ci.Push(i)
        }
    }
    kn.TpCnt := n
    kn.TpSumA := sa
    kn.TpSumAA := saa

    if (SwTplSumFn()) {
        ; native buffers kept alive inside kn
        kn.SetCapacity("TpBufV", n * 8 + 8)
        kn.SetCapacity("TpBufO", 9 * n * 4 + 8)
        pv := kn.GetAddress("TpBufV")
        po := kn.GetAddress("TpBufO")
        Loop % n
            NumPut(cv[A_Index], pv + 0, (A_Index - 1) * 8, "Double")
        w := 0
        dx := -1
        while (dx <= 1) {
            dy := -1
            while (dy <= 1) {
                Loop % n {
                    off := Mod(cj[A_Index] - dy + 16, 16) * 16 + Mod(ci[A_Index] - dx + 16, 16)
                    NumPut(off, po + 0, w * 4, "Int")
                    w += 1
                }
                dy += 1
            }
            dx += 1
        }
        kn.TpPV := pv
        kn.TpPO := po
        return
    }

    shifts := []
    dx := -1
    while (dx <= 1) {
        dy := -1
        while (dy <= 1) {
            lst := []
            Loop % n
                lst.Push(Mod(cj[A_Index] - dy + 16, 16) * 16 + Mod(ci[A_Index] - dx + 16, 16))
            shifts.Push(lst)
            dy += 1
        }
        dx += 1
    }
    kn.TpVals := cv
    kn.TpOffs := shifts
}
SwTplSumFn() {
    ; Builds (once) a tiny x64 routine:
    ;   fn(double* v, int* ofs, int n, double* tpl, double* out)
    ; for 9 rows: out[row] = { sum tpl[ofs], sum tpl[ofs]^2, sum v[c]*tpl[ofs] }
    static pFn := ""
    if (pFn != "")
        return pFn
    pFn := 0
    if (A_PtrSize != 8)
        return 0
    code := "4C8B542428C744240809000000660F57C0660F57C9660F57D231C04439C07D2E4C631AF2430F101CD9"
        . "F20F58C3660F28E3F20F59E3F20F58CCF20F102CC1F20F59EBF20F58D54883C204FFC0EBCD"
        . "F2410F1102F2410F114A08F2410F1152104983C218FF4C240875A4C3"
    size := StrLen(code) // 2
    mem := DllCall("VirtualAlloc", "Ptr", 0, "UPtr", size, "UInt", 0x3000, "UInt", 0x04, "Ptr")
    if (!mem)
        return 0
    Loop % size {
        byteHex := "0x" . SubStr(code, 2 * A_Index - 1, 2)
        NumPut(byteHex + 0, mem + 0, A_Index - 1, "UChar")
    }
    oldProt := 0
    if !DllCall("VirtualProtect", "Ptr", mem, "UPtr", size, "UInt", 0x20, "UInt*", oldProt) {
        DllCall("VirtualFree", "Ptr", mem, "UPtr", 0, "UInt", 0x8000)
        return 0
    }
    ; self test against a plain computation
    cols := 20
    VarSetCapacity(tv, cols * 8, 0)
    Loop % cols
        NumPut(Mod(7 * (A_Index - 1), 5) / 4.0, tv, (A_Index - 1) * 8, "Double")
    VarSetCapacity(ttpl, 256 * 8, 0)
    Loop 256
        NumPut(Mod(13 * (A_Index - 1), 255) / 255.0, ttpl, (A_Index - 1) * 8, "Double")
    VarSetCapacity(tofs, 9 * cols * 4, 0)
    Loop % 9 * cols
        NumPut(Mod(37 * (A_Index - 1) + 11, 256), tofs, (A_Index - 1) * 4, "Int")
    VarSetCapacity(tout, 216, 0)
    DllCall(mem, "Ptr", &tv, "Ptr", &tofs, "Int", cols, "Ptr", &ttpl, "Ptr", &tout)
    good := true
    Loop 9 {
        row := A_Index - 1
        sumB := 0.0, sumBB := 0.0, sumAB := 0.0
        Loop % cols {
            c := A_Index - 1
            vb := NumGet(ttpl, NumGet(tofs, (row * cols + c) * 4, "Int") * 8, "Double")
            va := NumGet(tv, c * 8, "Double")
            sumB := sumB + vb
            sumBB := sumBB + vb * vb
            sumAB := sumAB + va * vb
        }
        if (NumGet(tout, row * 24, "Double") != sumB
            || NumGet(tout, row * 24 + 8, "Double") != sumBB
            || NumGet(tout, row * 24 + 16, "Double") != sumAB) {
            good := false
            break
        }
    }
    if (!good) {
        DllCall("VirtualFree", "Ptr", mem, "UPtr", 0, "UInt", 0x8000)
        return 0
    }
    pFn := mem
    return pFn
}
