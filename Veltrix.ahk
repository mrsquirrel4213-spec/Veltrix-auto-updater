    if (CastBarW <= 0) {
        tGap := Max(10, Round(0.02 * W))
        nTrk := 0
        tBest := -1, tLen := 0, tRun := -1, tEnd := -1, tG := 0
        Loop % W {
            x := A_Index - 1
            P := NumGet(midP + x * 4, "UInt")
            b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF, s := r + g + b
            if (b - g > 20 && r - g > 5 && s >= 180 && s <= 340) {
                nTrk++
                if (tRun >= 0) {
