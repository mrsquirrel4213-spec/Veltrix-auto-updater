    FishBarBottom := WindowHeight / 1.1512
    if (SpecialRod = "Remembrance") {
        FishBarTop := WindowHeight / 1.2318
        FishBarBottom := WindowHeight / 1.1862
    }
    if (SpecialRod = "Doomsekkar") {
        FishBarLeft := WindowWidth * 0.24
        FishBarRight := WindowWidth * 0.76
    }
    if (SpecialRod = "Oppressor") {
        FishBarLeft := WindowWidth * 0.26
        FishBarRight := WindowWidth * 0.73
        FishBarTop := WindowHeight * 0.8285
        FishBarBottom := WindowHeight * 0.885
    }
    if (SpecialRod = "Stellarwave Melody") {
        FishBarLeft := WindowWidth * 0.22
        FishBarRight := WindowWidth * 0.78
        FishBarTop := WindowHeight * 0.795
        FishBarBottom := WindowHeight * 0.945
    }

    TrackLeft := FishBarLeft
    TrackRight := FishBarRight
    if (SpecialRod = "Stellarwave Melody") {
        TrackLeft := WindowWidth * 0.245
        TrackRight := WindowWidth * 0.755
    }

    FishBarTooltipHeight := WindowHeight / 1.0626
    gosub SetupCapture

    ResolutionScaling := 2560 / WindowWidth
    LookDownX := WindowWidth / 2
    LookDownY := WindowHeight / 4

    runtimeS := 0, runtimeM := 0, runtimeH := 0

    ; Tooltip rows are 20 px apart, row 10 sits at mid height
    TooltipX := WindowWidth / 20
    Loop, 20
        Tooltip%A_Index% := WindowHeight / 2 + 20 * (A_Index - 10)

    if (DetTesting)
        goto CalcTipsDone
    VxTip(2, "Runtime: 0h 0m 0s")
    if (DetTesting)
        goto CalcTipsDone
    gosub RefreshHints
    VxTip(14, "Navigation Key: """ NavigationKey """")
    if (ShakeMode = "Disabled")
        VxTip(16, "Shake Mode: ""Disabled""")
    else
        VxTip(16, "Shake Mode: ""Navigation""")
    goto CalcTipsDone
CalcTipsDone:
return

;====================================================================================================;

runtime:
    if (RcBusy)
        return
    runtimeS += 1
    if (runtimeS >= 60) {
        runtimeS := 0
        runtimeM += 1
    }
    if (runtimeM >= 60) {
        runtimeM := 0
        runtimeH += 1
    }

    if (WinActive("ahk_id " RobloxHwnd)) {
        VxTip(2, "Runtime: " runtimeH "h " runtimeM "m " runtimeS "s")
        gosub RefreshHints
    } else if (PasIdle()) {
        ; passive mode: leave the other window alone
        VxTip(2, "Runtime: " runtimeH "h " runtimeM "m " runtimeS "s | Passive - Roblox is in the background")
    } else {
        if (!CastHolding)
            Send, {lbutton up}
        Send, {rbutton up}
        Send, {shift up}
        PrecisionDown := false
        MacroPaused := true
        PausedMs := 0
        while (MacroRunning && !WinActive("ahk_id " RobloxHwnd)) {
            if (!WinExist("ahk_id " RobloxHwnd)) {
                gosub ResolveRoblox
                if (!RobloxHwnd) {
                    VxTip(2, "Waiting for the Roblox window to come back...")
                    Sleep, % Tm(TA("winback", 1000))
                    continue
                }
            }
            WinActivate, ahk_id %RobloxHwnd%
            WinWaitActive, ahk_id %RobloxHwnd%, , 1
            PausedMs += 100
            VxTip(2, "Reclaiming focus - Roblox was not in front")
            if (!WinActive("ahk_id " RobloxHwnd))
                Sleep, % Tm(TA("winfocus", 100))
        }
        MacroPaused := false
        if (!MacroRunning)
            goto Idle
    }
return
HotkeyToggle:
if (MacroRunning)
