        hits := 0
        for _, y in barRows {
            P := NumGet(bits + (y * W + x) * 4, "UInt")
            b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF, s := r + g + b
            m := CbxR[r] & CbxG[g] & CbxB[b]
            isTrk := ((b - g > 20 && r - g > 5 && s >= 180 && s <= 340) || (m & 0x7FC0000))
            isSw := ((g < 90 && b > 130 && b - g > 80 && r < 160) || (m & 0x3FE00))
            if (!isTrk && !isSw && (s >= 110 || (m & 0x1FF)))
                hits++
        }
        if (hits >= 2) {
            if (runS < 0)
                runS := x
            runE := x
            gap := 0
        } else if (runS >= 0) {
            gap++
            if (gap > gapMax) {
                if (runE - runS + 1 > bestLen)
