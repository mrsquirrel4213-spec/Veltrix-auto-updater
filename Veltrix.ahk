    NoiseBarW := (be - bs + 1) * step
    NoiseFound := true
    NoisePrevC := Floor((bs + be) * step / 2)
    NoisePrevT := tnow
    if (Abs(NoisePrevC - NoiseStillX) <= 2) {
        NoiseStillC := NoiseStillC + 1
    } else {
        NoiseStillC := 0
        NoiseStillX := NoisePrevC
    }
    if (NoiseStillC >= NoiseN45) {
        NoisePrevT := 0
        NoiseStillC := 0
    }

    ; --- O. fish marker ---
