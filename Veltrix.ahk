FindBarRelative() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, BarScanRow, VxNatRL, NatOff
    global RunLeft, RunWidth, RelBarL, RelBarR, RelBarRow
    row := BarScanRow
    if (row < 0 || row >= CaptureH)
        row := Floor(CaptureH / 2)

    if (VxNatRL && !NatOff) {
        VarSetCapacity(outBuf, 8, 0)
        if !DllCall(VxNatRL, "Ptr", pCaptureBits, "Int", CaptureW, "Int", row, "Ptr", &outBuf, "Int")
            return false
        RelBarL := NumGet(outBuf, 0, "Int")
        RelBarR := NumGet(outBuf, 4, "Int")
        RunLeft := FishBarLeft + RelBarL
        RunWidth := RelBarR - RelBarL + 1
        RelBarRow := row
        return true
    }

    rowP := pCaptureBits + row * CaptureW * 4
    total := 0, peak := 0
    Loop % CaptureW {
        v := NumGet(rowP + (A_Index - 1) * 4, "UInt")
        l := ((v & 0xFF) + ((v >> 8) & 0xFF) + ((v >> 16) & 0xFF)) // 3
        total += l
        if (l > peak)
            peak := l
    }
    avg := total // CaptureW
    thr := avg + Max(30, (peak - avg) * 35 // 100)
    if (peak < thr)
        return false

    bestS := -1, bestE := -1, bestW := 0
    runS := -1, runE := -1
    Loop % CaptureW {
        x := A_Index - 1
        v := NumGet(rowP + x * 4, "UInt")
        l := ((v & 0xFF) + ((v >> 8) & 0xFF) + ((v >> 16) & 0xFF)) // 3
        if (l >= thr) {
            if (runS < 0)
                runS := x
            runE := x
        } else if (runS >= 0 && x - runE > 4) {
            if (runE - runS + 1 > bestW)
                bestS := runS, bestE := runE, bestW := runE - runS + 1
            runS := -1
        }
    }
    if (runS >= 0 && runE - runS + 1 > bestW)
        bestS := runS, bestE := runE, bestW := runE - runS + 1

    if (bestW < 8 || bestW > 0.6 * CaptureW)
        return false
    RunLeft := FishBarLeft + bestS
    RunWidth := bestW
    RelBarL := bestS
    RelBarR := bestE
    RelBarRow := row
    return true
}
FindFishRelative() {
    global pCaptureBits, CaptureW, FishBarLeft, RelBarL, RelBarR, RelBarRow, VxNatRF, NatOff, LastFishX
    if (RelBarR - RelBarL < 20)
        return -1

    if (VxNatRF && !NatOff) {
        VarSetCapacity(outBuf, 8, 0)
        if !DllCall(VxNatRF, "Ptr", pCaptureBits, "Int", CaptureW, "Int", RelBarRow, "Int", RelBarL
            , "Int", RelBarR, "Ptr", &outBuf, "Int")
            return -1
        fx := FishBarLeft + (NumGet(outBuf, 0, "Int") + NumGet(outBuf, 4, "Int")) / 2
        LastFishX := fx
        return fx
    }

    rowP := pCaptureBits + RelBarRow * CaptureW * 4
    cnt := RelBarR - RelBarL + 1
    sB := 0, sG := 0, sR := 0
    x := RelBarL
    while (x <= RelBarR) {
        v := NumGet(rowP + x * 4, "UInt")
        sB += v & 0xFF, sG += (v >> 8) & 0xFF, sR += (v >> 16) & 0xFF
        x += 1
    }
    mB := sB // cnt, mG := sG // cnt, mR := sR // cnt

    madSum := 0
    x := RelBarL
    while (x <= RelBarR) {
        v := NumGet(rowP + x * 4, "UInt")
        madSum += Abs((v & 0xFF) - mB) + Abs(((v >> 8) & 0xFF) - mG) + Abs(((v >> 16) & 0xFF) - mR)
        x += 1
    }
    thr := Max(16, 3 * (madSum // cnt))

    bestS := -1, bestE := -1, bestSum := -1
    runS := -1, runSum := 0
    x := RelBarL
    while (x <= RelBarR + 1) {
        d := -1
        if (x <= RelBarR) {
            v := NumGet(rowP + x * 4, "UInt")
            d := Abs((v & 0xFF) - mB) + Abs(((v >> 8) & 0xFF) - mG) + Abs(((v >> 16) & 0xFF) - mR)
        }
        if (x <= RelBarR && d >= thr) {
            if (runS < 0)
                runS := x, runSum := 0
            runSum += d
        } else if (runS >= 0) {
            ; close the run; only narrow runs can be the fish marker
            if (x - runS <= 25 && runSum > bestSum)
                bestS := runS, bestE := x - 1, bestSum := runSum
            runS := -1
        }
        x += 1
    }
    if (bestS < 0)
        return -1
    fx := FishBarLeft + (bestS + bestE) / 2
    LastFishX := fx
    return fx
}
BarWPush(w) {
    global BarWRing, BarWMed
    if (!IsObject(BarWRing))
        BarWRing := []
    BarWRing.Push(w)
    if (BarWRing.Length() > 5)
        BarWRing.RemoveAt(1)
    cnt := BarWRing.Length()
    srt := []
    for _, v in BarWRing {
        pos := srt.Length()
        while (pos >= 1 && srt[pos] > v)
            pos -= 1
        srt.InsertAt(pos + 1, v)
    }
    BarWMed := srt[cnt // 2 + 1]
}
GradRod() {
