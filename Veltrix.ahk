MiguBarScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, NatOff, VxNatMB
    global MiguBarScanned, MiguBarFound, MiguBarL, MiguBarW
    if (MiguBarScanned)
        return MiguBarFound
    MiguBarScanned := true
    MiguBarFound := false
    W := CaptureW, H := CaptureH, bits := pCaptureBits
    if (W < 40 || H < 6)
        return false
    if (VxNatMB && !NatOff) {
        VarSetCapacity(res, 8, 0)
        if (!DllCall(VxNatMB, "Ptr", bits, "Int", W, "Int", H, "Ptr", &res, "Int"))
            return false
        MiguBarL := FishBarLeft + NumGet(res, 0, "Int")
        MiguBarW := NumGet(res, 4, "Int")
        MiguBarFound := true
        return true
    }
    rows := [Floor(H * 0.30), Floor(H * 0.50), Floor(H * 0.70)]
    ; the reddish track must cover a quarter of the 70% row
    base3 := bits + rows[3] * W * 4
    trk := 0
    Loop % W {
        P := NumGet(base3 + (A_Index - 1) * 4, "UInt")
        b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF
        if (r > 150 && g < 110 && r - g > 90 && r - b > 55)
            trk++
    }
    if (trk < 0.25 * W)
        return false
    ; per column: how many sample rows show bar colour
    colHits := []
    Loop % W {
        x := A_Index - 1
        n := 0
        for _, y in rows {
            P := NumGet(bits + (y * W + x) * 4, "UInt")
            b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF
            if (r > 190 && g >= 140 && g <= 245 && b >= 90 && b <= 215 && r - b > 40)
                n++
        }
        colHits[x] := n
    }
    gapMax := Max(12, Round(0.035 * W))
    minLen := Max(24, Round(0.05 * W))
    runS := -1, runLast := -1, bestL := -1, bestLen := 0
    x := 0
    while (x <= W) {
        if (x < W && colHits[x] >= 2) {
            if (runS < 0)
                runS := x
            runLast := x
        } else if (runS >= 0 && ((x - runLast) > gapMax || x = W)) {
            len := runLast - runS + 1
            if (len > bestLen)
                bestL := runS, bestLen := len
            runS := -1
        }
        x++
    }
    if (bestL < 0 || bestLen < minLen || bestLen > 0.85 * W)
        return false
    MiguBarL := FishBarLeft + bestL
    MiguBarW := bestLen
    MiguBarFound := true
    return true
}
MiguScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, FishColor, FishBarColorTolerance
    global MiguLastX, NatOff, VxNatMF, MiguScanned, MiguFound, MiguFishX
    if (MiguScanned)
        return MiguFound
    MiguScanned := true
    MiguFound := false
    MiguFishX := -1
    W := CaptureW, H := CaptureH, bits := pCaptureBits
    if (W < 40 || H < 6)
        return false
    if (VxNatMF && !NatOff) {
        lst := ColorListParse(FishColor)
        if (lst.n < 1)
            return false
        tol := (FishBarColorTolerance > 6) ? FishBarColorTolerance : 6
        prevX := (MiguLastX >= 0) ? MiguLastX : -1
        res := DllCall(VxNatMF, "Ptr", bits, "Int", W, "Int", H, "Ptr", ColorListBuf(lst), "Int", lst.n
            , "Double", tol, "Double", prevX, "Double", FishBarLeft, "Int")
        if (res < 0)
            return false
        MiguFishX := FishBarLeft + res
        MiguLastX := MiguFishX
        MiguFound := true
        return true
    }
    ; columns containing very dark pixels on any of three rows
    darkRows := [Floor(H * 0.30), Floor(H * 0.55), Floor(H * 0.85)]
    VarSetCapacity(dark, W, 0)
    Loop % W {
        x := A_Index - 1
        for _, y in darkRows {
            P := NumGet(bits + (y * W + x) * 4, "UInt")
            if (((P >> 16) & 0xFF) < 110 && ((P >> 8) & 0xFF) < 35 && (P & 0xFF) < 40) {
                NumPut(1, dark, x, "UChar")
                break
            }
        }
    }
    ; mask out narrow dark segments (and a little padding around them)
    minW := Max(3, Round(0.005 * W))
    maxW := Max(12, Round(0.034 * W))
    gap := Max(3, Round(0.006 * W))
    pad := Max(2, Round(0.004 * W))
    VarSetCapacity(mask, W, 0)
    x := 0
    while (x < W) {
        if (!NumGet(dark, x, "UChar")) {
            x++
            continue
        }
        segA := x, last := x
        while (x < W && (NumGet(dark, x, "UChar") || x - last <= gap)) {
            if (NumGet(dark, x, "UChar"))
                last := x
            x++
        }
        segW := last - segA + 1
        if (segW < minW || segW > maxW)
            continue
        mx := Max(0, segA - pad)
        mEnd := Min(W - 1, last + pad)
        while (mx <= mEnd) {
            NumPut(1, mask, mx, "UChar")
            mx++
        }
    }
    lst := ColorListParse(FishColor)
    if (lst.n < 1)
        return false
    tol := (FishBarColorTolerance > 6) ? FishBarColorTolerance : 6
    minR := lst.r[1], minG := lst.g[1]
    Loop % lst.n {
        if (lst.r[A_Index] < minR)
            minR := lst.r[A_Index]
        if (lst.g[A_Index] < minG)
            minG := lst.g[A_Index]
    }
    minR -= tol
    minG -= tol
    fr := []
    Loop 5 {
        y := Floor(H * (2 * A_Index - 1) / 10)
        fr[A_Index] := (y > H - 1) ? H - 1 : y
    }
    fw := Max(8, Round(0.03 * W))
    cands := []
    for _, ri in [3, 2, 4] {
        rowP := bits + fr[ri] * W * 4
        runS := -1
        x := 0
        while (x <= W) {
            hit := false
            if (x < W && !NumGet(mask, x, "UChar")) {
                P := NumGet(rowP + x * 4, "UInt")
                if (((P >> 16) & 0xFF) >= minR && ((P >> 8) & 0xFF) >= minG && ColorListHitPx(lst, P, tol))
                    hit := true
            }
            if (hit) {
                if (runS < 0)
                    runS := x
            } else if (runS >= 0) {
                rw := x - runS
                if (rw >= 2 && rw <= fw) {
                    cx := runS + rw // 2
                    votes := 0
                    Loop 5
                        if MiguFishAt(cx, fr[A_Index], lst, tol, &mask)
                            votes++
                    if (votes >= 4)
                        cands.Push([cx, votes])
                }
                runS := -1
            }
            x++
        }
        if (cands.Length())
            break
    }
    if (!cands.Length())
        return false
    bestV := 0
    for _, cd in cands
        if (cd[2] > bestV)
            bestV := cd[2]
    pick := -1
    if (MiguLastX >= 0) {
        bestD := ""
        for _, cd in cands {
            if (cd[2] != bestV)
                continue
            d := Abs(FishBarLeft + cd[1] - MiguLastX)
            if (d <= 0.25 * W && (pick < 0 || d < bestD))
                pick := cd[1], bestD := d
        }
    }
    if (pick < 0) {
        for _, cd in cands
            if (cd[2] >= bestV && (pick < 0 || cd[1] < pick))
                pick := cd[1]
    }
    MiguFishX := FishBarLeft + pick
    MiguLastX := MiguFishX
    MiguFound := true
    return true
}
MiguFishAt(fx, fy, fList, fTol, pMask) {
    global pCaptureBits, CaptureW, CaptureH
    if (fy < 0 || fy >= CaptureH)
        return false
    c := Max(0, fx - 5)
    cEnd := Min(CaptureW - 1, fx + 5)
    rowP := pCaptureBits + fy * CaptureW * 4
    while (c <= cEnd) {
        if (!NumGet(pMask + 0, c, "UChar") && ColorListHitPx(fList, NumGet(rowP + c * 4, "UInt"), fTol))
            return true
        c++
    }
    return false
}
CastboundScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, NatOff, VxNatCB
    global CastboundBarColors, CastboundFishColors, CastboundTrackColors
    global CastScanned, CastFound, CastBarL, CastBarW, CastFishX
    if ((CastboundBarColors != "" || CastboundFishColors != "" || CastboundTrackColors != "") && CastboundXActive())
        return CastboundScanX()
    if (CastScanned)
        return CastFound
    CastScanned := true
    CastFound := false
    CastBarL := -1, CastBarW := 0, CastFishX := -1
    W := CaptureW, H := CaptureH, bits := pCaptureBits
    if (W < 80 || H < 6)
        return false
    if (VxNatCB && !NatOff)
        return CastNat(0) ? CastTail() : false

    ; is the purple track present across the middle row?
    midP := bits + (H // 2) * W * 4
    nTrk := 0, tFirst := -1, tLast := -1
    Loop % W {
        x := A_Index - 1
        P := NumGet(midP + x * 4, "UInt")
        b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF, s := r + g + b
        if (b - g > 20 && r - g > 5 && s >= 180 && s <= 340) {
            nTrk++
            if (tFirst < 0)
                tFirst := x
            tLast := x
        }
    }
    if (nTrk < 0.10 * W)
        return false
    if (tLast - tFirst + 1 < 0.45 * W)
        return false

    ; bar: bright-ish columns that are neither track nor sword
    barRows := [H // 3, H // 2, (2 * H) // 3]
    gapMax := Max(30, Round(0.035 * W))
    runS := -1, runE := -1, gap := 0, bestL := -1, bestLen := 0
    Loop % W {
        x := A_Index - 1
        hits := 0
