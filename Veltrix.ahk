    {
        FrzI := A_Index
        FrzK := CMTargetKeys[FrzI]
        FrzMenu .= ((FrzI > 1) ? "     " : "") . ((FrzK = FreezeTarget) ? "▸ " : "") . FrzI . " " . CMShortLabel[FrzK]
    }
return
FreezePixelAt(sx, sy) {
    global pFullBits, FrzVX, FrzVY, FrzVW, FrzVH
    x := sx - FrzVX
    y := sy - FrzVY
    if (x < 0 || y < 0 || x >= FrzVW || y >= FrzVH)
        return ""
    px := NumGet(pFullBits + 0, y * FrzVW * 4 + x * 4, "UInt")
    return Format("0x{:02X}{:02X}{:02X}", (px >> 16) & 0xFF, (px >> 8) & 0xFF, px & 0xFF)
}
FreezePaintLoupe(sx, sy, force := false) {
    global hLoupeGui, hLoupeMem, hLoupeFont, hFullMemDC, pFullBits
    global LoupeSrc, LoupeZoom, LoupeImgW, LoupeW, LoupeH
    global FrzVX, FrzVY, FrzVW, FrzVH, VxBlt
    static lastX := -99999, lastY := -99999, lastZ := 0

    if (!hLoupeMem)
        return

    px := sx - FrzVX
    py := sy - FrzVY
    half := LoupeSrc // 2
    dc := hLoupeMem

    DllCall("SetBkMode", "Ptr", dc, "Int", 1)

    ; panel background
    VarSetCapacity(rc, 16, 0)
    NumPut(0, rc, 0, "Int"), NumPut(0, rc, 4, "Int"), NumPut(LoupeW, rc, 8, "Int"), NumPut(LoupeH, rc, 12, "Int")
    br := DllCall("CreateSolidBrush", "UInt", 0x140E0B, "Ptr")
    DllCall("FillRect", "Ptr", dc, "Ptr", &rc, "Ptr", br)
    DllCall("DeleteObject", "Ptr", br)

    ; magnified source block, clamped to the snapshot
    srcX := px - half
    srcY := py - half
    if (srcX > FrzVW - LoupeSrc)
        srcX := FrzVW - LoupeSrc
    if (srcX < 0)
        srcX := 0
    if (srcY > FrzVH - LoupeSrc)
        srcY := FrzVH - LoupeSrc
    if (srcY < 0)
        srcY := 0
    DllCall("SetStretchBltMode", "Ptr", dc, "Int", 3)
    DllCall("StretchBlt", "Ptr", dc, "Int", 6, "Int", 6, "Int", LoupeImgW, "Int", LoupeImgW
        , "Ptr", hFullMemDC, "Int", srcX, "Int", srcY, "Int", LoupeSrc, "Int", LoupeSrc, "UInt", 0x00CC0020)

    ; outline the cell under the cursor
    cellX := px - srcX
    cellY := py - srcY
    if (cellX < 0)
        cellX := 0
    if (cellY < 0)
        cellY := 0
    cx := 6 + LoupeZoom * cellX
    cy := 6 + LoupeZoom * cellY
    penBlack := DllCall("CreatePen", "Int", 0, "Int", 1, "UInt", 0x000000, "Ptr")
    penWhite := DllCall("CreatePen", "Int", 0, "Int", 1, "UInt", 0xFFFFFF, "Ptr")
    oldBrush := DllCall("SelectObject", "Ptr", dc, "Ptr", DllCall("GetStockObject", "Int", 5, "Ptr"), "Ptr")
    oldPen := DllCall("SelectObject", "Ptr", dc, "Ptr", penBlack, "Ptr")
    DllCall("Rectangle", "Ptr", dc, "Int", cx - 2, "Int", cy - 2, "Int", cx + 9, "Int", cy + 9)
    DllCall("SelectObject", "Ptr", dc, "Ptr", penWhite)
    DllCall("Rectangle", "Ptr", dc, "Int", cx - 1, "Int", cy - 1, "Int", cx + 8, "Int", cy + 8)
    DllCall("SelectObject", "Ptr", dc, "Ptr", oldPen)
    DllCall("SelectObject", "Ptr", dc, "Ptr", oldBrush)
    DllCall("DeleteObject", "Ptr", penBlack)
    DllCall("DeleteObject", "Ptr", penWhite)

    hex := FreezePixelAt(sx, sy)
    if (hex = "")
        hex := "0x000000"

    ; colour swatch (GDI wants BGR)
    rr := VxHexNum(SubStr(hex, 3, 2))
    gg := VxHexNum(SubStr(hex, 5, 2))
    bb := VxHexNum(SubStr(hex, 7, 2))
    bgr := (bb << 16) | (gg << 8) | rr
    NumPut(6, rc, 0, "Int"), NumPut(185, rc, 4, "Int"), NumPut(34, rc, 8, "Int"), NumPut(207, rc, 12, "Int")
    br := DllCall("CreateSolidBrush", "UInt", bgr, "Ptr")
    DllCall("FillRect", "Ptr", dc, "Ptr", &rc, "Ptr", br)
    DllCall("DeleteObject", "Ptr", br)

    ; hex text next to the swatch
    oldFont := DllCall("SelectObject", "Ptr", dc, "Ptr", hLoupeFont, "Ptr")
    DllCall("SetTextColor", "Ptr", dc, "UInt", 0xF7F1EE)
    NumPut(40, rc, 0, "Int"), NumPut(185, rc, 4, "Int"), NumPut(LoupeW - 6, rc, 8, "Int"), NumPut(207, rc, 12, "Int")
    DllCall("DrawText", "Ptr", dc, "Str", hex, "Int", -1, "Ptr", &rc, "UInt", 0x24)
    DllCall("SelectObject", "Ptr", dc, "Ptr", oldFont)

    ; push the finished image to the window
    wdc := DllCall("GetDC", "Ptr", hLoupeGui, "Ptr")
    DllCall(VxBlt, "Ptr", wdc, "Int", 0, "Int", 0, "Int", LoupeW, "Int", LoupeH
        , "Ptr", dc, "Int", 0, "Int", 0, "UInt", 0x00CC0020)
    DllCall("ReleaseDC", "Ptr", hLoupeGui, "Ptr", wdc)

    ; sit down-right of the cursor, flip near the edges
    lx := sx + 26
    ly := sy + 26
    if (lx + LoupeW > FrzVX + FrzVW)
        lx := sx - LoupeW - 26
    if (ly + LoupeH > FrzVY + FrzVH)
        ly := sy - LoupeH - 26

    if (force || lx != lastX || ly != lastY || A_TickCount - lastZ >= 100)
    {
        lastX := lx
        lastY := ly
        lastZ := A_TickCount
        DllCall("SetWindowPos", "Ptr", hLoupeGui, "Ptr", -1, "Int", lx, "Int", ly, "Int", 0, "Int", 0, "UInt", 0x11)
    }
}
ClearIconTip:
    MouseGetPos, , , , HoverCtrlHwnd, 2
