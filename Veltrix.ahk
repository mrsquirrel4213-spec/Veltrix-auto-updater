}

AqScrollHome() {
    global AquariumScrollSteps, AqBtnN
    attempt := 0, stable := 0, prevX := -99999
    while (attempt < 20) {
        attempt++
        if !AqWheel(AquariumScrollSteps, -1)
            return false
        AqScan()
        curX := AqLeftX()
        if (AqBtnN >= 1 && curX = prevX) {
            stable++
            if (stable >= 1)
                return true
        } else {
            stable := 0
        }
        prevX := curX
    }
    return true
}
AqMeasurePitch() {
    global AqBtnN, AqBtnCX, AqBtnW, AqCardPitch
    AqCardPitch := 0
    if (AqScan() < 1)
        return false
    if (AqBtnN >= 2) {
        widest := 0
        Loop % AqBtnN - 1 {
            step := AqBtnCX[A_Index + 1] - AqBtnCX[A_Index]
            if (step > widest)
                widest := step
        }
        AqCardPitch := widest
    }
    if (AqCardPitch < 20)
        AqCardPitch := Round(AqBtnW * 1.15)
    return AqCardPitch >= 20
}
NoiseIsCore(pv, cB, cG, cR, ctol) {
    vb := pv & 0xFF, vg := (pv >> 8) & 0xFF, vr := (pv >> 16) & 0xFF
    if (Abs(vb - cB) <= ctol && Abs(vg - cG) <= ctol && Abs(vr - cR) <= ctol)
        return true
    if (vg < 34 || vg > 104)
        return false
    if (vr > 52 || vb > 76)
        return false
    if (vg < vr + 10 || vg < vb + 4)
        return false
    lum := Floor((vr + vg + vb) / 3)
    if (lum < 14 || lum > 74)
        return false
    return true
}
