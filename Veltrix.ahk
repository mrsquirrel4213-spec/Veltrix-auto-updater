; the note's text for the skin picked
SkinWarnSet() {
	global SkinWarnH, SwPreset
	if (SkinWarnH and (SwPreset = "Toothly Interstellar" or SwPreset = "Kitty Keys"))
		GuiControl, 1:, %SkinWarnH%, % SwPreset . " may not work as well as the default skin."
}

; the Stellarwave skin in use is the one picked in the list (Default = Normal)
ColPresetShowSkin() {
	global SpecialRod, SwPreset, ColPresetDdl
	if (ColPresetDdl and SpecialRod = "Stellarwave Melody" and {"Toothly Interstellar": 1, "Ominous Ouija": 1, "Kitty Keys": 1}.HasKey(SwPreset))
		GuiControl, 1:ChooseString, ColPreset, %SwPreset%
}

; every colour box a preset holds
ColPresetFields() {
	return ["FishColor", "BarLeftColor", "BarRightColor", "ArrowColor", "NoteColor"
		, "TryhardBarColors", "TryhardFishColors", "TryhardTrackColors"
		, "CastboundBarColors", "CastboundFishColors", "CastboundTrackColors"
		, "StellarBarColors", "StellarFishColors", "StellarHeadColors"
		, "FishBarColorTolerance", "BarColorTolerance", "ArrowColorTolerance"]
}

ColPresetKey() {
	global SpecialRod
	k := RegExReplace((SpecialRod = "") ? "None" : SpecialRod, "[^A-Za-z0-9]", "")
	return (k = "") ? "None" : k
}

ColPresetRefresh:
if (ColPresetDdl)
	{
	GuiControl, 1:, ColPreset, % ColPresetList()
	GuiControl, 1:ChooseString, ColPreset, Default
	ColPresetShowSkin()
	}
return

ColPresetChosen:
GuiControlGet, ColPresetPick, 1:, ColPreset
if (SpecialRod = "Stellarwave Melody")
	{
	; a skin: its own colours and reading; Default or a saved one: the normal zodiac signs
	CpSkin := {"Toothly Interstellar": 1, "Ominous Ouija": 1, "Kitty Keys": 1}.HasKey(ColPresetPick) ? ColPresetPick : "Normal"
	SwPresetSwitched := false
	if (CpSkin != SwPreset)
		{
		SwPreset := CpSkin
		gosub, SwPresetChanged
		SkinWarnSet()
		gosub, ShowSection
		}
	if (CpSkin != "Normal" or (ColPresetPick = "Default" and SwPresetSwitched))
		return
	}
if (ColPresetPick = "Default" or ColPresetPick = "")
	{
	; the rod's own colours
	CpKeys := {}
	for i, k in ColPresetFields()
		CpKeys[k] := 1
	for i, f in ProfileFields
		{
		if (CpKeys.HasKey(f[2]))
			{
			CpK := f[2]
			%CpK% := f[3]
			}
		}
	if (SpecialRod = "Halibut Harpoon")
		gosub, ApplyHalibutPreset
	else if (SpecialRod = "Noiseform")
		gosub, ApplyNoiseformPreset
	else if (SpecialRod = "Remembrance")
		gosub, ApplyRemembrancePreset
	else if (SpecialRod = "MiguRod")
		gosub, ApplyMiguRodPreset
	else if (SpecialRod = "Verdant Oath")
		gosub, ApplyVerdantOathPreset
	else if (SpecialRod = "Doomsekkar")
		gosub, ApplyDoomsekkarPreset
	else if (SpecialRod = "Oppressor")
		gosub, ApplyOppressorPreset
	}
else
	{
	; one that comes with the macro, else one of yours
	CpBi := ColPresetBuiltin(ColPresetKey())
	if (CpBi.HasKey(ColPresetPick))
		CpAll := ColPresetPick . "~" . CpBi[ColPresetPick]
	else
		IniRead, CpAll, %SettingsFile%, ColorPresets, % ColPresetKey(), %A_Space%
	for i, p in StrSplit(Trim(CpAll), ";;")
		{
		CpP := StrSplit(p, "~")
		if (CpP[1] != ColPresetPick)
			continue
		for j, kv in StrSplit(CpP[2], "|")
			{
			CpE := InStr(kv, "=")
			if (!CpE)
				continue
			CpK := SubStr(kv, 1, CpE - 1)
			if CpK is alnum
				%CpK% := SubStr(kv, CpE + 1)
			}
		break
		}
	}
for i, k in ColPresetFields()
	GuiControl, 1:, %k%, % %k%
gosub, RefreshSwatches
gosub, QueueAutoSave
return

ColPresetSave:
GuiControlGet, CpName, 1:, ColPresetName
CpName := Trim(RegExReplace(CpName, "[~;|=\[\]]", ""))
if (CpName = "" or ColPresetReserved(CpName))
	return
Gui, Submit, NoHide
IniRead, CpAll, %SettingsFile%, ColorPresets, % ColPresetKey(), %A_Space%
CpOut := ""
for i, p in StrSplit(Trim(CpAll), ";;")
	{
	if (Trim(p) = "" or StrSplit(p, "~")[1] = CpName)
		continue
	CpOut .= ((CpOut = "") ? "" : ";;") . p
	}
CpVals := ""
for i, k in ColPresetFields()
	CpVals .= ((CpVals = "") ? "" : "|") . k . "=" . %k%
CpOut .= ((CpOut = "") ? "" : ";;") . CpName . "~" . CpVals
IniWrite, %CpOut%, %SettingsFile%, ColorPresets, % ColPresetKey()
GuiControl, 1:, ColPresetName,
GuiControl, 1:, ColPreset, % ColPresetList()
GuiControl, 1:ChooseString, ColPreset, %CpName%
return

ColPresetDelete:
GuiControlGet, CpName, 1:, ColPreset
if (CpName = "" or ColPresetReserved(CpName))
	return
IniRead, CpAll, %SettingsFile%, ColorPresets, % ColPresetKey(), %A_Space%
CpOut := ""
for i, p in StrSplit(Trim(CpAll), ";;")
	{
	if (Trim(p) = "" or StrSplit(p, "~")[1] = CpName)
		continue
	CpOut .= ((CpOut = "") ? "" : ";;") . p
	}
IniWrite, %CpOut%, %SettingsFile%, ColorPresets, % ColPresetKey()
gosub, ColPresetRefresh
return

ColorFieldChanged:
    ColFieldName := A_GuiControl
    if ColFieldName in PerfectGreenColor,PerfectWhiteColor,FishColor,NoteColor,BarLeftColor,BarRightColor,ArrowColor,TryhardBarColors,TryhardFishColors,TryhardTrackColors,CastboundBarColors,CastboundFishColors,CastboundTrackColors,StellarBarColors,StellarFishColors,StellarHeadColors
    {
        GuiControlGet, ColFieldVal, 1:, %ColFieldName%
        if (!ErrorLevel)
            %ColFieldName% := ColFieldVal
    }
    gosub RefreshSwatches
    gosub QueueAutoSave
return
QueueAutoSave:
if (GuiAutoSave)
	settimer, AutoSaveNow, -1200
return

AutoSaveNow:
if (!GuiAutoSave)
	return
gosub, SaveSettings
return

RefreshSwatches:
    SwFish := ColCount(FishColor) ? Format("{:06X}", ColMain(FishColor)) : "202020"
    SwNote := ColCount(NoteColor) ? Format("{:06X}", ColMain(NoteColor)) : "202020"
    SwLeft := ColCount(BarLeftColor) ? Format("{:06X}", ColMain(BarLeftColor)) : "202020"
    SwRight := ColCount(BarRightColor) ? Format("{:06X}", ColMain(BarRightColor)) : "202020"
