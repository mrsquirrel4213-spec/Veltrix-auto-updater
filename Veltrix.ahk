        }
        needBg := Round(0.20 * span), needPk := Round(0.98 * span)
        bg := 0, pk := 255, gotBg := false, run := 0
        Loop 64 {
            bin := A_Index - 1
            run += hist[bin]
            if (!gotBg && run >= needBg) {
                bg := bin * 4
                gotBg := true
            }
            if (run >= needPk) {
                pk := bin * 4
                break
            }
        }
        thr := bg + 0.40 * (pk - bg)
        if (thr < bg + 25)
            thr := bg + 25

        ; widest bright run, allowing short dark gaps
        bestLen := 0, bestS := -1, bestE := -1
        rs := -1, re := -1, gap := 0
        i := lo
        while (i < hi) {
            if (col[i] >= thr) {
                if (rs < 0)
                    rs := i
                re := i
                gap := 0
            } else if (rs >= 0) {
                gap++
                if (gap > gapmax) {
                    if (re - rs > bestLen)
                        bestLen := re - rs, bestS := rs, bestE := re
                    rs := -1, gap := 0
                }
            }
            i++
        }
        if (rs >= 0) {
            if (re - rs > bestLen)
                bestLen := re - rs, bestS := rs, bestE := re
        }

        barw := bestLen + 1
        bestIn := bestS >= 0 ? (pref[bestE + 1] - pref[bestS]) / barw : 0
        bestSc := bestIn - bg
        sizeOk := bestS >= 0 && barw >= minw && barw <= maxw
        if (sizeOk && bestSc >= 28)
            BelSeen := true
        if !(sizeOk && bestSc >= 120)
            continue

        BelA[sd] := 4 * bestS
        BelB[sd] := 4 * bestE
        BelOK[sd] := true

        ; fish marker: narrow darker dip framed by bright columns
        fhi := 0.62 * bestIn
        flo := bg + Max(20, 0.15 * (pk - bg))
        wcap := Max(2, Round(0.10 * halfc))
        s0 := Max(lo, bestS - 3)
        s1 := Min(hi - 1, bestE + 3)
        bestMean := 99999, fs := -1, fe := -1
        cs := -1, ce := -1
        i := s0
        while (i <= s1 + 1) {
            inside := (i <= s1 && col[i] >= flo && col[i] < fhi)
            if (inside) {
                if (cs < 0)
                    cs := i
                ce := i
            } else if (cs >= 0) {
                if (ce - cs <= wcap && cs > lo && ce < hi - 1 && col[cs - 1] >= fhi && col[ce + 1] >= fhi) {
                    total := 0
                    j := cs
                    while (j <= ce) {
                        total += col[j]
                        j++
                    }
                    mean := total / (ce - cs + 1)
                    if (mean < bestMean)
                        bestMean := mean, fs := cs, fe := ce
                }
                cs := -1
            }
            i++
        }
        if (fs >= 0)
            BelF[sd] := (fs + fe) * 4 // 2
    }

    if (BelOK[1] || BelOK[2])
        return 2
    return BelSeen ? 1 : 0
}
BellonaDrive(sd) {
    global BelOK, BelA, BelB, BelF, BelPrevF, BelPrevB, BelPrevT, BelVel, BelBVel
    global BelBias, BelAcc, BelSide, QpcFreq, WindowWidth, BelSlotT, BelRate, BelLastT, PredictOn
    global BelWallL, BelWallR, BelSetT, BelDown
    if !BelOK[sd]
        return
    bar := (BelA[sd] + BelB[sd]) / 2
    fish := BelF[sd]

    ; marker lost: keep pushing toward the side it was last seen on
    if (fish < 0) {
        if (BelSide[sd] = 0)
            return
        BelAcc[sd] := 0
        BellonaSet(sd, BelSide[sd] > 0)
        return
    }

    rs := WindowWidth / 2560
    if (rs <= 0)
        rs := 1
    BelSide[sd] := fish > bar ? 1 : -1

    DllCall("QueryPerformanceCounter", "Int64*", now)
    dt := BelLastT[sd] ? (now - BelLastT[sd]) / QpcFreq : 0
    BelLastT[sd] := now
    ; speeds over at least 25 ms: the positions come in 4 px steps, and over one scan (3 ms) a single step reads as
    ; 1300 px/s
    vt := BelPrevT[sd] ? (now - BelPrevT[sd]) / QpcFreq : 1
    if (vt >= 0.025) {
        if (vt < 0.5) {
            BelVel[sd] := 0.5 * BelVel[sd] + 0.5 * ((fish - BelPrevF[sd]) / vt)
            BelBVel[sd] := 0.5 * BelBVel[sd] + 0.5 * ((bar - BelPrevB[sd]) / vt)
        }
        BelPrevT[sd] := now
        BelPrevF[sd] := fish
        BelPrevB[sd] := bar
    }

    ; walls: held (or let go) for 150 ms and the bar stands still - it is against the right (left) wall
    if (BelSetT[sd] && (now - BelSetT[sd]) / QpcFreq >= 0.15 && Abs(BelBVel[sd]) < 40 * rs) {
        if (BelDown[sd])
            BelWallR[sd] := BelB[sd]
        else
            BelWallL[sd] := BelA[sd]
    }
    ; on a wall with the line between it and the bar's middle: the bar can't get closer, so keep it on the wall
    ; (pulsing here, it came off the wall and the line slipped out)
    wpad := 8 * rs
    if (BelWallL[sd] >= 0 && BelA[sd] <= BelWallL[sd] + wpad && fish < bar) {
        BelSlotT[sd] := 0
        BellonaSet(sd, false)
        return
    }
    if (BelWallR[sd] >= 0 && BelB[sd] >= BelWallR[sd] - wpad && fish > bar) {
        BelSlotT[sd] := 0
        BellonaSet(sd, true)
        return
    }

    ; prediction: aim where the line will be a moment from now (at most a quarter bar off)
    if (PredictOn) {
        pc := 0.25 * (BelB[sd] - BelA[sd])
        pl := BelVel[sd] * TA("predlead", 90) / 1000
        fish := fish + ((pl > pc) ? pc : (pl < -pc) ? -pc : pl)
    }
    err := bar - fish
    rel := BelBVel[sd] - BelVel[sd]
    if (Abs(err) <= 36 * rs && Abs(rel) <= 120 * rs) {
        kp := 0.0122 / rs
        kd := 0.00488 / rs
        ; the bias learns the hold share that keeps the bar still, so the line ends up in the middle, not beside it
        if (dt > 0 && dt < 0.1) {
            b := BelBias[sd] - 0.6 * kp * err * dt
            BelBias[sd] := b < -0.3 ? -0.3 : (b > 0.3 ? 0.3 : b)
        }
        duty := 0.463 + BelBias[sd] - kp * err - kd * rel
        duty := duty < 0 ? 0 : (duty > 1 ? 1 : duty)
        ; press slots: one press per slot, held for the duty's share of it
        BelRate[sd] := BellonaRate(err / rs, duty)
        gap := 1.0 / BelRate[sd]
        ph := BelSlotT[sd] ? (now - BelSlotT[sd]) / QpcFreq / gap : 1
        if (ph >= 1 || ph < 0) {
            BelSlotT[sd] := now
            ph := 0
        }
        ; a press shorter than 8 ms does not count in game: leave that slot empty
        want := (ph < duty) && (duty * gap >= 0.008)
    } else {
        BelSlotT[sd] := 0
        want := (err + 0.5 * rel) < 0
    }
    BellonaSet(sd, want)
}

; press slots per second for one bar: the Max presses per second setting; up to 20 while the line is off the middle
; (finer steering), down to 5 when the press has to be very short or very long (so it still counts). off = line - middle
; in 2560-wide pixels.
BellonaRate(off, duty) {
    global PressCap
    pref := (PressCap > 0) ? PressCap : 20
    lo := (pref < 5) ? pref : 5
    hi := (pref > 20) ? pref : 20
    f := Abs(off) / 24
    r := pref + (hi - pref) * ((f > 1) ? 1 : f)
    if (duty < 0.12 || duty > 0.88) {
        e := (duty < 0.12) ? (0.12 - duty) / 0.12 : (duty - 0.88) / 0.12
        r := r - (r - lo) * ((e > 1) ? 1 : e)
    }
    return (r < lo) ? lo : (r > hi) ? hi : r
}
BellonaSet(sd, want) {
    global BelDown, BelPressT, QpcFreq, PressCap, BelSetT
    btn := sd = 1 ? "LButton" : "RButton"
    if (want && (!BelDown[sd] || !GetKeyState(btn, "P"))) {
        ; each bar has its own press budget: the press slots set the pace, this only stops a burst (20 a second, or
        ; the setting when it is higher)
        DllCall("QueryPerformanceCounter", "Int64*", pn)
        cap := (PressCap > 20) ? PressCap : 20
        if (BelPressT[sd] && (pn - BelPressT[sd]) / QpcFreq < 1.0 / cap)
            return
        BelPressT[sd] := pn
        if (sd = 1)
            Send {LButton down}
        else
            Send {RButton down}
        BelDown[sd] := true
        BelSetT[sd] := pn
    } else if (!want && (BelDown[sd] || GetKeyState(btn, "P"))) {
        if (sd = 1)
            Send {LButton up}
        else
            Send {RButton up}
        BelDown[sd] := false
        DllCall("QueryPerformanceCounter", "Int64*", pn)
        BelSetT[sd] := pn
    }
}
BellonaRelease() {
    global BelDown, BelSetT
    Send {LButton up}
    Send {RButton up}
    BelDown := [false, false]
    BelSetT := [0, 0]
}
LineScan() {
    global LineScanned, LineFound, pCaptureBits, CaptureW, CaptureH, FishBarLeft
    global LineBarL, LineBarW, LineBarAge, SpecialRod, DarkHoldN, DarkFlashing, DarkAcc
    global LineFishSeen, LineFishX, LineNoteX, LineList
    if LineScanned
        return LineFound
    LineScanned := true

    ; Darkheart: hold the previous result through short dark flashes
    if (SpecialRod = "Darkheart") {
        if FrameIsDark() {
            DarkHoldN := DarkHoldN + 1
            if (DarkHoldN <= 45 && LineBarW >= 1) {
                if !DarkFlashing
                    DarkAcc := 0
                DarkFlashing := true
                return LineFound
            }
        } else {
            DarkHoldN := 0
            DarkFlashing := false
        }
    }

    LineFound := false, LineFishSeen := false
    LineFishX := -1, LineNoteX := -1
    LineList := []

    VarSetCapacity(hits, CaptureW * 4, 0)
    if (fn := LineHitsFn())
        rows := DllCall(fn, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Ptr", &hits, "Int")
    else
        rows := LineHitsAhk(pCaptureBits, CaptureW, CaptureH, &hits)
    need := Max(2, Round(0.5 * rows))

    ; group hot columns (gaps of up to 3) and record each group's centre
    gFirst := -1, gLast := -1
    x := 1
    while (x < CaptureW) {
        if (NumGet(hits, x * 4, "UInt") >= need) {
            if (gFirst >= 0 && x - gLast <= 3) {
                gLast := x
            } else {
                if (gFirst >= 0)
                    LineList.Push((gFirst + gLast) // 2)
                gFirst := x, gLast := x
            }
        }
        x++
    }
    if (gFirst >= 0)
        LineList.Push((gFirst + gLast) // 2)
    n := LineList.Length()

    ; fish = the tightest pair of edges 4..20 apart
    bestGap := 999, fi := -1
    i := 1
    while (i < n) {
        g := LineList[i + 1] - LineList[i]
        if (g >= 4 && g <= 20 && g < bestGap)
            bestGap := g, fi := i
        i++
    }

    pinCol := false
    if (SpecialRod = "Pinions Aria" && PinMarkerX(fcx)) {
        pinCol := true
        ci := 1
        while (ci < n) {
            cg := LineList[ci + 1] - LineList[ci]
            mid := (LineList[ci] + LineList[ci + 1]) / 2
            if (cg >= 3 && cg <= 20 && Abs(mid - fcx) <= 8) {
                fcx := mid
                break
            }
            ci++
        }
    } else if (fi < 0) {
        LineBarAge := LineBarAge + 1
        return false
    } else
        fcx := (LineList[fi] + LineList[fi + 1]) / 2

    LineFishX := FishBarLeft + fcx
    LineFishSeen := true

    others := []
    for idx, L in LineList {
        if (pinCol) {
            if (Abs(L - fcx) > 8 && L >= 3 && L <= CaptureW - 4)
                others.Push(L)
        } else if (idx != fi && idx != fi + 1)
            others.Push(L)
    }
    on := others.Length()

    if (on >= 2) {
        expW := LineBarW >= 40 ? LineBarW : 0
        lo := -1, hi := -1

        if (pinCol) {
            oLft := others[1], oRgt := others[on]
            if (oRgt - oLft >= 40 && oRgt - oLft <= 0.75 * CaptureW) {
                lo := oLft, hi := oRgt
                if (expW > 0 && Abs((oRgt - oLft + 1) - expW) > 0.25 * expW) {
                    found := false
                    pi := 1
                    while (pi < on && !found) {
                        pj := pi + 1
                        while (pj <= on) {
                            if (Abs((others[pj] - others[pi] + 1) - expW) <= 6) {
                                lo := others[pi], hi := others[pj]
                                found := true
                                break
                            }
                            pj++
                        }
                        pi++
                    }
                }
            }
        }

        vgSkip := false
        if (SpecialRod = "Verdant Oath") {
            vgSkip := true
            vgo1 := Round(0.005 * CaptureW)
            vgo2 := Round(0.018 * CaptureW)
            vgR := [], vgL := []
            for idx, L in LineList {
                vgR[idx] := LineGreenAt(L + vgo1, L + vgo2)
                vgL[idx] := LineGreenAt(L - vgo1, L - vgo2)
            }
            ; widest pair: green on the right of the left edge, green on the left of the right edge
            i := 1
            while (i < n) {
                if (vgR[i] && i != fi && i != fi + 1) {
                    j := i + 1
                    while (j <= n) {
                        sep := LineList[j] - LineList[i]
                        if (vgL[j] && j != fi && j != fi + 1 && sep >= 40 && (lo < 0 || sep > hi - lo))
                            lo := LineList[i], hi := LineList[j]
                        j++
                    }
                }
                i++
            }
            ; single edge with brown outside it: extend by the expected width
            if (lo < 0 && expW > 0) {
                i := 1
                while (i <= n) {
                    if (i != fi && i != fi + 1) {
                        vge := LineList[i]
                        if (vgR[i] && LineBrownAt(vge - vgo1)) {
                            lo := vge
                            hi := Min(vge + expW - 1, CaptureW - 1)
                            break
                        }
                        if (vgL[i] && LineBrownAt(vge + vgo1)) {
                            hi := vge
                            lo := Max(0, vge - expW + 1)
                            break
                        }
                    }
                    i++
                }
            }
        }

        ; generic: pair of edges whose separation best fits the expected width
        bestScore := 999999
        oi := vgSkip ? on : 1
        while (lo < 0 && oi < on) {
            oj := oi + 1
            while (oj <= on) {
                sep := others[oj] - others[oi]
                if (sep >= 40) {
                    score := expW > 0 ? Abs(sep - expW) : Abs(sep - 200)
                    if (score < bestScore)
                        bestScore := score, lo := others[oi], hi := others[oj]
                }
                oj++
            }
            oi++
        }

        if (lo >= 0) {
            LineBarL := FishBarLeft + lo
            LineBarW := hi - lo + 1
            LineBarAge := 0
        } else
            LineBarAge := LineBarAge + 1
    } else if (on = 1) {
        e := others[1]
        lsSide := ""
        ext := LineBarW >= 40 ? LineBarW : 200
        if (LineBarW >= 40) {
            lsHL := e - LineBarW + 1
            lsHR := e + LineBarW - 1
            lsOkL := lsHL >= -12
            lsOkR := lsHR <= CaptureW + 11
            if (lsOkL && lsOkR) {
                if (LineBarAge <= 3) {
                    prevL := LineBarL - FishBarLeft
                    lsSide := Abs(lsHL - prevL) <= Abs(e - prevL) ? "L" : "R"
                } else if (Abs(lsHL - fcx) <= 14 || lsHL <= 2)
                    lsSide := "L"
                else if (Abs(lsHR - fcx) <= 14 || lsHR >= CaptureW - 3)
                    lsSide := "R"
            } else if (lsOkL)
                lsSide := "L"
            else if (lsOkR)
                lsSide := "R"
        }
        if (lsSide = "") {
            spL := ColSpread(e - 120, e - 6, fcx)
            spR := ColSpread(e + 6, e + 120, fcx)
            if (spL > spR && spL > 0)
                lsSide := "L"
            else if (spR > 0)
                lsSide := "R"
        }
        if (lsSide = "L") {
            bl := Max(0, e - ext + 1)
            LineBarL := FishBarLeft + bl
            LineBarW := e - bl + 1
            LineBarAge := 0
        } else if (lsSide = "R") {
            br := Min(CaptureW - 1, e + ext - 1)
            LineBarL := FishBarLeft + e
            LineBarW := br - e + 1
            LineBarAge := 0
        } else
            LineBarAge := LineBarAge + 1
    } else
        LineBarAge := LineBarAge + 1

    if (LineBarW < 1 || LineBarAge > 12)
        return false
    LineFound := true
    return true
}
LineColAvg(x, ByRef cr, ByRef cg, ByRef cb) {
    global pCaptureBits, CaptureW, CaptureH
    cr := 0, cg := 0, cb := 0
    if (x < 0 || x >= CaptureW)
        return false
    sr := 0, sg := 0, sb := 0, n := 0
    y := 0
    while (y < CaptureH) {
        v := NumGet(pCaptureBits + 0, (y * CaptureW + x) * 4, "UInt")
        sb += v & 0xFF
        sg += (v >> 8) & 0xFF
        sr += (v >> 16) & 0xFF
        n++
        y += 12
    }
    if (n = 0)
        return false
    cr := sr / n, cg := sg / n, cb := sb / n
    return true
}
LineGreenAt(x1, x2) {
    if (LineColAvg(x1, r, g, b) && g - Max(r, b) > 30)
        return true
    if (LineColAvg(x2, r, g, b) && g - Max(r, b) > 30)
        return true
    return false
}
LineBrownAt(x) {
	return (LineColAvg(x, cr, cg, cb) and cr > cg + 10 and cr > cb + 20)
}

VerdantBarScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, VgPrm, VgPrmReady, VgBarL, VgBarW
    if (!pCaptureBits || CaptureW < 40 || CaptureH < 6)
        return false
    if !VgPrmReady {
        PcSetPrm(VgPrm, 0x3B8113, 0, 1, 0)
        VgPrmReady := true
    }
    lefts := [], rights := []
    for _, yr in [Floor(0.30 * CaptureH), Floor(0.50 * CaptureH), Floor(0.70 * CaptureH)] {
        rowPtr := pCaptureBits + yr * CaptureW * 4
        vgA := PcFind(rowPtr, CaptureW, 4, VgPrm)
        if (vgA < 0)
            continue
        back := PcFind(rowPtr + (CaptureW - 1) * 4, CaptureW, -4, VgPrm)
        if (back < 0)
            continue
        vgB := CaptureW - 1 - back
        wid := vgB - vgA + 1
        if (wid >= 0.04 * CaptureW && wid <= 0.85 * CaptureW) {
            lefts.Push(vgA)
            rights.Push(vgB)
        }
    }
    if (lefts.Length() < 2)
        return false
    if (lefts.Length() = 3) {
        left := MedianOf(lefts)
        right := MedianOf(rights)
    } else {
        left := Max(lefts[1], lefts[2])
        right := Min(rights[1], rights[2])
    }
    if (right - left + 1 < 0.04 * CaptureW)
        return false
    vgO := Round(0.005 * CaptureW) + 1
    if !(LineBrownAt(left - vgO) || LineBrownAt(right + vgO))
        return false
    VgBarL := FishBarLeft + left
    VgBarW := right - left + 1
    return true
}
VerdantFishX() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, FishColor, FishBarColorTolerance
    global LastFishX, VgPrmF, VgPrmFI
    if (!pCaptureBits || CaptureW < 40 || CaptureH < 6)
        return -1
    cols := ColorListParse(FishColor)
    if (cols.n < 1)
        return -1
    vfMaxW := Round(0.04 * CaptureW)
    for _, yr in [Floor(0.50 * CaptureH), Floor(0.30 * CaptureH), Floor(0.70 * CaptureH)] {
        rowPtr := pCaptureBits + yr * CaptureW * 4
        vfBest := -1, vfBestD := 999999
        Loop, % cols.n {
            hex := Format("0x{:02X}{:02X}{:02X}", cols.r[A_Index], cols.g[A_Index], cols.b[A_Index])
            PcSetPrm(VgPrmF, hex, FishBarColorTolerance, 1, 0)
            PcSetPrm(VgPrmFI, hex, FishBarColorTolerance, 1, 1)
            runs := 0, x := 0
            while (x < CaptureW && runs < 24) {
                s := PcFind(rowPtr + x * 4, CaptureW - x, 4, VgPrmF)
                if (s < 0)
                    break
                s += x
                t := PcFind(rowPtr + (s + 1) * 4, CaptureW - s - 1, 4, VgPrmFI)
                e := t < 0 ? CaptureW - 1 : s + t
                runs++
                wid := e - s + 1
                if (wid >= 3 && wid <= vfMaxW) {
                    mid := (s + e) / 2
                    d := LastFishX >= 0 ? Abs(FishBarLeft + mid - LastFishX) : 0
                    if (d < vfBestD)
                        vfBestD := d, vfBest := mid
                }
                x := e + 1
            }
        }
        if (vfBest >= 0) {
            LastFishX := FishBarLeft + vfBest
            return LastFishX
        }
    }
    return -1
}
PinMarkerX(ByRef cx) {
    global pCaptureBits, CaptureW, CaptureH, CapExtra, WindowHeight
    global PnPrmM, PnPrmMI, PnPrmC, PnPrmCI, PnPrmReady
    cx := -1
    if (!pCaptureBits || CaptureW < 40)
        return false
    if !PnPrmReady {
        PcSetPrm(PnPrmM, 0xC580FC, 36, 1, 0)
        PcSetPrm(PnPrmMI, 0xC580FC, 36, 1, 1)
        PcSetPrm(PnPrmC, 0x5AF7F9, 45, 1, 0)
        PcSetPrm(PnPrmCI, 0x5AF7F9, 45, 1, 1)
        PnPrmReady := true
    }
    rowList := []
    for _, f in [0.030, 0.034, 0.026, 0.038, 0.042]
        rowList.Push(Round(WindowHeight * f))
    for _, f in [0.009, 0.006, 0.012]
        rowList.Push(-Round(WindowHeight * f))
    for i, rr in rowList {
        if (rr >= CaptureH + 20 + CapExtra || rr < -17)
            continue
        rowPtr := pCaptureBits + rr * CaptureW * 4
        if (i <= 5) {
            i0 := PcFind(rowPtr, CaptureW, 4, PnPrmM)
            if (i0 < 0)
                continue
            i1 := PcFind(rowPtr + (i0 + 1) * 4, CaptureW - i0 - 1, 4, PnPrmMI)
        } else {
            i0 := PcFind(rowPtr, CaptureW, 4, PnPrmC)
            if (i0 < 0)
                continue
            i1 := PcFind(rowPtr + (i0 + 1) * 4, CaptureW - i0 - 1, 4, PnPrmCI)
        }
        w := i1 < 0 ? CaptureW - i0 : i1 + 1
        if (w < 2 || w > 30)
            continue
        cx := i0 + w / 2
        return true
    }
    return false
}
LineHitsAhk(pBits, w, h, pHits) {
    rowBytes := 4 * w
    rows := 0
    y := 0
    while (y < h) {
        base := pBits + y * rowBytes
        v := NumGet(base + 0, 0, "UInt")
        prev := (v & 0xFF) + ((v >> 8) & 0xFF) + ((v >> 16) & 0xFF)
        x := 1
        while (x < w) {
            v := NumGet(base + 0, x * 4, "UInt")
            cur := (v & 0xFF) + ((v >> 8) & 0xFF) + ((v >> 16) & 0xFF)
            if (Abs(cur - prev) > 54)
                NumPut(NumGet(pHits + 0, x * 4, "UInt") + 1, pHits + 0, x * 4, "UInt")
            prev := cur
            x++
        }
        rows++
        y += 3
    }
    return rows
}
LineHitsFn() {
    static pFn := ""
    ; x64 leaf routine: int f(uint* bits, int w, int h, uint* hits) - same algorithm as LineHitsAhk
    static code := "89D2535657415431C04531D24539C20F8D6F0000008B39400FB6F7C1EF08440FB6E74401E6C1EF08440FB6E74401E689F341BB010000004139D37D35428B3C99400FB6F7C1EF08440FB6E74401E6C1EF08440FB6E74401E689F729DF83FF367F0583FFCA7D0443FF049989F341FFC3EBC6FFC04183C203488D3C52488D0CB9E988FFFFFF415C5F5E5BC3"
    if (pFn != "")
        return pFn
    pFn := 0
    if (A_PtrSize != 8)
        return 0
    n := StrLen(code) // 2
    mem := DllCall("VirtualAlloc", "Ptr", 0, "Ptr", n, "UInt", 0x3000, "UInt", 0x04, "Ptr")
    if !mem
        return 0
    Loop % n
        NumPut("0x" SubStr(code, 2 * A_Index - 1, 2), mem + 0, A_Index - 1, "UChar")
    if !DllCall("VirtualProtect", "Ptr", mem, "Ptr", n, "UInt", 0x20, "UInt*", oldProt) {
        DllCall("VirtualFree", "Ptr", mem, "Ptr", 0, "UInt", 0x8000)
        return 0
    }

    ; check the native code against the script version on a pseudo-random image
    tw := 157, th := 23
    VarSetCapacity(img, tw * th * 4, 0)
    seed := 12345
    Loop % tw * th {
        seed := Mod(seed * 1103515245 + 12345, 2147483648)
        v := (seed >> 8) & 0xFFFFFFFF
        if (Mod(A_Index, 7) < 3)
            v := v & 0x3F3F3F3F
        NumPut(v, img, (A_Index - 1) * 4, "UInt")
    }
    VarSetCapacity(hA, tw * 4, 0)
    VarSetCapacity(hB, tw * 4, 0)
    rA := LineHitsAhk(&img, tw, th, &hA)
    rB := DllCall(mem, "Ptr", &img, "Int", tw, "Int", th, "Ptr", &hB, "Int")
    same := (rA = rB), anyHit := false
    Loop % tw {
        a := NumGet(hA, (A_Index - 1) * 4, "UInt")
        if (a != NumGet(hB, (A_Index - 1) * 4, "UInt"))
            same := false
        if (a != 0)
            anyHit := true
    }
    if (!same || !anyHit) {
        DllCall("VirtualFree", "Ptr", mem, "Ptr", 0, "UInt", 0x8000)
        return 0
    }
    pFn := mem
    return pFn
}
PinionScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, BarScanRow, FishColor, FishBarColorTolerance
    global NoteColor, NoteColorTolerance, VxNatPS, NatOff, PinFishX, PinNoteX, PinFound
    PinFishX := -1, PinNoteX := -1, PinFound := false
    row := BarScanRow
    if (row < 0 || row >= CaptureH)
        row := CaptureH // 2
    rowOff := row * CaptureW * 4

    fb := ToBGR(ColMain(FishColor))
    fB := (fb >> 16) & 0xFF, fG := (fb >> 8) & 0xFF, fR := fb & 0xFF
    ftol := Max(FishBarColorTolerance, 4)
    nb := ToBGR(NoteColor)
    nB := (nb >> 16) & 0xFF, nG := (nb >> 8) & 0xFF, nR := nb & 0xFF
    ntol := Max(NoteColorTolerance, 4)

    wholeTol := false
    if ftol is integer
        if ntol is integer
            wholeTol := true
    if (VxNatPS && !NatOff && wholeTol) {
        VarSetCapacity(res, 8, 0)
        DllCall(VxNatPS, "Ptr", pCaptureBits, "Int", CaptureW, "Int", row
            , "Int", fR, "Int", fG, "Int", fB, "Int", ftol
            , "Int", nR, "Int", nG, "Int", nB, "Int", ntol, "Ptr", &res)
        fx := NumGet(res, 0, "Int"), nx := NumGet(res, 4, "Int")
        if (fx >= 0)
            PinFishX := FishBarLeft + fx / 2
        if (nx >= 0)
            PinNoteX := FishBarLeft + nx / 2
        PinFound := PinFishX >= 0
        return PinFound
    }

    bestW := 0
    fRunS := -1, fRunE := -1, nRunS := -1, nRunE := -1
    x := 0
    while (x <= CaptureW) {
        isF := false, isN := false
        if (x < CaptureW) {
            v := NumGet(pCaptureBits + 0, rowOff + x * 4, "UInt")
            b := v & 0xFF, g := (v >> 8) & 0xFF, r := (v >> 16) & 0xFF
            isF := Abs(r - fR) <= ftol && Abs(g - fG) <= ftol && Abs(b - fB) <= ftol
            isN := Abs(r - nR) <= ntol && Abs(g - nG) <= ntol && Abs(b - nB) <= ntol
        }
        if (isF) {
            if (fRunS < 0)
                fRunS := x
            fRunE := x
        } else if (fRunS >= 0) {
            w := fRunE - fRunS + 1
            if (w >= 3 && w <= 25 && w > bestW) {
                bestW := w
                PinFishX := FishBarLeft + (fRunS + fRunE) / 2
            }
            fRunS := -1
        }
        if (isN) {
            if (nRunS < 0)
                nRunS := x
            nRunE := x
        } else if (nRunS >= 0) {
            w := nRunE - nRunS + 1
            if (w >= 2 && w <= 10 && PinNoteX < 0)
                PinNoteX := FishBarLeft + (nRunS + nRunE) / 2
            nRunS := -1
        }
        x++
    }
    PinFound := PinFishX >= 0
    return PinFound
}
TotemMaybeRun:
if (!TotemAuto or !MacroRunning)
	return
if (!TotemPreDone)
	{
	if (TotemLastCheck and (A_TickCount - TotemLastCheck) < (TotemPollSec * 1000))
		return
	; not read during the last bobber wait (it was too short) - one read here
	VxTip(7, "Current Task: Checking Totems")
	gosub, TotemAssess
	}
TotemPreDone := false
; nothing to pop: no time is spent here at all
if (TotemPending = "")
	return
TotemPending := ""
VxTip(7, "Current Task: Checking Totems")
VxTip(8, "")
if (WhLastCatchTick)
	{
	TotemSinceCatch := A_TickCount - WhLastCatchTick
	if (TotemSinceCatch >= 0 and TotemSinceCatch < TA("totemcatch", 0))
		Sleep, % Tm(TA("totemcatch", 0) - TotemSinceCatch)
	}
; a totem is due: the careful check (two matching reads) runs before anything is popped
TotemSkipNo := true
gosub, TotemRunCycle
TotemSkipNo := false
return

; one read of the totem icons and the decision, nothing popped: TotemPending = the totem that is due ("" = none)
TotemAssess:
TotemPending := ""
TotemAssessOnly := true
TotemAssessOk := false
TotemAsT0 := A_TickCount
gosub, TotemRunCycle
TotemAssessOnly := false
TotemLastCheck := A_TickCount
; a failed read is left to the restart (it tries again the normal way)
TotemPreDone := TotemAssessOk
return

;====================================================================================================;

TotemRunCycle:
TotemDidPop := false
TotemPass := 0
TotemCyclePopped := ","
if !TotemSkipNo
    TotemCheckNo += 1
; no return: continues into TotemLoop
TotemLoop:
TotemPass += 1
if (TotemPass > 6 || !MacroRunning)
    goto TotemDone
if !TotemStripInit()
    goto TotemDone

; read until two consecutive non-empty reads agree (max 8 reads)
TotemPrevSig := "", TotemSettleN := 0, TotemSettled := false
Loop 8 {
    if !MacroRunning
        goto TotemDone
    TotemSig := ""
    TotemRdT := A_TickCount
    if (TotemCaptureStrip() && TotemReadState())
        TotemSig := TotemTime "|" TotemWeather "|" TotemEvents
    TotemRdT := A_TickCount - TotemRdT
    if (TotemReadMs = "")
        TotemReadMs := TotemRdT
    else
        TotemReadMs := Round(0.7 * TotemReadMs + 0.3 * TotemRdT)
    if TotemAssessOnly {
        if (TotemSig = "")
            goto TotemDone
        TotemAssessOk := true, TotemSettled := true
        break
    }
    if (TotemSig != "" && TotemSig = TotemPrevSig) {
        TotemSettled := true
        break
    }
    TotemPrevSig := TotemSig
    TotemSettleN += 1
    Sleep % Tm(TA("totemsettle", 250))
}
if !TotemSettled
    goto TotemDone

TotemSlotN := TotemSlotCount()
TotemTaken := {}
; event totems identified by name claim their slots first
for TotemLpI, TotemLpNm in [TotemSel1, TotemSel2, TotemSel3] {
    if !TotemIsEventName(TotemLpNm)
        continue
    TotemLpK := TotemSlotOfName(TotemLpNm)
    if (TotemLpK > 0) {
        TotemAssumeSet(TotemLpNm, TotemLpK)
        TotemAssumeSrc[TotemLpNm] := "name"
        TotemTaken[TotemLpK] := TotemLpNm
    }
}
TotemBindNear()

; confirm (or give up on) the previous pop
if (TotemLastPop != "") {
    if (TotemLastPop = "Sundial")
        TotemLpSeen := (TotemTime = TotemWantTime)
    else
        TotemLpSeen := TotemHas(TotemLastPop)
    if (!TotemLpSeen && TotemIsEventName(TotemLastPop)) {
        TotemLpK := TotemNewUnknownSlot(TotemLastPopSigs)
        if (TotemLpK > 0) {
            TotemAssumeSet(TotemLastPop, TotemLpK)
            TotemAssumeSrc[TotemLastPop] := "pop"
            TotemAssumeAt[TotemLastPop] := A_TickCount
            TotemTaken[TotemLpK] := TotemLastPop
            TotemBound[TotemLastPop] := 1
            TotemCool.Delete(TotemLastPop)
            TotemLpSeen := true
        }
    }
    if (!TotemLpSeen && !TotemOnCooldown(TotemLastPop))
        TotemCool[TotemLastPop] := A_TickCount + (TotemLastPop = "Sundial" ? 90000 : 180000)
    if (TotemLpSeen || !TotemIsEventName(TotemLastPop) || A_TickCount > TotemLastPopUntil)
        TotemLastPop := ""
}
TotemBindRest()
for TotemLpNm in TotemCool.Clone() {
    if (TotemLpNm != "Sundial" && TotemHas(TotemLpNm))
        TotemCool.Delete(TotemLpNm)
}
if (TotemLastPop != "")
    goto TotemDone

; pick the first selected totem that can be used now
TotemNext := "", TotemNextKey := "", TotemFor := ""
for TotemLpI, TotemLpSel in [TotemSel1, TotemSel2, TotemSel3] {
    if (TotemLpSel = "" || TotemLpSel = "None")
        continue
    if (TotemLpSel = "Day" || TotemLpSel = "Night")
        TotemLpKey := TotemKeySundial
    else
        TotemLpKey := TotemKey%TotemLpSel%
    if (TotemLpKey = "")
        continue
    if TotemHas(TotemLpSel)
        continue
    if TotemGroupBusy(TotemLpSel)
        continue
    if TotemOnCooldown(TotemLpSel)
        continue
    if TotemWeatherConflict(TotemLpSel)
        continue
    if (TotemIsWeatherState(TotemLpSel) && TotemWeather = "Unknown")
        continue
    TotemLpNeed := TotemNeedsTime(TotemLpSel)
    if (TotemLpNeed != "" && TotemTime = "")
        continue
    if (TotemLpNeed != "" && TotemTime != TotemLpNeed) {
        ; wrong time of day: use the Sundial first
        if TotemConflict(TotemLpSel)
            continue
        if (TotemKeySundial = "" || TotemOnCooldown("Sundial"))
            continue
        TotemNext := "Sundial", TotemFor := TotemLpSel
        TotemNextKey := TotemKeySundial, TotemWantTime := TotemLpNeed
        break
    }
    if (TotemLpSel = "Day" || TotemLpSel = "Night")
        continue
    TotemNext := TotemLpSel, TotemFor := TotemLpSel, TotemNextKey := TotemLpKey
    break
}
if (TotemNext = "")
    goto TotemDone
if InStr(TotemCyclePopped, "," TotemNext ",")
    goto TotemDone
if TotemAssessOnly {
    TotemPending := TotemNext
    goto TotemDone
}

VxTip(7, "Current Task: Totem - " TotemNext)
Send {%TotemNextKey%}
Sleep % Tm(TA("totemkey", 300))
Click
TotemDidPop := true
TotemCyclePopped := TotemCyclePopped TotemNext ","
TotemLastPop := TotemNext
TotemLastPopSigs := TotemEvtSigs
TotemLastPopUntil := A_TickCount + 60000

if (TotemNext = "Sundial") {
    TotemWaited := 0
    while (MacroRunning && TotemWaited < TA("totemmax", 40000)) {
        Sleep % Tm(1000)
        TotemWaited += 1000
        TotemWaitS := TotemWaited // 1000
        VxTip(7, "Current Task: Totem - waiting for " TotemWantTime " (" TotemWaitS "s)")
        if !TotemCaptureStrip()
            continue
        TotemReadState()
        if (TotemTime = TotemWantTime)
            break
    }
} else
    Sleep % Tm(TotemActDelay)
if !MacroRunning
    goto TotemDone
goto TotemLoop
TotemDone:
if (TotemDidPop and RodSlotKey != "")
	{
	send {%RodSlotKey%}
	Sleep, % Tm(TA("totemdone", 400))
	}
return

;====================================================================================================;

TotemHasByName(nm) {
    global TotemWeather, TotemEvents, TotemTime
    if (nm = "Day" || nm = "Night")
        return TotemTime = nm
    if (nm = "Clearcast")
        return TotemWeather = "Clear"
    if (nm = "Tempest")
        return TotemWeather = "Rain"
    if (nm = "Windset")
        return TotemWeather = "Windy"
    if (nm = "Smokescreen")
        return TotemWeather = "Foggy"
    if (nm = "Shiny" || nm = "Sparkling")
        return InStr(TotemEvents, "Shiny,") || InStr(TotemEvents, "Sparkling,")
    return InStr(TotemEvents, nm ",") ? true : false
}
TotemHas(nm) {
    global TotemAssume
    if TotemHasByName(nm)
        return true
    glitter := (nm = "Shiny" || nm = "Sparkling")
    for aNm in TotemAssume {
        if (aNm = nm || (glitter && (aNm = "Shiny" || aNm = "Sparkling")))
            return true
    }
    return false
}
TotemIsEventName(nm) {
	return (nm = "Aurora" or nm = "Starfall" or nm = "Eclipse" or nm = "Shiny" or nm = "Sparkling" or nm = "Mutation")
}

TotemGroupOf(nm) {
	if (nm = "Shiny" or nm = "Sparkling" or nm = "Mutation")
		return "Shiny,Sparkling,Mutation"
	return ""
}

TotemGroupBusy(nm) {
    grp := TotemGroupOf(nm)
    if (grp = "")
        return false
    glitter := (nm = "Shiny" || nm = "Sparkling")
    Loop, Parse, grp, `,
    {
        other := A_LoopField
        if (other = nm)
            continue
        if (glitter && (other = "Shiny" || other = "Sparkling"))
            continue
        if TotemHas(other)
            return true
    }
    return false
}
TotemOnCooldown(nm) {
	global TotemCool
	return (TotemCool.HasKey(nm) and A_TickCount < TotemCool[nm]) ? true : false
}

TotemSigDist(a, b) {
    pa := StrSplit(a, "/"), pb := StrSplit(b, "/")
    if (pa.Length() < 4 || pb.Length() < 4)
        return 999999
    ga := pa[4], gb := pb[4]
    d := 0
    Loop 144 {
        at := (A_Index - 1) * 3 + 1
        d += Abs(SubStr(ga, at, 3) - SubStr(gb, at, 3))
    }
    d += 8 * Abs(pa[3] - pb[3])
    sa := pa[2], sb := pb[2]
    if (pa[1] >= 0 && pb[1] >= 0 && sa >= 20 && sb >= 20) {
        hd := Abs(pa[1] - pb[1])
        if (hd > 180)
            hd := 360 - hd
        d += 20 * hd + 15 * Abs(sa - sb)
    } else if (sa < 20 && sb < 20)
        d += 15 * Abs(sa - sb)
    else
        d += 2000
    return d
}
TotemSlotCount() {
	global TotemEvents
	if (TotemEvents = "")
		return 0
	trimmed := RTrim(TotemEvents, ",")
	pieces := StrSplit(trimmed, ",")
	return pieces.Length()
}

TotemSlotName(k) {
    global TotemEvents
    if (TotemEvents = "" || k < 1)
        return ""
    parts := StrSplit(RTrim(TotemEvents, ","), ",")
    return k <= parts.Length() ? parts[k] : ""
}
TotemSlotSig(k) {
    global TotemEvtSigs
    if (TotemEvtSigs = "" || k < 1)
        return ""
    parts := StrSplit(RTrim(TotemEvtSigs, ","), ",")
    return k <= parts.Length() ? parts[k] : ""
}
TotemSlotOfName(nm) {
    global TotemEvents
    if (TotemEvents = "")
        return 0
    glitter := (nm = "Shiny" || nm = "Sparkling")
    for i, entry in StrSplit(RTrim(TotemEvents, ","), ",") {
        if (entry = nm || (glitter && (entry = "Shiny" || entry = "Sparkling")))
            return i
    }
    return 0
}
TotemSortByD(arr) {
    i := 2
    while (i <= arr.MaxIndex()) {
        item := arr[i]
        j := i - 1
        while (j >= 1 && arr[j].d > item.d) {
            arr[j + 1] := arr[j]
            j--
        }
        arr[j + 1] := item
        i++
    }
    return arr
}
TotemBindNear() {
    global TotemAssume, TotemAssumeMiss, TotemTaken, TotemSlotN, TotemBound
    TotemBound := {}
    cand := []
    for nm, sig in TotemAssume {
        if TotemHasByName(nm)
            continue
        Loop % TotemSlotN {
            k := A_Index
            if (TotemTaken.HasKey(k) || TotemSlotName(k) != "?")
                continue
            d := TotemSigDist(TotemSlotSig(k), sig)
            if (d <= 1900)
                cand.Push({d: d, nm: nm, k: k})
        }
    }
    TotemSortByD(cand)
    ; closest matches win, each name and slot used once
    for _, c in cand {
        if (TotemBound.HasKey(c.nm) || TotemTaken.HasKey(c.k))
            continue
        TotemAssumeSet(c.nm, c.k)
        TotemTaken[c.k] := c.nm
        TotemBound[c.nm] := 1
    }
    for nm in TotemAssume {
        if TotemHasByName(nm) {
            TotemAssumeMiss[nm] := 0
            TotemBound[nm] := 1
        }
    }
}
TotemBindRest() {
    global TotemAssume, TotemAssumeMiss, TotemAssumeSlot, TotemAssumeCnt, TotemAssumeSrc, TotemAssumeAt
    global TotemTaken, TotemSlotN, TotemCheckNo, TotemCool, TotemBound
    for nm, sig in TotemAssume.Clone() {
        if TotemBound.HasKey(nm)
            continue
        k := TotemAssumeSlot[nm]
        if (k && !TotemTaken.HasKey(k) && TotemSlotN = TotemAssumeCnt[nm]
            && TotemSlotName(k) = "?" && TotemSigDist(TotemSlotSig(k), sig) <= 2800) {
            TotemAssumeSet(nm, k)
            TotemTaken[k] := nm
            continue
        }
        if !TotemAssumeMiss[nm] {
            TotemAssumeMiss[nm] := TotemCheckNo
        } else if (TotemCheckNo > TotemAssumeMiss[nm]) {
            if (TotemAssumeSrc[nm] = "pop" && A_TickCount - TotemAssumeAt[nm] < 120000)
                TotemCool[nm] := A_TickCount + 180000
            TotemAssume.Delete(nm)
            TotemAssumeMiss.Delete(nm)
            TotemAssumeSlot.Delete(nm)
            TotemAssumeCnt.Delete(nm)
            TotemAssumeSrc.Delete(nm)
            TotemAssumeAt.Delete(nm)
        }
    }
}
TotemNewUnknownSlot(oldSigs) {
    global TotemTaken, TotemSlotN
    os := oldSigs = "" ? [] : StrSplit(RTrim(oldSigs, ","), ",")
    pairs := []
    for j, o in os {
        Loop % TotemSlotN {
            d := TotemSigDist(TotemSlotSig(A_Index), o)
            if (d <= 1900)
                pairs.Push({d: d, j: j, k: A_Index})
        }
    }
    TotemSortByD(pairs)
    usedJ := {}, usedK := {}
    for _, p in pairs {
        if (usedJ.HasKey(p.j) || usedK.HasKey(p.k))
            continue
        usedJ[p.j] := 1
        usedK[p.k] := 1
    }
    Loop % TotemSlotN {
        k := A_Index
        if (TotemSlotName(k) != "?" || usedK.HasKey(k) || TotemTaken.HasKey(k))
            continue
        if (k <= os.Length() && !usedJ.HasKey(k) && TotemSigDist(TotemSlotSig(k), os[k]) <= 2800)
            continue
        return k
    }
    return 0
}
TotemAssumeSet(nm, k) {
    global TotemAssume, TotemAssumeMiss, TotemAssumeSlot, TotemAssumeCnt
    TotemAssume[nm] := TotemSlotSig(k)
    TotemAssumeMiss[nm] := 0
    TotemAssumeSlot[nm] := k
    TotemAssumeCnt[nm] := TotemSlotCount()
}
TotemCoolText() {
    global TotemCool
    txt := ""
    for nm, expiry in TotemCool {
        left := expiry - A_TickCount
        if (left <= 0)
            continue
        secs := left // 1000
        if (txt != "")
            txt .= "     "
        txt .= nm (nm = "Sundial" ? ": time unchanged (" : ": no effect (")
            . (secs // 60) ":" SubStr("0" Mod(secs, 60), -1) ")"
    }
    return txt
}
TotemAssumeText() {
    global TotemAssume
    txt := ""
    for nm in TotemAssume {
        if TotemHasByName(nm)
            continue
        txt .= (txt = "" ? "" : ", ") nm
    }
    return txt
}
TotemNeedsTime(nm) {
    if (nm = "Day" || nm = "Night")
        return nm
    if (nm = "Aurora" || nm = "Starfall")
        return "Night"
    if (nm = "Eclipse")
        return "Day"
    return ""
}
TotemIsWeather(nm) {
	return (nm = "Tempest" or nm = "Windset" or nm = "Smokescreen")
}

TotemConflict(nm) {
    global TotemSel1, TotemSel2, TotemSel3
    want := TotemNeedsTime(nm)
    if (want = "")
        return false
    for _, sel in [TotemSel1, TotemSel2, TotemSel3] {
        t := TotemNeedsTime(sel)
        if (t != "")
            return t != want
    }
    return false
}
TotemIsWeatherState(nm) {
	return (nm = "Clearcast" or nm = "Tempest" or nm = "Windset" or nm = "Smokescreen")
}

TotemWeatherConflict(nm) {
    global TotemSel1, TotemSel2, TotemSel3
    if !TotemIsWeatherState(nm)
        return false
    for _, sel in [TotemSel1, TotemSel2, TotemSel3] {
        if TotemIsWeatherState(sel)
            return sel != nm
    }
    return false
}
TotemPickClash(a, b, hard := false) {
    if (a = "" || a = "None" || b = "" || b = "None")
        return false
    if (a = b)
        return true
    ta := TotemNeedsTime(a), tb := TotemNeedsTime(b)
    if (ta != "" && tb != "")
        return (ta != tb) || (!hard && (a = ta || b = tb))
    if (TotemIsWeatherState(a) && TotemIsWeatherState(b))
        return true
    ga := TotemGroupOf(a)
    return ga != "" && ga = TotemGroupOf(b)
}
TotemTimeCovered(v, w1, w2) {
	if (v != "Day" && v != "Night")
		return false
	coverA := (w1 != v) && (TotemNeedsTime(w1) = v)
	coverB := (w2 != v) && (TotemNeedsTime(w2) = v)
	return coverA || coverB
}

TotemSelSanitize() {
    global TotemSel1, TotemSel2, TotemSel3
    if (TotemSel1 = "")
        TotemSel1 := "None"
    if (TotemSel2 = "")
        TotemSel2 := "None"
    if (TotemSel3 = "")
        TotemSel3 := "None"
    if TotemPickClash(TotemSel1, TotemSel2, true)
        TotemSel2 := "None"
    if (TotemPickClash(TotemSel1, TotemSel3, true) || TotemPickClash(TotemSel2, TotemSel3, true))
        TotemSel3 := "None"
    if TotemTimeCovered(TotemSel1, TotemSel2, TotemSel3)
        TotemSel1 := "None"
    if TotemTimeCovered(TotemSel2, TotemSel1, TotemSel3)
        TotemSel2 := "None"
    if TotemTimeCovered(TotemSel3, TotemSel1, TotemSel2)
        TotemSel3 := "None"
    if TotemPickClash(TotemSel1, TotemSel2)
        TotemSel2 := "None"
    if (TotemPickClash(TotemSel1, TotemSel3) || TotemPickClash(TotemSel2, TotemSel3))
        TotemSel3 := "None"
}
TotemListsRefresh() {
    global TotemSel1, TotemSel2, TotemSel3, TotemLblH
    if !IsObject(TotemLblH)
        return
    sels := [TotemSel1, TotemSel2, TotemSel3]
    opts := ["None", "Day", "Night", "Clearcast", "Aurora", "Starfall", "Eclipse"
        , "Tempest", "Windset", "Smokescreen", "Shiny", "Sparkling", "Mutation"]
    Loop 3 {
        K := A_Index
        tlCur := sels[K]
        list := "", pos := 1, n := 0
        for _, opt in opts {
            bad := false
            for oi, other in sels {
                if (oi != K && TotemPickClash(other, opt)) {
                    bad := true
                    break
                }
            }
            if bad
                continue
            n++
            list .= "|" opt
            if (opt = tlCur)
                pos := n
        }
        GuiControl, 1:, TotemSel%K%, %list%
        GuiControl, 1:Choose, TotemSel%K%, %pos%
    }
