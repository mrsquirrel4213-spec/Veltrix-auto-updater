        if (S(it, "st") == "seg") {
            Color sbg = sel ? acc : Mix(card, text, 0.06);
            b.Template = BtnTemplate(sbg, sel ? acc : Mix(card, text, 0.12), Math.Min(10, b.Height / 2));
)
