for SvIdx, SvField in ProfileFields
{
    if (SvField[4] != "num")
        continue
    SvKey := SvField[2]
    SvVal := %SvKey%
    if SvVal is not number
        BadFields .= "`n" SvKey
}
if (BadFields != "")
{
    MsgBox, 4144, Veltrix, These fields need a number:%BadFields%
    return
}
FileCopy, %ActiveProfileFile%, %ActiveProfileFile%.bak, 1
for SvIdx, SvField in ProfileFields
{
    SvSec := SvField[1], SvKey := SvField[2]
    SvVal := %SvKey%
    if (SvField[4] = "bool")
        SvVal := SvVal ? "true" : "false"
    if SvSec in Aquarium,Keeper,Update,Advanced,Misc,Webhook,Reconnect
        SvDest := SettingsFile
    else if (SvSec = "Totem" && TotemGlobal)
        SvDest := SettingsFile
    else
        SvDest := ActiveProfileFile
    IniWrite, %SvVal%, %SvDest%, %SvSec%, %SvKey%
}
for SvName, SvH in VxKeyH
{
    GuiControlGet, SvKeyTxt, 1:, %SvH%
