FishLineVisible() {
    global pCaptureBits, CaptureW, CaptureH, FishColor, FishBarColorTolerance, BarScanRow, ControlMode
    global LineFishSeen, SpecialRod, CastFishX, RemWhiteX, MiguFishX, HaliFishX, TryFishX, SwFishX, VxNatFL
    if (SpecialRod = "Stellarwave Melody")
        return SwScan() && SwFishX >= 0
    if (SpecialRod = "Castbound") {
        CastboundScan()
        return CastFishX >= 0
    }
    if (SpecialRod = "Halibut Harpoon")
        return HalibutBarScan() && HaliFishX >= 0
    if (SpecialRod = "Doomsekkar")
        return DoomScan() && DoomFishX >= 0
    if (SpecialRod = "Oppressor")
        return OppScan() && OppFishX >= 0
    if (SpecialRod = "Remembrance") {
        RemembranceScan()
        return RemWhiteX >= 0
    }
    if (SpecialRod = "MiguRod") {
        MiguScan()
        return MiguFishX >= 0 && BarPresent()
    }
    if (SpecialRod = "Tryhard Rod")
        return TryhardScan() && TryFishX >= 0
    if (ControlMode = "Lines") {
        LineScan()
        return LineFishSeen
    }
    if (SpecialRod = "Verdant Oath")
        return VerdantFishX() >= 0 && VerdantBarScan()

    fList := ColorListParse(FishColor)
    if (fList.n < 1)
        return false
    tol := FishBarColorTolerance
    row := BarScanRow
    if (row < 0 || row >= CaptureH)
        row := Floor(CaptureH / 2)

    if (VxNatFL && VxNatArgs(tol, row))
        return DllCall(VxNatFL, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Int", row
            , "Ptr", ColorListBuf(fList), "Int", fList.n, "Double", tol, "Int") != 0

    rowP := pCaptureBits + row * CaptureW * 4
    x := 0
    while (x < CaptureW) {
        if (!ColorListHitPx(fList, NumGet(rowP + x * 4, "UInt"), tol)) {
            x += 1
            continue
        }
        runSt := x
        while (x < CaptureW && ColorListHitPx(fList, NumGet(rowP + x * 4, "UInt"), tol))
            x += 1
        runLen := x - runSt
        if (runLen > 25)
            continue
        colX := runSt + runLen // 2
        hits := 0
        Loop 7 {
            sy := Floor(CaptureH * (2 * A_Index - 1) / 14)
            if (sy > CaptureH - 1)
                sy := CaptureH - 1
            if ColorListHitPx(fList, NumGet(pCaptureBits + (sy * CaptureW + colX) * 4, "UInt"), tol)
                hits += 1
        }
        if (hits >= 5)
            return true
    }
    return false
}
MedianOf(arr) {
    cnt := arr.MaxIndex()
    if (!cnt)
        return 0
    vals := []
    Loop % cnt
        vals.Push(arr[A_Index])
    ; insertion sort, ascending
    i := 2
    while (i <= cnt) {
        cur := vals[i]
        j := i - 1
        while (j >= 1 && vals[j] > cur) {
            vals[j + 1] := vals[j]
            j--
        }
        vals[j + 1] := cur
        i++
    }
    half := cnt // 2
    if (Mod(cnt, 2) = 0)
        return (vals[half] + vals[half + 1]) / 2
    return vals[half + 1]
}
ScanRowFirst(targetBGR, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft
    if (y < 0 || y >= CaptureH)
        return -1
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    wantB := (targetBGR >> 16) & 0xFF
    wantG := (targetBGR >> 8) & 0xFF
    wantR := targetBGR & 0xFF
    base := pCaptureBits + y * CaptureW * 4
    x := xFrom
    while (x <= xTo) {
        px := NumGet(base + x * 4, 0, "UInt")
        if (Abs((px & 0xFF) - wantB) <= tol && Abs(((px >> 8) & 0xFF) - wantG) <= tol && Abs(((px >> 16) & 0xFF) - wantR) <= tol)
            return FishBarLeft + x
        x++
    }
    return -1
}
ScanRowLast(targetBGR, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft
    if (y < 0 || y >= CaptureH)
        return -1
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    wantB := (targetBGR >> 16) & 0xFF
    wantG := (targetBGR >> 8) & 0xFF
    wantR := targetBGR & 0xFF
    base := pCaptureBits + y * CaptureW * 4
    x := xTo
    while (x >= xFrom) {
        px := NumGet(base + x * 4, 0, "UInt")
        if (Abs((px & 0xFF) - wantB) <= tol && Abs(((px >> 8) & 0xFF) - wantG) <= tol && Abs(((px >> 16) & 0xFF) - wantR) <= tol)
            return FishBarLeft + x
        x--
    }
    return -1
}
ScanRowCenter(targetBGR, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft
    if (y < 0 || y >= CaptureH)
        return -1
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    wantB := (targetBGR >> 16) & 0xFF
    wantG := (targetBGR >> 8) & 0xFF
    wantR := targetBGR & 0xFF
    base := pCaptureBits + y * CaptureW * 4
    first := -1
    last := -1
    x := xFrom
    while (x <= xTo) {
        px := NumGet(base + x * 4, 0, "UInt")
        if (Abs((px & 0xFF) - wantB) <= tol && Abs(((px >> 8) & 0xFF) - wantG) <= tol && Abs(((px >> 16) & 0xFF) - wantR) <= tol) {
            if (first < 0)
                first := x
            last := x
        } else if (first >= 0 && (x - last) > 4) {
            break
        }
        x++
    }
    if (first < 0)
        return -1
    return FishBarLeft + (first + last) / 2
}
ColorListParse(s) {
    global ColorListCache, ColorListCacheN
    if (!IsObject(ColorListCache)) {
        ColorListCache := {}
        ColorListCacheN := 0
    }
    if (ColorListCache.HasKey(s))
        return ColorListCache[s]
    if (ColorListCacheN > 96) {
        ColorListCache := {}
        ColorListCacheN := 0
    }
    res := {n: 0, r: [], g: [], b: []}
    src := ColExpand(s)
    Loop, Parse, src, `,;|%A_Space%, %A_Space%%A_Tab%
    {
        v := ColNorm(A_LoopField)
        if (v < 0)
            continue
        res.n += 1
        res.r.Push((v >> 16) & 0xFF)
        res.g.Push((v >> 8) & 0xFF)
        res.b.Push(v & 0xFF)
    }
    ColorListCache[s] := res
    ColorListCacheN += 1
    return res
}
; a gradient "0xAAAAAA-0xBBBBBB" (or more colours: "0xA-0xB-0xC") in a colour list stands for every shade along it,
; colour to colour: it is handed on as stops at most 6 shades apart (up to 25 per step), so a tolerance of 3 or more
; closes the gaps between them
ColExpand(s) {
	if (!InStr(s, "-"))
		return s
	s := RegExReplace(s, "\s*-\s*", "-")
	out := ""
	Loop, Parse, s, `,;|%A_Space%, %A_Space%%A_Tab%
	{
		t := A_LoopField
		if (t = "")
			continue
		if (!InStr(t, "-"))
		{
			out .= (out = "" ? "" : ",") . t
			continue
		}
		g := ColGradNorm(t)
		if (g = "")
			continue
		; each pair of neighbouring colours in turn (the colour they share is listed once)
		st := StrSplit(g, "-")
		Loop, % st.Length() - 1
		{
			a := ColNorm(st[A_Index]), b := ColNorm(st[A_Index + 1])
			ar := (a >> 16) & 0xFF, ag := (a >> 8) & 0xFF, ab := a & 0xFF
			br := (b >> 16) & 0xFF, bg := (b >> 8) & 0xFF, bb := b & 0xFF
			n := Ceil(Max(Abs(br - ar), Abs(bg - ag), Abs(bb - ab)) / 6)
			n := (n < 1) ? 1 : (n > 24) ? 24 : n
			k0 := (A_Index = 1) ? 0 : 1
			Loop, % n + 1 - k0
			{
				f := (A_Index - 1 + k0) / n
				out .= (out = "" ? "" : ",") . Format("0x{:02X}{:02X}{:02X}", Round(ar + (br - ar) * f), Round(ag + (bg - ag) * f), Round(ab + (bb - ab) * f))
			}
		}
	}
	return out
}

; a gradient (two colours or more, any notation) in one notation, "" when it is not one
ColGradNorm(t) {
	if (!InStr(t, "-"))
		return ""
	out := ""
	for i, p in StrSplit(t, "-")
	{
		c := ColNorm(p)
		if (c < 0)
			return ""
		out .= ((out = "") ? "" : "-") . Format("0x{:06X}", c)
	}
	return InStr(out, "-") ? out : ""
}

; a colour list item (a colour, or a gradient as text) for the list rows: its text and its swatch
ColItemText(v) {
	return InStr(v, "-") ? v : Format("0x{:06X}", v)
}
ColItemSw(v) {
	return InStr(v, "-") ? SubStr(v, 3, 6) : Format("{:06X}", v)
}

ColMain(s) {
	lst := ColorListParse(s)
	if (lst.n < 1)
		return 0
	return (lst.r[1] << 16) | (lst.g[1] << 8) | lst.b[1]
}

ColCount(s) {
	o := ColorListParse(s)
	return o.n
}

ColorListHitPx(o, px, tol) {
    pr := (px >> 16) & 0xFF
    pg := (px >> 8) & 0xFF
    pb := px & 0xFF
    Loop % o.n {
        if (Abs(pr - o.r[A_Index]) <= tol && Abs(pg - o.g[A_Index]) <= tol && Abs(pb - o.b[A_Index]) <= tol)
            return true
    }
    return false
}
ColorListFirstX(o, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, VxNatCF
    if (o.n < 1 || y < 0 || y >= CaptureH)
        return -1
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    if (VxNatCF && VxNatArgs(tol, y, xFrom, xTo)) {
        hit := DllCall(VxNatCF, "Ptr", pCaptureBits, "Int", CaptureW, "Int", y, "Int", xFrom, "Int", xTo
            , "Ptr", ColorListBuf(o), "Int", o.n, "Double", tol, "Int", 1, "Int")
        return (hit >= 0) ? FishBarLeft + hit : -1
    }
    base := pCaptureBits + y * CaptureW * 4
    x := xFrom
    while (x <= xTo) {
        if (ColorListHitPx(o, NumGet(base + x * 4, 0, "UInt"), tol))
            return FishBarLeft + x
        x++
    }
    return -1
}
ColorListLastX(o, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, VxNatCF
    if (o.n < 1 || y < 0 || y >= CaptureH)
        return -1
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    if (VxNatCF && VxNatArgs(tol, y, xFrom, xTo)) {
        hit := DllCall(VxNatCF, "Ptr", pCaptureBits, "Int", CaptureW, "Int", y, "Int", xFrom, "Int", xTo
            , "Ptr", ColorListBuf(o), "Int", o.n, "Double", tol, "Int", -1, "Int")
        return (hit >= 0) ? FishBarLeft + hit : -1
    }
    base := pCaptureBits + y * CaptureW * 4
    x := xTo
    while (x >= xFrom) {
        if (ColorListHitPx(o, NumGet(base + x * 4, 0, "UInt"), tol))
            return FishBarLeft + x
        x--
    }
    return -1
}
ColorListLineX(o, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft
    if (o.n < 1 || y < 0 || y >= CaptureH)
        return -1
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    rowStride := CaptureW * 4
    base := pCaptureBits + y * rowStride
    x := xFrom
    while (x <= xTo) {
        if (!ColorListHitPx(o, NumGet(base + x * 4, 0, "UInt"), tol)) {
            x++
            continue
        }
        runStart := x
        while (x <= xTo && ColorListHitPx(o, NumGet(base + x * 4, 0, "UInt"), tol))
            x++
        runLen := x - runStart
        if (runLen <= 25) {
            cx := runStart + Floor(runLen / 2)
            hits := 0
            Loop 7 {
                y2 := Floor(CaptureH * (2 * A_Index - 1) / 14)
                if (y2 > CaptureH - 1)
                    y2 := CaptureH - 1
                if (ColorListHitPx(o, NumGet(pCaptureBits + y2 * rowStride + cx * 4, 0, "UInt"), tol))
                    hits++
            }
            if (hits >= 5)
                return FishBarLeft + cx
        }
    }
    return -1
}
ColorListCenterX(o, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, VxNatCR
    if (o.n < 1 || y < 0 || y >= CaptureH)
        return -1
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    if (VxNatCR && VxNatArgs(tol, y, xFrom, xTo)) {
        VarSetCapacity(span, 8, 0)
        ok := DllCall(VxNatCR, "Ptr", pCaptureBits, "Int", CaptureW, "Int", y, "Int", xFrom, "Int", xTo
            , "Ptr", ColorListBuf(o), "Int", o.n, "Double", tol, "Ptr", &span, "Int")
        if (!ok)
            return -1
        return FishBarLeft + (NumGet(span, 0, "Int") + NumGet(span, 4, "Int")) / 2
    }
    base := pCaptureBits + y * CaptureW * 4
    first := -1
    last := -1
    x := xFrom
    while (x <= xTo) {
        if (ColorListHitPx(o, NumGet(base + x * 4, 0, "UInt"), tol)) {
            if (first < 0)
                first := x
            last := x
        } else if (first >= 0 && (x - last) > 4) {
            break
        }
        x++
    }
    if (first < 0)
        return -1
    return FishBarLeft + (first + last) / 2
}
StructBar() {
    global CaptureW, CaptureH, RunLeft, RunWidth, BarScanRow, BarRowAgreement
    if (CaptureW < 24 || CaptureH < 4)
        return false
    rows := 9
    if (CaptureH < rows)
        rows := CaptureH
    lefts := [], widths := [], centres := [], ys := []
    Loop % rows {
        y := Floor(CaptureH * (2 * A_Index - 1) / (2 * rows))
        if (y < 0)
            y := 0
        if (y > CaptureH - 1)
            y := CaptureH - 1
        if (!ScanRowBar(y, 8))
            continue
        if (RunWidth < 0.05 * CaptureW || RunWidth > 0.72 * CaptureW)
            continue
        lefts.Push(RunLeft)
        widths.Push(RunWidth)
        centres.Push(RunLeft + RunWidth / 2)
        ys.Push(y)
    }
    kept := centres.Length()
    if (kept < 4) {
        BarRowAgreement := kept
        return false
    }
    mc := MedianOf(centres)
    mw := MedianOf(widths)
    agree := 0
    bestIdx := 0
    bestDist := 999999
    Loop % kept {
        d := Abs(centres[A_Index] - mc)
        w := widths[A_Index]
        if (d <= 0.10 * CaptureW && w >= 0.6 * mw && w <= 1.6 * mw) {
            agree++
            if (d < bestDist) {
                bestDist := d
                bestIdx := A_Index
            }
        }
    }
    BarRowAgreement := agree
    if (agree < 4 || !bestIdx)
        return false
    RunLeft := lefts[bestIdx]
    RunWidth := widths[bestIdx]
    BarScanRow := ys[bestIdx]
    return true
}
StripSig() {
    global pCaptureBits, CaptureW, CaptureH
    if (!pCaptureBits || CaptureW < 4 || CaptureH < 1)
        return 0
    total := 0
    Loop 3 {
        y := Floor(CaptureH * (2 * A_Index - 1) / 6)
        if (y < 0)
            y := 0
        if (y > CaptureH - 1)
            y := CaptureH - 1
        base := pCaptureBits + y * CaptureW * 4
        x := 0
        while (x < CaptureW) {
            total += (NumGet(base + x * 4, 0, "UInt") & 0xFFFFFF) * (x + 1)
            x += 3
        }
    }
    return total
}
NoteHoldZone(w) {
	z := w * 0.20
	if (z < 10)
		z := 10
	return z
}

MgDetect() {
    global SpecialRod, CaptureW, RunWidth, MgSawBar, MgSawFish, MgSawArrow, MgConf
    MgSawBar := false
    MgSawFish := false
    MgSawArrow := false
    if (SpecialRod = "Tranquility") {
        MgSawFish := ManiaVisible()
        MgConf := MgSawFish ? 80 : 0
        return MgConf
    }
    score := 0
    if (FishLineVisible()) {
        MgSawFish := true
        score += 55
    }
    if (MinigameVisible(6)) {
        MgSawBar := true
        score += 40
    }
    if (score = 0 && FindArrowX() >= 0) {
        MgSawArrow := true
        score := 30
    }
    if (MgSawBar && RunWidth > 10 && RunWidth < 0.7 * CaptureW)
        score += 5
    if (score > 100)
        score := 100
    MgConf := score
    return score
}
MgAccumulate() {
    global MgScore
    conf := MgDetect()
    if (conf >= 90) {
        MgScore := 6
        return true
    }
    if (MgScore = "")
        MgScore := 0
    if (conf >= 55)
        MgScore += 2
    else if (conf >= 30)
        MgScore += 1
    else
        MgScore -= 2
    if (MgScore < 0)
        MgScore := 0
    if (MgScore > 6)
        MgScore := 6
    return MgScore >= 4
}
BarByEdges() {
    global MgInPlay, LineBarL, LineBarW, CaptureW, RunLeft, RunWidth, LastBarL, LastBarR
    if (!MgInPlay)
        return false
    if (!LineScan())
        return false
    if (LineBarW < 8 || LineBarW > 0.92 * CaptureW)
        return false
    RunLeft := LineBarL
    RunWidth := LineBarW
    LastBarL := LineBarL
    LastBarR := LineBarL + LineBarW - 1
    return true
}
BarSpanFill(lList, rList, tol, y, xFrom, xTo) {
    global pCaptureBits, CaptureW, CaptureH
    if (y < 0 || y >= CaptureH || xTo <= xFrom)
        return 0
    if (xFrom < 0)
        xFrom := 0
    if (xTo > CaptureW - 1)
        xTo := CaptureW - 1
    base := pCaptureBits + y * CaptureW * 4
    samples := 0
    matched := 0
    x := xFrom
    while (x <= xTo) {
        samples++
        px := NumGet(base + x * 4, 0, "UInt")
        if (ColorListHitPx(lList, px, tol) || ColorListHitPx(rList, px, tol))
            matched++
        x += 3
    }
    return samples > 0 ? matched / samples : 0
}
RemBarRef() {
	global RemBarRing, CaptureW
	if (IsObject(RemBarRing) and RemBarRing.MaxIndex() >= 3)
		return Round(MedianOf(RemBarRing))
	return Round(CaptureW * 0.206)
}

; Remembrance's whole scan in VeltrixNative, once per capture: RemNat[1..9] = white x, votes, black x, longest bar
; run left, length, best slide left, its sum, track left, right (strip x, -1 = none)
RemNat() {
	global VxNatRM, pCaptureBits, CaptureW, CaptureH, FishColor, FishBarColorTolerance, RemembranceMode, RemNatDone, RemNat
	if (!VxNatRM)
		return false
	if (RemNatDone)
		return true
	wList := ColorListParse(FishColor)
	if (wList.n < 1)
		wList := ColorListParse("0xFFFFFF")
	wTol := FishBarColorTolerance
	if wTol is not number
		wTol := 10
	wTol := (wTol < 6) ? 6 : Round(wTol)
	wMaxW := Round(CaptureW * 0.03), wMaxW := (wMaxW < 8) ? 8 : wMaxW
	bMin := Round(CaptureW * 0.004), bMin := (bMin < 2) ? 2 : bMin
	bMax := Round(CaptureW * 0.03), bMax := (bMax < 8) ? 8 : bMax
	bGap := Round(CaptureW * 0.018), bGap := (bGap < 6) ? 6 : bGap
	VarSetCapacity(rmo, 36, 0)
	if (!DllCall(VxNatRM, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Int", wList.r[1], "Int", wList.g[1], "Int", wList.b[1]
		, "Int", wTol, "Int", wMaxW, "Int", bMin, "Int", bMax, "Int", (RemembranceMode = "Departed") ? 1 : 0, "Int", RemBarRef(), "Int", bGap, "Ptr", &rmo, "Int"))
		return false
	RemNat := []
	Loop 9
		RemNat.Push(NumGet(rmo, (A_Index - 1) * 4, "Int"))
	RemNatDone := true
	return true
}

RemBarScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, RemembranceMode, RemNat
    global RemBarScanned, RemBarFound, RemBarL, RemBarW, RemBarRing
    if (RemBarScanned)
        return RemBarFound
    RemBarScanned := true
    RemBarFound := false
    W := CaptureW, H := CaptureH
    if (W < 40 || H < 6)
        return false
    if (RemembranceMode = "Departed")
        lumLo := 55, lumHi := 110
    else
        lumLo := 145, lumHi := 235
    if (RemNat())
        return RemBarPick(RemNat[4], RemNat[5], RemNat[6], RemNat[7])

    ; per-column hit counts over three sample rows
    colHits := []
    Loop % W + 1
        colHits[A_Index - 1] := 0
    for _, frac in [0.2, 0.5, 0.8] {
        base := pCaptureBits + Floor(frac * H) * W * 4
        x := 0
        while (x < W) {
            px := NumGet(base + x * 4, 0, "UInt")
            cr := (px >> 16) & 0xFF, cg := (px >> 8) & 0xFF, cb := px & 0xFF
            if (Abs(cr - cg) <= 10 && Abs(cg - cb) <= 10) {
                lum := Floor((cr + cg + cb) / 3)
                if (lum >= lumLo && lum <= lumHi)
                    colHits[x] += 1
            } else {
                hiC := Max(cr, cg, cb), loC := Min(cr, cg, cb)
                if (hiC >= 65 && hiC <= 140 && (hiC - loC) >= 8 && (hiC - loC) <= 55)
                    colHits[x] += 1
            }
            x++
        }
    }

    minRef := Round(0.08 * W)
    maxRef := Round(0.35 * W)
    if (!IsObject(RemBarRing))
        RemBarRing := []
    haveRef := RemBarRing.Length() >= 3
    bRef := haveRef ? Round(MedianOf(RemBarRing)) : Round(0.206 * W)
    accLo := haveRef ? Round(0.7 * bRef) : minRef
    accHi := haveRef ? Round(1.3 * bRef) : maxRef
    bGap := Round(0.018 * W)
    if (bGap < 6)
        bGap := 6

    ; pass A: longest run of columns hit on at least two rows, small gaps bridged
    bestL := -1, bestLen := 0
    runS := -1, lastOn := -1
    x := 0
    while (x <= W) {
        isOn := (x < W && colHits[x] >= 2)
        if (isOn) {
            if (runS < 0)
                runS := x
            lastOn := x
        } else if (runS >= 0 && ((x - lastOn) > bGap || x = W)) {
            runLen := lastOn - runS + 1
            if (runLen > bestLen)
                bestLen := runLen, bestL := runS
            runS := -1
        }
        x++
    }
    if (bestL >= 0 && bestLen >= accLo && bestLen <= accHi) {
        RemBarL := FishBarLeft + bestL
        RemBarW := bestLen
        RemBarRing.Push(bestLen)
        if (RemBarRing.Length() > 5)
            RemBarRing.RemoveAt(1)
        RemBarFound := true
        return true
    }

    ; pass B: fixed-width window with the highest total
    slideBest := 0, slideL := -1
    acc := 0
    x := 0
    while (x < W) {
        acc += colHits[x]
        if (x >= bRef)
            acc -= colHits[x - bRef]
        if (x >= bRef - 1 && acc > slideBest)
            slideBest := acc, slideL := x - bRef + 1
        x++
    }
    if (slideL < 0 || slideBest < 0.45 * 3 * bRef)
        return false
    RemBarL := FishBarLeft + slideL
    RemBarW := bRef
    RemBarFound := true
    return true
}
RemBarPick(runL, runLen, slideL, slideSum) {
    global CaptureW, FishBarLeft, RemBarRing, RemBarFound, RemBarL, RemBarW
    if (!IsObject(RemBarRing))
        RemBarRing := []
    haveRef := RemBarRing.Length() >= 3
    bRef := RemBarRef()
    accLo := haveRef ? Round(0.7 * bRef) : Round(0.08 * CaptureW)
    accHi := haveRef ? Round(1.3 * bRef) : Round(0.35 * CaptureW)
    if (runL >= 0 && runLen >= accLo && runLen <= accHi) {
        RemBarL := FishBarLeft + runL
        RemBarW := runLen
        RemBarRing.Push(runLen)
        while (RemBarRing.Length() > 5)
            RemBarRing.RemoveAt(1)
        RemBarFound := true
        return true
    }
    if (slideL < 0 || slideSum < 0.45 * 3 * bRef)
        return false
    RemBarL := FishBarLeft + slideL
    RemBarW := bRef
    RemBarFound := true
    return true
}
RemembranceScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, BarScanRow, FishColor, FishBarColorTolerance
    global RemScanned, RemFound, RemWhiteX, RemBlackX, RemTargetX, RemTrkL, RemTrkR, RemNat
    if (RemScanned)
        return RemFound
    RemScanned := true
    RemFound := false
    RemWhiteX := -1
    RemBlackX := -1
    RemTargetX := -1
    W := CaptureW, H := CaptureH
    if (W < 40 || H < 6)
        return false

    if (RemNat()) {
        if (RemNat[2] < 4)
            return false
        RemWhiteX := FishBarLeft + RemNat[1]
        if (RemNat[3] >= 0)
            RemBlackX := FishBarLeft + RemNat[3]
        RemTrkL := -1
        RemTrkR := -1
        if (RemNat[8] >= 0) {
            RemTrkL := FishBarLeft + RemNat[8]
            RemTrkR := FishBarLeft + RemNat[9]
        }
        RemFound := true
        RemBarScan()
        RemTargetX := RemAimX(RemWhiteX, RemBlackX)
        return true
    }

    rowStride := W * 4
    sampleY := []
    Loop 5 {
        yy := Floor(H * (2 * A_Index - 1) / 10)
        if (yy > H - 1)
            yy := H - 1
        sampleY.Push(yy)
    }

    fc := ColorListParse(FishColor)
    if (fc.n >= 1)
        wr := fc.r[1], wg := fc.g[1], wb := fc.b[1]
    else
        wr := 255, wg := 255, wb := 255
    wTol := FishBarColorTolerance
    if (wTol < 6)
        wTol := 6
    wMaxW := Round(0.03 * W)
    if (wMaxW < 8)
        wMaxW := 8

    ; white fish marker: runs on the middle rows, confirmed by votes across all five rows
    bestVotes := 0, bestCx := -1
    for _, rowIdx in [3, 2, 4] {
        base := pCaptureBits + sampleY[rowIdx] * rowStride
        runS := -1
        x := 0
        while (x <= W) {
            isHit := false
            if (x < W) {
                px := NumGet(base + x * 4, 0, "UInt")
                isHit := (Abs(((px >> 16) & 0xFF) - wr) <= wTol && Abs(((px >> 8) & 0xFF) - wg) <= wTol && Abs((px & 0xFF) - wb) <= wTol)
            }
            if (isHit) {
                if (runS < 0)
                    runS := x
            } else if (runS >= 0) {
                runW := x - runS
                if (runW >= 2 && runW <= wMaxW) {
                    cx := runS + Floor(runW / 2)
                    votes := 0
                    Loop 5
                        if (RemWhiteAt(cx, sampleY[A_Index], wr, wg, wb, wTol))
                            votes++
                    if (votes > bestVotes)
                        bestVotes := votes, bestCx := cx
                }
                runS := -1
            }
            x++
        }
        if (bestVotes >= 4)
            break
    }
    if (bestVotes < 4)
        return false
    RemWhiteX := FishBarLeft + bestCx

    ; black fish line: short dark runs voted per centre column
    dMin := Round(0.004 * W)
    if (dMin < 2)
        dMin := 2
    dMax := Round(0.03 * W)
    if (dMax < 8)
        dMax := 8
    darkVotes := []
    Loop % W
        darkVotes[A_Index - 1] := 0
    Loop 5 {
        base := pCaptureBits + sampleY[A_Index] * rowStride
        runS := -1
        x := 0
        while (x <= W) {
            isDark := false
            if (x < W) {
                px := NumGet(base + x * 4, 0, "UInt")
                isDark := (((px >> 16) & 0xFF) <= 24 && ((px >> 8) & 0xFF) <= 24 && (px & 0xFF) <= 24)
            }
            if (isDark) {
                if (runS < 0)
                    runS := x
            } else if (runS >= 0) {
                runLen := x - runS
                if (runLen >= dMin && runLen <= dMax && runS > 0 && x < W)
                    darkVotes[Floor((runS + x - 1) / 2)] += 1
                runS := -1
            }
            x++
        }
    }
    blackCol := -1, blackSum := 0
    x := 0
    while (x < W) {
        tot := 0
        k := x - 2
        while (k <= x + 2) {
            if (k >= 0 && k < W)
                tot += darkVotes[k]
            k++
        }
        if (tot >= 3 && tot > blackSum)
            blackSum := tot, blackCol := x
        x++
    }
    if (blackCol >= 0)
        RemBlackX := FishBarLeft + blackCol

    RemTrackEnds(sampleY[3])
    RemFound := true
    RemBarScan()
    RemTargetX := RemAimX(RemWhiteX, RemBlackX)
    return true
}
RemWhiteAt(hx, hy, hr, hg, hb, htol) {
    global pCaptureBits, CaptureW, CaptureH
    if (hy < 0 || hy >= CaptureH)
        return false
    base := pCaptureBits + hy * CaptureW * 4
    x := Max(0, hx - 5)
    xEnd := Min(CaptureW - 1, hx + 5)
    while (x <= xEnd) {
        px := NumGet(base + x * 4, 0, "UInt")
        if (Abs(((px >> 16) & 0xFF) - hr) <= htol && Abs(((px >> 8) & 0xFF) - hg) <= htol && Abs((px & 0xFF) - hb) <= htol)
            return true
        x++
    }
    return false
}
RemAimX(wx, bx) {
	global RunWidth, RemembranceMode, RemBarFound, RemBarL, RemBarW, RemTrkL, RemTrkR, TrackLeft, TrackRight
	w := (RemBarFound and RemBarW > 0) ? RemBarW : RunWidth
	h := w / 2
	if (wx < 0)
		return (RemBarFound and RemBarW > 0) ? RemBarL + h : -1
	if (h < 4 or bx < 0)
		return wx
	tl := (RemTrkL > 0) ? RemTrkL : TrackLeft
	tr := (RemTrkR > 0) ? RemTrkR : TrackRight
	; the white fish this far in from the bar's edge at least
	q := w * TA("remin", 12) / 100.0
	q := (q < 8) ? 8 : q
	lo := wx - h + q, hi := wx + h - q
	if (hi < lo)
		lo := hi := wx
	; clear of the black line: wide (wider in Departed), or just the edge between the lines
	for k, gap in [w * ((RemembranceMode = "Departed") ? TA("remgapd", 35) : TA("remgap", 25)) / 100.0, TA("remedge", 6)]
		{
		gap := (gap < 4) ? 4 : gap
		best := -99999
		; left of the black line: the middle at most bx - h - gap; right of it: at least bx + h + gap
		a := bx - h - gap
		if (a >= lo)
			best := (wx <= a) ? wx : a
		b := bx + h + gap
		if (b <= hi)
			{
			cb := (wx >= b) ? wx : b
			if (best = -99999 or Abs(cb - wx) < Abs(best - wx))
				best := cb
			}
		if (best != -99999)
			return RemClampTrack(best, h, tl, tr)
		}
	; too close for the edge to fit between them: the white fish inside, the black line as near the far edge as it gets
	return RemClampTrack((bx >= wx) ? lo : hi, h, tl, tr)
}

RemClampTrack(c, h, tl, tr) {
	if (tr - tl > 2 * h)
		c := (c < tl + h) ? tl + h : ((c > tr - h) ? tr - h : c)
	return c
}

; the ends of the track (its grey, darker in Departed) on one row, in window x
RemTrackEnds(y) {
	global pCaptureBits, CaptureW, CaptureH, FishBarLeft, RemembranceMode, RemTrkL, RemTrkR
	RemTrkL := -1, RemTrkR := -1
	if (y < 0 or y >= CaptureH)
		return
	t := (RemembranceMode = "Departed") ? 40 : 116
	p := pCaptureBits + y * CaptureW * 4, a := -1, e := -1, x := 0
	while (x < CaptureW)
		{
		v := NumGet(p + 0, x * 4, "UInt"), b := v & 0xFF, g := (v >> 8) & 0xFF, r := (v >> 16) & 0xFF
		if (Abs(r - t) <= 14 and Abs(g - t) <= 14 and Abs(b - t) <= 14)
			{
			a := (a < 0) ? x : a
			e := x
			}
		x++
		}
	if (a >= 0 and e - a >= CaptureW * 0.3)
		RemTrkL := FishBarLeft + a, RemTrkR := FishBarLeft + e
}

; Oppressor (VeltrixNative's vx_opp): the metallic bar, the fish spike above it and the parry marker
OppScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, VxNatOP
    global OppScanned, OppFound, OppBarL, OppBarW, OppFishX, OppMarkX, OppMarkW
    if (OppScanned)
        return OppFound
    OppScanned := true
    OppFound := false
    OppFishX := -1, OppMarkX := -1, OppMarkW := 0
    if (!VxNatOP || CaptureW < 40 || CaptureH < 20)
        return false
    VarSetCapacity(res, 20, 0)
    rc := DllCall(VxNatOP, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Ptr", &res, "Int")
    if (NumGet(res, 8, "Int") >= 0)
        OppFishX := FishBarLeft + NumGet(res, 8, "Int")
    if (NumGet(res, 12, "Int") >= 0) {
        OppMarkX := FishBarLeft + (NumGet(res, 12, "Int") + NumGet(res, 16, "Int")) / 2
        OppMarkW := NumGet(res, 16, "Int") - NumGet(res, 12, "Int")
    }
    if (rc < 2)
        return false
    OppBarL := FishBarLeft + NumGet(res, 0, "Int")
    OppBarW := NumGet(res, 4, "Int") - NumGet(res, 0, "Int")
    OppFound := OppBarW > 0
    return OppFound
}

; where the Oppressor bar should go, and the parry. A marker shows up at full size where the ball will land, holds for
; a moment, then its corners close in; the ball lands about 1.13 s after they start closing. The bar goes under the
; marker, and right mouse is pressed oppparry ms after the corners start closing; after that the bar goes back to the
; fish. A new marker only counts when it is seen at full size three looks in a row (a flash can look like one).
OppTarget() {
    global
    local now
    OppScan()
    now := A_TickCount
    if (OppMarkX >= 0) {
        if (!OppMkOn) {
            if (OppMarkW >= 0.06 * WindowWidth && OppCandN > 0 && Abs(OppMarkX - OppCandX) < 0.02 * WindowWidth)
                OppCandN += 1
            else
                OppCandN := (OppMarkW >= 0.06 * WindowWidth) ? 1 : 0
            OppCandX := OppMarkX
            if (OppCandN >= 3)
                OppMkOn := true, OppMkX := OppMarkX, OppMkW0 := OppMarkW, OppMkShrink := 0, OppMkDone := false, OppMkSeen := now
        } else if (Abs(OppMarkX - OppMkX) < 0.03 * WindowWidth) {
            OppMkSeen := now
            OppMkX := OppMarkX
            if (!OppMkShrink && OppMarkW < OppMkW0 - Max(2, 0.03 * OppMkW0))
                OppMkShrink := now
        }
    } else
        OppCandN := 0
    if (OppMkOn && !OppMkDone && OppMkShrink && now - OppMkShrink >= TA("oppparry", 1070)) {
        OppMkDone := true
        VxTip(13, "Oppressor: parry")
        Send, {RButton down}
        Sleep, % TA("opptap", 40)
        Send, {RButton up}
    }
    if (OppMkOn && now - OppMkSeen > 300)
        OppMkOn := false
    return (OppMkOn && !OppMkDone) ? OppMkX : OppFishX
}

; Doomsekkar (VeltrixNative's vx_doom): the bar by the thin green line along its top, the fish by its black stalk
DoomScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, VxNatDM
    global DoomScanned, DoomFound, DoomBarL, DoomBarW, DoomFishX, DoomReset
    if (DoomScanned)
        return DoomFound
    DoomScanned := true
    DoomFound := false
    DoomFishX := -1
    if (!VxNatDM || CaptureW < 40 || CaptureH < 8)
        return false
    VarSetCapacity(res, 16, 0)
    rc := DllCall(VxNatDM, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Int", DoomReset ? 1 : 0, "Ptr", &res, "Int")
    DoomReset := false
    if (NumGet(res, 8, "Int") >= 0)
        DoomFishX := FishBarLeft + NumGet(res, 8, "Int")
    if (rc < 2)
        return false
    DoomBarL := FishBarLeft + NumGet(res, 0, "Int")
    DoomBarW := NumGet(res, 4, "Int") - NumGet(res, 0, "Int")
    DoomFound := DoomBarW > 0
    return DoomFound
}
HalibutBarScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, VxNatHB, NatOff
    global HaliBarScanned, HaliBarFound, HaliBarL, HaliBarW, HaliFishX
    if (HaliBarScanned)
        return HaliBarFound
    HaliBarScanned := true
    HaliBarFound := false
    HaliFishX := -1
    W := CaptureW, H := CaptureH
    if (W < 40 || H < 8)
        return false

    if (VxNatHB && !NatOff) {
        VarSetCapacity(res, 12, 0)
        rc := DllCall(VxNatHB, "Ptr", pCaptureBits, "Int", W, "Int", H, "Ptr", &res, "Int")
        fish2 := NumGet(res, 8, "Int")
        if (fish2 >= 0)
            HaliFishX := FishBarLeft + fish2 / 2
        if (rc < 2)
            return false
        HaliBarL := FishBarLeft + NumGet(res, 0, "Int")
        HaliBarW := NumGet(res, 4, "Int")
        HaliBarFound := true
        return true
    }

    barCnt := [], darkCnt := []
    Loop % W + 1 {
        barCnt[A_Index - 1] := 0
        darkCnt[A_Index - 1] := 0
    }
    trackPx := 0
    for _, frac in [0.28, 0.38, 0.78, 0.88] {
        base := pCaptureBits + Floor(frac * H) * W * 4
        x := 0
        while (x < W) {
            px := NumGet(base + x * 4, 0, "UInt")
            cr := (px >> 16) & 0xFF, cg := (px >> 8) & 0xFF, cb := px & 0xFF
            if (Abs(cr - 83) <= 12 && Abs(cg - 72) <= 12 && Abs(cb - 160) <= 14) {
                barCnt[x] += 1
            } else if (Abs(cr - 42) <= 12 && Abs(cg - 38) <= 12 && Abs(cb - 117) <= 14) {
                trackPx++
            } else {
                hiC := Max(cr, cg, cb), loC := Min(cr, cg, cb)
                if (hiC < 60 && (hiC - loC) <= 10)
                    darkCnt[x] += 1
            }
            x++
        }
    }
    if (trackPx < 0.6 * W)
        return false

    ; longest purple run, gaps up to hGap bridged
    hGap := Round(0.03 * W)
    if (hGap < 12)
        hGap := 12
    bestL := -1, bestLen := 0
    runS := -1, lastOn := -1
    x := 0
    while (x <= W) {
        isOn := (x < W && barCnt[x] >= 2)
        if (isOn) {
            if (runS < 0)
                runS := x
            lastOn := x
        } else if (runS >= 0 && ((x - lastOn) > hGap || x = W)) {
            runLen := lastOn - runS + 1
            if (runLen > bestLen)
                bestLen := runLen, bestL := runS
            runS := -1
        }
        x++
    }

    ; fish: narrow dark neutral run with the most hits
    maxFishW := Round(0.02 * W)
    if (maxFishW < 12)
        maxFishW := 12
    bestHits := 0
    runS := -1, hits := 0
    x := 0
    while (x <= W) {
        isOn := (x < W && darkCnt[x] >= 2)
        if (isOn) {
            if (runS < 0)
                runS := x, hits := 0
            hits += darkCnt[x]
        } else if (runS >= 0) {
            if ((x - runS) <= maxFishW && hits > bestHits) {
                bestHits := hits
                HaliFishX := FishBarLeft + (runS + x - 1) / 2
            }
            runS := -1
        }
        x++
    }

    if (bestL < 0 || bestLen < 0.08 * W || bestLen > 0.85 * W)
        return false
    HaliBarL := FishBarLeft + bestL
    HaliBarW := bestLen
    HaliBarFound := true
    return true
}
TryRowRuns(p, ByRef prm, ByRef prmI, gap, rr) {
    global CaptureW
    x := 0
    found := 0
    curS := -1, curE := -1
    while (x < CaptureW && found < 40) {
        s := PcFind(p + 4 * x, CaptureW - x, 4, prm)
        if (s < 0)
            break
        s += x
        e := PcFind(p + 4 * (s + 1), CaptureW - s - 1, 4, prmI)
        e := (e < 0) ? CaptureW - 1 : s + e
        found++
        if (curS >= 0 && (s - curE - 1) <= gap) {
            curE := e
        } else {
            if (curS >= 0)
                rr.Push([curS, curE])
            curS := s, curE := e
        }
        x := e + 1
    }
    if (curS >= 0)
        rr.Push([curS, curE])
}
TryTrackAt(x) {
    global pCaptureBits, CaptureW, CaptureH
    if (x < 0 || x >= CaptureW)
        return false
    good := 0
    for _, frac in [0.30, 0.50, 0.70] {
        px := NumGet(pCaptureBits + Floor(frac * CaptureH) * CaptureW * 4 + x * 4, 0, "UInt")
        cr := (px >> 16) & 0xFF, cg := (px >> 8) & 0xFF, cb := px & 0xFF
        if (cr + 16 >= cb && cr < 70 && cb < 70 && (cg < 40 || (cg < 48 && cr >= cg)))
            good++
    }
    return good >= 2
}
TryTrackPx(px) {
    cr := (px >> 16) & 0xFF, cg := (px >> 8) & 0xFF, cb := px & 0xFF
    return (cr + 16 >= cb && cr < 70 && cb < 70 && cg >= 18 && (cg < 40 || (cg < 48 && cr >= cg)))
}
TryGapBright(p, a, b) {
    global CaptureW
    if (a > b || (b - a + 1) > 0.06 * CaptureW)
        return false
    total := b - a + 1
    bright := 0
    x := a
    while (x <= b) {
        if (((NumGet(p + 4 * x, 0, "UInt") >> 16) & 0xFF) >= 140)
            bright++
        x++
    }
    if (bright = total)
        return true
    return (total <= 0.03 * CaptureW && bright >= 2 && 5 * bright >= total)
}
TryhardScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, WindowHeight, LastFishX
    global TryScanned, TryFound, TryFishX, TryBarL, TryBarW, TryPrmReady
    global TryhardBarColors, TryhardFishColors, TryhardTrackColors, TryExB, TryExF, TryExT
    global TryPrm1, TryPrm1I, TryPrm2, TryPrm2I, TryPrm3, TryPrm3I, TryPrmF, TryPrmFI, TryPrmT, TryPrmTI

    ; user colours beyond the built-in defaults
    extras := []
    for _, item in [[TryhardBarColors, [0x33030B, 0x5F020A, 0xBE0C0E]]
                  , [TryhardFishColors, [0x2F020C]]
                  , [TryhardTrackColors, [0x3A0608]]] {
        out := ""
        src := ColExpand(item[1])
        Loop, Parse, src, `,;|%A_Space%, %A_Space%%A_Tab%
        {
            v := ColNorm(A_LoopField)
            if (v < 0)
                continue
            isBuiltin := false
            for _, bv in item[2]
                if (v = bv)
                    isBuiltin := true
            if (isBuiltin)
                continue
            out .= (out = "" ? "" : ",") . Format("0x{:06X}", v)
        }
        extras.Push(out)
    }
    TryExB := extras[1], TryExF := extras[2], TryExT := extras[3]
    if (ColCount(TryExB) > 0 || ColCount(TryExF) > 0 || ColCount(TryExT) > 0)
        return TryhardScanX()

    if (TryScanned)
        return TryFound
    TryScanned := true
    TryFound := false
    TryFishX := -1
    W := CaptureW, H := CaptureH
    if (!pCaptureBits || W < 40 || H < 6)
        return false

    if (!TryPrmReady) {
        PcSetPrm(TryPrm1, "0x33030B", 14, 0, 0), PcSetPrm(TryPrm1I, "0x33030B", 14, 0, 1)
        PcSetPrm(TryPrm2, "0x5F020A", 30, 0, 0), PcSetPrm(TryPrm2I, "0x5F020A", 30, 0, 1)
        PcSetPrm(TryPrm3, "0xBE0C0E", 66, 0, 0), PcSetPrm(TryPrm3I, "0xBE0C0E", 66, 0, 1)
        PcSetPrm(TryPrmF, "0x2F020C", 14, 0, 0), PcSetPrm(TryPrmFI, "0x2F020C", 14, 0, 1)
        PcSetPrm(TryPrmT, "0x3A0608", 14, 0, 0), PcSetPrm(TryPrmTI, "0x3A0608", 14, 0, 1)
        TryPrmReady := true
    }

    rowStride := W * 4
    fMaxW := Round(0.02 * W)
    fNear := Round(0.003 * W) + 1

    ; fish marker rows sit just above the capture origin
    cands := []
    for tag, frac in [0.0028, 0.0049, 0.0069] {
        off := Round(WindowHeight * frac)
        if (off < 1 || off > 17)
            continue
        runs := []
        TryRowRuns(pCaptureBits - off * rowStride, TryPrmF, TryPrmFI, 1, runs)
        for _, r in runs {
            rw := r[2] - r[1] + 1
            if (rw >= 3 && rw <= fMaxW)
                cands.Push([(r[1] + r[2]) / 2, tag])
        }
    }
    fishC := -1, bestD := 0
    for _, c in cands {
        tags := {}
        tags[c[2]] := 1
        for _, d in cands
            if (Abs(d[1] - c[1]) <= fNear)
                tags[d[2]] := 1
        if ((tags.HasKey(1) ? 1 : 0) + (tags.HasKey(2) ? 1 : 0) + (tags.HasKey(3) ? 1 : 0) < 2)
            continue
        dist := (LastFishX >= 0) ? Abs(FishBarLeft + c[1] - LastFishX) : Abs(c[1] - W / 2)
        if (fishC < 0 || dist < bestD)
            fishC := c[1], bestD := dist
    }
    if (fishC >= 0) {
        TryFishX := FishBarLeft + fishC
        LastFishX := TryFishX
    }

    ; bar span on three rows
    bGap := Round(0.006 * W)
    bMinW := Round(0.02 * W)
    if (bMinW < 12)
        bMinW := 12
    lefts := [], rights := []
    for _, frac in [0.30, 0.50, 0.70] {
        row := pCaptureBits + Floor(frac * H) * rowStride
        runs := []
        TryRowRuns(row, TryPrm1, TryPrm1I, 0, runs)
        TryRowRuns(row, TryPrm2, TryPrm2I, 0, runs)
        TryRowRuns(row, TryPrm3, TryPrm3I, 0, runs)
        i := 2
        while (i <= runs.Length()) {
            cur := runs[i]
            j := i - 1
            while (j >= 1 && runs[j][1] > cur[1]) {
                runs[j + 1] := runs[j]
                j--
            }
            runs[j + 1] := cur
            i++
        }
        spA := -1, spB := -1
        if (runs.Length()) {
            sS := runs[1][1], sE := runs[1][2]
            k := 2
            while (k <= runs.Length()) {
                ra := runs[k][1], rb := runs[k][2]
                if ((ra - sE - 1) <= bGap || TryGapBright(row, sE + 1, ra - 1)) {
                    if (rb > sE)
                        sE := rb
                } else {
                    if ((sE - sS) > (spB - spA))
                        spA := sS, spB := sE
                    sS := ra, sE := rb
                }
                k++
            }
            if ((sE - sS) > (spB - spA))
                spA := sS, spB := sE
        }
        if (spA >= 0 && (spB - spA + 1) >= bMinW && (spB - spA + 1) <= 0.6 * W)
            lefts.Push(spA), rights.Push(spB)
    }
    if (lefts.Length() < 2)
        return false
    if (lefts.Length() = 3)
        barA := MedianOf(lefts), barB := MedianOf(rights)
    else
        barA := Max(lefts[1], lefts[2]), barB := Min(rights[1], rights[2])

    ; dark-red track must border the bar
    tOff := Round(0.006 * W) + 2
    trkL := TryTrackAt(barA - tOff)
    trkR := TryTrackAt(barB + tOff)
    if (!(trkL || barA - tOff < 0) || !(trkR || barB + tOff >= W) || !(trkL || trkR))
        return false

    ; a fish marker sitting on a dark bar edge pulls that edge in
    if (fishC >= 0) {
        row := pCaptureBits + Floor(0.50 * H) * rowStride
        redSum := 0
        k := 2
        while (k <= 9) {
            sx := Round(barA + (barB - barA) * k / 10)
            redSum += (NumGet(row + 4 * sx, 0, "UInt") >> 16) & 0xFF
            k++
        }
        if (redSum <= 720) {
            ph := Round(0.006 * W)
            if (fishC >= barA - ph && fishC <= barA + ph + 2)
                barA := Round(fishC + ph + 1)
            else if (fishC >= barB - ph - 2 && fishC <= barB + ph)
                barB := Round(fishC - ph - 1)
        }
    }
    if (barB - barA + 1 < bMinW)
        return false

    ; fallback 1: dark notch inside a reddish bar
    if (fishC < 0) {
        cands := []
        for tag, frac in [0.30, 0.50, 0.70] {
            row := pCaptureBits + Floor(frac * H) * rowStride
            nRed := 0, sumRed := 0
            x := barA + 2
            while (x <= barB - 2) {
                px := NumGet(row + 4 * x, 0, "UInt")
                cr := (px >> 16) & 0xFF, cg := (px >> 8) & 0xFF, cb := px & 0xFF
                if (cr > cg + 60 && cr > cb + 60)
                    nRed++, sumRed += cr
                x++
            }
            if (nRed < 8)
                continue
            refRed := sumRed / nRed
            if (refRed < 110)
                continue
            runS := -1
            x := barA + 2
            while (x <= barB - 1) {
                isDark := false
                if (x < barB - 1) {
                    px := NumGet(row + 4 * x, 0, "UInt")
                    isDark := (((px >> 16) & 0xFF) < 0.72 * refRed && ((px >> 8) & 0xFF) < 40 && (px & 0xFF) < 40)
                }
                if (isDark) {
                    if (runS < 0)
                        runS := x
                } else if (runS >= 0) {
                    rw := x - runS
                    if (rw >= 3 && rw <= fMaxW) {
                        pen := (runS <= barA + 2 || x >= barB - 1) ? 100000 : 0
                        cands.Push([(runS + x - 1) / 2, tag, pen])
                    }
                    runS := -1
                }
                x++
            }
        }
        for _, c in cands {
            tags := {}
            tags[c[2]] := 1
            for _, d in cands
                if (Abs(d[1] - c[1]) <= fNear)
                    tags[d[2]] := 1
            if ((tags.HasKey(1) ? 1 : 0) + (tags.HasKey(2) ? 1 : 0) + (tags.HasKey(3) ? 1 : 0) < 2)
                continue
            dist := ((LastFishX >= 0) ? Abs(FishBarLeft + c[1] - LastFishX) : Abs(c[1] - (barA + barB) / 2)) + c[3]
            if (fishC < 0 || dist < bestD)
                fishC := c[1], bestD := dist
        }
        if (fishC >= 0) {
            TryFishX := FishBarLeft + fishC
            LastFishX := TryFishX
        }
    }

    ; fallback 2: track-coloured run framed by track pixels, away from the bar
    if (fishC < 0) {
        edgeK := Round(0.003 * W) + 2
        cands := []
        for tag, frac in [0.30, 0.50, 0.70] {
            row := pCaptureBits + Floor(frac * H) * rowStride
            runs := []
            TryRowRuns(row, TryPrmT, TryPrmTI, 1, runs)
            for _, r in runs {
                rs := r[1], re := r[2]
                rw := re - rs + 1
                if (rw < 2 || rw > fMaxW)
                    continue
                if (re >= barA - tOff && rs <= barB + tOff)
                    continue
                if (rs - edgeK < 0 || re + edgeK >= W)
                    continue
                if (TryTrackPx(NumGet(row + 4 * (rs - edgeK), 0, "UInt")) && TryTrackPx(NumGet(row + 4 * (re + edgeK), 0, "UInt")))
                    cands.Push([(rs + re) / 2, tag])
            }
        }
        for _, c in cands {
            tags := {}
            tags[c[2]] := 1
            for _, d in cands
                if (Abs(d[1] - c[1]) <= fNear)
                    tags[d[2]] := 1
            if ((tags.HasKey(1) ? 1 : 0) + (tags.HasKey(2) ? 1 : 0) + (tags.HasKey(3) ? 1 : 0) < 2)
                continue
            dist := (LastFishX >= 0) ? Abs(FishBarLeft + c[1] - LastFishX) : Abs(c[1] - (barA + barB) / 2)
            if (fishC < 0 || dist < bestD)
                fishC := c[1], bestD := dist
        }
        if (fishC >= 0) {
            TryFishX := FishBarLeft + fishC
            LastFishX := TryFishX
        }
    }

    TryBarL := FishBarLeft + barA
    TryBarW := barB - barA + 1
    TryFound := true
    return true
}
TryExtra(lst, normal) {
	if (Trim(lst) = "")
		return ""
	n := ColorListParse(normal)
	l := ColorListParse(lst)
	out := ""
	Loop % l.n
		{
		i := A_Index, same := false
		Loop % n.n
			{
			if (l.r[i] = n.r[A_Index] and l.g[i] = n.g[A_Index] and l.b[i] = n.b[A_Index])
				{
				same := true
				break
				}
			}
		if (!same)
			out .= ((out = "") ? "" : ",") . Format("0x{:02X}{:02X}{:02X}", l.r[i], l.g[i], l.b[i])
		}
	return out
}

TryhardScanX() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, WindowHeight, LastFishX
    global TryScanned, TryFound, TryFishX, TryBarL, TryBarW, TryPrmReady
    global TryExB, TryExF, TryExT, TryhardBarTol, TryhardFishTol, TryXKey, TryXBuf, TryXNB, TryXNF
    global TryPrm1, TryPrm1I, TryPrm2, TryPrm2I, TryPrm3, TryPrm3I, TryPrmF, TryPrmFI, TryPrmT, TryPrmTI

    if (TryScanned)
        return TryFound
    TryScanned := true
    TryFound := false
    TryFishX := -1
    W := CaptureW, H := CaptureH
    if (!pCaptureBits || W < 40 || H < 6)
        return false

    if (!TryPrmReady) {
        PcSetPrm(TryPrm1, "0x33030B", 14, 0, 0), PcSetPrm(TryPrm1I, "0x33030B", 14, 0, 1)
        PcSetPrm(TryPrm2, "0x5F020A", 30, 0, 0), PcSetPrm(TryPrm2I, "0x5F020A", 30, 0, 1)
        PcSetPrm(TryPrm3, "0xBE0C0E", 66, 0, 0), PcSetPrm(TryPrm3I, "0xBE0C0E", 66, 0, 1)
        PcSetPrm(TryPrmF, "0x2F020C", 14, 0, 0), PcSetPrm(TryPrmFI, "0x2F020C", 14, 0, 1)
        PcSetPrm(TryPrmT, "0x3A0608", 14, 0, 0), PcSetPrm(TryPrmTI, "0x3A0608", 14, 0, 1)
        TryPrmReady := true
    }

    ; rebuild the extra-colour blocks only when the inputs changed
    key := TryExB "|" TryhardBarTol "|" TryExF "|" TryhardFishTol "|" TryExT
    if (key != TryXKey) {
        TryXKey := key
        barList := ColorListParse(TryExB)
        fishList := ColorListParse(TryExF)
        trackList := ColorListParse(TryExT)
        TryXNB := Min(9, barList.n)
        TryXNF := Min(9, fishList.n)
        VarSetCapacity(TryXBuf, 48 * (TryXNB + TryXNF + 1), 0)
        Loop % TryXNB
            PcPrmAt(&TryXBuf + 48 * (A_Index - 1), barList.r[A_Index], barList.g[A_Index], barList.b[A_Index]
                , RodCap(barList, A_Index, trackList, RodTol(TryhardBarTol)), 0)
        Loop % TryXNF
            PcPrmAt(&TryXBuf + 48 * (TryXNB + A_Index - 1), fishList.r[A_Index], fishList.g[A_Index], fishList.b[A_Index]
                , RodTol(TryhardFishTol), 0)
    }

    rowStride := W * 4
    fMaxW := Round(0.02 * W)
    fNear := Round(0.003 * W) + 1

    cands := []
    for tag, frac in [0.0028, 0.0049, 0.0069] {
        off := Round(WindowHeight * frac)
        if (off < 1 || off > 17)
            continue
        row := pCaptureBits - off * rowStride
        runs := []
        TryRowRuns(row, TryPrmF, TryPrmFI, 1, runs)
        Loop % TryXNF
            TryRowRunsAt(row, &TryXBuf + 48 * (TryXNB + A_Index - 1), 1, runs)
        if (TryXNF > 0) {
            merged := TryRunsMerge(runs, 1)
            if (IsObject(merged))
                runs := merged
        }
        for _, r in runs {
            rw := r[2] - r[1] + 1
            if (rw >= 3 && rw <= fMaxW)
                cands.Push([(r[1] + r[2]) / 2, tag])
        }
    }
    ; extra fish colours: require a fish line through the candidate
    if (TryXNF > 0) {
        lineK := Round(0.012 * W) + 2
        filtered := []
        for _, c in cands
            if (TryFishLineAt(Round(c[1]), lineK))
                filtered.Push(c)
        cands := filtered
    }
    fishC := -1, bestD := 0
    for _, c in cands {
        tags := {}
        tags[c[2]] := 1
        for _, d in cands
            if (Abs(d[1] - c[1]) <= fNear)
                tags[d[2]] := 1
        if ((tags.HasKey(1) ? 1 : 0) + (tags.HasKey(2) ? 1 : 0) + (tags.HasKey(3) ? 1 : 0) < 2)
            continue
        dist := (LastFishX >= 0) ? Abs(FishBarLeft + c[1] - LastFishX) : Abs(c[1] - W / 2)
        if (fishC < 0 || dist < bestD)
            fishC := c[1], bestD := dist
    }
    if (fishC >= 0) {
        TryFishX := FishBarLeft + fishC
        LastFishX := TryFishX
    }

    bGap := Round(0.006 * W)
    bMinW := Round(0.02 * W)
    if (bMinW < 12)
        bMinW := 12
    lefts := [], rights := []
    for _, frac in [0.30, 0.50, 0.70] {
        row := pCaptureBits + Floor(frac * H) * rowStride
        runs := []
        TryRowRuns(row, TryPrm1, TryPrm1I, 0, runs)
        TryRowRuns(row, TryPrm2, TryPrm2I, 0, runs)
        TryRowRuns(row, TryPrm3, TryPrm3I, 0, runs)
        Loop % TryXNB
            TryRowRunsAt(row, &TryXBuf + 48 * (A_Index - 1), 0, runs)
        i := 2
        while (i <= runs.Length()) {
            cur := runs[i]
            j := i - 1
            while (j >= 1 && runs[j][1] > cur[1]) {
                runs[j + 1] := runs[j]
                j--
            }
            runs[j + 1] := cur
            i++
        }
        spA := -1, spB := -1
        if (runs.Length()) {
            sS := runs[1][1], sE := runs[1][2]
            k := 2
            while (k <= runs.Length()) {
                ra := runs[k][1], rb := runs[k][2]
                if ((ra - sE - 1) <= bGap || TryGapBright(row, sE + 1, ra - 1)) {
                    if (rb > sE)
                        sE := rb
                } else {
                    if ((sE - sS) > (spB - spA))
                        spA := sS, spB := sE
                    sS := ra, sE := rb
                }
                k++
            }
            if ((sE - sS) > (spB - spA))
                spA := sS, spB := sE
        }
        if (spA >= 0 && (spB - spA + 1) >= bMinW && (spB - spA + 1) <= 0.6 * W)
            lefts.Push(spA), rights.Push(spB)
    }
    if (lefts.Length() < 2)
        return false
    if (lefts.Length() = 3)
        barA := MedianOf(lefts), barB := MedianOf(rights)
    else
        barA := Max(lefts[1], lefts[2]), barB := Min(rights[1], rights[2])

    tOff := Round(0.006 * W) + 2
    trkL := TryTrackAtX(barA - tOff)
    trkR := TryTrackAtX(barB + tOff)
    if (!(trkL || barA - tOff < 0) || !(trkR || barB + tOff >= W) || !(trkL || trkR))
        return false

    if (fishC >= 0) {
        row := pCaptureBits + Floor(0.50 * H) * rowStride
        redSum := 0
        k := 2
        while (k <= 9) {
            sx := Round(barA + (barB - barA) * k / 10)
            redSum += (NumGet(row + 4 * sx, 0, "UInt") >> 16) & 0xFF
            k++
        }
        if (redSum <= 720) {
            ph := Round(0.006 * W)
            if (fishC >= barA - ph && fishC <= barA + ph + 2)
                barA := Round(fishC + ph + 1)
            else if (fishC >= barB - ph - 2 && fishC <= barB + ph)
                barB := Round(fishC - ph - 1)
        }
    }
    if (barB - barA + 1 < bMinW)
        return false

    ; fallback 1: dark notch inside a reddish bar
    if (fishC < 0) {
        cands := []
        for tag, frac in [0.30, 0.50, 0.70] {
            row := pCaptureBits + Floor(frac * H) * rowStride
            nRed := 0, sumRed := 0
            x := barA + 2
            while (x <= barB - 2) {
                px := NumGet(row + 4 * x, 0, "UInt")
                cr := (px >> 16) & 0xFF, cg := (px >> 8) & 0xFF, cb := px & 0xFF
                if (cr > cg + 60 && cr > cb + 60)
                    nRed++, sumRed += cr
                x++
            }
            if (nRed < 8)
                continue
            refRed := sumRed / nRed
            if (refRed < 110)
                continue
            runS := -1
            x := barA + 2
            while (x <= barB - 1) {
                isDark := false
                if (x < barB - 1) {
                    px := NumGet(row + 4 * x, 0, "UInt")
                    isDark := (((px >> 16) & 0xFF) < 0.72 * refRed && ((px >> 8) & 0xFF) < 40 && (px & 0xFF) < 40)
                }
                if (isDark) {
                    if (runS < 0)
                        runS := x
                } else if (runS >= 0) {
                    rw := x - runS
                    if (rw >= 3 && rw <= fMaxW) {
                        pen := (runS <= barA + 2 || x >= barB - 1) ? 100000 : 0
                        cands.Push([(runS + x - 1) / 2, tag, pen])
                    }
                    runS := -1
                }
                x++
            }
        }
        for _, c in cands {
            tags := {}
            tags[c[2]] := 1
            for _, d in cands
                if (Abs(d[1] - c[1]) <= fNear)
                    tags[d[2]] := 1
            if ((tags.HasKey(1) ? 1 : 0) + (tags.HasKey(2) ? 1 : 0) + (tags.HasKey(3) ? 1 : 0) < 2)
                continue
            dist := ((LastFishX >= 0) ? Abs(FishBarLeft + c[1] - LastFishX) : Abs(c[1] - (barA + barB) / 2)) + c[3]
            if (fishC < 0 || dist < bestD)
                fishC := c[1], bestD := dist
        }
        if (fishC >= 0) {
            TryFishX := FishBarLeft + fishC
            LastFishX := TryFishX
        }
    }

    ; fallback 2: track-coloured run framed by track pixels, away from the bar
    if (fishC < 0) {
        edgeK := Round(0.003 * W) + 2
        cands := []
        for tag, frac in [0.30, 0.50, 0.70] {
            row := pCaptureBits + Floor(frac * H) * rowStride
            runs := []
            TryRowRuns(row, TryPrmT, TryPrmTI, 1, runs)
            for _, r in runs {
                rs := r[1], re := r[2]
                rw := re - rs + 1
                if (rw < 2 || rw > fMaxW)
                    continue
                if (re >= barA - tOff && rs <= barB + tOff)
                    continue
                if (rs - edgeK < 0 || re + edgeK >= W)
                    continue
                if (TryTrackPx(NumGet(row + 4 * (rs - edgeK), 0, "UInt")) && TryTrackPx(NumGet(row + 4 * (re + edgeK), 0, "UInt")))
                    cands.Push([(rs + re) / 2, tag])
            }
        }
        for _, c in cands {
            tags := {}
            tags[c[2]] := 1
            for _, d in cands
                if (Abs(d[1] - c[1]) <= fNear)
                    tags[d[2]] := 1
            if ((tags.HasKey(1) ? 1 : 0) + (tags.HasKey(2) ? 1 : 0) + (tags.HasKey(3) ? 1 : 0) < 2)
                continue
            dist := (LastFishX >= 0) ? Abs(FishBarLeft + c[1] - LastFishX) : Abs(c[1] - (barA + barB) / 2)
            if (fishC < 0 || dist < bestD)
                fishC := c[1], bestD := dist
        }
        if (fishC >= 0) {
            TryFishX := FishBarLeft + fishC
            LastFishX := TryFishX
        }
    }

    TryBarL := FishBarLeft + barA
    TryBarW := barB - barA + 1
    TryFound := true
    return true
}
SwLog(m) {
	global SwLogOn
	static f := ""
	if (!SwLogOn)
		return
	if (f = "")
		{
		f := A_ScriptDir . "\stellarwave_log.txt"
		FileGetSize, sz, %f%
		if (!ErrorLevel and sz > 2000000)
			FileDelete, %f%
		FileAppend, % "---- " . A_Now . "`n", %f%
		}
	FileAppend, % Format("{:.3f} ", SwNow()) . m . "`n", %f%
}

SwSetup() {
    global SwZ, SwFrR, SwFrG, SwFrB, SwFrTol, SwTpl, SwTplF, SwTplFBuf, SwGradDef
    global SwWSign, SwStarV, SwStarT, SwLockFail, SwLockN, SwColKey, SwXBarN, SwXCapN, SwXHdN
    global SwPitchRef, SwPitchRefH, SwStarYRef, SwStarYRefH, SwCacheW, SwCacheH, SwCacheSB, SwCacheFrH, SwCacheFrT, SwReady
    global SwPrmBk, SwPrmBkI, SwPrmCap, SwPrmCapI, SwPrmWh, SwPrmWhI, SwPrmHd, SwPrmHdI
    global SwPrmCore, SwPrmCoreI, SwPrmStU, SwPrmStUI

    ; DATA BLOB: paste the original 3072-byte template (6144 hex digits) and the
    ; 192-byte gradient table (384 hex digits) here. Missing bytes read as 0.
    SwTplHex := ""
    SwGradHex := ""

    VarSetCapacity(SwTpl, 3072, 0)
    VarSetCapacity(SwTplFBuf, 3072 * 8, 0)
    SwTplF := []
    Loop 3072 {
        hx := SubStr(SwTplHex, 2 * A_Index - 1, 2)
        byteV := (StrLen(hx) = 2) ? VxHexNum(hx) : 0
        NumPut(byteV, SwTpl, A_Index - 1, "UChar")
        fv := byteV / 255.0
        SwTplF[A_Index] := fv
        NumPut(fv, SwTplFBuf, (A_Index - 1) * 8, "Double")
    }

    VarSetCapacity(SwGradDef, 192, 0)
    Loop 192 {
        hx := SubStr(SwGradHex, 2 * A_Index - 1, 2)
        NumPut((StrLen(hx) = 2) ? VxHexNum(hx) : 0, SwGradDef, A_Index - 1, "UChar")
    }

    SwZ := ["Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius", "Capricorn", "Aquarius", "Pisces"]

    SwFrR := 85, SwFrG := 68, SwFrB := 109
    SwFrTol := 26
    SwSetFrame(85, 68, 109)

    PcSetPrm(SwPrmBk, "0x000000", 45, 0, 0), PcSetPrm(SwPrmBkI, "0x000000", 45, 0, 1)
    PcSetPrm(SwPrmCap, "0xAFDAE8", 22, 0, 0), PcSetPrm(SwPrmCapI, "0xAFDAE8", 22, 0, 1)
    PcSetPrm(SwPrmWh, "0xFFFFFF", 30, 0, 0), PcSetPrm(SwPrmWhI, "0xFFFFFF", 30, 0, 1)
    PcSetPrm(SwPrmHd, "0xFFFFFF", 30, 0, 0), PcSetPrm(SwPrmHdI, "0xFFFFFF", 30, 0, 1)
    PcSetPrm(SwPrmCore, "0x7E5CA6", 22, 0, 0), PcSetPrm(SwPrmCoreI, "0x7E5CA6", 22, 0, 1)
    PcSetPrm(SwPrmStU, "0x3C1C60", 30, 0, 0), PcSetPrm(SwPrmStUI, "0x3C1C60", 30, 0, 1)

    SwWSign := 0
    SwStarV := []
    SwStarT := []
    Loop 12 {
        SwStarV.Push(0)
        SwStarT.Push(0)
    }
    SwLockFail := false
    SwLockN := 0
    SwColKey := ""
    SwXBarN := 0, SwXCapN := 0, SwXHdN := 0
    SwPitchRef := -1, SwPitchRefH := -1, SwStarYRef := -1, SwStarYRefH := -1
    SwCacheW := -1, SwCacheH := -1
    SwCacheSB := 0
    SwCacheFrH := -1, SwCacheFrT := -1
    SwReady := true
}
SwSetFrame(r, g, b) {
    global SwPrmFr, SwPrmFrI, SwFrTol
    hexCol := Format("0x{:02X}{:02X}{:02X}", r, g, b)
    PcSetPrm(SwPrmFr, hexCol, SwFrTol, 0, 0)
    PcSetPrm(SwPrmFrI, hexCol, SwFrTol, 0, 1)
}
SwColsGet() {
	global StellarBarColors, StellarBarTol, StellarFishColors, StellarFishTol, StellarHeadColors, StellarHeadTol
	return StellarBarColors . "|" . StellarBarTol . "|" . StellarFishColors . "|" . StellarFishTol . "|" . StellarHeadColors . "|" . StellarHeadTol
}

SwColsSet(v) {
	global StellarBarColors, StellarBarTol, StellarFishColors, StellarFishTol, StellarHeadColors, StellarHeadTol
	p := StrSplit(v, "|")
	StellarBarColors := p[1], StellarBarTol := p[2], StellarFishColors := p[3], StellarFishTol := p[4], StellarHeadColors := p[5], StellarHeadTol := p[6]
}

SwTolOf(v, d) {
    if v is not number
        return d
    t := Round(v)
    if (t < 0)
        t := 0
    if (t > 255)
        t := 255
    return t
}
SwXFill(ByRef buf, o, tol) {
    cnt := o.n - 1
    if (cnt > 8)
        cnt := 8
    VarSetCapacity(buf, 48 * 8, 0)
    i := 1
    while (i <= cnt) {
        PcPrmAt(&buf + 48 * (i - 1), o.r[i + 1], o.g[i + 1], o.b[i + 1], tol, 0)
        i++
    }
    return cnt > 0 ? cnt : 0
}
SwApplyColours() {
    global StellarBarColors, StellarBarTol, StellarFishColors, StellarFishTol, StellarHeadColors, StellarHeadTol
    global SwColKey, SwFrR, SwFrG, SwFrB, SwFrTol, SwFrLearned
    global SwPrmCap, SwPrmCapI, SwPrmHd, SwPrmHdI
    global SwXBar, SwXBarN, SwXCap, SwXCapN, SwXHd, SwXHdN
    key := StellarBarColors "|" StellarBarTol "|" StellarFishColors "|" StellarFishTol "|" StellarHeadColors "|" StellarHeadTol
    if (key == SwColKey)
        return
    SwColKey := key
    barTol := SwTolOf(StellarBarTol, 26)
    fishTol := SwTolOf(StellarFishTol, 22)
    headTol := SwTolOf(StellarHeadTol, 30)

    ; bar / frame colour
    lst := ColorListParse(ColCount(StellarBarColors) >= 1 ? StellarBarColors : "0x55446D")
    SwFrR := lst.r[1], SwFrG := lst.g[1], SwFrB := lst.b[1]
    SwFrTol := barTol
    SwSetFrame(SwFrR, SwFrG, SwFrB)
    SwFrLearned := false
    SwXBarN := SwXFill(SwXBar, lst, barTol)

    ; fish colour
    lst := ColorListParse(ColCount(StellarFishColors) >= 1 ? StellarFishColors : "0xAFDAE8")
    hexCol := Format("0x{:02X}{:02X}{:02X}", lst.r[1], lst.g[1], lst.b[1])
    PcSetPrm(SwPrmCap, hexCol, fishTol, 0, 0)
    PcSetPrm(SwPrmCapI, hexCol, fishTol, 0, 1)
    SwXCapN := SwXFill(SwXCap, lst, fishTol)

    ; head colour
    lst := ColorListParse(ColCount(StellarHeadColors) >= 1 ? StellarHeadColors : "0xFFFFFF")
    hexCol := Format("0x{:02X}{:02X}{:02X}", lst.r[1], lst.g[1], lst.b[1])
    PcSetPrm(SwPrmHd, hexCol, headTol, 0, 0)
    PcSetPrm(SwPrmHdI, hexCol, headTol, 0, 1)
    SwXHdN := SwXFill(SwXHd, lst, headTol)

    SwLog(Format("colours bar {},{},{}+{} tol {}  fish +{} tol {}  head +{} tol {}"
        , SwFrR, SwFrG, SwFrB, SwXBarN, barTol, SwXCapN, fishTol, SwXHdN, headTol))
}
SwRunsAt(p, x0, x1, a, gap, rr) {
    x := x0
    curS := -1, curE := -1
    found := 0
    while (x <= x1 && found < 60) {
        i := PcFindAt(p + 4 * x, x1 - x + 1, 4, a)
        if (i < 0)
            break
        s := x + i
        j := PcFindAt(p + 4 * (s + 1), x1 - s, 4, a + 24)
        e := (j < 0) ? x1 : s + j
        found++
        if (curS >= 0 && (s - curE - 1) <= gap) {
            curE := e
        } else {
            if (curS >= 0)
                rr.Push([curS, curE])
            curS := s, curE := e
        }
        x := e + 1
    }
    if (curS >= 0)
        rr.Push([curS, curE])
}
SwRunsX(p, x0, x1, a, n, gap, rr) {
	Loop % n
		SwRunsAt(p, x0, x1, a + (A_Index - 1) * 48, gap, rr)
	TryRunsMerge(rr, gap)
}

SwColScan(x, y0, y1, need, span, aN, aI) {
    ; walk down one column looking for a start-colour run followed by a bright pixel
    global pCaptureBits, CaptureW
    y := y0
    while (y <= y1 - need) {
        hit := PcFindAt(pCaptureBits + (y * CaptureW + x) * 4, y1 - y + 1, CaptureW * 4, aN)
        if (hit < 0)
            return -1
        y += hit
        brk := (y < y1) ? PcFindAt(pCaptureBits + ((y + 1) * CaptureW + x) * 4, y1 - y, CaptureW * 4, aI) : -1
        runLen := (brk < 0) ? (y1 - y + 1) : (brk + 1)
        if (runLen >= need) {
            below := y + runLen
            k2 := 0
            while (k2 < span && below + k2 <= y1) {
                if (SwLum(pCaptureBits + ((below + k2) * CaptureW + x) * 4) >= 240)
                    return y
                k2++
            }
        }
        y += runLen
    }
    return -1
}
SwNow() {
	global QpcFreq
	DllCall("QueryPerformanceCounter", "Int64*", t)
	return t / QpcFreq
}

SwLum(p) {
	px := NumGet(p + 0, 0, "UInt")
	return ((px >> 16) & 0xFF) + 2 * ((px >> 8) & 0xFF) + (px & 0xFF)
}

SwMedian(arr) {
    cnt := arr.Length()
    if (cnt < 1)
        return 0
    v := []
    for _, item in arr
        v.Push(item)
    ; insertion sort, ascending
    i := 2
    while (i <= cnt) {
        key := v[i]
        j := i - 1
        while (j >= 1 && v[j] > key) {
            v[j + 1] := v[j]
            j--
        }
        v[j + 1] := key
        i++
    }
    if (Mod(cnt, 2) = 1)
        return v[(cnt + 1) // 2]
    return (v[cnt // 2] + v[cnt // 2 + 1]) / 2
}
SwRuns(p, x0, x1, ByRef prm, ByRef prmI, gap, rr) {
    ; horizontal runs on one row, joining runs separated by at most gap pixels
    x := x0, openS := -1, openE := -1, starts := 0
    while (x <= x1 && starts < 60) {
        hit := PcFind(p + x * 4, x1 - x + 1, 4, prm)
        if (hit < 0)
            break
        s := x + hit
        brk := (s < x1) ? PcFind(p + (s + 1) * 4, x1 - s, 4, prmI) : -1
        e := (brk < 0) ? x1 : s + brk
        starts++
        if (openS >= 0 && (s - openE - 1) <= gap) {
            openE := e
        } else {
            if (openS >= 0)
                rr.Push([openS, openE])
            openS := s, openE := e
        }
        x := e + 1
    }
    if (openS >= 0)
        rr.Push([openS, openE])
}
SwCover(rr, a, b) {
    total := 0
    for _, r in rr {
        lo := (r[1] > a) ? r[1] : a
        hi := (r[2] < b) ? r[2] : b
        if (hi >= lo)
            total += hi - lo + 1
    }
    return total
}
SwGlowAdd(x, now) {
    global SwGlowX, SwGlowT
    if !IsObject(SwGlowX) {
        SwGlowX := []
        SwGlowT := []
    }
    SwGlowX.Push(x)
    SwGlowT.Push(now)
    while (SwGlowX.Length() > 8) {
        SwGlowX.RemoveAt(1)
        SwGlowT.RemoveAt(1)
    }
}
SwGlowZones(now) {
    global SwGlowX, SwGlowT, SwPitch, SwZL, SwZH
    SwZL := []
    SwZH := []
    if !IsObject(SwGlowX)
        return 0
    los := [], his := []
    for idx, gx in SwGlowX {
        age := now - SwGlowT[idx]
        if (age < 0.55)
            wt := 1.4
        else if (age < 0.7)
            wt := 1.0
        else if (age < 0.85)
            wt := 0.5
        else
            wt := 0
        if (age < 0 || wt <= 0)
            continue
        rad := Round(wt * SwPitch)
        lo := gx - rad, hi := gx + rad
        ; keep the interval lists sorted by their left edge
        pos := los.Length() + 1
        while (pos > 1 && los[pos - 1] > lo)
            pos--
        los.InsertAt(pos, lo)
        his.InsertAt(pos, hi)
    }
    for idx, lo in los {
        hi := his[idx]
        nz := SwZL.Length()
        if (nz > 0 && lo <= SwZH[nz] + 1) {
            if (hi > SwZH[nz])
                SwZH[nz] := hi
        } else {
            SwZL.Push(lo)
            SwZH.Push(hi)
        }
    }
    return SwZL.Length()
}
SwGlowNear(x, h, amax, now) {
    global SwGlowX, SwGlowT, SwPitch
    if !IsObject(SwGlowX)
        return false
    for idx, gx in SwGlowX {
        age := now - SwGlowT[idx]
        if (age >= 0 && age < amax && Abs(gx - x) <= h * SwPitch)
            return true
    }
    return false
}
SwCoverX(rr, a, b) {
    global SwZL, SwZH
    c := SwCover(rr, a, b)
    for idx, zl in SwZL {
        lo := (zl > a) ? zl : a
        hi := (SwZH[idx] < b) ? SwZH[idx] : b
        if (hi >= lo)
            c -= SwCover(rr, lo, hi)
    }
    return c
}
SwZoneLen(a, b) {
    global SwZL, SwZH
    total := 0
    for idx, zl in SwZL {
        lo := (zl > a) ? zl : a
        hi := (SwZH[idx] < b) ? SwZH[idx] : b
        if (hi - lo + 1 >= 0)
            total += hi - lo + 1
    }
    return total
}
SwInZone(x, m) {
    global SwZL, SwZH
    for idx, zl in SwZL {
        if (x >= zl - m && x <= SwZH[idx] + m)
            return true
    }
    return false
}
