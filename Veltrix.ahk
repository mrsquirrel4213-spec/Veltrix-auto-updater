CastboundXActive() {
    global CastboundBarColors, CastboundBarTol, CastboundFishColors, CastboundFishTol
    global CastboundTrackColors, CastboundTrackTol
    static key := "", act := false
    k := CastboundBarColors "|" CastboundBarTol "|" CastboundFishColors "|" CastboundFishTol
        . "|" CastboundTrackColors "|" CastboundTrackTol
    if (k == key)
        return act
    key := k
    act := false
    groups := [[CastboundBarColors, CastboundBarTol], [CastboundSwordX(), CastboundFishTol]
        , [CastboundTrackColors, CastboundTrackTol]]
    for role, grp in groups {
        lst := ColorListParse(grp[1])
        t := RodTol(grp[2])
        i := 1
        while (i <= lst.n && i <= 9) {
            r0 := Max(0, lst.r[i] - t), r1 := Min(255, lst.r[i] + t)
            g0 := Max(0, lst.g[i] - t), g1 := Min(255, lst.g[i] + t)
            b0 := Max(0, lst.b[i] - t), b1 := Min(255, lst.b[i] + t)
            if (role = 1)
                fits := (r0 + g0 + b0 >= 110)
            else if (role = 2)
                fits := (g1 < 90 && b0 > 130 && (b0 - g1) > 80 && r1 < 160)
            else
                fits := ((b0 - g1) > 20 && (r0 - g1) > 5 && r0 + g0 + b0 >= 180 && r1 + g1 + b1 <= 340)
            if (!fits) {
                act := true
                return true
            }
            i++
        }
    }
    return act
}
CastboundSwordX() {
    global CastboundFishColors
    static inp := "", outp := ""
    if (CastboundFishColors == inp)
        return outp
    txt := ""
    cbs := ColExpand(CastboundFishColors)
    Loop, Parse, cbs, `,;| %A_Tab%
    {
        v := ColNorm(A_LoopField)
        if (v < 0 || v = 0x5522A3)
            continue
        txt .= (txt = "" ? "" : ", ") . Format("0x{:06X}", v)
    }
    inp := CastboundFishColors
    outp := txt
    return outp
}
RodLut(ByRef lr, ByRef lg, ByRef lb, bar, barTol, fish, fishTol, trk, trkTol) {
    lr := [], lg := [], lb := []
    Loop 256 {
        lr[A_Index - 1] := 0, lg[A_Index - 1] := 0, lb[A_Index - 1] := 0
    }
    oB := ColorListParse(bar), oF := ColorListParse(fish), oT := ColorListParse(trk)
    groups := [[oB, RodTol(barTol), 0, oF, oT]
        , [oF, RodTol(fishTol), 9, oT, oT]
        , [oT, RodTol(trkTol), 18, oF, oF]]
    for _, grp in groups {
        lst := grp[1]
        k := 1
        while (k <= lst.n && k <= 9) {
            t := RodCap(lst, k, grp[5], RodCap(lst, k, grp[4], grp[2]))
            bit := 1 << (grp[3] + k - 1)
            cr := lst.r[k], cg := lst.g[k], cb := lst.b[k]
            Loop 256 {
                v := A_Index - 1
                if (Abs(v - cr) <= t)
                    lr[v] := lr[v] | bit
                if (Abs(v - cg) <= t)
                    lg[v] := lg[v] | bit
                if (Abs(v - cb) <= t)
                    lb[v] := lb[v] | bit
            }
            k++
        }
    }
}
BarLiveOk(px, po, tol, prev) {
