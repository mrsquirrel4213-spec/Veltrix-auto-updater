FindBarByColor() {
    global BarLeftColor, BarRightColor, BarColorTolerance, BarScanRow, BarColRing, BarColT, QpcFreq
    global CaptureH, CaptureW, FishBarLeft, LastBarL, LastBarR, BarLiveL, BarLiveR, BarLiveMiss
    global BarWLive, BarLiveOnlyAt, MgInPlay, RunLeft, RunWidth
    if (BarLeftColor = "" || BarRightColor = "")
        return false
    W := CaptureW, H := CaptureH
