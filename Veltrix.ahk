	KbLy2 := KbMy + 15
	}
KbLineKeys := ["Up", "Down", "Left", "Right", "Enter", "NumpadEnter", "Esc", "u", "LButton"]
PickHeld := {}
for i, kn in KbLineKeys
	{
	Hotkey, *%kn%, KbLineKeyDown, On
	Hotkey, *%kn% up, KbLineKeyUp, On
	}
Gui, KbLine:New, +AlwaysOnTop -Caption +ToolWindow +E0x20
Gui, KbLine:Color, FF2D55
KbLineSave := false
KbLock := false
KbDrag := ""
KbUWas := false
KbTU := 0
KbTD := 0
KbTL := 0
KbTR := 0
VarSetCapacity(KbClip, 16, 0)
Loop
	{
	if KeyHeld("Esc")
		break
	if (KeyHeld("Enter") or KeyHeld("NumpadEnter"))
		{
		KbLineSave := true
		break
		}
	MouseGetPos, KbMx, KbMy
	KbUNow := KeyHeld("u")
	if (KbUNow and !KbUWas)
		{
		if (!KbLock)
			{
			KbLx := KbMx
			KbLy1 := KbMy
			KbLy2 := KbMy + 2
			NumPut(KbMx, KbClip, 0, "Int")
			NumPut(KbMy, KbClip, 4, "Int")
			NumPut(KbMx + 1, KbClip, 8, "Int")
			NumPut(KbWy + KbWh, KbClip, 12, "Int")
			DllCall("ClipCursor", "Ptr", &KbClip)
			KbLock := true
			}
		else
			{
			KbLy2 := (KbMy > KbLy1 + 2) ? KbMy : KbLy1 + 2
			DllCall("ClipCursor", "Ptr", 0)
			KbLock := false
			}
		}
	KbUWas := KbUNow
	if (KbLock)
		KbLy2 := (KbMy > KbLy1 + 2) ? KbMy : KbLy1 + 2
	KbLb := KeyHeld("LButton")
	if (KbLb and !KbLock)
		{
		if (KbDrag = "")
			{
			if (Abs(KbMx - KbLx) <= 8 and KbMy >= KbLy1 - 8 and KbMy <= KbLy2 + 8)
				{
				if (Abs(KbMy - KbLy1) <= 6)
					KbDrag := "top"
				else if (Abs(KbMy - KbLy2) <= 6)
					KbDrag := "bot"
				else
					{
					KbDrag := "move"
					KbOffX := KbMx - KbLx
					KbOffY := KbMy - KbLy1
					}
				}
			else
				KbDrag := "none"
			}
		if (KbDrag = "top")
			KbLy1 := (KbMy < KbLy2 - 2) ? KbMy : KbLy2 - 2
		else if (KbDrag = "bot")
			KbLy2 := (KbMy > KbLy1 + 2) ? KbMy : KbLy1 + 2
		else if (KbDrag = "move")
			{
			KbLen := KbLy2 - KbLy1
			KbLx := KbMx - KbOffX
			KbLy1 := KbMy - KbOffY
			KbLy2 := KbLy1 + KbLen
			}
		}
	else if (!KbLb)
		KbDrag := ""
	KbSt := KeyHeld("Shift") ? 10 : 1
	if (!KbLock)
		{
		if (KbKeyStep("Up", KbTU))
			{
			KbLy1 -= KbSt
			KbLy2 -= KbSt
			}
		if (KbKeyStep("Down", KbTD))
			{
			KbLy1 += KbSt
			KbLy2 += KbSt
			}
		if (KbKeyStep("Left", KbTL))
			KbLx -= KbSt
		if (KbKeyStep("Right", KbTR))
			KbLx += KbSt
		}
	KbLh := KbLy2 - KbLy1 + 1
	KbShowX := KbLx - 1
	Gui, KbLine:Show, x%KbShowX% y%KbLy1% w3 h%KbLh% NoActivate
	KbTipX := KbLx + 18
	if (KbLock)
		VxPickTip("Move the mouse down to the BOTTOM of the bar`nand press U again (the cursor is locked to the line)", KbTipX, KbLy1)
	else
		VxPickTip("Power line: " . KbLh . " px tall`nDrag the line to move it`nDrag its top or bottom end to make it taller / shorter`nU - press on the top of the bar, then U again on the bottom`nArrow keys - nudge it (Shift = 10 px)`nEnter - save     Esc - cancel", KbTipX, KbLy1)
	Sleep 15
	}
DllCall("ClipCursor", "Ptr", 0)
while (KeyHeld("Enter") or KeyHeld("NumpadEnter") or KeyHeld("Esc") or KeyHeld("LButton"))
	Sleep 20
for i, kn in KbLineKeys
	{
	Hotkey, *%kn%, KbLineKeyDown, Off
	Hotkey, *%kn% up, KbLineKeyUp, Off
	}
PickHeld := {}
Gui, KbLine:Destroy
VxPickTip("")
CoordMode, Mouse, Client
CoordMode, ToolTip, Relative
if (KbLineSave)
	{
	KbCx := KbLx - KbWx
	KbCy1 := KbLy1 - KbWy
	KbCy2 := KbLy2 - KbWy
	if (KbCx < 0 or KbCy1 < 0 or KbCx >= KbWw or KbCy2 >= KbWh)
		msgbox, 4144, Veltrix, That line is outside the Roblox window, so it was not saved.
	else
		{
		KeeperLineX := KbCx
		KeeperLineY1 := KbCy1
		KeeperLineY2 := KbCy2
		gosub, QueueAutoSave
		}
	}
Gui, Show
TargetSection := "Keeper"
gosub, ShowSection
gosub, KeeperRefreshSpots
return

KeeperPickColor:
Gui, Hide
Sleep 250
CoordMode, Mouse, Screen
CoordMode, Pixel, Screen
CoordMode, ToolTip, Screen
KbPickCancel := false
KbPc := ""
Loop
	{
	if KeyHeld("Escape")
		{
		KbPickCancel := true
		break
		}
	if KeyHeld("u")
		{
		MouseGetPos, KbPx, KbPy
		PixelGetColor, KbPc, %KbPx%, %KbPy%, RGB
		while KeyHeld("u")
			Sleep 20
		break
		}
	MouseGetPos, KbMx, KbMy
	PixelGetColor, KbHov, %KbMx%, %KbMy%, RGB
	VxPickTip("Press U over the FILLED part of the power bar (not the text)`nColor under the mouse: " . KbHov . "`nEsc to cancel", KbMx + 26, KbMy + 30)
	Sleep 30
	}
VxPickTip("")
CoordMode, Mouse, Client
CoordMode, Pixel, Client
CoordMode, ToolTip, Relative
if (!KbPickCancel and KbPc != "")
	{
	KeeperLineColor := KbPc + 0
	gosub, QueueAutoSave
	}
Gui, Show
TargetSection := "Keeper"
gosub, ShowSection
gosub, KeeperRefreshSpots
return

