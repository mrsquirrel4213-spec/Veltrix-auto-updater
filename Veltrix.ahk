                        rA[nrun] := rS, rB[nrun] := rE
                    }
                    rS := -1, rE := -1, gap := 0
                }
            }
            i++
        }
    }
    gotBar := (nrun >= 1)

    ; --- G. pick a run ---
    DllCall("QueryPerformanceCounter", "Int64*", tnow)
    fresh := (NoisePrevT > 0 && (tnow - NoisePrevT) / QpcFreq < 0.6)
    bs := -99999, be := -1
    if (gotBar) {
        bestI := 0, bestSc := 0
        Loop % nrun {
            w := rB[A_Index] - rA[A_Index] + 1
            cx := Floor((rA[A_Index] + rB[A_Index]) * step / 2)
            sc := w
            if (fresh)
                sc := w - Floor(Abs(cx - NoisePrevC) / step)
            if (bestI = 0 || sc > bestSc) {
                bestI := A_Index
                bestSc := sc
            }
        }
        bs := rA[bestI], be := rB[bestI]
        if (NoiseWCal < 40 && rA[bestI] > 0 && rB[bestI] < ncol - 1)
