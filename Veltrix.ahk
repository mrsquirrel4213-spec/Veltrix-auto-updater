;---- Debug (Extra > Debug): scanning FPS and the bar's LEFT / RIGHT / LINE markers ---------------------------
; Both only show while the macro runs. The markers sit in a band right above the strip the macro reads, so they
; never cover what it looks at (and Fast capture stays on).

DbgOnChanged:
GuiControlGet, DbgOn, 1:, DbgOn
DbgOn := DbgOn ? 1 : 0
IniWrite, %DbgOn%, %SettingsFile%, Debug, On
gosub, DbgApply
return

DbgOptChanged:
GuiControlGet, DbgFps, 1:, DbgFps
GuiControlGet, DbgBar, 1:, DbgBar
DbgFps := DbgFps ? 1 : 0
DbgBar := DbgBar ? 1 : 0
IniWrite, %DbgFps%, %SettingsFile%, Debug, ScanFps
IniWrite, %DbgBar%, %SettingsFile%, Debug, BarPositions
gosub, DbgApply
return

DbgApply:
if (DbgOn and (DbgFps or DbgBar))
	SetTimer, VxDebugTickL, 33
else
	{
	SetTimer, VxDebugTickL, Off
	VxDbgFpsShow("")
	VxDbgBarsShow(-1, -1, -1)
	}
return

DbgOpen:
TargetSection := "Debug"
gosub, ShowSection
return

VxDebugTickL:
VxDebugTick()
return

VxDebugTick() {
	global DbgOn, DbgFps, DbgBar, MacroRunning, RobloxHwnd, VxScanN
	global VxDbgFish, VxDbgFishT, VxDbgBarC, VxDbgBarW, VxDbgBarT, VxNatStats, NativeCapture
	global VxDbgFish2, VxDbgFish2T, VxDbgBar2C, VxDbgBar2W, VxDbgBar2T
	static fpsT := 0, fpsN := 0, fps := 0, natN := 0, bltN := 0, fast := ""
	OppDump()
	if (!DbgOn or !MacroRunning or !RobloxHwnd or !WinExist("ahk_id " . RobloxHwnd))
		{
		VxDbgFpsShow("")
		VxDbgBarsShow(-1, -1, -1)
		fpsT := 0, fps := 0
		return
		}
	RobloxClientRect(RobloxHwnd, cx, cy)
	; reads of the bar per second, counted over half a second
	now := A_TickCount
	if (!fpsT)
		fpsT := now, fpsN := VxScanN
	else if (now - fpsT >= 500)
		{
		fps := Round((VxScanN - fpsN) * 1000 / (now - fpsT))
		fpsT := now, fpsN := VxScanN
		; share of the screen grabs that came from fast capture in that half second
		fast := "  ·  fast off"
		if (VxNatStats and NativeCapture)
			{
			VarSetCapacity(st, 88, 0)
			DllCall(VxNatStats, "Ptr", &st, "Int", 0)
			dn := NumGet(st, 0, "Int64") - natN, db := NumGet(st, 8, "Int64") - bltN
			natN := NumGet(st, 0, "Int64"), bltN := NumGet(st, 8, "Int64")
			fast := (dn + db > 0) ? "  ·  fast " . Round(100 * dn / (dn + db)) . "%" : "  ·  fast -"
			}
		}
	s := A_ScreenDPI / 96
	VxDbgFpsShow(DbgFps ? fps . " FPS" . fast : "", cx + Round(14 * s), cy + Round(14 * s))
	if (!DbgBar)
		{
		VxDbgBarsShow(-1, -1, -1)
		return
		}
	; positions older than a quarter second are gone (no minigame now)
	bl := -1, br := -1, fx := -1
	if (VxDbgBarT and now - VxDbgBarT < 250 and VxDbgBarW > 0)
		bl := VxDbgBarC - VxDbgBarW / 2, br := VxDbgBarC + VxDbgBarW / 2
	if (VxDbgFishT and now - VxDbgFishT < 250)
		fx := VxDbgFish
	; a second bar (Bellona's Waraxe, right mouse)
	bl2 := -1, br2 := -1, fx2 := -1
	if (VxDbgBar2T and now - VxDbgBar2T < 250 and VxDbgBar2W > 0)
		bl2 := VxDbgBar2C - VxDbgBar2W / 2, br2 := VxDbgBar2C + VxDbgBar2W / 2
	if (VxDbgFish2T and now - VxDbgFish2T < 250)
		fx2 := VxDbgFish2
	VxDbgBarsShow(bl, br, fx, cx, cy, bl2, br2, fx2)
}

; Debug + Oppressor: the strip the macro reads, saved to Veltrix\caps every 1.5 s (at most 60 a session), with what the
; Oppressor reader made of it in the file name: rc (2 bar, 1 fish or marker only, 0 nothing), bar ends, fish, marker
OppDump() {
	global DbgOn, SpecialRod, MacroRunning, pCaptureBits, CaptureW, CaptureH, CapExtra, VxNatOP
	static last := 0, n := 0
	if (!DbgOn or SpecialRod != "Oppressor" or !MacroRunning or !pCaptureBits or CaptureW < 40 or n >= 60 or A_TickCount - last < 1500)
		return
	last := A_TickCount
	n += 1
	; just the rows the reader uses: the fast capture's buffer holds no more than that
	h := CaptureH
	rc := -1
	VarSetCapacity(res, 20, 0xFF)
	if (VxNatOP)
		rc := DllCall(VxNatOP, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Ptr", &res, "Int")
	dir := A_ScriptDir . "\caps"
	FileCreateDir, %dir%
	FormatTime, t, , HHmmss
	f := dir . "\strip_" . t . "_" . n . "_rc" . rc . "_bar" . NumGet(res, 0, "Int") . "-" . NumGet(res, 4, "Int")
		. "_f" . NumGet(res, 8, "Int") . "_m" . NumGet(res, 12, "Int") . "-" . NumGet(res, 16, "Int") . "_" . CaptureW . "x" . CaptureH . ".bmp"
	sz := CaptureW * h * 4
	VarSetCapacity(hd, 54, 0)
	NumPut(0x4D42, hd, 0, "UShort"), NumPut(54 + sz, hd, 2, "UInt"), NumPut(54, hd, 10, "UInt")
	NumPut(40, hd, 14, "UInt"), NumPut(CaptureW, hd, 18, "Int"), NumPut(-h, hd, 22, "Int"), NumPut(1, hd, 26, "UShort"), NumPut(32, hd, 28, "UShort")
	fh := FileOpen(f, "w")
	if (!IsObject(fh))
		return
	fh.RawWrite(hd, 54)
	wrote := fh.RawWrite(pCaptureBits + 0, sz)
	fh.Close()
	if (wrote < sz)
		FileDelete, %f%
}

; the scanning FPS, a small box at the top left of Roblox ("" hides it)
VxDbgFpsShow(t, x := 0, y := 0) {
	global VxDbgFW, VxDbgFT, ColorText, SpecialBrushes, hBrushBG, ColorTextBGR, ColorBG
	static last := "", lastPos := ""
	if (t = "")
		{
		if (VxDbgFW and last != "")
			Gui, VxDbgF:Hide
		last := "", lastPos := ""
		return
		}
	if (!VxDbgFW)
		{
		Gui, VxDbgF:New, +AlwaysOnTop -Caption +ToolWindow +E0x20 +HwndVxDbgFW
		Gui, VxDbgF:Color, %ColorBG%
		Gui, VxDbgF:Margin, 10, 5
		Gui, VxDbgF:Font, s11 Bold cE8ECEF, Segoe UI
		Gui, VxDbgF:Add, Text, w230 h20 +0x80 HwndVxDbgFT, 000 FPS
		SpecialBrushes[VxDbgFT] := {brush: hBrushBG, text: 0xEFECE8}
		Gui, 1:Default
		}
	if (!(t == last))
		{
		last := t
		GuiControl, VxDbgF:, %VxDbgFT%, %t%
		}
	pos := x . "," . y
	if (pos != lastPos)
		{
		lastPos := pos
		Gui, VxDbgF:Show, x%x% y%y% NoActivate AutoSize
		; see-through a little (layered, so the macro's screen reads never see it)
		WinSet, Transparent, 230, ahk_id %VxDbgFW%
		}
}

; the LEFT / RIGHT / LINE markers (client x positions, -1 = not there), for one bar or two (bl2 br2 fx2: Bellona's
; second bar); all -1 hides them
VxDbgBarsShow(bl, br, fx, cx := 0, cy := 0, bl2 := -1, br2 := -1, fx2 := -1) {
	global VxDbgBW, FishBarTop, TrackLeft, TrackRight
	static dc := 0, hbm := 0, obm := 0, bits := 0, g := 0, bmp := 0, sw := 0, sh := 0, shown := false, lastKey := ""
	static fam := 0, font := 0, fmt := 0
	VxDbgMidShow((bl >= 0 and br >= 0) ? (bl + br) / 2 : -1, cx, cy, 1)
	VxDbgMidShow((bl2 >= 0 and br2 >= 0) ? (bl2 + br2) / 2 : -1, cx, cy, 2)
	if (bl < 0 and br < 0 and fx < 0 and bl2 < 0 and br2 < 0 and fx2 < 0)
		{
		if (shown)
			Gui, VxDbgB:Hide
		shown := false, lastKey := ""
		return
		}
	if (!HudGdipStart())
		return
	s := A_ScreenDPI / 96
	pad := Round(60 * s)
	bandH := Round(40 * s)
	labH := Round(18 * s)
	W := Round(TrackRight - TrackLeft) + 2 * pad
	if (W < 80)
		W := 80
	H := bandH
	ox := cx + Round(TrackLeft) - pad
	; the band ends right where the macro's strip starts (18 px above the bar)
	oy := cy + Round(FishBarTop) - 18 - H
	key := Round(bl) . "|" . Round(br) . "|" . Round(fx) . "|" . Round(bl2) . "|" . Round(br2) . "|" . Round(fx2) . "|" . ox . "|" . oy . "|" . W
	if (shown and key == lastKey)
		return
	lastKey := key
	if (!VxDbgBW)
		{
		Gui, VxDbgB:New, +AlwaysOnTop -Caption +ToolWindow +E0x80020 +HwndVxDbgBW
		Gui, 1:Default
		}
	if (!g or sw != W or sh != H)
		{
		if (g)
			DllCall("gdiplus\GdipDeleteGraphics", "Ptr", g), DllCall("gdiplus\GdipDisposeImage", "Ptr", bmp)
		if (dc)
			DllCall("SelectObject", "Ptr", dc, "Ptr", obm), DllCall("DeleteObject", "Ptr", hbm), DllCall("DeleteDC", "Ptr", dc)
		VarSetCapacity(bi, 40, 0)
		NumPut(40, bi, 0, "UInt"), NumPut(W, bi, 4, "Int"), NumPut(-H, bi, 8, "Int"), NumPut(1, bi, 12, "UShort"), NumPut(32, bi, 14, "UShort")
		dc := DllCall("CreateCompatibleDC", "Ptr", 0, "Ptr")
		hbm := DllCall("CreateDIBSection", "Ptr", dc, "Ptr", &bi, "UInt", 0, "Ptr*", bits, "Ptr", 0, "UInt", 0, "Ptr")
		obm := DllCall("SelectObject", "Ptr", dc, "Ptr", hbm, "Ptr")
		DllCall("gdiplus\GdipCreateBitmapFromScan0", "Int", W, "Int", H, "Int", W * 4, "Int", 0xE200B, "Ptr", bits, "Ptr*", bmp)
		DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", bmp, "Ptr*", g)
		DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", g, "Int", 4)
		DllCall("gdiplus\GdipSetTextRenderingHint", "Ptr", g, "Int", 4)
		sw := W, sh := H
		}
	if (!font)
		{
		DllCall("gdiplus\GdipCreateFontFamilyFromName", "WStr", "Segoe UI", "Ptr", 0, "Ptr*", fam)
		DllCall("gdiplus\GdipCreateFont", "Ptr", fam, "Float", 11.5 * s, "Int", 1, "Int", 2, "Ptr*", font)
		DllCall("gdiplus\GdipCreateStringFormat", "Int", 0x1000, "Int", 0, "Ptr*", fmt)
		DllCall("gdiplus\GdipSetStringFormatAlign", "Ptr", fmt, "Int", 1)
		DllCall("gdiplus\GdipSetStringFormatLineAlign", "Ptr", fmt, "Int", 1)
		}
	DllCall("gdiplus\GdipGraphicsClear", "Ptr", g, "UInt", 0x00000000)
	for i, mk in [[bl, "LEFT", 0xFF5AA9FF], [br, "RIGHT", 0xFF5AA9FF], [fx, "LINE", 0xFFFFFFFF]
		, [bl2, "LEFT", 0xFF5AA9FF], [br2, "RIGHT", 0xFF5AA9FF], [fx2, "LINE", 0xFFFFFFFF]]
		{
		if (mk[1] < 0)
			continue
		lx := mk[1] - (TrackLeft - pad)
		; the line, from under the label down to the bar
		DllCall("gdiplus\GdipCreateSolidFill", "UInt", mk[3], "Ptr*", brl)
		DllCall("gdiplus\GdipFillRectangle", "Ptr", g, "Ptr", brl, "Float", lx - 1.5 * s, "Float", labH + 2 * s, "Float", 3 * s, "Float", H - labH - 2 * s)
		; the label: its text on a dark pill
		VarSetCapacity(lay, 16, 0), VarSetCapacity(bnd, 16, 0)
		NumPut(0, lay, 0, "Float"), NumPut(0, lay, 4, "Float"), NumPut(400, lay, 8, "Float"), NumPut(labH, lay, 12, "Float")
		DllCall("gdiplus\GdipMeasureString", "Ptr", g, "WStr", mk[2], "Int", -1, "Ptr", font, "Ptr", &lay, "Ptr", fmt, "Ptr", &bnd, "Int*", cp, "Int*", ln)
		tw := NumGet(bnd, 8, "Float") + 10 * s
		px := lx - tw / 2
		DllCall("gdiplus\GdipCreateSolidFill", "UInt", 0xD90B0F14, "Ptr*", brb)
		DllCall("gdiplus\GdipFillRectangle", "Ptr", g, "Ptr", brb, "Float", px, "Float", 0, "Float", tw, "Float", labH)
		NumPut(px, lay, 0, "Float"), NumPut(0, lay, 4, "Float"), NumPut(tw, lay, 8, "Float"), NumPut(labH, lay, 12, "Float")
		DllCall("gdiplus\GdipDrawString", "Ptr", g, "WStr", mk[2], "Int", -1, "Ptr", font, "Ptr", &lay, "Ptr", fmt, "Ptr", brl)
		DllCall("gdiplus\GdipDeleteBrush", "Ptr", brb)
		DllCall("gdiplus\GdipDeleteBrush", "Ptr", brl)
		}
	DllCall("gdiplus\GdipFlush", "Ptr", g, "Int", 0)
	if (!shown)
		{
		Gui, VxDbgB:Show, NoActivate x%ox% y%oy% w%W% h%H%
		shown := true
		}
	VarSetCapacity(sz, 8, 0), NumPut(W, sz, 0, "Int"), NumPut(H, sz, 4, "Int")
	VarSetCapacity(pt, 8, 0), NumPut(ox, pt, 0, "Int"), NumPut(oy, pt, 4, "Int")
	VarSetCapacity(src, 8, 0)
	VarSetCapacity(bf, 4, 0), NumPut(0, bf, 0, "UChar"), NumPut(0, bf, 1, "UChar"), NumPut(255, bf, 2, "UChar"), NumPut(1, bf, 3, "UChar")
	DllCall("UpdateLayeredWindow", "Ptr", VxDbgBW, "Ptr", 0, "Ptr", &pt, "Ptr", &sz, "Ptr", dc, "Ptr", &src, "UInt", 0, "Ptr", &bf, "UInt", 2)
}

; the MID marker (client x, -1 hides it): a short line with its label just under the strip the macro reads, so it
; never covers what is scanned. Drawn once - after that the window only moves. k = which bar (a window each).
VxDbgMidShow(mx, cx := 0, cy := 0, k := 1) {
	global FishBarTop, CaptureH, CapExtra
	static dc := 0, hbm := 0, obm := 0, bits := 0, g := 0, bmp := 0, W := 0, H := 0, shown := {}, lastKey := {}, hw := {}
	gn := "VxDbgM" . k
	if (mx < 0)
		{
		if (shown[k])
			Gui, %gn%:Hide
		shown[k] := false, lastKey[k] := ""
		return
		}
	if (!HudGdipStart())
		return
	s := A_ScreenDPI / 96
	if (!g)
		{
		W := Round(44 * s), H := Round(34 * s)
		VarSetCapacity(bi, 40, 0)
		NumPut(40, bi, 0, "UInt"), NumPut(W, bi, 4, "Int"), NumPut(-H, bi, 8, "Int"), NumPut(1, bi, 12, "UShort"), NumPut(32, bi, 14, "UShort")
		dc := DllCall("CreateCompatibleDC", "Ptr", 0, "Ptr")
		hbm := DllCall("CreateDIBSection", "Ptr", dc, "Ptr", &bi, "UInt", 0, "Ptr*", bits, "Ptr", 0, "UInt", 0, "Ptr")
		obm := DllCall("SelectObject", "Ptr", dc, "Ptr", hbm, "Ptr")
		DllCall("gdiplus\GdipCreateBitmapFromScan0", "Int", W, "Int", H, "Int", W * 4, "Int", 0xE200B, "Ptr", bits, "Ptr*", bmp)
		DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", bmp, "Ptr*", g)
		DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", g, "Int", 4)
		DllCall("gdiplus\GdipSetTextRenderingHint", "Ptr", g, "Int", 4)
		DllCall("gdiplus\GdipGraphicsClear", "Ptr", g, "UInt", 0x00000000)
		labH := Round(18 * s)
		DllCall("gdiplus\GdipCreateSolidFill", "UInt", 0xFF3DDC97, "Ptr*", brl)
		DllCall("gdiplus\GdipFillRectangle", "Ptr", g, "Ptr", brl, "Float", W / 2 - 1.5 * s, "Float", 0, "Float", 3 * s, "Float", H - labH - 2 * s)
		DllCall("gdiplus\GdipCreateFontFamilyFromName", "WStr", "Segoe UI", "Ptr", 0, "Ptr*", fam)
		DllCall("gdiplus\GdipCreateFont", "Ptr", fam, "Float", 11.5 * s, "Int", 1, "Int", 2, "Ptr*", font)
		DllCall("gdiplus\GdipCreateStringFormat", "Int", 0x1000, "Int", 0, "Ptr*", fmt)
		DllCall("gdiplus\GdipSetStringFormatAlign", "Ptr", fmt, "Int", 1)
		DllCall("gdiplus\GdipSetStringFormatLineAlign", "Ptr", fmt, "Int", 1)
		DllCall("gdiplus\GdipCreateSolidFill", "UInt", 0xD90B0F14, "Ptr*", brb)
		DllCall("gdiplus\GdipFillRectangle", "Ptr", g, "Ptr", brb, "Float", 0, "Float", H - labH, "Float", W, "Float", labH)
		VarSetCapacity(lay, 16, 0)
		NumPut(0, lay, 0, "Float"), NumPut(H - labH, lay, 4, "Float"), NumPut(W, lay, 8, "Float"), NumPut(labH, lay, 12, "Float")
		DllCall("gdiplus\GdipDrawString", "Ptr", g, "WStr", "MID", "Int", -1, "Ptr", font, "Ptr", &lay, "Ptr", fmt, "Ptr", brl)
		DllCall("gdiplus\GdipDeleteBrush", "Ptr", brb), DllCall("gdiplus\GdipDeleteBrush", "Ptr", brl)
		DllCall("gdiplus\GdipDeleteStringFormat", "Ptr", fmt), DllCall("gdiplus\GdipDeleteFont", "Ptr", font), DllCall("gdiplus\GdipDeleteFontFamily", "Ptr", fam)
		DllCall("gdiplus\GdipFlush", "Ptr", g, "Int", 0)
		}
	ox := cx + Round(mx) - W // 2
	; under the strip the macro reads (from 18 px above the bar, CaptureH + 38 rows)
	oy := cy + Round(FishBarTop) + CaptureH + 20 + CapExtra + Round(2 * s)
	key := ox . "|" . oy
	if (shown[k] and key == lastKey[k])
		return
	lastKey[k] := key
	if (!hw[k])
		{
		Gui, %gn%:New, +AlwaysOnTop -Caption +ToolWindow +E0x80020 +HwndmwH
		hw[k] := mwH
		Gui, 1:Default
		}
	if (!shown[k])
		{
		Gui, %gn%:Show, NoActivate x%ox% y%oy% w%W% h%H%
		shown[k] := true
		}
	VarSetCapacity(sz, 8, 0), NumPut(W, sz, 0, "Int"), NumPut(H, sz, 4, "Int")
	VarSetCapacity(pt, 8, 0), NumPut(ox, pt, 0, "Int"), NumPut(oy, pt, 4, "Int")
	VarSetCapacity(src, 8, 0)
	VarSetCapacity(bf, 4, 0), NumPut(0, bf, 0, "UChar"), NumPut(0, bf, 1, "UChar"), NumPut(255, bf, 2, "UChar"), NumPut(1, bf, 3, "UChar")
	DllCall("UpdateLayeredWindow", "Ptr", hw[k], "Ptr", 0, "Ptr", &pt, "Ptr", &sz, "Ptr", dc, "Ptr", &src, "UInt", 0, "Ptr", &bf, "UInt", 2)
}

; the Debug page (Extra > Debug > Open)
BuildDebugSection:
Gui, Font, s9 Norm c%ColorAccent%, Segoe UI
Gui, Add, Text, x%CARDX% y120 w220 h18 +0x100 gChangelogBack HwndhC, <  Extra
