                break
            }
            j++
        }
        i++
    }

    ; --- E. arrow fallback ---
    arwOK := false, arwL := 0, arwR := 0
    if (!pairOK) {
        ay0 := Round(0.46 * H), ay1 := Round(0.87 * H)
        if (ay1 <= ay0 + 1) {
            ay0 := H // 2
            ay1 := ay0 + 2
        }
        if (VxNatNA && !NatOff) {
            VarSetCapacity(nao, 8, 0)
            if DllCall(VxNatNA, "Ptr", pCaptureBits, "Int", W, "Int", H, "Int", ay0, "Int", ay1
                , "Int", (NoiseWCal >= 40) ? Round(NoiseWCal) : 0, "Ptr", &nao, "Int")
                arwL := NumGet(nao, 0, "Int"), arwR := NumGet(nao, 4, "Int"), arwOK := true
        } else {
        acnt := {}
        ax := 0
        while (ax < W) {
            c := 0
            y := ay0
            while (y < ay1) {
                px := NumGet(pCaptureBits + y * stride + 4 * ax, "UInt")
                if ((((px >> 16) & 255) + ((px >> 8) & 255) + (px & 255)) // 3 <= 12)
                    c++
                y += 4
            }
            acnt[ax] := c
            ax += 2
        }
        awmin := Round(0.019 * W), awmax := Round(0.09 * W)
        bestAw := 0, bestAa := 0, bestAb := 0
        ra := -1, rb := -1
        ax := 0
        while (ax <= W) {
            on := (ax < W && acnt[ax] >= 1)
            if (on) {
                if (ra < 0)
                    ra := ax
                rb := ax
            } else if (ra >= 0) {
                aw := rb - ra + 1
                if (aw >= awmin && aw <= awmax && aw > bestAw) {
                    bestAw := aw, bestAa := ra, bestAb := rb
                }
                ra := -1
            }
            ax += 2
        }
        if (bestAw > 0) {
            th := Max(1, bestAw // 3)
            lsum := 0, rsum := 0
            Loop % th {
                cl := bestAa + 2 * (A_Index - 1)
                cr := bestAb - 2 * (A_Index - 1)
                if (acnt.HasKey(cl))
                    lsum += acnt[cl]
                if (acnt.HasKey(cr))
                    rsum += acnt[cr]
            }
            useW := (NoiseWCal >= 40) ? NoiseWCal : 0.30 * W
            ains := Round(0.125 * useW)
            acx := (bestAa + bestAb) // 2
            if (rsum > lsum) {
                barRp := acx + ains
                barLp := barRp - Round(useW)
            } else {
                barLp := acx - ains
                barRp := barLp + Round(useW)
            }
            if (barRp - barLp >= 40) {
                arwL := barLp, arwR := barRp, arwOK := true
            }
        }
        }
        wexp := (NoiseWCal >= 40) ? NoiseWCal : 0.303 * W
        wtol := Max(10, Round(0.016 * W))
    }

    ; --- F. bright-run fallback ---
    rA := [], rB := [], nrun := 0
    if (!pairOK && !arwOK && VxNatNB && !NatOff) {
        VarSetCapacity(nba, 64 * 4, 0), VarSetCapacity(nbb, 64 * 4, 0)
        nq := DllCall(VxNatNB, "Ptr", pCaptureBits, "Int", W, "Int", H, "Int", y0, "Int", y1
            , "Ptr", &nba, "Ptr", &nbb, "Int", 64, "Int")
        if (nq < 0)
            return false
        Loop, % nq
            nrun++, rA[nrun] := NumGet(nba, (A_Index - 1) * 4, "Int"), rB[nrun] := NumGet(nbb, (A_Index - 1) * 4, "Int")
    } else if (!pairOK && !arwOK) {
        lum := [], gex := [], hist := []
        Loop 64
            hist[A_Index - 1] := 0
        i := 0
        while (i < ncol) {
            sl := 0, sg := 0, cnt := 0
            y := y0
            while (y < y1) {
                px := NumGet(pCaptureBits + y * stride + 4 * i, "UInt")
                cr := (px >> 16) & 255, cg := (px >> 8) & 255, cb := px & 255
                sl += (cr + cg + cb) // 3
                sg += cg - Max(cr, cb)
                cnt++
                y += 2
            }
            lum[i] := sl // cnt
            gex[i] := Floor(sg / cnt)
            bin := lum[i] // 4
            if (bin < 0)
                bin := 0
            if (bin > 63)
                bin := 63
            hist[bin] := hist[bin] + 1
            i++
        }
        need20 := Round(0.20 * ncol), need98 := Round(0.98 * ncol)
        bg := 0, pk := 255, got20 := false, cum := 0
        Loop 64 {
            b := A_Index - 1
            cum += hist[b]
            if (!got20 && cum >= need20) {
                bg := b * 4
                got20 := true
            }
            if (cum >= need98) {
                pk := b * 4
                break
            }
        }
        if (pk - bg < 40)
            return false
        thr := bg + 0.45 * (pk - bg)
        gapmax := Max(5, Round(0.025 * ncol))
        minw := Max(20, Round(0.22 * ncol))
        rS := -1, rE := -1, gap := 0
        i := 0
        while (i <= ncol) {
            if (i < ncol && lum[i] >= thr) {
                if (rS < 0)
                    rS := i
                rE := i
                gap := 0
            } else if (rS >= 0) {
                gap++
                if (gap > gapmax || i = ncol) {
                    wd := rE - rS + 1
                    gs := 0
                    k := rS
                    while (k <= rE) {
                        gs += gex[k]
                        k++
                    }
