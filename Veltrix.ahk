    wantG := (targetHex >> 8) & 0xFF
    wantR := targetHex & 0xFF
    Loop 5
    {
        rowY := Floor(CaptureH * (2 * A_Index - 1) / 10)
        if (rowY < 0)
            rowY := 0
        if (rowY > CaptureH - 1)
            rowY := CaptureH - 1
        rowPtr := pCaptureBits + rowY * CaptureW * 4
        col := 0
