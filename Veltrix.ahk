SwGuessPickPts:
gosub, KeeperFindRoblox
if (!RobloxHwnd)
	{
	msgbox, 4144, Veltrix, Could not find the Roblox window. Start Roblox first.
	return
	}
RobloxClientRect(RobloxHwnd, GwX, GwY, GwW, GwH)
Gui, Hide
WinActivate, ahk_id %RobloxHwnd%
Sleep 250
CoordMode, Mouse, Screen
CoordMode, ToolTip, Screen
GPts := []
GCancel := false
GUWas := true
Loop
	{
	if KeyHeld("Escape")
		{
		GCancel := true
		break
		}
	GUNow := KeyHeld("u")
	if (GUNow and !GUWas)
		{
		MouseGetPos, GMx, GMy
		GPts.Push([GMx - GwX, GMy - GwY])
		if (GPts.Length() >= 2)
			break
		}
	GUWas := GUNow
	MouseGetPos, GMx, GMy
	GTip := (GPts.Length() = 0) ? "Press U on the CENTER of star 1 (far LEFT star)" : "Now press U on the CENTER of star 12 (far RIGHT star)"
	VxPickTip(GTip . "`nThe 10 in between are filled in evenly`nEsc to cancel", GMx + 26, GMy + 30)
	Sleep 20
	}
VxPickTip("")
CoordMode, Mouse, Client
CoordMode, ToolTip, Relative
if (!GCancel)
	{
	GS := ""
	Loop 12
		{
		Gf := (A_Index - 1) / 11
		Gx := Round(GPts[1][1] + (GPts[2][1] - GPts[1][1]) * Gf)
		Gy := Round(GPts[1][2] + (GPts[2][2] - GPts[1][2]) * Gf)
		GS .= ((A_Index > 1) ? "|" : "") . Gx . "," . Gy
		}
	SwGuessPts := GS
	gosub, QueueAutoSave
	}
Gui, Show
TargetSection := "Guess"
gosub, ShowSection
return

