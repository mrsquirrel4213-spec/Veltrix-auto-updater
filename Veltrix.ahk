            b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF
            m := CbxR[r] & CbxG[g] & CbxB[b]
            if ((m & 0x3FE00) || (g < 90 && b > 130 && b - g > 80 && r < 160))
