    DllCall("ClientToScreen", "Ptr", RobloxHwnd, "Ptr", &pt)
    SwPreX := NumGet(pt, 0, "Int"), SwPreY := NumGet(pt, 4, "Int")

    CoordMode, Mouse, Screen
    MouseMove, % SwPreX, % SwPreY, 0
    CoordMode, Mouse, Client
    SwPreK := nk
    SwPreNudge := 0
    SwPreAt := SwNow()
    SwLog("prehover slot " nk)
