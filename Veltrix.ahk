    sy := (lParam >> 16) & 0xFFFF
    if (sy > 32767)
        sy -= 65536
    VarSetCapacity(pt, 8, 0)
    NumPut(sx, pt, 0, "Int")
    NumPut(sy, pt, 4, "Int")
    DllCall("ScreenToClient", "Ptr", GuiHwnd, "Ptr", &pt)
    mwCx := NumGet(pt, 0, "Int") / DpiF
    mwCy := NumGet(pt, 4, "Int") / DpiF
    ; sidebar and header strip do not scroll
    if (mwCx < SIDEW || mwCy < HEADH + BARH)
        return
    ScrollBy(mwD > 0 ? -66 : 66)
    return 0
}
WM_CTLCOLORSTATIC(wParam, lParam, msg, hwnd) {
    global hBrushBG, hBrushGreen, hBrushRed, hStartStopBtnHwnd, SpecialBrushes, MacroRunning
    global ColorTextBGR, ColorBG, ColorGreen, ColorRed, hFrzGui
    if (hFrzGui && DllCall("GetParent", "Ptr", lParam, "Ptr") = hFrzGui)
        return
    DllCall("SetBkMode", "Ptr", wParam, "Int", 1)
    if (lParam = hStartStopBtnHwnd)
    {
        DllCall("SetTextColor", "Ptr", wParam, "UInt", 0xFFFFFF)
        if (MacroRunning)
            return EnsureBrush(hBrushRed, ColorRed)
        return EnsureBrush(hBrushGreen, ColorGreen)
    }
    if (IsObject(SpecialBrushes) && SpecialBrushes.HasKey(lParam))
    {
        entry := SpecialBrushes[lParam]
        if (entry.brush != "")
        {
            DllCall("SetTextColor", "Ptr", wParam, "UInt", entry.text)
            return entry.brush
        }
    }
    DllCall("SetTextColor", "Ptr", wParam, "UInt", ColorTextBGR)
    return EnsureBrush(hBrushBG, ColorBG)
}
CtrlSnapPos(h, ByRef cx, ByRef cy, ByRef cw, ByRef ch) {
    global GuiHwnd, DpiF
    VarSetCapacity(rc, 16, 0)
    DllCall("GetWindowRect", "Ptr", h, "Ptr", &rc)
    left := NumGet(rc, 0, "Int"), top := NumGet(rc, 4, "Int")
    right := NumGet(rc, 8, "Int"), bottom := NumGet(rc, 12, "Int")
    VarSetCapacity(pt, 8, 0)
    NumPut(left, pt, 0, "Int")
    NumPut(top, pt, 4, "Int")
    DllCall("ScreenToClient", "Ptr", GuiHwnd, "Ptr", &pt)
    cx := Round(NumGet(pt, 0, "Int") / DpiF)
    cy := Round(NumGet(pt, 4, "Int") / DpiF)
    cw := Round((right - left) / DpiF)
    ch := Round((bottom - top) / DpiF)
}
SnapshotBase(lst) {
    global CtrlBaseX, CtrlBaseY, CtrlW, CtrlH
    for _, h in lst
    {
        if CtrlBaseY.HasKey(h)
            continue
        CtrlSnapPos(h, bx, by, bw, bh)
        CtrlBaseX[h] := bx
        CtrlBaseY[h] := by
        CtrlW[h] := bw
        CtrlH[h] := bh
    }
}
ShiftCtrls(lst, keepFirst := 0) {
	global XS, YS, PROFDY, DpiF, ShiftedSet
	if (!IsObject(ShiftedSet))
		ShiftedSet := {}
	for i, h in lst
		{
		if (ShiftedSet.HasKey(h))
			continue
		ShiftedSet[h] := 1
		CtrlSnapPos(h, cx, cy, cw, ch)
		dy := (keepFirst and i > keepFirst) ? PROFDY : 0
		DllCall("SetWindowPos", "Ptr", h, "Ptr", 0, "Int", Round((cx - XS) * DpiF), "Int", Round((cy - YS + dy) * DpiF)
			, "Int", 0, "Int", 0, "UInt", 0x15)
		}
}

ShellDragDown(wParam, lParam, msg, hwnd) {
	global GuiHwnd, TOPH, SIDEW, DpiF
	if (hwnd != GuiHwnd)
		return
	y := (lParam >> 16) & 0xFFFF
	x := lParam & 0xFFFF
	if (y < TOPH * DpiF or x < SIDEW * DpiF)
		{
		PostMessage, 0xA1, 2, 0, , ahk_id %GuiHwnd%
		return 0
		}
}

SetBase(h, x, y) {
	global CtrlBaseX, CtrlBaseY, CtrlW, CtrlH, XS, YS
	CtrlBaseX[h] := x - XS
	CtrlBaseY[h] := y - YS
	if (!CtrlH.HasKey(h) || !CtrlW.HasKey(h)) {
		CtrlSnapPos(h, sx, sy, sw, sh)
		CtrlW[h] := sw
		CtrlH[h] := sh
	}
}

ShowList(lst, cond) {
	global HelpHidden
	hh := IsObject(HelpHidden)
	for i, h in lst
		GuiControl, % ((cond and !(hh and HelpHidden.HasKey(h))) ? "1:Show" : "1:Hide"), %h%
}

CollectVisible() {
    global AllManaged, VisibleCtrls
    VisibleCtrls := []
    for _, h in AllManaged
    {
        style := DllCall("GetWindowLong", "Ptr", h, "Int", -16, "UInt")
        if (style & 0x10000000)
            VisibleCtrls.Push(h)
    }
}
ApplyScroll() {
    global VisibleCtrls, CtrlBaseX, CtrlBaseY, CtrlW, CtrlH, CtrlRgnR, CtrlClip
    global SecScroll, SecMaxScroll, TargetSection, WINH, WINW, SecTopEdge, GuiHwnd
    global SbTrack, SbThumb, SbTrackH, SbThumbH, SbShown, DpiF

    ; lowest content edge decides how far the page can scroll
    bottom := 0
    for _, h in VisibleCtrls
    {
        if !CtrlBaseY.HasKey(h)
            continue
        edge := CtrlBaseY[h] + CtrlH[h]
        if (edge > bottom)
            bottom := edge
    }
    maxOff := bottom + 14 - WINH
    if (maxOff < 0)
        maxOff := 0
    SecMaxScroll := maxOff

    off := SecScroll[TargetSection]
    if (off = "")
        off := 0
    if (off > maxOff)
        off := maxOff
    if (off < 0)
        off := 0
    SecScroll[TargetSection] := off

    ; custom scrollbar
    trackTop := SecTopEdge + 6
    trackH := WINH - trackTop - 12
    trackX := WINW - 15
    if (maxOff <= 0 || trackH < 40)
    {
        if (SbShown != 0)
        {
            SbShown := 0
            GuiControl, Hide, SbTrack
            GuiControl, Hide, SbThumb
        }
    }
    else
    {
        view := WINH - SecTopEdge
        thumbH := Round(trackH * view / (view + maxOff))
        if (thumbH < 30)
            thumbH := 30
        if (thumbH > trackH)
            thumbH := trackH
        thumbY := trackTop + Round((trackH - thumbH) * off / maxOff)
        GuiControl, Move, SbTrack, x%trackX% y%trackTop% w9 h%trackH%
        GuiControl, Move, SbThumb, x%trackX% y%thumbY% w9 h%thumbH%
        if (SbTrackH != trackH)
        {
            SbTrackH := trackH
            GuiControlGet, hPart, Hwnd, SbTrack
            rgn := DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", Round(9 * DpiF) + 1, "Int", Round(trackH * DpiF) + 1, "Int", Round(9 * DpiF), "Int", Round(9 * DpiF), "Ptr")
            DllCall("SetWindowRgn", "Ptr", hPart, "Ptr", rgn, "Int", 1)
        }
        if (SbThumbH != thumbH)
        {
            SbThumbH := thumbH
            GuiControlGet, hPart, Hwnd, SbThumb
            rgn := DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", Round(9 * DpiF) + 1, "Int", Round(thumbH * DpiF) + 1, "Int", Round(9 * DpiF), "Int", Round(9 * DpiF), "Ptr")
            DllCall("SetWindowRgn", "Ptr", hPart, "Ptr", rgn, "Int", 1)
        }
        if (SbShown != 1)
        {
            SbShown := 1
            GuiControl, Show, SbTrack
            GuiControl, Show, SbThumb
        }
    }

    count := VisibleCtrls.Length()
    if (!count)
        return

    clipped := []
    batch := DllCall("BeginDeferWindowPos", "Int", count, "Ptr")
    for _, h in VisibleCtrls
    {
        if !CtrlBaseY.HasKey(h)
            continue
        newY := CtrlBaseY[h] - off
        posX := Round(CtrlBaseX[h] * DpiF)
        if !IsCard(h)
        {
            ; plain controls above the top edge are parked off screen
            posY := (newY < SecTopEdge) ? -6000 : Round(newY * DpiF)
            batch := DllCall("DeferWindowPos", "Ptr", batch, "Ptr", h, "Ptr", 0, "Int", posX, "Int", posY, "Int", 0, "Int", 0, "UInt", 0x1D, "Ptr")
            continue
        }
        cardW := CtrlW[h]
        cardH := CtrlH[h]
        showH := cardH
        cut := 0
        parked := false
        if (newY + cardH <= SecTopEdge)
            parked := true
        else if (newY < SecTopEdge)
        {
            cut := SecTopEdge - newY
            showH := cardH - cut
            newY := SecTopEdge
        }
        clipped.Push({h: h, cut: cut, w: cardW, r: CtrlRgnR[h], ht: showH})
        posY := parked ? -6000 : Round(newY * DpiF)
        batch := DllCall("DeferWindowPos", "Ptr", batch, "Ptr", h, "Ptr", 0, "Int", posX, "Int", posY, "Int", Round(cardW * DpiF), "Int", Round(showH * DpiF), "UInt", 0x14, "Ptr")
    }
    DllCall("EndDeferWindowPos", "Ptr", batch)

    for _, e in clipped
    {
        prev := CtrlClip.HasKey(e.h) ? CtrlClip[e.h] : 0
        if (e.cut = prev)
            continue
        CtrlClip[e.h] := e.cut
        if (e.cut > 0)
            DllCall("SetWindowRgn", "Ptr", e.h, "Ptr", 0, "Int", 1)
        else
        {
            dia := Round(2 * e.r * DpiF)
            rgn := DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", Round(e.w * DpiF) + 1, "Int", Round(e.ht * DpiF) + 1, "Int", dia, "Int", dia, "Ptr")
            DllCall("SetWindowRgn", "Ptr", e.h, "Ptr", rgn, "Int", 1)
        }
    }
    DllCall("RedrawWindow", "Ptr", GuiHwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x0185)
}
IsCard(h) {
    global CtrlRgnR, CtrlH
    if (!CtrlRgnR.HasKey(h) || !CtrlH.HasKey(h))
        return false
    return (CtrlRgnR[h] > 0 && CtrlH[h] > 44)
}
ScrollBy(delta) {
    global SecScroll, SecMaxScroll, TargetSection, GuiHwnd
    cur := SecScroll[TargetSection]
    if (cur = "")
        cur := 0
    target := cur + delta
    if (target > SecMaxScroll)
        target := SecMaxScroll
    if (target < 0)
        target := 0
    if (target = cur)
        return
    SecScroll[TargetSection] := target
    if (GuiHwnd)
    {
        DllCall("SendMessage", "Ptr", GuiHwnd, "UInt", 0x000B, "Ptr", 0, "Ptr", 0)
        ApplyScroll()
        DllCall("SendMessage", "Ptr", GuiHwnd, "UInt", 0x000B, "Ptr", 1, "Ptr", 0)
        DllCall("RedrawWindow", "Ptr", GuiHwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x0185)
    }
    else
        ApplyScroll()
}
MgBlockOpen(name, cardY, h) {
    global MgBlocks, MgAllCtrls, CARDX, CARDW
    card := AddPanel(CARDX, cardY, CARDW, h)
    MgBlocks[name] := {card: card, y: cardY, h: h, ctrls: [], dxs: [], dys: []}
    MgAllCtrls.Push(card)
}
MgAdd(name, h) {
    global MgBlocks, MgAllCtrls, CtrlW, CtrlH
    blk := MgBlocks[name]
    if !IsObject(blk)
        return
    CtrlSnapPos(h, px, py, pw, ph)
    blk.ctrls.Push(h)
    blk.dxs.Push(px)
    blk.dys.Push(py - blk.y)
    if !CtrlW.HasKey(h)
        CtrlW[h] := pw
    if !CtrlH.HasKey(h)
        CtrlH[h] := ph
    MgAllCtrls.Push(h)
}
LayoutMinigame() {
    global MgBlocks, SpecialRod, SwPreset, ControlMode, CARDX, MiniTop
    global ProfCtrls, ProfPosX, ProfPosY, ProfCardH, MgVisible
    MgVisible := {}
    order := ["tip", "mode", "presets"]
    if (SpecialRod = "Stellarwave Melody" && (SwPreset = "Toothly Interstellar" || SwPreset = "Kitty Keys"))
        order.Push("skinwarn")
    if (SpecialRod = "Stellarwave Melody" && SwPreset = "Ominous Ouija")
        order.Push("ojwarn")
    if (SpecialRod = "Halibut Harpoon")
        order.Push("halicol")
    if (SpecialRod = "Remembrance")
        order.Push("remem")
    if (SpecialRod = "Lullaby")
        order.Push("lullmode")
    if (SpecialRod = "Pinions Aria")
        order.Push("notes")
    if (SpecialRod != "Tryhard Rod" && SpecialRod != "Stellarwave Melody" && SpecialRod != "Castbound")
        order.Push("colors")
    if (SpecialRod = "Stellarwave Melody")
    {
        order.Push("stellar")
        order.Push("swcol")
    }
    if (SpecialRod = "Tryhard Rod")
        order.Push("trycol")
    if (SpecialRod = "Castbound")
        order.Push("cbcol")
    order.Push("cmquick")
    if (SpecialRod = "Requiem")
        order.Push("reel")
    order.Push("barctl")
    order.Push("detcheck")

    top := MiniTop
    if (IsObject(ProfCtrls) && ProfCtrls.Length())
    {
        for i, h in ProfCtrls
            SetBase(h, ProfPosX[i], top + ProfPosY[i])
        top += ProfCardH + 10
    }
    for _, name in order
    {
        blk := MgBlocks[name]
        if !IsObject(blk)
            continue
        MgVisible[name] := 1
        SetBase(blk.card, CARDX, top)
        for j, h in blk.ctrls
            SetBase(h, blk.dxs[j], top + blk.dys[j])
        top += blk.h + 10
    }
}
AddPanel(px, py, pw, ph, pr := 10) {
    global SpecialBrushes, hBrushCard, ColorTextBGR, CardRects, CtrlRgnR, CtrlW, CtrlH
    Gui, Add, Text, x%px% y%py% w%pw% h%ph% HwndhPnl
    SpecialBrushes[hPnl] := {brush: hBrushCard, text: ColorTextBGR}
    if !IsObject(CardRects)
        CardRects := []
    CardRects.Push({x: px, y: py, w: pw, h: ph})
    if (pr > 0)
        RoundCtrl(hPnl, pw, ph, pr)
    return hPnl
}
FixCardBrushes(lst) {
    global SpecialBrushes, hBrushCard, ColorTextBGR, CardRects, GuiHwnd, DpiF
    if !IsObject(CardRects)
        return
    for _, h in lst
    {
        if SpecialBrushes.HasKey(h)
            continue
        VarSetCapacity(rc, 16, 0)
        DllCall("GetWindowRect", "Ptr", h, "Ptr", &rc)
        VarSetCapacity(pt, 8, 0)
        NumPut(NumGet(rc, 0, "Int"), pt, 0, "Int")
        NumPut(NumGet(rc, 4, "Int"), pt, 4, "Int")
        DllCall("ScreenToClient", "Ptr", GuiHwnd, "Ptr", &pt)
        cx := Round(NumGet(pt, 0, "Int") / DpiF)
        cy := Round(NumGet(pt, 4, "Int") / DpiF)
        for _, card in CardRects
        {
            if (cx >= card.x && cx < card.x + card.w && cy >= card.y && cy < card.y + card.h)
            {
                SpecialBrushes[h] := {brush: hBrushCard, text: ColorTextBGR}
                break
            }
        }
    }
}
ThemeCtl(h) {
	global GuiInputs
	VarSetCapacity(cb, 128, 0)
	DllCall("GetClassName", "Ptr", h, "Str", cb, "Int", 64)
	cls := cb
	DllCall("uxtheme\SetWindowTheme", "Ptr", h, "Str", (cls = "ComboBox") ? "DarkMode_CFD" : "DarkMode_Explorer", "Ptr", 0)
	if (GuiInputs != "Filled")
		return
	if (cls = "Edit")
		{
		st := DllCall("GetWindowLong", "Ptr", h, "Int", -16, "Int")
		DllCall("SetWindowLong", "Ptr", h, "Int", -16, "Int", st & ~0x800000)
		ex := DllCall("GetWindowLong", "Ptr", h, "Int", -20, "Int")
		DllCall("SetWindowLong", "Ptr", h, "Int", -20, "Int", ex & ~0x200)
		DllCall("SetWindowPos", "Ptr", h, "Ptr", 0, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x27)
		DllCall("SendMessage", "Ptr", h, "UInt", 0xD3, "Ptr", 3, "Ptr", (7 << 16) | 7)
		}
	if (cls = "Edit" or cls = "ComboBox")
		{
		CtrlSnapPos(h, cx, cy, cw, ch)
		if (cw > 4 and ch > 4)
			RoundCtrl(h, cw, ch, (ch > 40) ? 9 : 7)
		}
}

; round every box-like control that was not rounded when it was made
RoundExtras() {
	global GuiHwnd, CtrlRgnR, GuiInputs
	if (!GuiHwnd)
		return
	dhw := A_DetectHiddenWindows
	DetectHiddenWindows, On
	WinGet, lst, ControlListHwnd, ahk_id %GuiHwnd%
	DetectHiddenWindows, %dhw%
	Loop, Parse, lst, `n
		{
		h := A_LoopField + 0
		if (CtrlRgnR.HasKey(h))
			continue
		VarSetCapacity(cb, 128, 0)
		DllCall("GetClassName", "Ptr", h, "Str", cb, "Int", 64)
		cls := cb
		if (cls = "msctls_progress32" or cls = "ComboBox" or (cls = "Edit" and GuiInputs = "Filled"))
			{
			CtrlSnapPos(h, cx, cy, cw, ch)
			if (cw > 4 and ch > 4)
				RoundCtrl(h, cw, ch, (cls = "msctls_progress32") ? 5 : ((ch > 40) ? 9 : 7))
			}
		}
}

; minimal look: the ? help icons go away (their tips go with them)
HideHelpIcons() {
	global GuiHwnd, GuiHelp, HelpHidden
	if (GuiHelp != "Hide" or !GuiHwnd)
		return
	if (!IsObject(HelpHidden))
		HelpHidden := {}
	dhw := A_DetectHiddenWindows
