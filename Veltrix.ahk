; Veltrix migration (build 122): moves this install to the protected Veltrix.
#NoEnv
#SingleInstance Force
#NoTrayIcon
SetBatchLines, -1
SetWorkingDir, %A_Temp%
VxBuild := 122
VxBaseVersion := "migration"
EnvGet, MgLocal, LOCALAPPDATA
EnvGet, MgTarget, VELTRIX_INSTALL_TEST_DIR
if (MgTarget = "")
	MgTarget := MgLocal . "\Veltrix"
MgExe := MgTarget . "\Veltrix.exe"
; already moved: this file only opens the new Veltrix
if (FileExist(MgExe) && !FileExist(MgTarget . "\Veltrix.ahk")) {
	Run, "%MgExe%", %MgTarget%, UseErrorLevel
	ExitApp
}
; keep the old settings: the installer moves this folder away
MgSave := A_Temp . "\Veltrix migrate " . A_Now
FileCreateDir, %MgSave%
if (FileExist(A_ScriptDir . "\Settings.ini"))
	FileCopy, %A_ScriptDir%\Settings.ini, %MgSave%\Settings.ini, 1
if (FileExist(A_ScriptDir . "\Profiles"))
	FileCopyDir, %A_ScriptDir%\Profiles, %MgSave%\Profiles, 1
; the installer, checked against its hash
s := MgPayload()
n := 0
DllCall("crypt32\CryptStringToBinaryW", "Str", s, "UInt", 0, "UInt", 1, "Ptr", 0, "UInt*", n, "Ptr", 0, "Ptr", 0)
if (!n)
	ExitApp, 2
VarSetCapacity(bin, n, 0)
DllCall("crypt32\CryptStringToBinaryW", "Str", s, "UInt", 0, "UInt", 1, "Ptr", &bin, "UInt*", n, "Ptr", 0, "Ptr", 0)
s := ""
if (MgSha256(&bin, n) != "f6fb5cb48efa3916965340b56fed8cf188c3c3279c116b3d1d17258da067b059")
	ExitApp, 3
MgSetup := A_Temp . "\Veltrix Setup " . A_Now . ".exe"
f := FileOpen(MgSetup, "w")
if (!IsObject(f))
	ExitApp, 4
f.RawWrite(bin, n), f.Close()
VarSetCapacity(bin, 0)
MgStart := A_Now
TrayTip, Veltrix, Veltrix is moving to its new version - press Install in the window that opens., 5
RunWait, "%MgSetup%", %A_Temp%, UseErrorLevel
Loop, 20
{
	FileDelete, %MgSetup%
	if (!FileExist(MgSetup))
		break
	Sleep, 250
}
if (!FileExist(MgExe))
	ExitApp, 5
; the old settings into the new install (Settings.ini there made only now = the new app's defaults)
MgDst := MgTarget . "\Veltrix settings"
FileCreateDir, %MgDst%
MgNew := true
if (FileExist(MgDst . "\Settings.ini")) {
	FileGetTime, t, %MgDst%\Settings.ini, C
	MgNew := (t >= MgStart)
}
if (MgNew && FileExist(MgSave . "\Settings.ini"))
	FileCopy, %MgSave%\Settings.ini, %MgDst%\Settings.ini, 1
if (MgNew && FileExist(MgSave . "\Profiles"))
	FileCopyDir, %MgSave%\Profiles, %MgDst%\Profiles, 1
FileRemoveDir, %MgSave%, 1
ExitApp, 0

MgSha256(p, n) {
	alg := 0, out := ""
	DllCall("bcrypt\BCryptOpenAlgorithmProvider", "Ptr*", alg, "WStr", "SHA256", "Ptr", 0, "UInt", 0)
	VarSetCapacity(h, 32, 0)
	DllCall("bcrypt\BCryptHash", "Ptr", alg, "Ptr", 0, "UInt", 0, "Ptr", p, "UInt", n, "Ptr", &h, "UInt", 32)
	DllCall("bcrypt\BCryptCloseAlgorithmProvider", "Ptr", alg, "UInt", 0)
	Loop, 32
		out .= Format("{:02x}", NumGet(h, A_Index - 1, "UChar"))
	return out
}

; never run: old updaters look for these before taking an update
MgOldUpdaterMarks:
LicGate()
LicRecheck:
return
LicGate() {
}

