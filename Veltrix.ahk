SwTplOk(k, z) {
    global SwTie, SwLastOnset, SwSlotFirst, SwSlotSt
    SwTplMask(k, m, kn)
    if (!IsObject(m))
        return 3
    s0 := SwTplScore(m, kn, z)
    s1 := SwTplScore(m, kn, Mod(z + 11, 12))
    s2 := SwTplScore(m, kn, Mod(z + 1, 12))
    SwLog("shape slot " k " " SwZodiac(z) " " Round(s0, 3) " prev " Round(s1, 3) " next " Round(s2, 3))
    ; reads clearly as the following zodiac
    if (z < 11 && s2 >= 0.5 && s2 >= s0 + 0.15)
        return 0
    ; weak read: is another pending sign a much better match?
    if (s0 < 0.35) {
        Loop 12 {
            kk := A_Index
            if (kk = k)
                continue
            if (SwSlotSt[kk] != 1 && SwSlotSt[kk] != 2)
                continue
            if (SwSlotWhite(kk))
                continue
            SwTplMask(kk, m2, kn2)
            if (!IsObject(m2))
                continue
            s := SwTplScore(m2, kn2, z)
            if (s >= 0.45 && s >= s0 + 0.15) {
                SwLog("slot " k " reads weak - slot " kk " is clearly " SwZodiac(z))
                return 0
            }
        }
    }
    if (s0 < 0.05)
        return 3
    return 1
}
SwRecover(i, z) {
    global SwSlotSt, SwOrder, SwRecZ
    if (!SwTplSumFn() || z = SwRecZ)
        return false
    SwRecZ := z
    n := 0, fk := 0, fs := 0, fo := 0
    Loop 12 {
        kk := A_Index
        if (SwSlotSt[kk] >= 2 || SwSlotWhite(kk))
            continue
        SwTplMask(kk, m, kn)
        if (!IsObject(m))
            continue
        sc := SwTplScore(m, kn, z)
        ot := -9
        zz := z + 1
        while (zz <= 11) {
            s := SwTplScore(m, kn, zz)
            if (s > ot)
                ot := s
            zz += 1
        }
        if (sc >= 0.35 && sc >= ot + 0.10) {
            n += 1
            fk := kk, fs := sc, fo := ot
        }
    }
    if (n != 1)
        return false
    SwSlotSt[fk] := 2
