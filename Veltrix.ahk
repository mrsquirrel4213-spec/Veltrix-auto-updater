                row0 := pCaptureBits + pr0 * stride
                alt := []
                mx := 0
                while (mx < W) {
                    mst := -1
                    while (mx < W) {
                        px := NumGet(row0 + 4 * mx, "UInt")
                        cr := (px >> 16) & 255, cg := (px >> 8) & 255, cb := px & 255
                        if !(cb <= 52 && cr <= 12 && cg >= 40 && cg <= 80 && cg >= cb + 8)
                            break
                        if (mst < 0)
                            mst := mx
                        mx++
                    }
                    if (mst < 0) {
                        mx++
                        continue
                    }
                    mw := mx - mst
                    if (mw < 3 || mw > mwMax)
                        continue
                    mcx := mst + mw // 2
                    ok := true
                    for q, ry in [pr1, pr2] {
                        px := NumGet(pCaptureBits + ry * stride + 4 * mcx, "UInt")
                        cr := (px >> 16) & 255, cg := (px >> 8) & 255, cb := px & 255
                        if !(cb <= 52 && cr <= 12 && cg >= 40 && cg <= 80 && cg >= cb + 8) {
                            ok := false
                            break
                        }
                    }
                    if (!ok)
                        continue
                    ownG := (NumGet(row0 + 4 * mcx, "UInt") >> 8) & 255
                    maxL := 0, maxR := 0
                    Loop 4 {
                        gl := (NumGet(row0 + 4 * Max(0, mst - A_Index), "UInt") >> 8) & 255
                        gr := (NumGet(row0 + 4 * Min(W - 1, mx - 1 + A_Index), "UInt") >> 8) & 255
                        maxL := Max(maxL, gl)
                        maxR := Max(maxR, gr)
                    }
                    if (maxL >= ownG + 80 && maxR >= ownG + 80)
                        alt.Push(mcx)
                }
                if (alt.Length() > 0) {
                    fX := alt
                    nf := alt.Length()
                }
            }
        }
    }

    fishAge := (NoiseFishT > 0) ? (tnow - NoiseFishT) / QpcFreq : 0
    if (nf < 1) {
        if (NoiseFishT > 0 && NoiseFishPrev >= 0 && fishAge < 1.2)
            NoiseFishX := FishBarLeft + NoiseFishPrev
        return true
    }
    fpick := fX[1]
    if (NoiseFishT > 0 && NoiseFishPrev >= 0 && fishAge < 0.35) {
        fjmax := Max(100, Round(0.10 * W))
        near := false
        Loop % nf {
            if (Abs(fX[A_Index] - NoiseFishPrev) <= fjmax) {
                near := true
                break
            }
        }
        if (!near) {
            NoiseFishX := FishBarLeft + NoiseFishPrev
            return true
        }
    }
    if (NoiseFishT > 0 && fishAge < 0.6) {
        bestD := ""
        Loop % nf {
            d := Abs(fX[A_Index] - NoiseFishPrev)
            if (bestD = "" || d < bestD) {
                bestD := d
                fpick := fX[A_Index]
            }
        }
    }
    NoiseFishX := FishBarLeft + fpick
    NoiseFishFresh := true
    NoiseFishPrev := fpick
    NoiseFishT := tnow
    return true
}
