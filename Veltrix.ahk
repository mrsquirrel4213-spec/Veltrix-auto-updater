    if (!GuiKeepOpen)
        Gui, 1:Hide
return
HotkeyWatch:
if (FreezeActive)
	return
if (!DllCall("IsWindowVisible", "Ptr", GuiHwnd))
	gosub, ArmHotkeys
gosub, SyncRunKeys
return

ArmHotkeys:
    if (!HotkeysArmed) {
        Hotkey, $%StartStopKey%, On
        HotkeysArmed := true
    }
    gosub SyncRunKeys
return
SyncRunKeys:
    MacroLive := (HotkeysArmed || MacroRunning)
    if (MacroLive && !RunKeysArmed) {
        Hotkey, $%ReloadKey%, On
        Hotkey, $%ExitKey%, On
        RunKeysArmed := true
    } else if (!MacroLive && RunKeysArmed) {
        Hotkey, $%ReloadKey%, Off
        Hotkey, $%ExitKey%, Off
        RunKeysArmed := false
    }
return
DisarmHotkeys:
    if (HotkeysArmed) {
        Hotkey, $%StartStopKey%, Off
        HotkeysArmed := false
    }
    gosub SyncRunKeys
return
DoReload:
MacroRunning := false
Send, {LButton up}
Send, {RButton up}
Send, {Shift up}
Reload
DoExit:
MacroRunning := false
Send, {LButton up}
Send, {RButton up}
Send, {Shift up}
ExitApp
StartMacroFlow:
    ; fresh session counters
    TotemLastCheck := 0
    TotemCool := {}
    TotemLastPop := ""
    WhStartTick := A_TickCount
    WhCatches := 0
    FsExtraCount := 0
    FsGroups := []
    FsDone := []
    FsCount := 0
    FsTotal := 0
    FsLastName := ""
    FsLastKg := ""
    FsLastVal := ""
    FsSeen := {}
    WhLastCatchTick := 0
    WhLastSummary := A_TickCount
    WhStalled := false
    RcLogPath := "", RcLogEnd := true, RcGoneT := 0, RcHungT := 0, RcBusy := false, RcSessionT := A_TickCount

    Send, {lbutton up}
    Send, {rbutton up}
    Send, {shift up}

    gosub ResolveRoblox
    if (!RobloxHwnd) {
        MacroRunning := false
        MsgBox, 0x1030, Veltrix, Could not find the Roblox game window. Make sure Roblox is running, then try again.
        return
    }
    WinActivate, ahk_id %RobloxHwnd%
    WinWaitActive, ahk_id %RobloxHwnd%, , 2
    WinMaximize, ahk_id %RobloxHwnd%
    gosub Calculations
    SetTimer, runtime, 1000
    SetTimer, WhTick, 5000
    SetTimer, RcTick, 2000
    WhStarted()
    gosub RefreshHints
    for cmIdx_, tipNo in [6, 10, 11, 12, 14, 16]
        VxTip(tipNo, "")
    ; continues straight into RestartMacro
RestartMacro:

if (!MacroRunning)
	goto Idle

if (SwPressK)
	SwPressEnd()
SwWantK := 0
; in passive mode you may be in another window - do not send it stray button-ups
if (!PasIdle() or WinActive("ahk_id " . RobloxHwnd))
	{
	send {lbutton up}
	send {rbutton up}
	}
if (SwPreK)
	{
	SwPreEnd("restart")
	while (SwParkAt and SwParkWait())
		Sleep, % Tm(5)
	}

; only reached between fights: a fight that ended through a failsafe, passive "minigame lost" or a Tranquility
; timeout skipped BarMinigameOver and left MgInPlay on - the recharge guard took that as "minigame on screen" and
; kept putting the recharge off - and its failsafe timer kept counting through the recharge
MgInPlay := false
; Doomsekkar learns its bar width again each fight
DoomReset := true
OppMkOn := false, OppCandN := 0
PrecisionDown := false
settimer, BarCalculationFailsafe, off
settimer, NavigationShakeFailsafe, off
if (!KeeperAuto)
	{
	KbOwed := false
	KbPreLow := false
	}
if (KeeperAuto and !KbBusy)
	{
	KbHandled := false
	KbDue := false
	if (KbOwed)
		{
		; already read low (twice) and not recharged yet - do it now, before anything else, no new reading
		KbHandled := true
		KbDue := true
		KbPreState := 0
		}
	else if (KeeperAutoBar and KbPreState)
		{
		; read fine while the bobber was out - nothing to wait for here
		KbHandled := true
		KbPreState := 0
		}
	else if (KeeperAutoBar or KeeperOcrOn)
		{
		if (KbOcrCatches >= ((Round(KeeperOcrEvery) < 1) ? 1 : Round(KeeperOcrEvery)))
			{
			KbOcrCatches := 0
			KbHandled := false
			if (KeeperAutoBar)
				{
				KbAutoAt := KeeperAutoPct
				if KbAutoAt is not number
					KbAutoAt := 15
				; one quick look - the bar is often hidden right after a catch, and the next cast reads it anyway
				; the cast read it low: wait for it to show (about 1.5 s) - a low bar is not put off by a hidden hotbar
				KbLookLow := KbPreLow
				KbPreLow := false
				KbLook := KbLookLow ? 20 : 2
				KbFound := false
				Loop % KbLook
					{
					if (KbAutoRead(KbPct))
						{
						KbFound := true
						break
						}
					if (A_Index < KbLook)
						Sleep, % KbLookLow ? 75 : 30
					}
				KbHandled := true
				if (KbFound)
					{
					KbMissN := 0
					if (KbPct < KbAutoAt + 4)
						{
						if (KbAutoReadStable(KbPct2, 3))
							KbPct := KbPct2
						if (KbPct < KbAutoAt)
							{
							; a moment later it must still read low - one odd frame never starts a recharge
							Sleep, 300
							KbDue := (KbAutoReadStable(KbPct3, 3) and KbPct3 < KbAutoAt)
							}
						}
					KbOcrLast := "power bar " . Round(KbPct, 1) . "%"
					if (!KbDue and KbPct >= KbAutoAt)
						{
						KbGoodPct := KbPct
						KbSuspect := false
						}
					else if (KbDue and KbGoodPct != "" and KbGoodPct - KbPct > 30 and !KbSuspect)
						{
						; the bar cannot drop that far in one catch - almost always a misread, so confirm next catch
						KbSuspect := true
						KbDue := false
						KbOcrCatches := 9999
						KbOcrLast .= " - big drop from " . Round(KbGoodPct) . "%, checking again next catch"
						}
					}
				else
					{
					; not seen this time (UI fading, popup, menu) - skip, do NOT fall back to counting catches
					KbMissN := KbMissN + 1
					KbOcrLast := "power bar not found (" . KbMissN . "x in a row)"
					if (KbLookLow)
						KbOcrCatches := 9999
					if (KbMissN >= 10 and !KeeperOcrOn)
						KbDue := (KbCatches >= Round(KeeperEveryCatches))
					}
				}
			if (!KbHandled and !KeeperOcrOn)
				KbDue := (KbCatches >= Round(KeeperEveryCatches))
			}
		}
	if (KeeperOcrOn and !KbHandled)
		{
		if (KeeperAutoBar or KbOcrCatches >= ((Round(KeeperOcrEvery) < 1) ? 1 : Round(KeeperOcrEvery)))
			{
			KbOcrCatches := 0
			gosub, KbWaitUiClear
			KbLr := KbLineCheck(KbLm, KbLt)
			if (KbLr = 1)
				{
				sleep 300
				KbDue := (KbLineCheck(KbLm2, KbLt2) = 1)
				if (KbDue)
					{
					sleep 250
					KbDue := (KbLineCheck(KbLm3, KbLt3) = 1)
					}
				}
			if (KbLr < 0)
				KbOcrLast := "line or bar color not set"
			else
				KbOcrLast := ((KbLr = 1) ? "LOW" : "ok") . " (" . KbLm . " of " . KbLt . " px off)"
			}
		}
	else if (!KeeperAutoBar and !KeeperOcrOn and KbCatches >= Round(KeeperEveryCatches))
		KbDue := true
	if (KbDue)
		{
		KbOwed := true
		gosub, KbGuardClear
		; nothing is being reeled here - 3 times in a row "minigame on screen" means the check is wrong
		KbForce := (!KbUiClear and KbPostponeN >= 3)
		if (KbUiClear or KbForce)
			{
			if (KbForce)
				KbOcrLast := "minigame check said on screen " . KbPostponeN . "x in a row - recharging anyway"
			gosub, KeeperRun
			KbForce := false
			}
		else
			{
			KbPostponeN := KbPostponeN + 1
			KbOcrCatches := 9999
			KbOcrLast := "recharge postponed - minigame on screen (" . KbPostponeN . "x)"
			}
		}
	}

if (!MacroRunning)
	goto Idle

if (AquariumAuto and !AqBusy and !KbOwed and (AqNextTick = 0 or A_TickCount >= AqNextTick))
	gosub, AquariumRun

if (!MacroRunning)
	goto Idle

; Auto Totem with the other between-catch checks (passive mode goes its own way right below): only when its check
; is due, so the restart does not wait on it otherwise
if (!KbOwed and RobloxHwnd and WinActive("ahk_id " . RobloxHwnd))
	gosub, TotemMaybeRun
if (!MacroRunning)
	goto Idle

VxTip(9, "")
if (!MacroRunning)
	goto Idle

if (PassiveAll or (SwPassive and SpecialRod = "Stellarwave Melody"))
	{
	NukeAfter := false
	goto SwPassiveWatch
	}

; a nuke was just balanced: the rod was put away - take it out again (bag first when there is one, so the rod key
; is pressed once and the rod ends up in hand either way)
if (NukeAfter)
	{
	NukeAfter := false
	if (RodSlotKey != "")
		{
		VxTip(7, "Current Task: Re-equipping Rod (after the nuke)")
		send {lbutton up}
		Sleep, % Tm(TA("reeq1", 120))
		if (BagSlotKey != "")
			{
			send {%BagSlotKey%}
			Sleep, % Tm(TA("reeq2", 400))
			}
		send {%RodSlotKey%}
		Sleep, % Tm(TA("reeq3", 600))
		RodEquippedOnce := true
		ForceReEquip := false
		CastFailCount := 0
		}
	if (!MacroRunning)
		goto Idle
	}
if (RodSlotKey != "" and !RodEquippedOnce)
	ForceReEquip := true
; Lullaby mode switch first: the bag puts the rod away, so it is equipped again right below
gosub, LmMaybeSwitch

if (RodSlotKey != "" and (ForceReEquip or (UnstickAfter > 0 and CastFailCount >= UnstickAfter)))
	{
	VxTip(7, "Current Task: Re-equipping Rod (stuck bobber)")
	send {lbutton up}
	send {rbutton up}
	Sleep, % Tm(TA("reeq1", 120))
	if (BagSlotKey != "")
		send {%BagSlotKey%}
	else
		send {%RodSlotKey%}
	Sleep, % Tm(TA("reeq2", 400))
	send {%RodSlotKey%}
	Sleep, % Tm(TA("reeq3", 600))
	CastFailCount := 0
	ForceReEquip := false
	RodEquippedOnce := true
	if (!MacroRunning)
		goto Idle
	}

VxTip(7, "Current Task: Casting Rod")
CastHolding := true
if (CastMode = "Perfect")
	{
	send {lbutton down}
	gosub, PerfectCastRelease
	if (!PCReleased)
		send {lbutton up}
	}
else
	{
	; Smart cast: N casts back to back (hold, release, hold, ...) - the last one is the normal watched cast
	ScN := SmartCastN
	if ScN is not number
		ScN := 1
	ScN := Round(ScN)
	if (ScN > 10)
		ScN := 10
	CastMgN := 0
	KbPreTried := false
	if (SmartCast and ScN > 1)
		{
		Loop % ScN - 1
			{
			VxTip(8, "Action: Cast " . A_Index . "/" . ScN . " (" . HoldRodCastDuration . "ms)")
			send {lbutton down}
			CastT0 := A_TickCount
			while (A_TickCount - CastT0 < HoldRodCastDuration)
				{
				gosub, CastMgPoll
				if (CastMgHit)
					goto CastMgGo
				}
			send {lbutton up}
			; wait the cast hold time plus 50 ms before the next cast - still watching for the minigame
			CastT0 := A_TickCount
			gosub, KbPreMaybe
			CastGapMs := HoldRodCastDuration + TA("castgap", 50)
			while (A_TickCount - CastT0 < CastGapMs)
				{
				gosub, CastMgPoll
				if (CastMgHit)
					goto CastMgGo
				}
			}
		}
	send {lbutton down}
	VxTip(8, "Action: Casting For " . HoldRodCastDuration . "ms")
	CastSeen := false
	if (SmartCast)
		{
		CastT0 := A_TickCount
		while (A_TickCount - CastT0 < HoldRodCastDuration)
			{
			if (!CastSeen)
				CastSeen := CastBarSeen()
			gosub, CastMgPoll
			if (CastMgHit)
				goto CastMgGo
			}
		}
	else
		sleep %HoldRodCastDuration%
	send {lbutton up}
	if (SmartCast and !CastSeen)
		{
		CastPostT := A_TickCount
		while (!CastSeen and A_TickCount - CastPostT < TA("castpost", 120))
			{
			CastSeen := CastBarSeen()
			gosub, CastMgPoll
			if (CastMgHit)
				goto CastMgGo
			}
		}
	if (SmartCast)
		{
		; one last look before the bobber wait / shaking
		gosub, CastMgPoll
		if (CastMgHit)
			goto CastMgGo
		}
	if (SmartCast and CastSeen)
		{
		CastSeenN := CastSeenN + 1
		CastMissN := 0
		}
	else if (SmartCast and CastSeenN >= 3)
		{
		CastMissN := CastMissN + 1
		if (CastMissN <= 2)
			{
			CastHolding := false
			VxTip(8, "Action: Cast did not go through - recasting (" . CastMissN . "/2)")
			Sleep, % Tm(TA("castretry", 150))
			if (CastMissN = 2 and RodSlotKey != "")
				ForceReEquip := true
			goto RestartMacro
			}
		CastMissN := 0
		CastSeenN := 0
		}
	}
CastHolding := false
if (!MacroRunning)
	goto Idle
; a nuke came during the cast: the rod was put away - start over (re-equip, cast)
if (NukeAfter)
	goto RestartMacro
VxTip(8, "Action: Waiting For Bobber (" . WaitForBobberDelay . "ms)")
KbPreT0 := A_TickCount
KbPreWait := Tm(WaitForBobberDelay)
; read the Keeperbound power bar now, while the bobber flies - so the end of the fight never waits on it
gosub, KbPreMaybe
; the totem check reads its icons now too, while nothing else happens - only if the read fits in the wait
if (TotemAuto and !TotemPreDone and (!TotemLastCheck or A_TickCount - TotemLastCheck >= TotemPollSec * 1000))
	{
	TotemLeft := KbPreWait - (A_TickCount - KbPreT0)
	if (TotemLeft >= ((TotemReadMs = "") ? 400 : TotemReadMs + 60))
		gosub, TotemAssess
	}
KbPreLeft := KbPreWait - (A_TickCount - KbPreT0)
if (KbPreLeft > 0)
	Sleep, %KbPreLeft%
if (!MacroRunning)
	goto Idle
if (NukeAfter)
	goto RestartMacro

if (ShakeMode == "Disabled")
goto BarMinigame
else
goto NavigationShakeMode

;====================================================================================================;

SwPassiveWatch:
if (WinActive("ahk_id " . RobloxHwnd))
	{
	send {lbutton up}
	send {rbutton up}
	}
VxTip(7, "Current Task: Passive - watching for the minigame")
VxTip(8, "")
VxTip(10, "")
MgInPlay := false
if (SpecialRod = "Stellarwave Melody")
	SwFightReset()
if (SpecialRod = "Tranquility")
	TqResetAll()
PasSeen := 0
Loop
	{
	if (!MacroRunning)
		goto Idle
	PasStellar := (SwPassive and SpecialRod = "Stellarwave Melody")
	if (!PassiveAll and !PasStellar)
		goto RestartMacro
	; tabbed out with something covering the fish bar: those pixels are not Roblox, so do not look at them
	if (!PasRobloxShown())
		{
		PasSeen := 0
		Sleep, 100
		continue
		}
	gosub, CaptureFishBar
	if (SpecialRod = "Tranquility")
		{
		PasSeen := ManiaVisible() ? PasSeen + 1 : 0
		if (PasSeen >= 2)
			{
			VxTip(7, "")
			gosub, PasFocus
			goto BarMinigame
			}
		if (PasSeen)
			{
			Sleep, 5
			continue
			}
		}
	else
		{
		if (FishLineVisible() or BarPresent())
			{
			VxTip(7, "")
			gosub, PasFocus
			goto BarMinigame
			}
		if ((SpecialRod = "Stellarwave Melody") ? ((SwPreset = "Ominous Ouija") ? OjSeen() : SwSeen()) : MinigameVisible(6))
			{
			SwBurstT0 := A_TickCount
			while (MacroRunning and A_TickCount - SwBurstT0 < 1500)
				{
				gosub, CaptureFishBar
				if (FishLineVisible() or BarPresent())
					{
					VxTip(7, "")
					gosub, PasFocus
					goto BarMinigame
					}
				Sleep, 5
				}
			}
		}
	SwPassWait := PasStellar ? SwPassiveMs : PassiveMs
	if SwPassWait is not number
		SwPassWait := 500
	Sleep, % (SwPassWait < 10) ? 10 : Round(SwPassWait)
	}

; a minigame showed up while you were in another window - Roblox has to be in front to play it
PasFocus:
if (RobloxHwnd and !WinActive("ahk_id " . RobloxHwnd))
	{
	WinActivate, ahk_id %RobloxHwnd%
	WinWaitActive, ahk_id %RobloxHwnd%, , 1
	}
return

; Smart cast: one look for the minigame while casting - the same test shaking uses, no waiting
CastMgPoll:
CastMgHit := false
if (!SmartCast or !MacroRunning)
	return
gosub, CaptureFishBar
if (SpecialRod = "Tranquility")
	{
	CastMgN := ManiaVisible() ? CastMgN + 1 : 0
	CastMgHit := (CastMgN >= 2)
	}
else if (FishLineVisible())
	CastMgHit := true
else
	{
	CastMgN := MinigameVisible(6) ? CastMgN + 1 : 0
	CastMgHit := (CastMgN >= ((SpecialRod = "Stellarwave Melody") ? 1 : 2))
	}
if (CastMgHit and !(SpecialRod = "Tranquility" or SpecialRod = "Lullaby" or SpecialRod = "Stellarwave Melody" or SpecialRod = "Oppressor" or UiStartGate()))
	CastMgHit := false
if (!CastMgHit)
	UiPhantomT := 0
return

; the minigame is up mid-cast: stop casting and play it now (no bobber wait, no shaking)
CastMgGo:
send {lbutton up}
CastHolding := false
CastSeenN := CastSeenN + 1
CastMissN := 0
VxTip(8, "Action: Minigame up - playing it")
MgInPlay := false
if (SpecialRod = "Tranquility")
	TqResetAll()
if (SpecialRod = "Stellarwave Melody" and ShakeMode != "Disabled")
	SwFightReset()
goto BarMinigame

NavigationShakeFailsafe:
NavigationFailsafeCount += 1
VxTip(10, "Failsafe: " . NavigationFailsafeCount . "/" . NavigationShakeFailsafe)
if (NavigationFailsafeCount >= NavigationShakeFailsafe) {
	SetTimer, NavigationShakeFailsafe, Off
	CastFailCount += 1
	ForceReset := true
}
return
NavigationShakeMode:
    VxTip(7, "Current Task: Shaking")
    VxTip(8, "Attempt Count: 0")
    VxTip(10, "Failsafe: 0/" NavigationShakeFailsafe)
    MgInPlay := false
    if (SpecialRod = "Tranquility")
        TqResetAll()
    if (SpecialRod = "Stellarwave Melody")
        SwFightReset()
    NavigationFailsafeCount := 0
    NavigationCounter := 0
    ForceReset := false
    MinigameSeen := 0
    MgScore := 0
    MgConf := 0
    SetTimer, NavigationShakeFailsafe, 1000
    ; continues into NavigationShakeModeRedo
NavigationShakeModeRedo:
    if (!MacroRunning)
        goto Idle
    if (ForceReset = true or NukeAfter) {
        VxTip(10, "")
        goto RestartMacro
    }
    Sleep, % Tm(NavigationSpamDelay)
    if (SpecialRod = "Splitbranch Twig")
        gosub TwigMaybePick
    gosub CaptureFishBar

    if (SpecialRod = "Tranquility") {
        MinigameSeen := ManiaVisible() ? MinigameSeen + 1 : 0
        MinigameHit := (MinigameSeen >= 2)
    } else {
        MinigameHit := FishLineVisible()
        if (MinigameHit) {
            MinigameSeen := 0
        } else {
            MinigameSeen := MinigameVisible(6) ? MinigameSeen + 1 : 0
            needSeen := (SpecialRod = "Stellarwave Melody") ? 1 : 2
            if (MinigameSeen >= needSeen)
                MinigameHit := true
        }
    }

    if (MinigameHit && (SpecialRod = "Tranquility" || SpecialRod = "Lullaby" || SpecialRod = "Stellarwave Melody" || SpecialRod = "Oppressor"
        || UiStartGate())) {
        SetTimer, NavigationShakeFailsafe, Off
        goto BarMinigame
    }
    if (!MinigameHit)
        UiPhantomT := 0
    NavigationCounter += 1
    VxTip(8, "Attempt Count: " NavigationCounter)
    Sleep, 1
    Send, {enter}
    goto NavigationShakeModeRedo
CastChargeCheck:
    if (MgCastCharged || WindowHeight < 100)
        return
    PCSearchTop := Round(0.13 * WindowHeight)
    PCSearchBottom := Round(0.90 * WindowHeight)
    PCVerifyOff := false
    ; both passes must find the full-charge marker
    Loop, 2 {
        if (A_Index = 2)
            Sleep, % Tm(TA("chg", 40))
        PCLastGoodY := -1
        PCGreenY := -1
        if (!PerfectAcquireGreen() || PerfectTrackFrame() != 2)
            return
    }
    MgCastCharged := true
return
TwigMaybePick:
    if (!MacroRunning)
        return
    DllCall("QueryPerformanceCounter", "Int64*", TwigNow)
    if (TwigLastCheck && (TwigNow - TwigLastCheck) / QpcFreq < 0.30)
        return
    TwigLastCheck := TwigNow
    if (!TwigPrompt(TwigLX, TwigRX, TwigLabY))
        return
    VxTip(8, "Action: Splitbranch Twig - choosing a fish")
    MouseGetPos, TwigSaveX, TwigSaveY
    TwigIconY := Round(0.493 * WindowHeight)
    ; two icons first, then the two labels
    TwigT := [[TwigLX, TwigIconY], [TwigRX, TwigIconY], [TwigLX, TwigLabY], [TwigRX, TwigLabY]]
    for TwigI, twigPt in TwigT {
        if (!MacroRunning)
            break
        TwigCX := twigPt[1]
        TwigCY := twigPt[2]
        MouseMove, %TwigCX%, %TwigCY%, 0
        Sleep, % Tm(TA("twig1", 40))
        Send, {lbutton down}
        Sleep, % Tm(TA("twig2", 40))
        Send, {lbutton up}
        Sleep, % Tm(TA("twig3", 260))
        if (!TwigPrompt(TwigLX, TwigRX, TwigLabY))
            break
    }
    MouseMove, %TwigSaveX%, %TwigSaveY%, 0
    DllCall("QueryPerformanceCounter", "Int64*", TwigLastCheck)
return
BarCalculationFailsafe:
    BarCalcFailsafeCounter += 1
    BarCalcLimit := BarCalculationFailsafe
    VxTip(10, "Failsafe: " BarCalcFailsafeCounter "/" BarCalcLimit)
    if (BarCalcFailsafeCounter >= BarCalcLimit) {
        SetTimer, BarCalculationFailsafe, Off
        CastFailCount += 1
        ForceReEquip := true
        ForceReset := true
    }
return
BarMinigame:
    MgInPlay := true
    GradLive := true
    gosub SpeedCaps
    DbX0 := -1
    DbSeenQ := 0
    DbMoveQ := 0
    DbInv := false
    if (SpecialRod = "Stellarwave Melody" && ShakeMode = "Disabled")
        SwFightReset()
    UiEdgeReset()
    BarColRing := []
    BarColT := 0
    RemBarRing := []
    HudWRing := []
    HudWMed := 0
    CastFailCount := 0

    if (SpecialRod = "Tranquility") {
        VxTip(7, "Current Task: Playing Notes")
        VxTip(8, "")
        VxTip(10, "")
        ForceReset := false
        MinigameLost := 0
        DllCall("QueryPerformanceCounter", "Int64*", TqNowC)
        TqResetFight(TqNowC / QpcFreq)
        goto BarMinigame2
    }

    VxTip(7, "Current Task: Calculating Bar Size")
    VxTip(8, "")
    VxTip(10, "Failsafe: 0/" BarCalculationFailsafe)
    ForceReset := false
    BarCalcFailsafeCounter := 0
    MgFightMode := false
    MgOverWhy := ""
    PasNow := (PassiveAll || (SwPassive && SpecialRod = "Stellarwave Melody"))
    PasLastSeen := A_TickCount
    if (!PasNow)
        SetTimer, BarCalculationFailsafe, 1000
    else
        VxTip(10, "Failsafe: off (passive)")

    if (SpecialRod = "Noiseform") {
        NoiseWCal := 0, NoiseWCnt := {}, NoiseWVote := 0
        NoisePrevC := -1, NoisePrevT := 0, NoiseVelC := 0, NoiseCoastN := 0
        NoiseStillX := -1, NoiseStillC := 0, NoiseLostN := 0
        NoiseEHist := [], NoiseBandT := -99, NoiseBandB := -99, NoiseRlW := 0, NoiseRlN := 0
        NoiseFishPrev := -1, NoiseFishT := 0, NoiseFoundStreak := 0
        NoiseJumpHold := 0, NoiseStuckN := 0, NoiseStuckRel := 0, NoiseStaleN := 0, NoiseStaleBlk := 0
        NoiseOnZoneN := 0, NoiseLastBarX := -1, NoiseAltW := 0, NoiseAltN := 0, NoiseZSeenT := 0
        NoiseRate := 1, NoiseRateT := 0
        NoiseN6 := 6, NoiseN8 := 8, NoiseN15 := 15, NoiseN45 := 45
        HudZoneShown := false
        HudDirty := true
    }
    ; continues into BarMinigameRedo
BarMinigameRedo:
    if (!MacroRunning)
        goto Idle
    if (SpecialRod = "Splitbranch Twig")
        gosub TwigMaybePick
    if (ForceReset = true or NukeAfter) {
        VxTip(10, "")
        goto RestartMacro
    }
    gosub CaptureFishBar

    if (PasNow) {
        if (BarPresent() || FishLineVisible() || MinigameVisible(6)
            || (SpecialRod = "Stellarwave Melody" && (SwPreset = "Ominous Ouija" ? OjSeen() : SwSeen()))) {
            PasLastSeen := A_TickCount
        } else if (A_TickCount - PasLastSeen > TA("passivelost", 3000)) {
            VxTip(10, "")
            goto RestartMacro
        }
    }

    if (BarPresent() && (SpecialRod = "Stellarwave Melody" || SpecialRod = "Oppressor" || UiStartGate())) {
        if (SpecialRod = "Dreambreaker" && !DbSeenQ)
            DllCall("QueryPerformanceCounter", "Int64*", DbSeenQ)
        BarWidthSamples := [RunWidth]
        NoiseEntryFish := NoiseFishFresh ? 1 : 0
        sampleRounds := (SpecialRod = "Stellarwave Melody") ? 3 : 8
        Loop, %sampleRounds% {
            if (!MacroRunning)
                goto Idle
            Sleep, % Tm(TA("barsamp", 12))
            gosub CaptureFishBar
            if (BarPresent())
                BarWidthSamples.Push(RunWidth)
            if (NoiseFishFresh)
                NoiseEntryFish += 1
        }
        if (BarWidthSamples.Length() >= 3 && (SpecialRod != "Noiseform" || NoiseEntryFish >= 2)) {
            WhiteBarSize := MedianOf(BarWidthSamples)
            BarWCal := WhiteBarSize
            BarWTrust := WhiteBarSize
            goto BarMinigameSingle
        }
    }

    if (SpecialRod = "Stellarwave Melody") {
        if (SwPreset = "Ominous Ouija")
            OjStep()
        else if (SwPhase && SwStarsValid)
            SwClickStep()
    }
    Sleep, 1
    goto BarMinigameRedo
BarMinigameSingle:
    UiHoShown := false
    UiNoBarN := 0
    MgFightMode := true
    BarCalcFailsafeCounter := 0
    MgCastCharged := false
    UiEdgeStart()
    VxTip(7, "Current Task: Playing Bar Minigame")
    VxTip(8, "")

    MgLastSig := -1, MgStaticN := 0
    BarSizeBadN := 0, BarSizePend := 0, BarSizePendN := 0
    DllCall("QueryPerformanceCounter", "Int64*", MgStaticAt)
    AtLeastFindWhiteBar := false
    LastFishX := -1, LastBarL := -1, LastBarR := -1
    MinigameLost := 0
    BelNoStrong := 0

    BelPrevT := [0, 0], BelVel := [0, 0], BelBVel := [0, 0]
    BelSide := [0, 0], BelAcc := [0, 0], BelBias := [0, 0]
    BelWallL := [-1, -1], BelWallR := [-1, -1], BelSetT := [0, 0]

    HudFish2Tgt := -1, HudFish2Cur := -1, HudBar2Tgt := -1, HudBar2Cur := -1, HudBar2W := 0

    ; Noiseform state
    NoisePrevC := -1, NoisePrevT := 0, NoiseFishPrev := -1, NoiseFishT := 0
    NoiseStillX := -1, NoiseStillC := 0, NoiseWCal := 0
    NoiseJumpN := 0, NoiseJumpHold := 0, NoiseStuckN := 0, NoiseStuckRel := 0
    NoiseStaleN := 0, NoiseStaleBlk := 0, NoiseOnZoneN := 0, NoiseLastBarX := -1
    NoiseRate := 1, NoiseRateT := 0
    NoiseN6 := 6, NoiseN8 := 8, NoiseN15 := 15, NoiseN45 := 45
    NoiseAltW := 0, NoiseAltN := 0, NoiseZSeenT := 0
    NoiseWCnt := {}, NoiseWVote := 0, NoiseLastD := 0, NoiseOscN := 0
    NoiseVelC := 0, NoiseLostN := 0, NoiseRowOff := 0, NoiseCoastN := 0
    NoiseWBase := 0, NoiseWBaseML := 0, NoiseWDthr := 6
    NoiseZoneTgt := -1, NoiseZoneT := 0, NoiseZoneKind := ""
    NoiseZScanT := 0, NoiseZFreshT := 0, NoisePendKind := "", NoisePendT := 0
    NoiseWNow := "", NoiseWBlk := 0
    NoiseDkRing := [], NoiseMlRing := [], NoiseD6Ring := []
    NoiseDkIdx := 0, NoiseDkN := 0, NoiseWGT := 0
    Loop, 32 {
        ringIdx := A_Index - 1
        NoiseDkRing[ringIdx] := -1
        NoiseMlRing[ringIdx] := -1
        NoiseD6Ring[ringIdx] := -1
    }
    NoiseMissN := 0, NoiseMissT := 0
    WMissN := 0, WMissT := 0, WRW := 0, WRH := 0, WRN := 0, WRIdx := 0, WRSkip := 0
    NoiseZWx := -1, NoiseZGx := -1, NoiseZKx := -1, NoiseZOK := false
    NfPW := -1, NfPG := -1, NfPK := -1, NfCW := -1, NfCG := -1, NfCK := -1
    NfIconN := 0, NfGoneN := 0, NfLatchKind := "", NfLatchT := 0
    NfRingN := 0, NfRingIdx := 0, NfWhy := ""
    NoiseEHist := [], NoiseBandT := -99, NoiseBandB := -99, NoiseRlW := 0, NoiseRlN := 0
    RelLock := 0
    DutyAvg := 0.5, DarkAcc := 0, NoteAcc := 0, DarkHoldN := 0, DarkFlashing := false

    NoteLockX := -1, NoteLockN := 0, NoteNextX := -1, NoteNextY := -1, NoteLockY := -1, NoteHoldX := -1

    ; Pinions Aria
    PnState := 0, PnFall := 0, PnFallN := 0, PnRes := 0
    PnGlueAt := 0, PnGlueLo := 0, PnGlueHi := 0, PnAwayAt := 0, PnTwoN := 0, PnResBlockUntil := 0
    PnPrevT := 0, PnPrevY := -1, PnPrevX := -1, PnProg := -1, PnNoteX := -1, PnCoverX := -1
    PnImpactAt := 0, PnWhy := "", PnSeenY := -1, PnSeenAt := 0, PnLandAt := 0, PnLeaveAt := 0
    PnGone := false, PnTipAt := 0

    ; Lullaby
    LullFrames := 0, LullCalN := 0, LullR := 0, LullLitOk := "", LullSecN := 0
    LullCalLt := [], LullCalDk := [], LullCalLs := [], LullBg := [], LullSecA := [], LullSecB := []
    LullArmA := [], LullClrT := [], LullHitC := []
    LullLastAct := 0, LullActive := false, LullSeen := false, LullGoneN := 0, LullClicks := 0

    NoteAllN := 0
    LineBarW := -1, LineBarAge := 99
    MaxLeftToggle := false, MaxRightToggle := false

    PrevBarX := -1, PrevFishX := -1, PrevSampleT := 0
    BarVel := 0.0, FishVel := 0.0, PrevPosAbs := -1
    PrecisionDown := false, PrecisionResendAt := 0
    BarLostAt := 0, NoFishAt := 0, BlindAcc := 0, BarWOutFirst := 0
    BarWCal := WhiteBarSize
    BarWRing := [], BarWMed := 0, BarWOutN := 0
    HudWRing := [], HudWMed := 0
    BarWidthTrusted := true
    BarLiveL := -1, BarLiveR := -1, BarLiveMiss := 0, BarWLive := -1, BarLiveOnlyAt := 0

    CastBlindN := 0, CastPrevL := -1, CastPrevW := -1, CastPrevF := -1
    CastSameN := 0, CastSameT := 0, CastStatic := false

    RemWhiteX := -1, RemBlackX := -1, RemTargetX := -1, CtrAcc := 0, CtrBias := 0
    MiguLastX := -1
    NoiseFoundStreak := 0

    ; keep the safe-zone inset under 40% of the track
    ZoneInset := WhiteBarSize * SideBarRatio
    ZoneInsetMax := (TrackRight - TrackLeft) * 0.4
    if (ZoneInset > ZoneInsetMax)
        ZoneInset := ZoneInsetMax
    MaxLeftBar := TrackLeft + ZoneInset
    MaxRightBar := TrackRight - ZoneInset

    gosub ShowHud
    gosub UpdateHud
    ; continues into BarMinigame2
BarMinigame2:
    if (!MacroRunning)
        goto Idle
    if (ForceReset = true or NukeAfter) {
        MgOverWhy := "forcereset"
        goto BarMinigameOver
    }

    ; pace scans so they start ScanGapMs apart
    if (ScanGapMs > 0 && PfPrev) {
        DllCall("QueryPerformanceCounter", "Int64*", PfA)
        PreciseSleep(ScanGapMs - (PfA - PfPrev) * 1000 / QpcFreq)
    }
    DllCall("QueryPerformanceCounter", "Int64*", PfA)
    PfDt := PfPrev ? Round((PfA - PfPrev) * 1000 / QpcFreq, 1) : 0
    PfPrev := PfA

    Sleep, 0
    if (SwPressK)
        SwPressTick()

    DllCall("QueryPerformanceCounter", "Int64*", PfB)
    gosub CaptureFishBar
    DllCall("QueryPerformanceCounter", "Int64*", PfC)
    PfSleep := Round((PfB - PfA) * 1000 / QpcFreq, 1)
    PfCap := Round((PfC - PfB) * 1000 / QpcFreq, 1)

    uiRod := (SpecialRod = "Tranquility" || SpecialRod = "Lullaby" || SpecialRod = "Stellarwave Melody")
    UiGoneNow := (!uiRod && UiEdgeTick() = "gone")
    if (UiGoneNow) {
        MgOverWhy := "uigone"
        goto BarMinigameOver
    }
    if (UiGoneT && !uiRod) {
        DllCall("QueryPerformanceCounter", "Int64*", UiFastNow)
        if (!BarPresent() && !FishLineVisible())
            UiNoBarN += 1
        else
            UiNoBarN := 0
        if (UiNoBarN >= 2 && (UiFastNow - UiGoneT) * 1000 / QpcFreq >= TA("uigonefast", 0)) {
            UiNoBarN := 0
            MgOverWhy := "uigone"
            goto BarMinigameOver
        }
    } else {
        UiNoBarN := 0
    }

    ; Lullaby: click on lit sectors, end once the dial has gone
    if (SpecialRod = "Lullaby") {
        if (LullScan() && VxPressOk()) {
            Send, {lbutton down}
            Sleep, % Tm(TA("lullhold", 20))
            Send, {lbutton up}
            LullClicks += 1
            VxTip(9, "Lullaby: " LullSecN " light sector(s), hits " LullClicks " (last #" LullHitSec ")")
        }
        if (LullActive) {
            LullSeen := true
            LullGoneN := 0
        } else if (LullSeen) {
            LullGoneN += 1
            if (LullGoneN >= 3 && (A_TickCount - LullLastAct) >= TA("lullgone", 250)) {
                MgOverWhy := "lullaby-done"
                goto BarMinigameOver
            }
        }
        goto BarMinigame2
    }

    if (SpecialRod = "Tranquility") {
        DllCall("QueryPerformanceCounter", "Int64*", TqNowC)
        if (!ManiaStep(TqNowC / QpcFreq)) {
            if (TqExpired) {
                CastFailCount += 1
                ForceReEquip := true
                VxTip(10, "")
                goto RestartMacro
            }
            goto BarMinigameOver
        }
        goto BarMinigame2
    }

    if (SpecialRod = "Bellona's Waraxe") {
        BelRes := BellonaScan()
        if (BelRes = 2)
            BelNoStrong := 0
        else
            BelNoStrong += 1
        if (BelRes = 0) {
            MinigameLost += 1
            if (MinigameLost = 1)
                BellonaRelease()
            if (MinigameLost >= 8)
                goto BarMinigameOver
            goto BarMinigame2
        }
        MinigameLost := 0
        if (BelNoStrong >= 150) {
            BellonaRelease()
            goto BarMinigameOver
        }
        BellonaDrive(1)
        BellonaDrive(2)
        if (BelOK[1]) {
            if (BelF[1] >= 0)
                MoveHudFish(FishBarLeft + BelF[1])
            MoveHudBarSpan(FishBarLeft + BelA[1], BelB[1] - BelA[1])
        }
        if (BelOK[2]) {
            if (BelF[2] >= 0)
                MoveHudFish2(FishBarLeft + BelF[2])
            MoveHudBar2Span(FishBarLeft + BelA[2], BelB[2] - BelA[2])
        }
        ; Debug > Bar positions: both bars as they were read (the first one's width is the read one, not the average)
        if (BelOK[1]) {
            VxDbgBarC := FishBarLeft + (BelA[1] + BelB[1]) / 2, VxDbgBarW := BelB[1] - BelA[1], VxDbgBarT := A_TickCount
            if (BelF[1] >= 0)
                VxDbgFish := FishBarLeft + BelF[1], VxDbgFishT := A_TickCount
        }
        if (BelOK[2]) {
            VxDbgBar2C := FishBarLeft + (BelA[2] + BelB[2]) / 2, VxDbgBar2W := BelB[2] - BelA[2], VxDbgBar2T := A_TickCount
            if (BelF[2] >= 0)
                VxDbgFish2 := FishBarLeft + BelF[2], VxDbgFish2T := A_TickCount
        }
        if (HudNoteX >= 0)
            MoveHudNote(-1)
        if (HudNote2X >= 0)
            MoveHudNote2(-1)
        if (HudZoneShown) {
            HudZoneShown := false
            HudDirty := true
        }
        goto BarMinigame2
    }

    FoundBar := BarPresent()
    if (FoundBar && (SpecialRod = "None" || SpecialRod = "Splitbranch Twig") && BarWCal > 0 && RunWidth < 0.2 * BarWCal)
        FoundBar := false
    LineSeen := FishLineVisible()
    if (!FoundBar && !LineSeen
        && SpecialRod != "Remembrance" && SpecialRod != "MiguRod" && SpecialRod != "Halibut Harpoon"
        && SpecialRod != "Tryhard Rod" && SpecialRod != "Stellarwave Melody" && SpecialRod != "Doomsekkar"
        && SpecialRod != "Oppressor")
        LineSeen := (FindArrowX() >= 0)

    ; nothing on screen: release and decide whether the fight is over
    if (!FoundBar && !LineSeen) {
        if (SpecialRod = "Stellarwave Melody" && SwPreset != "Ominous Ouija" && SwPhase && SwStarsValid)
            SwClickStep()
        NoiseFoundStreak := 0
        MinigameLost += 1
        if (MinigameLost = 1) {
            if (UiState != 2 && !SwPressK)
                gosub CastChargeCheck
            if (!SwPressK)
                Send, {lbutton up}
            SwWantK := 0
            PrecisionDown := false
            DllCall("QueryPerformanceCounter", "Int64*", BarLostAt)
            HudLossHidden := false
        }
        DllCall("QueryPerformanceCounter", "Int64*", BarLostNow)
        if (!HudLossHidden && BarLostAt && (BarLostNow - BarLostAt) * 1000 / QpcFreq > TA("barhide", 150)) {
            gosub HideHud
            HudLossHidden := true
        }
        BarLostMs := BarLostAt ? (BarLostNow - BarLostAt) * 1000 / QpcFreq : 0
        BarLostLimNow := BarLostLim()
        if (SpecialRod = "Stellarwave Melody" && SwPreset = "Ominous Ouija") {
            OjStep()
            if (OjStarsVis) {
                BarLostLimNow := 2147483647
            } else if (OjStarSeenT && BarLostMs >= TA("swendfast", 120) && (A_TickCount - OjStarSeenT) >= 80) {
                MgOverWhy := "ojend"
                goto BarMinigameOver
            }
        } else if (SpecialRod = "Stellarwave Melody" && SwStarOkT) {
            if (!SwStarsValid) {
                if (!SwStarGoneAt)
                    SwStarGoneAt := BarLostNow
                if (BarLostMs >= TA("swendfast", 120) && (BarLostNow - SwStarGoneAt) * 1000 / QpcFreq >= 80) {
                    MgOverWhy := "swend"
                    goto BarMinigameOver
                }
            } else {
                SwStarGoneAt := 0
                if (BarLostLimNow < TA("barlostui", 450))
                    BarLostLimNow := TA("barlostui", 450)
            }
        } else if (UiState = 2 && !UiGoneT && BarLostLimNow < TA("barlostui", 450)) {
            BarLostLimNow := TA("barlostui", 450)
        }
        if (BarLostAt && BarLostMs > BarLostLimNow) {
            MgOverWhy := "barlost"
            goto BarMinigameOver
        }
        goto BarMinigame2
    }

    ; bar or line is back
    if (MinigameLost && HudBuilt && HudLossHidden)
        gosub ShowHud
    HudLossHidden := false
    MinigameLost := 0
    BarLostAt := 0
    SwStarGoneAt := 0
    NoiseFoundStreak += 1

    if (FoundBar && RunWidth > 0) {
        ; rolling width estimate; four agreeing outliers in a row replace it
        if (BarWidthTrusted && !(BarWCal > 0 && RunWidth > 1.3 * BarWCal)) {
            if (BarWMed <= 0 || Abs(RunWidth - BarWMed) <= 0.25 * BarWMed) {
                BarWPush(RunWidth)
                BarWOutN := 0
                BarWOutFirst := 0
            } else {
                if (BarWOutN > 0 && BarWOutFirst > 0 && Abs(RunWidth - BarWOutFirst) <= 0.15 * BarWOutFirst) {
                    BarWOutN += 1
                } else {
                    BarWOutFirst := RunWidth
                    BarWOutN := 1
                }
                if (BarWOutN >= 4) {
                    BarWRing := []
                    BarWMed := 0
                    BarWOutN := 0
                    BarWOutFirst := 0
                    BarWPush(RunWidth)
                }
            }
        }
        NewBarSize := (BarWMed > 0) ? BarWMed : RunWidth
        if (SpecialRod = "Noiseform" && NoiseWCal >= 40)
            NewBarSize := NoiseWCal
        if (!HudZoneShown && HudBuilt && (SpecialRod != "Noiseform" || NoiseWCal >= 40)) {
            HudZoneShown := true
            HudDirty := true
        }
        BarWTrust := (BarWMed > 0 && Abs(RunWidth - BarWMed) <= 0.25 * BarWMed) ? RunWidth : NewBarSize
        if (BarWidthTrusted && Abs(NewBarSize - WhiteBarSize) > 0.2 * WhiteBarSize) {
            WhiteBarSize := NewBarSize
            ZoneInset := WhiteBarSize * SideBarRatio
            ZoneInsetMax := 0.4 * (TrackRight - TrackLeft)
            if (ZoneInset > ZoneInsetMax)
                ZoneInset := ZoneInsetMax
            MaxLeftBar := TrackLeft + ZoneInset
            MaxRightBar := TrackRight - ZoneInset
            gosub UpdateHud
        }
    }

    DllCall("QueryPerformanceCounter", "Int64*", PfD)
    FishX := GetFishPos()
    DllCall("QueryPerformanceCounter", "Int64*", PfE)

    if (SpecialRod = "Stellarwave Melody") {
        if (SwPreset = "Ominous Ouija")
            OjStep()
        else
            SwClickStep()
    }

    if (SpecialRod != "Tranquility" && SpecialRod != "Lullaby" && SpecialRod != "Noiseform") {
        if (FishX >= 0) {
            NoFishAt := 0
        } else if (!NoFishAt) {
            NoFishAt := A_TickCount
        } else if ((A_TickCount - NoFishAt) > TA("nofish", 8000)) {
            MgOverWhy := "nofishline"
            goto BarMinigameOver
        }
    }

    NoteAt := NoteTarget()
    TargetIsNote := false
    DllCall("QueryPerformanceCounter", "Int64*", PfF)
    PfFish := Round((PfE - PfD) * 1000 / QpcFreq, 1)
    PfNote := Round((PfF - PfE) * 1000 / QpcFreq, 1)

    isPinions := (SpecialRod = "Pinions Aria")
    if (DarkFlashing)
        MoveHudNote(FishX)
    else if (isPinions && NoteAt < 0 && NoteBias >= 100)
        MoveHudNote(NoteHoldX)
    else
        MoveHudNote(NoteAt)
    if (SpecialRod = "Remembrance")
        MoveHudNote(RemBlackX)
    MoveHudNote2((isPinions && !DarkFlashing) ? NoteNextX : -1)
    if (FishX >= 0)
        MoveHudFish(FishX)

    if (isPinions) {
        FishX := PinionPlan(FishX, NoteAt, TargetIsNote)
        DllCall("QueryPerformanceCounter", "Int64*", PnTipNow)
        if (!PnTipAt || (PnTipNow - PnTipAt) / QpcFreq >= 0.2) {
            PnTipAt := PnTipNow
            PnTipTxt := "Pinions: progress " (PnProg >= 0 ? Round(PnProg * 100) "%" : "?") "  |  " PnWhy
            VxTip(13, PnTipTxt)
        }
    } else if (NoteAt >= 0) {
        NoteW2 := NoteBias
        if (SpecialRod = "Noiseform" || SpecialRod = "Halibut Harpoon")
            NoteW2 := 100
        NoteW2 := Max(0, Min(100, NoteW2))
        if (SpecialRod = "Halibut Harpoon" && FishX >= 0 && RunWidth > 0)
            NoteAt := Max(FishX - 0.42 * RunWidth, Min(FishX + 0.42 * RunWidth, NoteAt))
        ; blend toward the note by NoteW2 percent
        if (FishX >= 0)
            FishX := (NoteAt * NoteW2 + FishX * (100 - NoteW2)) / 100
        else if (SpecialRod != "Noiseform" && SpecialRod != "Halibut Harpoon")
            FishX := NoteAt
        if (isPinions) {
            NoteHoldX := NoteAt
            DllCall("QueryPerformanceCounter", "Int64*", NoteHoldAt)
        }
        TargetIsNote := (NoteW2 >= 60)
    } else if (isPinions && NoteBias >= 100 && NoteHoldX >= 0) {
        DllCall("QueryPerformanceCounter", "Int64*", NoteHoldNow)
        if (NoteHoldAt && (NoteHoldNow - NoteHoldAt) * 1000 / QpcFreq < 220) {
            FishX := NoteHoldX
            TargetIsNote := true
        } else {
            NoteHoldX := -1
        }
    }

    if (DarkFlashing) {
        if (DutyWant(DarkAcc, DutyAvg))
            gosub PrecisionHold
        else
            gosub PrecisionRelease
        goto BarMinigame2
    }

    ; learn how often the button is held while on target
    if (FishX >= 0 && RunWidth > 0) {
        DutyErr := Abs(FishX - (RunLeft + RunWidth / 2))
        DutyNear := TargetIsNote ? NoteHoldZone(RunWidth) : 30
        if (DutyNear < 30)
            DutyNear := 30
        if (DutyErr < DutyNear)
            DutyAvg := 0.9 * DutyAvg + (PrecisionDown ? 0.1 : 0)
    }

    if (FishX < 0 && SpecialRod = "Noiseform") {
        NoiseLostN += 1
        if (NoiseLostN = 1)
            NoiseLostAt := A_TickCount
        gosub PrecisionRelease
        if (NoiseLostN >= 60 && (A_TickCount - NoiseLostAt) >= TA("noiselost", 2000)) {
            MgOverWhy := "nofish60"
            goto BarMinigameOver
        }
        goto BarMinigame2
    }
    if (SpecialRod = "Noiseform")
        NoiseLostN := 0

    if (FishX >= 0)
        goto BarPrecisionControl

    if (DutyWant(BlindAcc, DutyAvg))
        gosub PrecisionHold
    else
        gosub PrecisionRelease
    goto BarMinigame2
BarPrecisionControl:
    ; ---- bar not visible this frame ----
    if (!FoundBar) {
        if (SpecialRod = "Castbound" && CastBlindN < 40) {
            CastBlindN += 1
            WantDown := DutyWant(NoteAcc, DutyAvg)
            Goto, PrecisionApply
        }
        if (SpecialRod = "Remembrance" || SpecialRod = "MiguRod" || SpecialRod = "Halibut Harpoon"
            || SpecialRod = "Tryhard Rod" || SpecialRod = "Stellarwave Melody" || SpecialRod = "Doomsekkar"
            || SpecialRod = "Oppressor") {
            Gosub, PrecisionRelease
            Goto, BarMinigame2
        }
        BpcArrow := FindArrowX()
        if (BpcArrow < 0) {
            Gosub, PrecisionRelease
            Goto, BarMinigame2
        }
        MoveHudBarC(BpcArrow)
        WantDown := (BpcArrow > FishX) ? false : true
        Goto, PrecisionApply
    }

    BarX := RunLeft + RunWidth / 2
    CastBlindN := 0
    MoveHudBarSpan(RunLeft, RunWidth)
    BpcNoise := (SpecialRod = "Noiseform")
    BpcCast := (SpecialRod = "Castbound")

    ; ---- Dreambreaker: remember when the bar was first seen and first moved ----
    if (SpecialRod = "Dreambreaker" && !DbInv) {
        DllCall("QueryPerformanceCounter", "Int64*", DbNowQ)
        if (DbX0 < 0) {
            DbX0 := BarX
            if (!DbSeenQ)
                DbSeenQ := DbNowQ
        } else if (!DbMoveQ && Abs(BarX - DbX0) > Max(6, 12 * WindowHeight / 1440)) {
            DbMoveQ := DbNowQ
        }
    }

    ; ---- velocity estimate ----
    DllCall("QueryPerformanceCounter", "Int64*", tNowP)
    if (PrevSampleT > 0) {
        dtP := (tNowP - PrevSampleT) / QpcFreq
        if (dtP > 0.0005) {
            rawBarVel := (BarX - PrevBarX) / dtP
            rawFishVel := (FishX - PrevFishX) / dtP
            if (Abs(FishX - PrevFishX) > 100) {
                rawFishVel := 0
                FishVel := 0
            }
            if (TargetIsNote) {
                rawFishVel := 0
                FishVel := 0
            }
            VsA := VelocitySmoothing
            if (BpcNoise && NoiseRate > 1 && VsA > 0 && VsA < 1)
                VsA := 1 - (1 - VsA) ** NoiseRate
            if (!BpcNoise && VsA < 0.6)
                VsA := 0.6
            BarVel := VsA * rawBarVel + (1 - VsA) * BarVel
            FishVel := VsA * rawFishVel + (1 - VsA) * FishVel
            PrevBarX := BarX
            PrevFishX := FishX
            PrevSampleT := tNowP
        }
    } else {
        PrevBarX := BarX
        PrevFishX := FishX
        PrevSampleT := tNowP
    }

    ; prediction (Reel > Bar behaviour, per rod): aim where the fish will be a moment from now - its speed on screen
    ; times the delay from reading the screen to the bar answering, at most a quarter bar off where it is
    if (PredictOn && !TargetIsNote && RunWidth > 0) {
        PredCap := 0.25 * RunWidth
        FishX := FishX + Max(-PredCap, Min(PredCap, FishVel * TA("predlead", 90) / 1000))
    }

    PosError := BarX - FishX
    RelVel := BarVel - FishVel

    ; ---- slow mid-line trim ----
    BpcHz := TA("hardzone", 0)
    BpcFishOn := (FishX >= RunLeft && FishX <= RunLeft + RunWidth)
    if (!BpcNoise && !TargetIsNote && BpcFishOn
        && (BpcHz <= 0 || Abs(FishX - BarX) <= RunWidth * BpcHz / 100)) {
        if (dtP > 0 && dtP < 0.1)
            MidTrim += PosError * dtP * TA("midtrim", 0) / 10
        BpcMidLim := 0.35 * RunWidth
        if (MidTrim > BpcMidLim)
            MidTrim := BpcMidLim
        else if (MidTrim < -BpcMidLim)
            MidTrim := -BpcMidLim
        PosError := PosError + MidTrim
    }

    SteadyTarget := (TargetIsNote && SpecialRod != "Halibut Harpoon")

    ; ---- stopping distance ----
    if (BpcNoise) {
        StopDist := Abs(RelVel) * StoppingDistanceMultiplier * 0.04
        if (StopDist < CaptureW * 0.01)
            StopDist := CaptureW * 0.01
        if (StopDist > RunWidth * 0.5)
            StopDist := RunWidth * 0.5
    } else {
        StopDist := Abs(RelVel) * StoppingDistanceMultiplier
    }
    if (SteadyTarget && !BpcNoise)
        StopDist := StopDist * 1.6

    HalfW := RunWidth / 2
    MinReach := TrackLeft + HalfW
    MaxReach := TrackRight - HalfW

    CtrRs := (ResolutionScaling > 0) ? ResolutionScaling : 1
    CtrZoneE := Min(36 / CtrRs, 0.35 * RunWidth)
    CtrZoneV := 120 / CtrRs
    CtrHold := (SpecialRod != "Requiem") && !SteadyTarget
        && Abs(PosError) <= CtrZoneE && Abs(RelVel) <= CtrZoneV

    if (BpcNoise && !BpcFishOn) {
        if (NoiseFishFresh)
            NoiseStaleN := 0
        NoiseStuckN := 0
        NoiseStuckRel := 0
        NoiseLastBarX := Round(BarX)
    }

    ; ---- decision cascade ----
    if (BpcCast && CastStatic && RunLeft > FishBarLeft + 2 && RunLeft + RunWidth < FishBarRight - 2
        && Abs(PosError) <= 0.5 * RunWidth) {
        WantDown := DutyWant(NoteAcc, 0.5)
    } else if (FishX < MinReach) {
        WantDown := false
    } else if (FishX > MaxReach) {
        WantDown := true
    } else if (!SteadyTarget && !BpcNoise && !BpcCast && SpecialRod != "Halibut Harpoon"
        && RunWidth > 0 && BpcHz > 0 && Abs(FishX - BarX) > RunWidth * BpcHz / 100) {
        ; fish is off the bar: chase it
        WantDown := (FishX > BarX)
    } else if (CtrHold) {
        CtrKp := 0.0122 * CtrRs
        CtrKd := 0.00488 * CtrRs
        if (dtP > 0 && dtP < 0.1) {
            CtrBias := CtrBias - 0.25 * CtrKp * PosError * dtP
            CtrBias := Max(-0.2, Min(0.2, CtrBias))
        }
        CtrDuty := 0.463 + CtrBias - CtrKp * PosError - CtrKd * RelVel
        CtrDuty := Max(0, Min(1, CtrDuty))
        WantDown := DutyWant(CtrAcc, CtrDuty)
    } else if (BpcCast) {
        CastSdm := (StoppingDistanceMultiplier <= 0) ? 3.0 : StoppingDistanceMultiplier
        CastStopA := 1000 * (3 / CastSdm)
        CastSigma := PosError + RelVel * Abs(RelVel) / (2 * CastStopA)
        CastDead := Max(2, 0.02 * RunWidth)
        if (CastSigma > CastDead)
            WantDown := false
        else if (CastSigma < -CastDead)
            WantDown := true
        else
            WantDown := PrecisionDown
    } else if (SpecialRod = "Halibut Harpoon" && TargetIsNote) {
        HaliSigma := PosError + 0.55 * RelVel
        HaliDead := Max(2, 0.02 * RunWidth)
        if (HaliSigma > HaliDead)
            WantDown := false
        else if (HaliSigma < -HaliDead)
            WantDown := true
        else
            WantDown := PrecisionDown
    } else if (BpcFishOn) {
        if (BpcNoise) {
            if (NoiseFishFresh)
                NoiseStaleN := 0
            else
                NoiseStaleN := NoiseStaleN + 1
            BpcRbx := Round(BarX)
            if (PrecisionDown && Abs(BpcRbx - NoiseLastBarX) <= 2 && Abs(PosError) > 100) {
                NoiseStuckN += 1
            } else if (Abs(BpcRbx - NoiseLastBarX) > 2) {
                NoiseStuckN := 0
                NoiseLastBarX := BpcRbx
            }
            if (NoiseStuckN >= NoiseN6 && !PrecisionDown) {
                NoiseStuckRel += 1
                if (NoiseStuckRel >= 12) {
                    NoiseStuckN := 0
                    NoiseStuckRel := 0
                    NoiseLastBarX := Round(BarX)
                }
            } else {
                NoiseStuckRel := 0
            }
            ZoneSlack := 0
            if (NoiseZoneTgt >= 0)
                ZoneSlack := Round(CaptureW * 0.030)
            if (NoiseZoneTgt >= 0 && ZoneSlack > 0 && Abs(PosError) <= ZoneSlack)
                NoiseOnZoneN := NoiseOnZoneN + 1
            else
                NoiseOnZoneN := 0
            if (ZoneSlack > 0 && Abs(PosError) <= ZoneSlack) {
                WantDown := ((PosError + 0.12 * RelVel) > 0) ? false : true
            } else {
                ControlOut := Kp * PosError + Kd * RelVel * 0.60
                WantDown := (ControlOut <= 0) ? true : false
            }
        } else if (SteadyTarget && Abs(PosError) <= NoteHoldZone(RunWidth)) {
            NoteDuty := DutyAvg - PosError / (NoteHoldZone(RunWidth) * 5.4) - BarVel * 0.0016
            NoteDuty := Max(0, Min(1, NoteDuty))
            WantDown := DutyWant(NoteAcc, NoteDuty)
        } else if (PosError < -StopDist) {
            WantDown := true
        } else if (PosError > StopDist) {
            WantDown := false
        } else {
            ; inside the stopping band: look ahead by the velocity
            NoteAcc := 0
            CtrLook := (Kp > 0) ? Kd / Kp : 0.12
            CtrMax := SteadyTarget ? 0.25 : 1.50
            CtrLook := Max(0.02, Min(CtrMax, CtrLook))
            WantDown := ((PosError + RelVel * CtrLook) <= 0) ? true : false
        }
    } else {
        if (BpcNoise) {
            ControlOut := Kp * PosError + Kd * RelVel * 0.60
        } else if (SteadyTarget) {
            OutLook := (Kp > 0) ? Kd / Kp : 0.12
            OutLook := Max(0.02, Min(0.25, OutLook))
            ControlOut := Kp * (PosError + RelVel * OutLook)
        } else {
            ControlOut := Kp * PosError + Kd * RelVel
        }
        WantDown := (ControlOut <= 0) ? true : false
    }
    ; falls through into PrecisionApply
PrecisionApply:
    if (SpecialRod = "Noiseform") {
        if (WantDown && !PrecisionDown && NoiseFoundStreak < NoiseN6)
            WantDown := false
        if (NoiseStuckN >= NoiseN6)
            WantDown := false
    }
    if (SpecialRod = "Noiseform" && WantDown && !PrecisionDown && NoiseStaleN >= NoiseN6
        && !(NoiseZoneTgt >= 0 && NoiseZOK)) {
        NoiseStaleBlk += 1
        if (NoiseStaleBlk < NoiseN15)
            WantDown := false
        else
            NoiseStaleBlk := 0
    } else {
        NoiseStaleBlk := 0
    }
    if (SpecialRod = "Dreambreaker" && !DbInv && DbSeenQ) {
        DllCall("QueryPerformanceCounter", "Int64*", DbNowQ)
        if ((DbMoveQ && (DbNowQ - DbMoveQ) / QpcFreq >= 1.4) || (DbNowQ - DbSeenQ) / QpcFreq >= 3.1)
            DbInv := true
    }
    if (SpecialRod = "Dreambreaker" && DbInv)
        WantDown := !WantDown
    if (WantDown)
        Gosub, PrecisionHold
    else
        Gosub, PrecisionRelease
    Goto, BarMinigame2
PrecisionHold:
    if (SpecialRod = "Stellarwave Melody" && (SwPressK || SwWantK))
        return
    if (SwClickFirst()) {
        if (PrecisionDown || (GetKeyState("LButton") && !SwPressK)) {
            Send, {LButton up}
            PrecisionDown := false
            DllCall("QueryPerformanceCounter", "Int64*", PrecisionUpAt)
        }
        return
    }
    if (!PrecisionDown) {
        ; minimum gap since the last release
        if (SpecialRod = "Requiem") {
            SwMinRel := ReelMinRelease
        } else if (SpecialRod = "Stellarwave Melody" && SwPhase) {
            if (SwRetryClicks)
                PhDwellOk := (SwPressN + SwRetry < 3 && SwClickSlot != SwOverS)
            else
                PhDwellOk := !SwPressN
            if (SwDwell && PhDwellOk)
                SwMinRel := 500
            else if (SwPreK)
                SwMinRel := 320
            else if (SwFastClicks || SwMaxSigns)
                SwMinRel := 250
            else
                SwMinRel := 100
        } else {
            SwMinRel := 0
        }
        if (SwMinRel > 0 && PrecisionUpAt) {
            DllCall("QueryPerformanceCounter", "Int64*", ReelNow)
            if ((ReelNow - PrecisionUpAt) * 1000 / QpcFreq < SwMinRel)
                return
        }
        if (SwPreK) {
            SwPreEnd("reel")
            return
        }
        if (SwParkAt && SwParkWait())
            return
        if (!VxPressOk())
            return
        Send, {LButton down}
        PrecisionDown := true
        DllCall("QueryPerformanceCounter", "Int64*", PrecisionDownAt)
        PrecisionResendAt := PrecisionDownAt
        return
    }
    ; already held: re-press if the button dropped or periodically
    DllCall("QueryPerformanceCounter", "Int64*", ReelNow)
    PhBtn := GetKeyState("LButton")
    if (!PhBtn || (ReelNow - PrecisionResendAt) * 1000 / QpcFreq >= 400) {
        if (SwPreK) {
            SwPreEnd("reel")
            return
        }
        if (SwParkAt && SwParkWait())
            return
        if (!PhBtn && !VxPressOk())
            return
        Send, {LButton down}
        PrecisionResendAt := ReelNow
    }
    return
PrecisionRelease:
    if (PrecisionDown) {
        if (SpecialRod = "Requiem")
            SwMinHold := ReelMinHold
        else if (SpecialRod = "Stellarwave Melody" && SwPhase)
            SwMinHold := 250
        else
            SwMinHold := 0
        if (SwMinHold > 0 && PrecisionDownAt) {
            DllCall("QueryPerformanceCounter", "Int64*", ReelNow)
            if ((ReelNow - PrecisionDownAt) * 1000 / QpcFreq < SwMinHold)
                return
        }
        Send, {LButton up}
        PrecisionDown := false
        DllCall("QueryPerformanceCounter", "Int64*", PrecisionUpAt)
        return
    }
    if (GetKeyState("LButton") && !SwPressK)
        Send, {LButton up}
    return
BarMinigameOver:
    GradLive := false
    if (SwPressK)
        SwPressEnd()
    SwWantK := 0
    NoFishAt := 0
    BarLiveL := -1
    BarLiveR := -1
    BarLiveMiss := 0
    BarWLive := -1
    BarLiveOnlyAt := 0
    if (!MgCastCharged && GetKeyState("LButton"))
        Gosub, CastChargeCheck
    Send, {LButton up}{RButton up}
    PrecisionDown := false
    MgInPlay := false
    WhCatches += 1
    KbCatches += 1
    KbOcrCatches += 1
    WhCatch()
    WhLastCatchTick := A_TickCount
    WhStalled := false
    SetTimer, BarCalculationFailsafe, Off
    Send, {LButton up}{RButton up}
    if (MgCastCharged) {
        MgCastCharged := false
        if (RodSlotKey != "")
            ForceReEquip := true
    }
    VxTip(7, "Current Task: Restarting")
    for _, BmoLine in [8, 10, 11, 12, 13, 15]
        VxTip(BmoLine, "")
    Gosub, HideHud
    if (AdaptiveCast && !(PassiveAll || (SwPassive && SpecialRod = "Stellarwave Melody"))) {
        AcMs := AdaptiveCastMs
        if AcMs is not number
            AcMs := 150
        AcNeed := (AcMs < 0) ? 1 : 2
        AcT0 := A_TickCount
        AcClear := 0
        AcGone := (MgOverWhy = "swend" || MgOverWhy = "ojend" || MgOverWhy = "uigone")
        ; wait until the minigame UI has been gone for a couple of polls
        while (!AcGone && MacroRunning && A_TickCount - AcT0 < 1500) {
            Gosub, CaptureFishBar
            if (SpecialRod = "Tranquility")
                AcVis := ManiaVisible()
            else if (SpecialRod = "Stellarwave Melody")
                AcVis := (SwScan() && SwStarsValid)
            else
                AcVis := (BarPresent() || FishLineVisible())
            AcClear := AcVis ? 0 : AcClear + 1
            if (AcClear >= AcNeed)
                break
            Sleep, 15
        }
        if (AcMs <= 0) {
            VxTip(8, "Casting right away")
        } else {
            VxTip(8, "Casting " AcMs "ms after the minigame closed")
            Sleep, % Tm(AcMs)
        }
    } else {
        Sleep, % Tm(RestartDelay)
    }
    Goto, RestartMacro
KeeperRun:

KbBusy := true
KbPrevWin := 0
SetBatchLines, -1
KbLastResult := ""
KbStatus := "opening"
KbRecharged := 0
KbOpenCol := -1
KbRelicOn := false
MouseGetPos, KbSaveX, KbSaveY
send {lbutton up}
send {rbutton up}
VxTip(7, "Current Task: Keeperbound Recharge")
KbPreV := KeeperPreDelay
if KbPreV is number
	{
	if (KbPreV > 0)
		{
		VxTip(8, "Action: Waiting " . KbPreV . " ms before recharging")
		Sleep, % Tm(KbPreV)
		}
	}

gosub, MgOnScreenChk
if (!KbForce and (MgOnScreen or MgInPlay))
	{
	KbPostponeN := KbPostponeN + 1
	KbOcrCatches := 9999
	KbLastResult := "postponed - a minigame was on screen"
	KbStatus := "postponed"
	VxTip(8, "")
	KbBusy := false
	return
	}
KbPostponeN := 0

if (KeeperRelicKey = "")
	{
	KbLastResult := "no relic key set"
	goto KeeperBail
	}
if (RobloxHwnd and !WinActive("ahk_id " . RobloxHwnd))
	{
	KbPrevWin := WinExist("A")
	WinActivate, ahk_id %RobloxHwnd%
	WinWaitActive, ahk_id %RobloxHwnd%, , % TA("kbfocusto", 3)
	Sleep, % Tm(TA("kbfocus", 100))
	}

gosub, KeeperClearDialog

KbWant := Round(KeeperRecharges)
if (KbWant < 1)
	KbWant := 1
if (KbWant > 20)
	KbWant := 20

KbManual := (KbSpot("enchant", KbEx, KbEy) and KbSpot("confirm", KbCx, KbCy))
KbStatus := "recharging"

if (KbManual)
	{
	VxTip(8, "Action: Open Inventory")
	KbKey(KeeperInvKey)
	Sleep, % Tm(KeeperOpenDelay)

	VxTip(8, "Action: Equip Relic")
	KbKey(KeeperRelicKey)
	KbRelicOn := true
	Sleep, % Tm(KeeperStepDelay)
	KbOpenCol := -1
	PixelGetColor, KbOpenCol, %KbEx%, %KbEy%, RGB
	if (ErrorLevel)
		KbOpenCol := -1

	KbI := 0
	while (KbI < KbWant and MacroRunning)
		{
		KbI++
		VxTip(8, "Action: Enchant Rod")
		KbTapSaved(KbEx, KbEy)
		Sleep, % Tm(KeeperStepDelay)
		VxTip(8, "Action: Confirm")
		KbTapSaved(KbCx, KbCy)
		Sleep, % Tm(KeeperStepDelay)
		if (KbSpot("extra", KbXx, KbXy))
			{
			VxTip(8, "Action: Extra Confirm")
			KbTapSaved(KbXx, KbXy)
			Sleep, % Tm(KeeperStepDelay)
			}
		KbRecharged++
		if (KbI < KbWant)
			Sleep, % Tm(KeeperBetweenDelay)
		}
	KbLastResult := "pressed " . KbRecharged . " of " . KbWant
	goto KeeperBail
	}

; ---- no saved positions: find the buttons instead ------------------------------------------
VxTip(8, "Action: Open Inventory")
if (!KbWaitFor("enchant", KbEx, KbEy, TA("kbinv1", 700)))
	{
	KbKey(KeeperInvKey)
