    sRun := -1, sPrev := -1, sGap := 0, sBest := -1, sLen := 0
    Loop % W {
        x := A_Index - 1
        hits := 0
        for _, y in swRows {
            P := NumGet(bits + (y * W + x) * 4, "UInt")
            b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF
            if (g < 90 && b > 130 && b - g > 80 && r < 160)
                hits++
        }
        if (hits >= 2) {
            if (sRun < 0)
                sRun := x
            sPrev := x
            sGap := 0
        } else if (sRun >= 0) {
            sGap++
            if (sGap > 6) {
                if (sPrev - sRun + 1 > sLen)
                    sLen := sPrev - sRun + 1, sBest := (sRun + sPrev) // 2
                sRun := -1, sGap := 0
            }
