    GuiControl, 1:+Background%SwLeft%, BarLeftColorSwatch
    GuiControl, 1:+Background%SwRight%, BarRightColorSwatch
    GuiControl, 1:+Background%SwArrow%, ArrowColorSwatch
    GuiControl, 1:+Background%SwCastG%, CastGreenSwatch
