AqWheel(n, dir) {
    global AqBtnN, AqHoverX, AqHoverY, AqHoverOk
    if (AqBtnN < 1 && !AqHoverOk) {
        if (AqScan() < 1)
            return false
    }
    if !AqHoverOk
        return false
    MouseMove, %AqHoverX%, %AqHoverY%, 0
    Sleep % Tm(TA("aqwh1", 60))
    Loop % n {
        if (dir > 0)
            Send {WheelDown}
        else
            Send {WheelUp}
        Sleep % Tm(TA("aqwh2", 30))
    }
    Sleep % Tm(TA("aqwh3", 130))
    return true
}
AqRecoverRow() {
    global WindowWidth, WindowHeight, AqHoverX, AqHoverY, AqHoverOk
    AqHoverX := Round(WindowWidth * 0.50)
    AqHoverY := Round(WindowHeight * 0.62)
    AqHoverOk := true
    used := 0
    Loop 6 {
        if !AqWheel(5, -1)
            break
        used += 5
        if (AqScan() >= 1)
