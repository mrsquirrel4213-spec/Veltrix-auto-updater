;@@V1-PHASE1
;@@V1-PHASE2
;---- What the macro has to say goes to the info panel (no tooltips on screen) ---------------------------

; one row of the info panel: n is its slot (1 download, 2 runtime, 4-6 keys, 7 task, 8 action, 10 failsafe,
; 13 rod specials, 14 navigation key, 16 shake mode ...), "" takes it away
VxTip(n, t := "") {
	global VxTips
	if (!IsObject(VxTips))
		VxTips := {}
	if (t = "")
		{
		if (VxTips.HasKey(n))
			VxTips.Delete(n)
		; 3 and 17-20 are still real tooltips (window hints, color pickers)
		if (n = 3 or n >= 17)
			ToolTip, , , , %n%
		return
		}
	VxTips[n] := t
}

; a hotkey as people say it: ^+F4 -> Ctrl + Shift + F4, XButton1 -> Mouse back
VxKeyName(k) {
	pre := ""
	while (StrLen(k) > 1 and InStr("^!+#", SubStr(k, 1, 1)))
		{
		c := SubStr(k, 1, 1)
		pre .= (c = "^") ? "Ctrl + " : ((c = "!") ? "Alt + " : ((c = "+") ? "Shift + " : "Win + "))
		k := SubStr(k, 2)
		}
	n := {XButton1: "Mouse back", XButton2: "Mouse forward", MButton: "Middle mouse", RButton: "Right mouse", WheelUp: "Wheel up", WheelDown: "Wheel down"}[k]
	if (n = "")
		n := (StrLen(k) = 1) ? Format("{:U}", k) : k
	return pre . n
}

; a new Start/Stop, Reload or Exit key (h = its key box): checked, armed like the old one, saved
VxSetKey(h, k) {
	global
	local var, cur, other, lbl, st, iniKey
	var := VxKeyCtrls[h]
	if (var = "" or k = "")
		return false
	cur := (var = "StartStopKeyCtrl") ? StartStopKey : ((var = "ReloadKeyCtrl") ? ReloadKey : ExitKey)
	if (k = cur)
		{
		GuiControl, 1:, %h%, %cur%
		return true
		}
	other := ""
	if (var != "StartStopKeyCtrl" and k = StartStopKey)
		other := "Start/Stop"
	else if (var != "ReloadKeyCtrl" and k = ReloadKey)
		other := "Reload"
	else if (var != "ExitKeyCtrl" and k = ExitKey)
		other := "Exit"
	else if (k = "F9")
		other := "picking colors (F9)"
	else if (PogoOn and k = PogoHotkey)
		other := "the Pogo Jump Tech"
	else if (k = "LButton")
		other := "clicking"
	if (other != "")
		{
		MsgBox, 4144, Veltrix, % VxKeyName(k) . " is already used for " . other . ". Pick another key."
		GuiControl, 1:, %h%, %cur%
		return false
		}
	lbl := (var = "StartStopKeyCtrl") ? "HotkeyToggle" : ((var = "ReloadKeyCtrl") ? "HotkeyReload" : "HotkeyExit")
	st := (var = "StartStopKeyCtrl") ? (HotkeysArmed ? "On" : "Off") : (RunKeysArmed ? "On" : "Off")
	Hotkey, % "$" . k, %lbl%, UseErrorLevel %st%
	if (ErrorLevel)
		{
		MsgBox, 4144, Veltrix, % """" . k . """ cannot be used as a hotkey. Pick another key."
		GuiControl, 1:, %h%, %cur%
		return false
		}
	Hotkey, % "$" . cur, , UseErrorLevel Off
	if (var = "StartStopKeyCtrl")
		StartStopKey := k, iniKey := "StartStop"
	else if (var = "ReloadKeyCtrl")
		ReloadKey := k, iniKey := "Reload"
	else
		ExitKey := k, iniKey := "Exit"
	%var% := k
	GuiControl, 1:, %h%, %k%
	IniWrite, %k%, %SettingsFile%, Hotkeys, %iniKey%
	gosub, RefreshHints
	return true
}

; a key box was clicked in the panel: the next key or mouse button becomes that key (Esc cancels)
VxKeyCapture:
if (VxCapBusy or PogoCapturing or !VxCapNext)
	return
VxCapBusy := true
VxCapH := VxCapNext
VxCapNext := 0
VxCapK := PogoCapture()
if (VxCapK != "")
	VxSetKey(VxCapH, VxCapK)
GuiControlGet, VxCapV, 1:, %VxCapH%
UiSend(7, "{""h"":" . VxCapH . ",""v"":" . UiJ(VxCapV) . "}")
VxCapBusy := false
return

; the color-pick hints follow the mouse: a small box in Veltrix's colors at x, y (screen pixels); "" hides it
VxPickTip(t, x := 0, y := 0) {
	global ColorCard, ColorText, ColorTextBGR, hBrushCard, SpecialBrushes, VxPkW, VxPkT
	static last := "", lastT := "", tw := 0, th := 0, pad := 0
	if (t = "")
		{
		if (VxPkW)
			Gui, VxPick:Hide
		last := ""
		return
		}
	if (!VxPkW)
		{
		Gui, VxPick:New, +AlwaysOnTop -Caption +ToolWindow +E0x20 -DPIScale +HwndVxPkW
		Gui, VxPick:Color, %ColorCard%
		Gui, VxPick:Margin, 0, 0
		Gui, VxPick:Font, s9 Norm c%ColorText%, Segoe UI
		Gui, VxPick:Add, Text, x0 y0 w10 h10 +0x80 HwndVxPkT
		SpecialBrushes[VxPkT] := {brush: hBrushCard, text: ColorTextBGR}
		Gui, 1:Default
		pad := Round(10 * A_ScreenDPI / 96)
		}
	if (!(t == lastT))
		{
		lastT := t
		GuiControl, VxPick:, %VxPkT%, %t%
		hdc := DllCall("GetDC", "Ptr", VxPkT, "Ptr")
		hf := DllCall("SendMessage", "Ptr", VxPkT, "UInt", 0x31, "Ptr", 0, "Ptr", 0, "Ptr")
		old := DllCall("SelectObject", "Ptr", hdc, "Ptr", hf, "Ptr")
		VarSetCapacity(rc, 16, 0)
		DllCall("DrawText", "Ptr", hdc, "Str", t, "Int", -1, "Ptr", &rc, "UInt", 0xC00)
		DllCall("SelectObject", "Ptr", hdc, "Ptr", old)
		DllCall("ReleaseDC", "Ptr", VxPkT, "Ptr", hdc)
		tw := NumGet(rc, 8, "Int") + 2
		th := NumGet(rc, 12, "Int") + 2
		GuiControl, VxPick:Move, %VxPkT%, % "x" . pad . " y" . pad . " w" . tw . " h" . th
		last := ""
		}
	key := x . "," . y
	if (key == last)
		return
	last := key
	gw := tw + 2 * pad
	gh := th + 2 * pad
	Gui, VxPick:Show, % "NoActivate x" . Round(x) . " y" . Round(y) . " w" . gw . " h" . gh
	r := Round(16 * A_ScreenDPI / 96)
	WinSet, Region, % "0-0 w" . gw . " h" . gh . " R" . r . "-" . r, ahk_id %VxPkW%
}

; how wide a text is in a control's font, in the window's own units
IpTextW(h, s) {
	if (s = "")
		return 0
	hdc := DllCall("GetDC", "Ptr", h, "Ptr")
	hf := DllCall("SendMessage", "Ptr", h, "UInt", 0x31, "Ptr", 0, "Ptr", 0, "Ptr")
	old := DllCall("SelectObject", "Ptr", hdc, "Ptr", hf, "Ptr")
	VarSetCapacity(sz, 8, 0)
	DllCall("GetTextExtentPoint32", "Ptr", hdc, "Str", s, "Int", StrLen(s), "Ptr", &sz)
	DllCall("SelectObject", "Ptr", hdc, "Ptr", old)
	DllCall("ReleaseDC", "Ptr", h, "Ptr", hdc)
	return Ceil(NumGet(sz, 0, "Int") * 96 / A_ScreenDPI) + 8
}

; a control of the profile card, with its place in the card (design coordinates, card top = 120)
ProfPut(h, x, y) {
	global ProfCtrls, ProfPosX, ProfPosY
	ProfCtrls.Push(h)
	ProfPosX.Push(x)
	ProfPosY.Push(y - 120)
}

; the changelog (Extra > Changelog), newest first: [version, [on the changelog page], [on its details page]]
VxChangelog() {
	c := []
	c.Push(["v1.0", ["Released"], ["Released"]])
	return c
}

; one version's card(s) into lst from y: its title, Open (openIdx > 0) and a line per note; a long one goes on in
; a second card (the panel leaves out anything taller than 400). Returns the y below it.
VxClCards(lst, y, title, lines, openIdx) {
	global
	local groups, gh, j, ln, lh, g, grp, inH, cardH, ty, p, hC, bY
	groups := [[]]
	gh := 22
	for j, ln in lines
		{
		lh := Ceil((StrLen(ln) + 3) / 76) * 16
		if (gh + lh + 2 > 350)
			{
			groups.Push([])
			gh := 0
			}
		groups[groups.Length()].Push([ln, lh])
		gh += lh + 2
		}
	for g, grp in groups
		{
		inH := (g = 1) ? 22 : 0
		for j, p in grp
			inH += p[2] + 2
		cardH := 12 + inH + 10
		if (g = 1 and openIdx and cardH < 54)
			cardH := 54
		hC := AddPanel(CARDX, y, CARDW, cardH)
		lst.Push(hC)
		ty := y + 12
		if (g = 1)
			{
			Gui, Font, s10 Bold c%ColorText%, Segoe UI
			Gui, Add, Text, x%CX% y%ty% w400 h18 +0x80 HwndhC, %title%
			lst.Push(hC)
			SpecialBrushes[hC] := {brush: hBrushCard, text: ColorTextBGR}
			if (openIdx)
				{
				bY := y + 13
				Gui, Font, s9 Bold c%ColorAccent%, Segoe UI
				Gui, Add, Text, x642 y%bY% w86 h28 Center +0x100 +0x200 vClOpen%openIdx% gChangelogDetailOpen HwndhC, Open
				lst.Push(hC)
				SpecialBrushes[hC] := {brush: hBrushCard, text: ColorAccentBGR}
				RoundCtrl(hC, 86, 28, 7)
				}
			ty += 22
			}
		Gui, Font, s9 Norm c%ColorMuted%, Segoe UI
		for j, p in grp
			{
			lh := p[2]
			ln := p[1]
			Gui, Add, Text, x%CX% y%ty% w%TXW% h%lh% +0x80 HwndhC, %ln%
			lst.Push(hC)
			SpecialBrushes[hC] := {brush: hBrushCard, text: ColorMutedBGR}
			ty += lh + 2
			}
		y += cardH + 10
		}
	return y
}

;---- VeltrixNative.dll ----------------------------------------------------------------------------------
; Fast capture: the DLL (64-bit, built from native\vx_native.c) is written next to the script and loaded.
; Its vx_blt has BitBlt's exact signature - a grab of the screen into a 32-bit bitmap comes from the graphics
; card's copy of the desktop (DXGI Desktop Duplication), everything else (and anything it is not sure about)
; goes to BitBlt. Without it every grab is BitBlt, as before.
VxNativeInit() {
	global VxNatMod, VxNatEnable, VxNatStats, NativeCapture
	if (VxNatMod)
		return true
	if (A_PtrSize != 8)
		return false
	f := A_ScriptDir . "\VeltrixNative.dll"
	b64 := VxNativeB64()
	n := 0
	DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", 0, "UInt*", n, "Ptr", 0, "Ptr", 0)
	if (!n)
		return false
	VarSetCapacity(bin, n, 0)
	DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", &bin, "UInt*", n, "Ptr", 0, "Ptr", 0)
	crc := DllCall("ntdll\RtlComputeCrc32", "UInt", 0, "Ptr", &bin, "UInt", n, "UInt")
	; written only when the file there is not this one (one still in use by a closing copy cannot be written yet)
	Loop, 4
		{
		same := false
		FileGetSize, have, %f%
		if (!ErrorLevel and have = n)
			{
			h := FileOpen(f, "r")
			if (IsObject(h))
				{
				VarSetCapacity(cur, n, 0)
				h.RawRead(cur, n)
				h.Close()
				same := (DllCall("ntdll\RtlComputeCrc32", "UInt", 0, "Ptr", &cur, "UInt", n, "UInt") = crc)
				}
			}
		if (same)
			break
		h := FileOpen(f, "w")
		if (IsObject(h))
			{
			h.RawWrite(bin, n)
			h.Close()
			same := true
			break
			}
		Sleep, 300
		}
	if (!same)
		return false
	VxNatMod := DllCall("LoadLibrary", "Str", f, "Ptr")
	if (!VxNatMod)
		return false
	p := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_blt", "Ptr")
	VxNatEnable := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_enable", "Ptr")
	VxNatStats := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_stats", "Ptr")
	VxNatCF := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_cl_find", "Ptr")
	VxNatCR := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_cl_run", "Ptr")
	VxNatFL := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_fishline", "Ptr")
	VxNatRB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_rowbar", "Ptr")
	VxNatGB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_gradbar", "Ptr")
	VxNatRM := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_remscan", "Ptr")
	VxNatSS := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_swshape", "Ptr")
	VxNatIO := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_ignore_own", "Ptr")
	VxNatFD := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_framedark", "Ptr")
	VxNatCP := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_colspread", "Ptr")
	VxNatCB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_castscan", "Ptr")
	VxNatBL := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_bellona", "Ptr")
	VxNatPS := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_pinscan", "Ptr")
	VxNatRL := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_relbar", "Ptr")
	VxNatRF := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_relfish", "Ptr")
	VxNatHB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_halibut", "Ptr")
	VxNatDM := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_doom", "Ptr")
	VxNatOP := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_opp", "Ptr")
	VxNatMB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_migubar", "Ptr")
	VxNatMF := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_migufish", "Ptr")
	VxNatNE := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nz_edges", "Ptr")
	VxNatNA := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nz_arrow", "Ptr")
	VxNatNB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nz_bars", "Ptr")
	VxNatNF := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nz_fish", "Ptr")
	VxNatNFB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nz_fishband", "Ptr")
	VxNatTQ := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_tq_runs", "Ptr")
	VxNatSK := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_sk_slots", "Ptr")
	VxNatSB := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_sk_bar", "Ptr")
	VxNatSF := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_sk_fish", "Ptr")
	VxNatSP := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_sk_pill", "Ptr")
	VxNatND := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nf_diffrow", "Ptr")
	VxNatNI := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nf_iconhist", "Ptr")
	VxNatGX := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_green_box", "Ptr")
	VxNatNK := DllCall("GetProcAddress", "Ptr", VxNatMod, "AStr", "vx_nuke_read", "Ptr")
	if (!p or !VxNatEnable)
		{
		DllCall("FreeLibrary", "Ptr", VxNatMod)
		VxNatMod := 0
		VxNatCF := 0, VxNatCR := 0, VxNatFL := 0, VxNatRB := 0, VxNatGB := 0, VxNatRM := 0, VxNatSS := 0, VxNatIO := 0
		VxNatFD := 0, VxNatCP := 0, VxNatCB := 0, VxNatBL := 0, VxNatPS := 0, VxNatRL := 0, VxNatRF := 0, VxNatHB := 0, VxNatMB := 0, VxNatMF := 0, VxNatNE := 0, VxNatNA := 0, VxNatNB := 0, VxNatNF := 0, VxNatNFB := 0, VxNatTQ := 0, VxNatSK := 0, VxNatSB := 0, VxNatSF := 0, VxNatSP := 0, VxNatND := 0, VxNatNI := 0, VxNatGX := 0, VxNatNK := 0, VxNatDM := 0, VxNatOP := 0
		return false
		}
	VxBlt := p
	DllCall(VxNatEnable, "Int", NativeCapture ? 1 : 0)
	return true
}

; the DLL's loops only take plain numbers: the tolerance a number, every other argument a whole number
VxNatArgs(tol, p*) {
	if tol is not number
		return false
	for i, v in p
		{
		if v is not integer
			return false
		}
	return true
}

; a color list as 0xRRGGBB ints for the DLL - made once per list (the lists are cached)
ColorListBuf(o) {
	if (!o.HasKey("pk"))
		{
		o.pk := ""
		o.SetCapacity("pk", o.n * 4 + 4)
		p := o.GetAddress("pk")
		Loop, % o.n
			NumPut((o.r[A_Index] << 16) | (o.g[A_Index] << 8) | o.b[A_Index], p + (A_Index - 1) * 4, "Int")
		}
	return o.GetAddress("pk")
}

NativeCaptureChanged:
GuiControlGet, NativeCapture, 1:, NativeCapture
NativeCapture := NativeCapture ? 1 : 0
IniWrite, %NativeCapture%, %SettingsFile%, Capture, Native
if (NativeCapture and !VxNatMod)
	VxNativeInit()
if (VxNatEnable)
	DllCall(VxNatEnable, "Int", NativeCapture)
return

