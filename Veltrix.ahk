RodTol(v) {
    if v is not number
        return 20
    v := Round(v)
    if (v < 0)
        v := 0
    else if (v > 255)
        v := 255
    return v
}
RodCap(o, k, other, t) {
    i := 1
    while (i <= other.n && i <= 9) {
        d := Abs(o.r[k] - other.r[i])
        dg := Abs(o.g[k] - other.g[i])
        db := Abs(o.b[k] - other.b[i])
        if (dg > d)
            d := dg
        if (db > d)
            d := db
        lim := (d = 0) ? -1 : Floor((d - 1) / 2)
        if (lim < t)
            t := lim
        i++
    }
    return t
}
PcPrmAt(a, r, g, b, tol, mode) {
    ; two identical search records (B,G,R,tol,mode) followed by a flag
    Loop 2 {
        base := (A_Index - 1) * 24
        NumPut(b, a + 0, base, "Int")
        NumPut(g, a + 0, base + 4, "Int")
        NumPut(r, a + 0, base + 8, "Int")
        NumPut(tol, a + 0, base + 12, "Int")
        NumPut(mode, a + 0, base + 16, "Int")
    }
    NumPut(0, a + 0, 20, "Int")
    NumPut(1, a + 0, 44, "Int")
}
PcFindAt(p, n, stride, a) {
    if (n <= 0)
        return -1
    fn := PcFindPixFn()
    if (fn)
        return DllCall(fn, "Ptr", p, "Int", n, "Int", stride, "Ptr", a, "Int")
    return PcFindPixAhk(p, n, stride, NumGet(a + 0, 0, "Int"), NumGet(a + 0, 4, "Int"), NumGet(a + 0, 8, "Int")
        , NumGet(a + 0, 12, "Int"), NumGet(a + 0, 16, "Int"), NumGet(a + 0, 20, "Int"))
}
TryRowRunsAt(p, a, gap, rr) {
    global CaptureW
    W := CaptureW
    x := 0, hits := 0, openS := -1, openE := -1
    while (x < W && hits < 40) {
        s := PcFindAt(p + x * 4, W - x, 4, a)
        if (s < 0)
            break
        s += x
        e := PcFindAt(p + (s + 1) * 4, W - s - 1, 4, a + 24)
        e := (e < 0) ? W - 1 : s + e
        hits++
        if (openS >= 0 && (s - openE - 1) <= gap) {
            openE := e
        } else {
            if (openS >= 0)
                rr.Push([openS, openE])
            openS := s, openE := e
        }
        x := e + 1
    }
    if (openS >= 0)
        rr.Push([openS, openE])
}
TryRunsMerge(rr, gap) {
    cnt := rr.Length()
    i := 2
    while (i <= cnt) {
        item := rr[i]
        j := i - 1
        while (j >= 1 && rr[j][1] > item[1]) {
            rr[j + 1] := rr[j]
            j--
        }
        rr[j + 1] := item
        i++
    }
    merged := []
    for _, run in rr {
        m := merged.Length()
        if (m && (run[1] - merged[m][2] - 1) <= gap) {
            if (run[2] > merged[m][2])
                merged[m][2] := run[2]
        } else {
            merged.Push([run[1], run[2]])
        }
    }
    if (cnt)
        rr.RemoveAt(1, cnt)
    for _, run in merged
        rr.Push(run)
}
TryFishLineAt(c, k) {
    global pCaptureBits, CaptureW, CaptureH
    W := CaptureW, H := CaptureH
    if (c < 0 || c >= W)
        return false
    votes := 0
    for _, f in [0.30, 0.50, 0.70] {
        y := Floor(H * f)
        rowP := pCaptureBits + y * W * 4
        v := NumGet(rowP + c * 4, "UInt")
        pa := (c - k >= 0) ? NumGet(rowP + (c - k) * 4, "UInt") : -1
        pb := (c + k < W) ? NumGet(rowP + (c + k) * 4, "UInt") : -1
        if (pa < 0)
            pa := pb
        if (pb < 0)
            pb := pa
        if (pa < 0)
            continue
        diff := 0
        Loop 3 {
            sh := (A_Index - 1) * 8
            dd := Abs(((v >> sh) & 0xFF) - (((pa >> sh) & 0xFF) + ((pb >> sh) & 0xFF)) / 2)
            if (dd > diff)
                diff := dd
        }
        if (diff >= 8)
            votes++
    }
    return votes >= 2
}
TryTrackAtX(x) {
    global pCaptureBits, CaptureW, CaptureH, TryExT, TryhardTrackTol
    W := CaptureW, H := CaptureH
    if (x < 0 || x >= W)
        return false
    lst := ColorListParse(TryExT)
    tol := RodTol(TryhardTrackTol)
    hits := 0
    for _, f in [0.30, 0.50, 0.70] {
