    }
    BarScanRow := row
    BarLiveMiss := 0

    lc := Round(l - FishBarLeft), rc := Round(r - FishBarLeft)
    pl := BarPixAt(lc + 2, row)
    pr := BarPixAt(rc - 2, row)
    if ((pl >= 0 && ColorListHitPx(lList, pl, tol)) || (pr >= 0 && ColorListHitPx(rList, pr, tol))) {
        BarLiveOnlyAt := 0
    } else if (BarLiveOnlyAt = 0) {
        BarLiveOnlyAt := A_TickCount
    } else if (A_TickCount - BarLiveOnlyAt > 6000) {
        ; only live colours have matched for too long: drop them
        BarLiveL := -1, BarLiveR := -1
        BarWLive := -1
        BarLiveOnlyAt := 0
        LastBarL := -1, LastBarR := -1
        return false
    }
    if (BarWLive <= 0 || Abs(RunWidth - BarWLive) <= 0.35 * BarWLive) {
        if (pl >= 0)
            BarLiveL := BarLiveOk(pl, BarPixAt(lc - 10, row), adTol, BarLiveL)
        if (pr >= 0)
            BarLiveR := BarLiveOk(pr, BarPixAt(rc + 10, row), adTol, BarLiveR)
    }
    BarWLive := RunWidth
    return true
}
MinigameVisible(minRun) {
