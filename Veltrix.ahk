FindArrowX() {
    global ArrowColor, ArrowColorTolerance, CaptureW, CaptureH, BarScanRow
    if (ArrowColor = "")
        return -1
    tol := Max(ArrowColorTolerance, 8)
    aList := ColorListParse(ArrowColor)
    if (aList.n < 1)
