CastNat(lut) {
	global pCaptureBits, CaptureW, CaptureH, FishBarLeft, CastBarL, CastBarW, CastFishX
	VarSetCapacity(cbOut, 12, 0)
	if (!DllCall(VxNatCB, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Ptr", lut, "Ptr", &cbOut, "Int"))
		return false
	if (NumGet(cbOut, 0, "Int") >= 0)
		{
		CastBarL := FishBarLeft + NumGet(cbOut, 0, "Int")
		CastBarW := NumGet(cbOut, 4, "Int")
		}
	if (NumGet(cbOut, 8, "Int") >= 0)
		CastFishX := FishBarLeft + NumGet(cbOut, 8, "Int")
	return true
}

; the end of both Castbound scans: has the picture stood still (CastStatic), and is the fight found
CastTail() {
    global CastBarL, CastBarW, CastFishX, CastPrevL, CastPrevW, CastPrevF, CastSameN, CastSameT
    global QpcFreq, CastStatic, CastFound
    csNow := 0
    DllCall("QueryPerformanceCounter", "Int64*", csNow)
    if (CastBarW > 0 && CastBarL = CastPrevL && CastBarW = CastPrevW && CastFishX = CastPrevF) {
        CastSameN += 1
        if (!CastSameT)
            CastSameT := csNow
    } else {
        CastSameN := 0
        CastSameT := 0
    }
    CastPrevL := CastBarL, CastPrevW := CastBarW, CastPrevF := CastFishX
    CastStatic := (CastSameT && (csNow - CastSameT) / QpcFreq >= 0.25) ? true : false
    CastFound := (CastBarW > 0 && CastFishX >= 0) ? true : false
    return CastFound
}
CastboundScanX() {
