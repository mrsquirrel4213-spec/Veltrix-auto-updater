        else
            LapFile := ActiveProfileFile
        IniRead, LapVal, %LapFile%, %LapSec%, %LapKey%, %LapDef%
        if (LapVal = "ERROR" && LapDef = "")
            LapVal := ""
        if (LapVal = "" && LapDef != "")
            LapVal := LapDef
        if (!ProfFieldOk(LapType, LapVal)) {
            ConfigWarnings .= LapKey "`n"
            LapVal := LapDef
            IniWrite, %LapDef%, %LapFile%, %LapSec%, %LapKey%
        }
        if (LapType = "bool")
            LapVal := (LapVal = "true") ? true : false
        %LapKey% := LapVal
    }
    TotemSelSanitize()
    if (ConfigWarnings != "") {
        MsgBox, 4144, Veltrix - Config Notice, % "Some settings in """ ActiveProfile ".ini"" were invalid and have been reset to their defaults:`n`n" ConfigWarnings
    }
    Gosub, AstraMigrateColours
    KeeperOcrOn := false
    PredictOn := PredictLoad()
    Gosub, RefreshControlModes
    if (Trim(TryhardBarColors) = "")
        TryhardBarColors := "0x33030B, 0x5F020A, 0xBE0C0E"
    if (Trim(TryhardFishColors) = "")
        TryhardFishColors := "0x2F020C"
    if (Trim(TryhardTrackColors) = "")
        TryhardTrackColors := "0x3A0608"
    AutoUpdate := true
    ; fixed controller tuning (not user editable)
    Kp := 0.5
    Kd := 0.3
    VelocitySmoothing := 0.2
    StoppingDistanceMultiplier := 3.0
    SwFastClicks := true
    SwSignsFirst := true
    SwRetryFails := true
    SwMaxSigns := true
    SwTurbo := true
    return
ProfFieldOk(type, ByRef val) {
    if (type = "bool")
        return (val = "true" || val = "false")
    if (type = "num") {
        if val is number
            return true
        return false
    }
    if (type = "shakemode") {
        if (val = "Click")
            val := "Navigation"
        allowed := "Navigation|Disabled"
    } else if (type = "specialrod") {
        if (val = "Pinion Aria")
            val := "Pinions Aria"
        allowed := "None|Pinions Aria|Requiem|Darkheart|Bellona's Waraxe|Dreambreaker|Tranquility|Noiseform"
            . "|Verdant Oath|Lullaby|Castbound|Remembrance|MiguRod|Halibut Harpoon|Splitbranch Twig"
            . "|Astraenus Serenade|Tryhard Rod|Chasm Stalker|Stellarwave Melody|Doomsekkar|Oppressor"
    } else if (type = "remembrancemode") {
        allowed := "Living|Departed"
    } else if (type = "controlmode") {
        allowed := "Precision|Lines"
    } else if (type = "castmode") {
        allowed := "Normal|Perfect"
    } else if (type = "totemsel") {
        allowed := "None|Day|Night|Clearcast|Aurora|Starfall|Eclipse|Tempest|Windset|Smokescreen|Shiny|Sparkling|Mutation"
    } else {
        return true
    }
    for _, opt in StrSplit(allowed, "|")
        if (val = opt)
            return true
    return false
}
BuildDefaultProfile:
    for BdpIdx, BdpEnt in ProfileFields {
        BdpSec := BdpEnt[1]
        BdpKey := BdpEnt[2]
        BdpDef := BdpEnt[3]
        IniWrite, %BdpDef%, %DefaultProfileFile%, %BdpSec%, %BdpKey%
    }
    return
BuildCastHud:
    CastHudIds := []
    for BchIdx, BchSpec in [["CkA", "F04747"], ["CkB", "F04747"], ["CkC", "FFD400"]
        , ["CkD", "FFD400"], ["CkE", "22D3EE"], ["CkF", "22D3EE"]] {
        BchName := BchSpec[1]
        BchCol := BchSpec[2]
        Gui, %BchName%: -Caption +AlwaysOnTop +ToolWindow +E0x20 +HwndBchHwnd
        Gui, %BchName%: Color, %BchCol%
        Gui, %BchName%: Margin, 0, 0
        Gui, %BchName%: Show, Hide NA x0 y0 w22 h7
        CastHudIds.Push(BchHwnd)
    }
    CastHudBuilt := true
    CH_LastG := -9999
    CH_LastT := -9999
    CH_LastB := -9999
    return
ShowCastHud:
    if (!CastHudBuilt)
        Gosub, BuildCastHud
    CH_LX := WindowLeft + PCGreenL - 28
    CH_RX := WindowLeft + PCGreenR + 8
    CH_LastG := -9999
    CH_LastT := -9999
    CH_LastB := -9999
    Loop, 6
        DllCall("ShowWindow", "Ptr", CastHudIds[A_Index], "Int", 8)
    return
HideCastHud:
if (!CastHudBuilt)
	return
for _chIdx, _chHwnd in CastHudIds
	DllCall("ShowWindow", "Ptr", _chHwnd, "Int", 0)
return
CastHudMark(gy, wt, wb, gl, gr) {
    global CastHudBuilt, CastHudIds, WindowLeft, WindowTop
    global CH_LX, CH_RX, CH_LastG, CH_LastT, CH_LastB
    if (!CastHudBuilt)
        return
    lx := WindowLeft + gl - 28
    rx := WindowLeft + gr + 8
    shifted := (lx != CH_LX || rx != CH_RX)
    if (shifted) {
        CH_LX := lx
        CH_RX := rx
    }
    ; each pair: [row, index of left marker]
    rows := []
    if (gy != CH_LastG || shifted) {
        CH_LastG := gy
        rows.Push([gy, 1])
    }
    if (wt != CH_LastT || shifted) {
        CH_LastT := wt
        rows.Push([wt, 3])
    }
    if (wb != CH_LastB || shifted) {
        CH_LastB := wb
        rows.Push([wb, 5])
    }
    for _, r in rows {
        top := WindowTop + r[1] - 3
        DllCall("SetWindowPos", "Ptr", CastHudIds[r[2]], "Ptr", -1, "Int", lx, "Int", top, "Int", 22, "Int", 7, "UInt", 0x10)
        DllCall("SetWindowPos", "Ptr", CastHudIds[r[2] + 1], "Ptr", -1, "Int", rx, "Int", top, "Int", 22, "Int", 7, "UInt", 0x10)
    }
}
PerfectCastRelease:
    PCGreenRGB := ColMain(PerfectGreenColor)
    PCWhiteBGR := ToBGR(ColMain(PerfectWhiteColor))
    PCSearchTop := Round(0.13 * WindowHeight)
    PCSearchBottom := Round(0.90 * WindowHeight)
    PCGreenY := -1
    PCGreenL := -1
    PCGreenR := -1
    PCReachedBottom := false
    PCLastFill := -1
    PCSpeedSum := 0.0
    PCSpeedCount := 0
    PCReleased := false
    PCLostCount := 0
    PCValidFrames := 0
    PCFrameDt := 0
    PCTipT := 0
    PCCycles := 0
    PCSawTop := false
    PCDir := 0
    PCWaitN := PerfectWaitCycles + 0
    if (PCWaitN < 0 || PCWaitN > 5)
        PCWaitN := 1
    DllCall("QueryPerformanceCounter", "Int64*", PCStart)
    PCLastT := PCStart
    PCCapT := PCStart
    ; falls through into PerfectCastLoop
PerfectCastLoop:
    Loop {
        if (!MacroRunning or NukeAfter) {
            VxTip(8, "")
            Gosub, HideCastHud
            return
        }
        DllCall("QueryPerformanceCounter", "Int64*", PCNow)
        PCElapsed := (PCNow - PCStart) / QpcFreq
        if (PCElapsed > PerfectFailTimeout) {
            VxTip(8, "Action: Perfect cast timed out - released")
            Gosub, HideCastHud
            return
        }
        if (PCGreenY < 0) {
            PCVerifyOff := (PCElapsed > 1.5)
            if (!PerfectAcquireGreen()) {
                VxTip(8, "Action: Looking for cast bar")
                continue
            }
            PCLostCount := 0
            Gosub, ShowCastHud
        }
        PCState := PerfectTrackFrame()
        if (PCState = 0) {
            PCLostCount += 1
            if (PCLostCount >= 6) {
                PCGreenY := -1
                PCLostCount := 0
            }
            continue
        }
        PCLostCount := 0
        if (PCState = 1) {
            VxTip(8, "Action: Perfect cast - bar empty, waiting")
            continue
        }
        PCTotal := PCWhiteBottom - PCGreenY
        if (PCTotal <= 0)
            continue
        PCFill := (1 - (PCWhiteTop - PCGreenY) / PCTotal) * 100

        ; count full swings (top, then back to the bottom)
        if (PCFill >= 90)
            PCSawTop := true
        if (PCSawTop && PCFill <= 10) {
            PCCycles += 1
            PCSawTop := false
        }

        PCOffset := 0.0
        if (PCLastFill >= 0) {
            PCdt := (PCCapT - PCLastT) / QpcFreq
            if (PCdt > 0.0005) {
                PCFrameDt := PCdt
                PCChange := PCFill - PCLastFill
                if (PCChange > 0.5)
                    PCDir := 1
                else if (PCChange < -0.5)
                    PCDir := -1
                if (PCChange < -50) {
                    PCSpeedSum := 0
                    PCSpeedCount := 0
                    PCReachedBottom := false
                    PCValidFrames := 0
                    PCLastFill := -1
                } else {
                    if (PCChange > 0) {
                        PCSpeedSum += PCChange / PCdt
                        PCSpeedCount += 1
                        if (PCSpeedCount > 20) {
                            PCSpeedSum := PCSpeedSum * 20 / PCSpeedCount
                            PCSpeedCount := 20
                        }
                    }
                    if (PCSpeedCount > 0) {
                        PCAvgSpeed := PCSpeedSum / PCSpeedCount
                        PCOffset := 1.5 * Ln(1 + PCAvgSpeed / 25.0)
                        if (PerfectReleaseTiming < 0) {
                            PCBaseMult := 1.0 - PerfectReleaseTiming / 5.0
                            PCScale := Min(6.0, (PCAvgSpeed / 100.0) ** 2)
                            PCOffset := PCOffset * (PCBaseMult + (PCBaseMult - 1.0) * PCScale)
                        }
                        if (PCOffset > 50.0)
                            PCOffset := 50.0
                    }
                }
            }
        }
        PCPredicted := PCFill + PCOffset

        if (!PCReachedBottom) {
            PCValidFrames += 1
            if (PCPredicted <= 5.0 + PCOffset || PCValidFrames >= 3) {
                PCReachedBottom := true
                PCLastFill := -1
                PCSpeedSum := 0.0
                PCSpeedCount := 0
            }
        }

        if (PerfectReleaseTiming <= 0)
            PCThreshold := 95.5
        else
            PCThreshold := Min(100, 95.5 + (PerfectReleaseTiming / 50.0) * 4.5)

        PcArmed := (PCReachedBottom && PCCycles >= PCWaitN && PCDir > 0)
        if (PcArmed && PCPredicted >= PCThreshold) {
            Send, {LButton up}
            PCReleased := true
            Gosub, HideCastHud
            return
        }
        if (PcArmed && PCSpeedCount >= 3 && PCAvgSpeed > 1 && PCFrameDt > 0) {
            ; time left until the threshold, plus 10 ms
            PCLead := (PCThreshold - PCPredicted) / PCAvgSpeed + 0.010
            DllCall("QueryPerformanceCounter", "Int64*", PCNowR)
            PCLatency := (PCNowR - PCCapT) / QpcFreq
            if (PCLead < PCFrameDt + PCLatency) {
                PCWaitMs := Min(250, (PCLead - PCLatency) * 1000)
                if (PCWaitMs > 0)
                    PreciseSleep(PCWaitMs)
                Send, {LButton up}
                PCReleased := true
                Gosub, HideCastHud
                return
            }
        }

        CastHudMark(PCGreenY, Round(PCWhiteTop - (PCOffset / 100.0) * PCTotal), PCWhiteBottom, PCGreenL, PCGreenR)

        if ((PCCapT - PCTipT) / QpcFreq >= 0.12) {
            PCTipT := PCCapT
            PCFillDbg := Round(PCPredicted)
            PCGateDbg := PCReachedBottom ? "armed" : "arming"
            if (PCCycles < PCWaitN)
                PCGateDbg := "watching swing " (PCCycles + 1) "/" PCWaitN
            VxTip(8, "Action: Perfect " PCFillDbg "% / " PCThreshold "% (" PCGateDbg ")")
        }
        PCLastFill := PCFill
        PCLastT := PCCapT
    }
return
CastBarSeen() {
	global PCSearchTop, PCSearchBottom, WindowHeight, PCVerifyOff, PCGreenY, PCGreenL, PCGreenR
	if (WindowHeight < 100)
		return false
	PCSearchTop := Round(WindowHeight * 0.13)
	PCSearchBottom := Round(WindowHeight * 0.90)
	PCVerifyOff := false
	PCGreenY := -1
	return PerfectAcquireGreen()
}

PerfectAcquireGreen() {
    global PerfectGreenColor, PerfectGreenTolerance, PCSearchTop, PCSearchBottom
    global WindowLeft, WindowTop, WindowWidth, PCLastGoodY, PCPrmG, PCPrmGI
    global hPCFullDC, hPCFullBM, pPCFullBits, PCFullW, PCFullH, hPCFullOld, VxBlt
    global PCGreenY, PCGreenL, PCGreenR
    if (!PcFindPixFn())
        return PerfectAcquireGreenAhk()
    w := WindowWidth
    h := PCSearchBottom - PCSearchTop
    if (w < 8 || h < 8)
        return false

    ; (re)create the capture buffer when the size changes
    if (!hPCFullDC || PCFullW != w || PCFullH != h) {
        if (hPCFullDC) {
            DllCall("SelectObject", "Ptr", hPCFullDC, "Ptr", hPCFullOld)
            DllCall("DeleteObject", "Ptr", hPCFullBM)
            DllCall("DeleteDC", "Ptr", hPCFullDC)
            hPCFullDC := 0, hPCFullBM := 0, pPCFullBits := 0
        }
        VarSetCapacity(bih, 40, 0)
        NumPut(40, bih, 0, "UInt")
        NumPut(w, bih, 4, "Int")
        NumPut(-h, bih, 8, "Int")
        NumPut(1, bih, 12, "UShort")
        NumPut(32, bih, 14, "UShort")
        scr := DllCall("GetDC", "Ptr", 0, "Ptr")
        hPCFullDC := DllCall("CreateCompatibleDC", "Ptr", scr, "Ptr")
        bits := 0
        hPCFullBM := DllCall("CreateDIBSection", "Ptr", scr, "Ptr", &bih, "UInt", 0, "Ptr*", bits, "Ptr", 0, "UInt", 0, "Ptr")
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)
        pPCFullBits := bits
        hPCFullOld := DllCall("SelectObject", "Ptr", hPCFullDC, "Ptr", hPCFullBM, "Ptr")
        PCFullW := w
        PCFullH := h
    }
    scr := DllCall("GetDC", "Ptr", 0, "Ptr")
    DllCall(VxBlt, "Ptr", hPCFullDC, "Int", 0, "Int", 0, "Int", w, "Int", h
        , "Ptr", scr, "Int", WindowLeft, "Int", WindowTop + PCSearchTop, "UInt", 0x00CC0020)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)

    PcSetPrm(PCPrmG, PerfectGreenColor, PerfectGreenTolerance, 1, 0)
    PcSetPrm(PCPrmGI, PerfectGreenColor, PerfectGreenTolerance, 1, 1)

    pitch := w * 4
    gRow := -1
    Loop, 2 {
        narrow := (A_Index = 1 && PCLastGoodY >= 0)
        if (narrow) {
            yFrom := Max(0, Min(h, PCLastGoodY - PCSearchTop - 70))
            yTo := Max(0, Min(h, PCLastGoodY - PCSearchTop + 70))
        } else {
            yFrom := 0
            yTo := h
        }
        y := yFrom
        while (y < yTo) {
            rowP := pPCFullBits + y * pitch
            if (PcFind(rowP, w, 4, PCPrmG) < 0) {
                y += 1
                continue
            }
            lo := -1, hi := -1
            if (!PcRowRun(rowP, w, PCPrmG, PCPrmGI, lo, hi)) {
                y += 1
                continue
            }
            runLen := hi - lo + 1
            if (runLen >= 6 && runLen < 60 && PcCapVerify(y, lo, hi)) {
                gRow := y, gl := lo, gr := hi
                break
            }
            ; skip the rest of this green band
            y += 1
            while (y < yTo && PcFind(pPCFullBits + y * pitch, w, 4, PCPrmG) >= 0)
                y += 1
        }
        if (gRow >= 0 || !narrow)
            break
    }
    if (gRow < 0)
        return false
    PCGreenY := PCSearchTop + gRow
    PCGreenL := gl
    PCGreenR := gr
    PCLastGoodY := PCGreenY
    return true
}
PerfectTrackFrame() {
    global PCGreenY, PCGreenL, PCGreenR, PCSearchBottom, WindowLeft, WindowTop, WindowWidth
    global PerfectGreenColor, PerfectGreenTolerance, PerfectWhiteColor, PerfectWhiteTolerance
    global PCPrmG, PCPrmGI, PCPrmW, PCPrmWI, PCWhiteTop, PCWhiteBottom, PCCapT, VxBlt
    global hPCColDC, hPCColBM, pPCColBits, PCColW, PCColH, hPCColOld
    if (!PcFindPixFn())
        return PerfectTrackFrameAhk()
    w := 160
    mid := Round((PCGreenL + PCGreenR) / 2)
    sx := mid - 80
    if (sx < 0)
        sx := 0
    if (sx + w > WindowWidth)
        sx := WindowWidth - w
    if (sx < 0)
        return 0
    sy := PCGreenY - 50
    if (sy < 0)
        sy := 0
    h := PCSearchBottom - sy
    if (h < 8)
        return 0

    if (!hPCColDC || PCColW != w || PCColH != h) {
        if (hPCColDC) {
            DllCall("SelectObject", "Ptr", hPCColDC, "Ptr", hPCColOld)
            DllCall("DeleteObject", "Ptr", hPCColBM)
            DllCall("DeleteDC", "Ptr", hPCColDC)
            hPCColDC := 0, hPCColBM := 0, pPCColBits := 0
        }
        VarSetCapacity(bih, 40, 0)
        NumPut(40, bih, 0, "UInt")
        NumPut(w, bih, 4, "Int")
        NumPut(-h, bih, 8, "Int")
        NumPut(1, bih, 12, "UShort")
        NumPut(32, bih, 14, "UShort")
        scr := DllCall("GetDC", "Ptr", 0, "Ptr")
        hPCColDC := DllCall("CreateCompatibleDC", "Ptr", scr, "Ptr")
        bits := 0
        hPCColBM := DllCall("CreateDIBSection", "Ptr", scr, "Ptr", &bih, "UInt", 0, "Ptr*", bits, "Ptr", 0, "UInt", 0, "Ptr")
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)
        pPCColBits := bits
        hPCColOld := DllCall("SelectObject", "Ptr", hPCColDC, "Ptr", hPCColBM, "Ptr")
        PCColW := w
        PCColH := h
    }
    qpc := 0
    DllCall("QueryPerformanceCounter", "Int64*", qpc)
    PCCapT := qpc
    scr := DllCall("GetDC", "Ptr", 0, "Ptr")
    DllCall(VxBlt, "Ptr", hPCColDC, "Int", 0, "Int", 0, "Int", w, "Int", h
        , "Ptr", scr, "Int", WindowLeft + sx, "Int", WindowTop + sy, "UInt", 0x00CC0020)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)

    PcSetPrm(PCPrmG, PerfectGreenColor, PerfectGreenTolerance, 1, 0)
    PcSetPrm(PCPrmGI, PerfectGreenColor, PerfectGreenTolerance, 1, 1)
    PcSetPrm(PCPrmW, PerfectWhiteColor, PerfectWhiteTolerance, 2, 0)
    PcSetPrm(PCPrmWI, PerfectWhiteColor, PerfectWhiteTolerance, 2, 1)

    base := pPCColBits
    pitch := w * 4
    scanTo := Min(h, 110)
    gRow := -1
    yPrev := PCGreenY - sy
    for _, cy in [yPrev, yPrev - 1, yPrev + 1, yPrev - 2, yPrev + 2] {
        if (cy < 0 || cy >= scanTo)
            continue
        lo := -1, hi := -1
        if (PcRowRun(base + cy * pitch, w, PCPrmG, PCPrmGI, lo, hi)) {
            len := hi - lo + 1
            if (len >= 6 && len < 60) {
                gRow := cy, gl := lo, gr := hi
                break
            }
        }
    }
    if (gRow < 0) {
        cy := 0
        while (cy < scanTo) {
            lo := -1, hi := -1
            if (PcRowRun(base + cy * pitch, w, PCPrmG, PCPrmGI, lo, hi)) {
                len := hi - lo + 1
                if (len >= 6 && len < 60) {
                    gRow := cy, gl := lo, gr := hi
                    break
                }
            }
            cy += 1
        }
        if (gRow < 0)
            return 0
    }
    PCGreenY := sy + gRow
    PCGreenL := sx + gl
    PCGreenR := sx + gr

    ; top of the white fill: highest white sample below the green row
    cx := (gl + gr) // 2
    xa := Max(0, cx - 6)
    xb := Min(w - 1, cx + 5)
    top := -1
    x := xa
    while (x <= xb) {
        i := PcFind(base + gRow * pitch + x * 4, h - gRow, pitch, PCPrmW)
        if (i >= 0 && (top < 0 || gRow + i < top))
            top := gRow + i
        x += 1
    }
    if (top < 0)
        return 1

    ; bottom of the white fill, bridging gaps of up to 16 rows
    bot := top
    x := xa
    while (x <= xb) {
        cy := top
        colBot := -1
        Loop {
            i := PcFind(base + cy * pitch + x * 4, Min(17, h - cy), pitch, PCPrmW)
            if (i < 0 || i > 16)
                break
            ws := cy + i
            j := PcFind(base + ws * pitch + x * 4, h - ws, pitch, PCPrmWI)
            if (j < 0) {
                colBot := h - 1
                break
            }
            colBot := ws + j - 1
            cy := colBot + 1
        }
        if (colBot > bot)
            bot := colBot
        x += 1
    }
    PCWhiteTop := sy + top
    PCWhiteBottom := sy + bot
    return 2
}
PcSetPrm(ByRef prm, rgbHex, tol, mode, inv) {
    bgr := ToBGR(ColMain(rgbHex))
    VarSetCapacity(prm, 24, 0)
    NumPut((bgr >> 16) & 0xFF, prm, 0, "Int")
    NumPut((bgr >> 8) & 0xFF, prm, 4, "Int")
    NumPut(bgr & 0xFF, prm, 8, "Int")
    NumPut(tol, prm, 12, "Int")
    NumPut(mode, prm, 16, "Int")
    NumPut(inv, prm, 20, "Int")
}
PcFind(p, n, stride, ByRef prm) {
    if (n <= 0)
        return -1
    fn := PcFindPixFn()
    if (fn)
        return DllCall(fn, "Ptr", p, "Int", n, "Int", stride, "Ptr", &prm, "Int")
    return PcFindPixAhk(p, n, stride, NumGet(prm, 0, "Int"), NumGet(prm, 4, "Int"), NumGet(prm, 8, "Int")
        , NumGet(prm, 12, "Int"), NumGet(prm, 16, "Int"), NumGet(prm, 20, "Int"))
}
PcRowRun(rowP, w, ByRef prm, ByRef prmInv, ByRef lo, ByRef hi) {
    lo := -1, hi := -1
    x := 0
    while (x < w) {
        i := PcFind(rowP + x * 4, w - x, 4, prm)
        if (i < 0)
            break
        rs := x + i
        re := rs
        Loop {
            j := PcFind(rowP + (re + 1) * 4, w - (re + 1), 4, prmInv)
            if (j < 0) {
                re := w - 1
                break
            }
            re := re + j
            ; allow a gap of at most 2 non-matching pixels
            k := PcFind(rowP + (re + 1) * 4, Min(3, w - (re + 1)), 4, prm)
            if (k < 0 || k > 2)
                break
            re := re + 1 + k
        }
        if (re - rs + 1 > hi - lo + 1) {
            lo := rs
            hi := re
        }
        x := re + 2
    }
    return lo >= 0
}
PcCapVerify(gRow, lo, hi) {
    global pPCFullBits, PCFullW, PCFullH, WindowHeight, PCVerifyOff
    if (PCVerifyOff)
        return true
    w := PCFullW
    cx := (lo + hi) // 2
    edge := Max(4, Round(0.0023 * w))
    if (lo - edge < 0 || hi + edge >= w || hi - lo < 3)
        return false
    ok := 0
    tried := 0
    for _, fr in [0.020, 0.040, 0.070, 0.100, 0.145, 0.190] {
        y := gRow + Round(WindowHeight * fr)
        if (y >= PCFullH)
            break
        tried += 1
        li := Min(lo + 2, cx)
        ri := Max(hi - 2, cx)
        rowP := pPCFullBits + y * w * 4
        if (!PcBarPx(rowP, cx) || !PcBarPx(rowP, li) || !PcBarPx(rowP, ri))
            continue
        if (Abs(PcLumPx(rowP, lo + 1) - PcLumPx(rowP, lo - edge)) < 25)
            continue
        if (Abs(PcLumPx(rowP, hi - 1) - PcLumPx(rowP, hi + edge)) < 25)
            continue
        ok += 1
    }
    if (tried < 3)
        return (ok > 0 && ok = tried)
    return ok >= 3
}
PcBarPx(p, x) {
    a := p + x * 4
    b := NumGet(a + 0, 0, "UChar")
    g := NumGet(a + 0, 1, "UChar")
    r := NumGet(a + 0, 2, "UChar")
    hiC := Max(r, g, b)
    loC := Min(r, g, b)
    return (hiC < 100 || loC > 150) && (hiC - loC) < 45
}
PcLumPx(p, x) {
	px := NumGet(p + 0, x * 4, "UInt")
	return ((px & 0xFF) + ((px >> 8) & 0xFF) + ((px >> 16) & 0xFF)) // 3
}

TwigPrompt(ByRef lcx, ByRef rcx, ByRef labY) {
    global WindowLeft, WindowTop, WindowWidth, WindowHeight, VxBlt
    global hTwigDC, hTwigBM, pTwigBits, TwigW, TwigH, hTwigOld
    w := Round(0.20 * WindowWidth)
    h := Round(0.41 * WindowHeight)
    if (w < 60 || h < 60)
        return false
    x0 := Round(0.40 * WindowWidth)
    y0 := Round(0.17 * WindowHeight)

    if (!hTwigDC || TwigW != w || TwigH != h) {
        if (hTwigDC) {
            DllCall("SelectObject", "Ptr", hTwigDC, "Ptr", hTwigOld)
            DllCall("DeleteObject", "Ptr", hTwigBM)
            DllCall("DeleteDC", "Ptr", hTwigDC)
            hTwigDC := 0, hTwigBM := 0, pTwigBits := 0
        }
        VarSetCapacity(bih, 40, 0)
        NumPut(40, bih, 0, "UInt")
        NumPut(w, bih, 4, "Int")
        NumPut(-h, bih, 8, "Int")
        NumPut(1, bih, 12, "UShort")
        NumPut(32, bih, 14, "UShort")
        scr := DllCall("GetDC", "Ptr", 0, "Ptr")
        hTwigDC := DllCall("CreateCompatibleDC", "Ptr", scr, "Ptr")
        bits := 0
        hTwigBM := DllCall("CreateDIBSection", "Ptr", scr, "Ptr", &bih, "UInt", 0, "Ptr*", bits, "Ptr", 0, "UInt", 0, "Ptr")
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)
        pTwigBits := bits
        hTwigOld := DllCall("SelectObject", "Ptr", hTwigDC, "Ptr", hTwigBM, "Ptr")
        TwigW := w
        TwigH := h
    }
    scr := DllCall("GetDC", "Ptr", 0, "Ptr")
    DllCall(VxBlt, "Ptr", hTwigDC, "Int", 0, "Int", 0, "Int", w, "Int", h
        , "Ptr", scr, "Int", WindowLeft + x0, "Int", WindowTop + y0, "UInt", 0x00CC0020)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)

    base := pTwigBits
    pitch := w * 4

    ; near-white banner along the top
    pbH := Round(0.17 * h)
    cnt := 0
    y := 0
    while (y < pbH) {
        rowP := base + y * pitch
        x := 0
        while (x < w) {
            px := rowP + x * 4
            b := NumGet(px + 0, 0, "UChar"), g := NumGet(px + 0, 1, "UChar"), r := NumGet(px + 0, 2, "UChar")
            mn := Min(r, g, b)
            if (mn > 225 && Max(r, g, b) - mn < 30)
                cnt += 1
            x += 2
        }
        y += 2
    }
    if (cnt * 4 < 0.04 * pbH * w)
        return false

    ; bright markers with a dark outline in the lower band
    yb := Round(0.878 * h)
    half := w // 2
    lN := 0, lSum := 0, rN := 0, rSum := 0, ySum := 0
    y := yb
    while (y < h) {
        rowP := base + y * pitch
        x := 3
        while (x <= w - 4) {
            px := rowP + x * 4
            if (Max(NumGet(px + 0, 0, "UChar"), NumGet(px + 0, 1, "UChar"), NumGet(px + 0, 2, "UChar")) > 185) {
                dark := false
                Loop, 3 {
                    for _, nx in [x - A_Index, x + A_Index] {
                        q := rowP + nx * 4
                        if (NumGet(q + 0, 0, "UChar") < 70 && NumGet(q + 0, 1, "UChar") < 70 && NumGet(q + 0, 2, "UChar") < 70) {
                            dark := true
                            break
                        }
                    }
                    if (dark)
                        break
                }
                if (dark) {
                    if (x < half)
                        lN += 1, lSum += x
                    else
                        rN += 1, rSum += x
                    ySum += y
                }
            }
            x += 2
        }
        y += 2
    }
    slot := (h - yb) * half * 0.035
    if (lN * 4 < slot || rN * 4 < slot)
        return false
    lcx := x0 + Round(lSum / lN)
    rcx := x0 + Round(rSum / rN)
    labY := y0 + Round(ySum / (lN + rN))
    return true
}
PcFindPixAhk(p, n, stride, tB, tG, tR, tol, mode, inv) {
    i := 0
    while (i < n) {
        a := p + i * stride
        b := NumGet(a + 0, 0, "UChar")
        g := NumGet(a + 0, 1, "UChar")
        r := NumGet(a + 0, 2, "UChar")
        hit := (Abs(b - tB) <= tol && Abs(g - tG) <= tol && Abs(r - tR) <= tol) ? 1 : 0
        if (!hit && mode = 1 && g > 80 && g - r > 22 && g - b > 22)
            hit := 1
        if (!hit && mode = 2 && r > 200 && g > 200 && b > 200) {
            if (Max(r, g, b) - Min(r, g, b) < 32)
                hit := 1
        }
        if (hit != inv)
            return i
        i += 1
    }
    return -1
}
PcFindPixFn() {
    static pFn := ""
    ; x64 code: int f(BYTE* p, int n, int stride, int* prm) - same rules as PcFindPixAhk
    static hex := "5356574D63C031C039D00F8D0B010000440FB611440FB659010FB6590231F64489D7412B397902F7DF413B790C0F8F33000000"
        . "4489DF412B79047902F7DF413B790C0F8F1E00000089DF412B79087902F7DF413B790C0F8F0A000000BE01000000E99D000000"
        . "418B791083FF010F85310000004183FB500F8E860000004489DF29DF83FF160F8E780000004489DF4429D783FF160F8E690000"
        . "00BE01000000E95F00000083FF020F855600000081FBC80000000F8E4A0000004181FBC80000000F8E3D0000004181FAC80000"
        . "000F8E300000004489D74439DF410F4CFB39DF0F4CFB4489D64439DE410F4FF339DE0F4FF329F731F683FF200F8D05000000BE"
        . "01000000413B71140F850A0000004C01C1FFC0E9F1FEFFFF5F5E5BC348C7C0FFFFFFFF5F5E5BC3"
    if (pFn != "")
        return pFn
    pFn := 0
    if (A_PtrSize != 8)
        return 0
    size := StrLen(hex) // 2
    mem := DllCall("VirtualAlloc", "Ptr", 0, "UPtr", size, "UInt", 0x3000, "UInt", 0x04, "Ptr")
    if (!mem)
        return 0
    Loop, %size%
        NumPut("0x" SubStr(hex, 2 * A_Index - 1, 2), mem + 0, A_Index - 1, "UChar")
    oldProt := 0
    if (!DllCall("VirtualProtect", "Ptr", mem, "UPtr", size, "UInt", 0x20, "UInt*", oldProt)) {
        DllCall("VirtualFree", "Ptr", mem, "UPtr", 0, "UInt", 0x8000)
        return 0
    }

    ; self-test against the AHK finder on pseudo-random pixels
    tw := 240
    VarSetCapacity(buf, tw * 4, 0)
    seed := 4242
    Loop, %tw% {
        seed := Mod(seed * 1103515245 + 12345, 0x80000000)
        px := (seed >> 8) & 0xFFFFFF
        m := Mod(A_Index, 23)
        if (m = 3)
            px := 0x61AC4A
        else if (m = 9)
            px := 0xF8FCFF
        else if (m = 14)
            px := 0x30C030
        else if (m = 19)
            px := 0xE0FFE0
        NumPut(px, buf, (A_Index - 1) * 4, "UInt")
    }
    cases := [[0x4A, 0xAC, 0x61, 20, 1, 0], [0x4A, 0xAC, 0x61, 20, 1, 1]
        , [0xF3, 0xFE, 0xFF, 25, 2, 0], [0xF3, 0xFE, 0xFF, 25, 2, 1]
        , [0x4A, 0xAC, 0x61, 5, 0, 0], [0x10, 0x20, 0x30, 0, 0, 0]]
    ; scans: [first pixel, step in pixels]
    scans := [[0, 1], [tw - 1, -1], [5, 3]]
    bad := false, anyHit := false, anyMiss := false
    VarSetCapacity(prm, 24, 0)
    for _, c in cases {
        Loop, 6
            NumPut(c[A_Index], prm, (A_Index - 1) * 4, "Int")
        for _, s in scans {
            Loop, 8 {
                st := s[1] + (A_Index - 1) * 5 * (s[2] > 0 ? 1 : -1)
                if (s[2] > 0)
                    cnt := (tw - st + s[2] - 1) // s[2]
                else
                    cnt := st + 1
                if (st < 0 || st >= tw || cnt <= 0)
                    continue
                p := &buf + st * 4
                nat := DllCall(mem, "Ptr", p, "Int", cnt, "Int", s[2] * 4, "Ptr", &prm, "Int")
                ref := PcFindPixAhk(p, cnt, s[2] * 4, c[1], c[2], c[3], c[4], c[5], c[6])
                if (nat != ref)
                    bad := true
                if (ref >= 0)
                    anyHit := true
                else
                    anyMiss := true
            }
        }
    }
    if (bad || !anyHit || !anyMiss) {
        DllCall("VirtualFree", "Ptr", mem, "UPtr", 0, "UInt", 0x8000)
        return 0
    }
    pFn := mem
    return pFn
}
PerfectAcquireGreenAhk() {
    global WindowWidth, WindowLeft, WindowTop, PCSearchTop, PCSearchBottom
    global PerfectGreenColor, PerfectGreenTolerance, PerfectWhiteColor, PerfectWhiteTolerance
    global PCLastGoodY, PCGreenY, PCGreenL, PCGreenR, VxBlt
    global hPCFullDC, hPCFullBM, hPCFullOld, pPCFullBits, PCFullW, PCFullH
    w := WindowWidth
    h := PCSearchBottom - PCSearchTop
    if (w < 8 || h < 8)
        return false

    ; (re)build the cached full-strip buffer when missing or resized
    if (!hPCFullDC || !pPCFullBits || PCFullW != w || PCFullH != h) {
        if (hPCFullDC) {
            if (hPCFullOld)
                DllCall("SelectObject", "Ptr", hPCFullDC, "Ptr", hPCFullOld)
            DllCall("DeleteDC", "Ptr", hPCFullDC)
        }
        if (hPCFullBM)
            DllCall("DeleteObject", "Ptr", hPCFullBM)
        hPCFullDC := 0, hPCFullBM := 0, hPCFullOld := 0, pPCFullBits := 0
        scr := DllCall("GetDC", "Ptr", 0, "Ptr")
        hPCFullDC := DllCall("CreateCompatibleDC", "Ptr", scr, "Ptr")
        VarSetCapacity(bmi, 40, 0)
        NumPut(40, bmi, 0, "UInt")
        NumPut(w, bmi, 4, "Int")
        NumPut(-h, bmi, 8, "Int")
        NumPut(1, bmi, 12, "UShort")
        NumPut(32, bmi, 14, "UShort")
        hPCFullBM := DllCall("CreateDIBSection", "Ptr", hPCFullDC, "Ptr", &bmi, "UInt", 0, "Ptr*", pPCFullBits, "Ptr", 0, "UInt", 0, "Ptr")
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)
        hPCFullOld := DllCall("SelectObject", "Ptr", hPCFullDC, "Ptr", hPCFullBM, "Ptr")
        PCFullW := w
        PCFullH := h
    }

    scr := DllCall("GetDC", "Ptr", 0, "Ptr")
    DllCall(VxBlt, "Ptr", hPCFullDC, "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr", scr, "Int", WindowLeft, "Int", WindowTop + PCSearchTop, "UInt", 0x00CC0020)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)

    gc := ToBGR(ColMain(PerfectGreenColor))
    tb := (gc >> 16) & 0xFF, tg := (gc >> 8) & 0xFF, tr := gc & 0xFF
    tol := PerfectGreenTolerance
    ; white target is prepared but not used by this search
    wc := ToBGR(ColMain(PerfectWhiteColor))
    wtol := PerfectWhiteTolerance

    found := false
    Loop, 2
    {
        narrow := (A_Index = 1 && PCLastGoodY != "" && PCLastGoodY >= 0)
        if (narrow) {
            y0 := PCLastGoodY - PCSearchTop - 70
            if (y0 < 0)
                y0 := 0
            y1 := PCLastGoodY - PCSearchTop + 70
            if (y1 > h)
                y1 := h
        } else {
            y0 := 0
            y1 := h
        }
        y := y0
        while (y < y1) {
            bestLo := -1, bestHi := -1
            runLo := -1, runHi := -1, miss := 0
            rowPtr := pPCFullBits + y * w * 4
            x := 0
            while (x < w) {
                p := NumGet(rowPtr + x * 4, "UInt")
                b := p & 0xFF, g := (p >> 8) & 0xFF, r := (p >> 16) & 0xFF
                isGreen := (g > 80 && g > r + 22 && g > b + 22) || (Abs(b - tb) <= tol && Abs(g - tg) <= tol && Abs(r - tr) <= tol)
                if (isGreen) {
                    if (runLo < 0)
                        runLo := x
                    runHi := x
                    miss := 0
                } else if (runLo >= 0) {
                    miss++
                    if (miss > 1) {
                        if (bestLo < 0 || runHi - runLo > bestHi - bestLo) {
                            bestLo := runLo
                            bestHi := runHi
                        }
                        runLo := -1
                        miss := 0
                    }
                }
                x += 2
            }
            if (runLo >= 0 && (bestLo < 0 || runHi - runLo > bestHi - bestLo)) {
                bestLo := runLo
                bestHi := runHi
            }
            if (bestLo >= 0) {
                runW := bestHi - bestLo + 1
                if (runW >= 6 && runW < 60) {
                    gRow := y, gl := bestLo, gr := bestHi
                    found := true
                    break
                }
                ; wrong width: skip the whole green band below this row
                y++
                while (y < y1) {
                    rowHas := false
                    rowPtr := pPCFullBits + y * w * 4
                    x := 0
                    while (x < w) {
                        p := NumGet(rowPtr + x * 4, "UInt")
                        b := p & 0xFF, g := (p >> 8) & 0xFF, r := (p >> 16) & 0xFF
                        if ((g > 80 && g > r + 22 && g > b + 22) || (Abs(b - tb) <= tol && Abs(g - tg) <= tol && Abs(r - tr) <= tol)) {
                            rowHas := true
                            break
                        }
                        x += 2
                    }
                    if (!rowHas)
                        break
                    y++
                }
                continue
            }
            y++
        }
        if (found || !narrow)
            break
    }
    if (!found)
        return false
    PCGreenY := PCSearchTop + gRow
    PCGreenL := gl
    PCGreenR := gr
    PCLastGoodY := PCGreenY
    return true
}
PerfectTrackFrameAhk() {
    global PCGreenL, PCGreenR, PCGreenY, PCSearchBottom, WindowLeft, WindowTop, WindowWidth
    global PerfectGreenColor, PerfectGreenTolerance, PerfectWhiteColor, PerfectWhiteTolerance
    global hPCColDC, hPCColBM, pPCColBits, PCColW, PCColH, hPCColOld
    global PCCapT, PCWhiteTop, PCWhiteBottom, VxBlt
    w := 160
    mid := Round((PCGreenL + PCGreenR) / 2)
    sx := mid - 80
    if (sx < 0)
        sx := 0
    if (sx + 160 > WindowWidth)
        sx := WindowWidth - 160
    if (sx < 0)
        return 0
    sy := PCGreenY - 50
    if (sy < 0)
        sy := 0
    h := PCSearchBottom - sy
    if (h < 8)
        return 0

    if (!hPCColDC || !pPCColBits || PCColW != w || PCColH != h) {
        if (hPCColDC) {
            if (hPCColOld)
                DllCall("SelectObject", "Ptr", hPCColDC, "Ptr", hPCColOld)
            DllCall("DeleteDC", "Ptr", hPCColDC)
        }
        if (hPCColBM)
            DllCall("DeleteObject", "Ptr", hPCColBM)
        hPCColDC := 0, hPCColBM := 0, hPCColOld := 0, pPCColBits := 0
        scr := DllCall("GetDC", "Ptr", 0, "Ptr")
        hPCColDC := DllCall("CreateCompatibleDC", "Ptr", scr, "Ptr")
        VarSetCapacity(bmi, 40, 0)
        NumPut(40, bmi, 0, "UInt")
        NumPut(w, bmi, 4, "Int")
        NumPut(-h, bmi, 8, "Int")
        NumPut(1, bmi, 12, "UShort")
        NumPut(32, bmi, 14, "UShort")
        hPCColBM := DllCall("CreateDIBSection", "Ptr", hPCColDC, "Ptr", &bmi, "UInt", 0, "Ptr*", pPCColBits, "Ptr", 0, "UInt", 0, "Ptr")
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)
        hPCColOld := DllCall("SelectObject", "Ptr", hPCColDC, "Ptr", hPCColBM, "Ptr")
        PCColW := w
        PCColH := h
    }

    DllCall("QueryPerformanceCounter", "Int64*", PCCapT)
    scr := DllCall("GetDC", "Ptr", 0, "Ptr")
    DllCall(VxBlt, "Ptr", hPCColDC, "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr", scr, "Int", WindowLeft + sx, "Int", WindowTop + sy, "UInt", 0x00CC0020)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)

    gc := ToBGR(ColMain(PerfectGreenColor))
    tb := (gc >> 16) & 0xFF, tg := (gc >> 8) & 0xFF, tr := gc & 0xFF
    tol := PerfectGreenTolerance

    scanTo := (h < 110) ? h : 110
    gRow := -1
    y := 0
    while (y < scanTo) {
        bestLo := -1, bestHi := -1
        runLo := -1, runHi := -1, miss := 0
        rowPtr := pPCColBits + y * w * 4
        x := 0
        while (x < w) {
            p := NumGet(rowPtr + x * 4, "UInt")
            b := p & 0xFF, g := (p >> 8) & 0xFF, r := (p >> 16) & 0xFF
            if ((g > 80 && g > r + 22 && g > b + 22) || (Abs(b - tb) <= tol && Abs(g - tg) <= tol && Abs(r - tr) <= tol)) {
                if (runLo < 0)
                    runLo := x
                runHi := x
                miss := 0
            } else if (runLo >= 0) {
                miss++
                if (miss > 2) {
                    if (bestLo < 0 || runHi - runLo > bestHi - bestLo) {
                        bestLo := runLo
                        bestHi := runHi
                    }
                    runLo := -1
                    miss := 0
                }
            }
            x++
        }
        if (runLo >= 0 && (bestLo < 0 || runHi - runLo > bestHi - bestLo)) {
            bestLo := runLo
            bestHi := runHi
        }
        if (bestLo >= 0) {
            gRow := y, gl := bestLo, gr := bestHi
            break
        }
        y++
    }
    if (gRow < 0)
        return 0
    runW := gr - gl + 1
    if (runW < 6 || runW >= 60)
        return 0

    PCGreenY := sy + gRow
    PCGreenL := sx + gl
    PCGreenR := sx + gr

    ; look for the white marker in a narrow column just under the green row
    wc := ToBGR(ColMain(PerfectWhiteColor))
    wb := (wc >> 16) & 0xFF, wg := (wc >> 8) & 0xFF, wr := wc & 0xFF
    wtol := PerfectWhiteTolerance
    top := -1, bot := -1
    y := gRow
    while (y < h && (top < 0 || y - bot <= 16)) {
        rowPtr := pPCColBits + y * w * 4
        Loop, 12
        {
            x := 73 + A_Index
            p := NumGet(rowPtr + x * 4, "UInt")
            b := p & 0xFF, g := (p >> 8) & 0xFF, r := (p >> 16) & 0xFF
            hi := Max(r, g, b), lo := Min(r, g, b)
            if ((r > 200 && g > 200 && b > 200 && hi - lo < 32) || (Abs(b - wb) <= wtol && Abs(g - wg) <= wtol && Abs(r - wr) <= wtol)) {
                if (top < 0)
                    top := y
                bot := y
                break
            }
        }
        y++
    }
    if (top < 0)
        return 1
    PCWhiteTop := sy + top
    PCWhiteBottom := sy + bot
    return 2
}
