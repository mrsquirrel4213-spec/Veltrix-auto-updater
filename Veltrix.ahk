            NoiseAltW := 0
        } else if (NoiseAltW > 0 && Abs((altR - altL) - NoiseAltW) <= 4) {
            NoiseAltN := NoiseAltN + 1
        } else {
            NoiseAltW := altR - altL
            NoiseAltN := 1
        }
        if (NoiseAltN >= 3) {
            NoiseWCal := altR - altL
            NoiseWCnt := {}
            NoiseWVote := 0, NoiseJumpN := 0, NoiseOscN := 0, NoiseCoastN := 0
            NoiseAltN := 0, NoiseAltW := 0
