                        tRun := -1, tG := 0
                    }
                }
            } else {
                if (tRun < 0)
                    tRun := x
                tEnd := x
                tG := 0
            }
        }
        if (tRun >= 0 && tEnd - tRun + 1 > tLen)
            tBest := tRun, tLen := tEnd - tRun + 1
