	OjStarsVis := false, OjStarSeenT := 0, OjNextRd := 1, OjStarsMissN := 0
	; a blank time would make "now - OjLastFind < 300" true forever (blank math is blank in AHK v1) - so set it
	OjLastFind := -99999, OjBarL := -99999, OjTipT := 0
}

