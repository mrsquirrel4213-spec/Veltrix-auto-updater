    ; --- note buffer ---
    if (hNoteMemDC) {
        if (hNoteOldBitmap)
            DllCall("SelectObject", "Ptr", hNoteMemDC, "Ptr", hNoteOldBitmap)
        DllCall("DeleteDC", "Ptr", hNoteMemDC)
    }
    if (hNoteBitmap)
        DllCall("DeleteObject", "Ptr", hNoteBitmap)
    if (hNoteScreenDC)
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", hNoteScreenDC)
    hNoteMemDC := 0, hNoteBitmap := 0, hNoteOldBitmap := 0, hNoteScreenDC := 0

    NoteW := CaptureW
    NoteH := Round(NoteRegionHeight)
    if (SpecialRod = "Tranquility")
        NoteH := Max(NoteH, Round(0.55 * WindowHeight))
    else if (SpecialRod = "Noiseform")
        NoteH := Max(NoteH, Round(0.50 * WindowHeight))
    else if (SpecialRod = "Halibut Harpoon")
        NoteH := Round(0.075 * WindowHeight)
    if (NoteH < 20)
        NoteH := 20
    if (NoteH > 1400)
        NoteH := 1400
    NoteTop := Round(FishBarTop) - NoteH
    if (NoteTop < 0) {
        NoteTop := 0
        NoteH := Max(20, Round(FishBarTop))
    }
    if (SpecialRod = "Noiseform") {
        sc_nfTop := Round(0.5194 * WindowHeight) - Round(0.135 * WindowHeight) - 2
        if (sc_nfTop > NoteTop && sc_nfTop < Round(FishBarTop) - 80) {
            NoteTop := sc_nfTop
            NoteH := Round(FishBarTop) - NoteTop
        }
    }

    NoteIndep := false
    NoteNeeded := (SpecialRod = "Pinions Aria" || SpecialRod = "Noiseform" || SpecialRod = "Tranquility" || SpecialRod = "Lullaby" || SpecialRod = "Halibut Harpoon" || SpecialRod = "Stellarwave Melody")
    NoteOriginX := Round(FishBarLeft)
    NoteOriginY := NoteTop

    if (SpecialRod = "Pinions Aria") {
        sc_nrx := Round(ClickShakeLeft)
        sc_nrw := Round(ClickShakeRight - ClickShakeLeft)
        sc_nry := Round(ClickShakeTop)
        sc_nrh := Round(ClickShakeBottom - ClickShakeTop)
        if (sc_nry + sc_nrh > Round(FishBarTop))
            sc_nrh := Round(FishBarTop) - sc_nry
        if (sc_nrw >= 20 && sc_nrh >= 40) {
            NoteIndep := true
            NoteOriginX := sc_nrx
            NoteOriginY := sc_nry
            NoteW := sc_nrw
            NoteH := sc_nrh
        }
    }
    if (SpecialRod = "Stellarwave Melody") {
        NoteIndep := true
        NoteOriginX := Round(0.20 * WindowWidth)
        NoteOriginY := Round(0.69 * WindowHeight)
        NoteW := Round(0.60 * WindowWidth)
        NoteH := Round(0.10 * WindowHeight)
        if (NoteH < 20)
            NoteH := 20
    }

    hNoteScreenDC := DllCall("GetDC", "Ptr", 0, "Ptr")
    hNoteMemDC := DllCall("CreateCompatibleDC", "Ptr", hNoteScreenDC, "Ptr")
    NoteFullH := NoteIndep ? NoteH : NoteH + CaptureH + 20 + CapExtra
    if (SpecialRod = "Stellarwave Melody" && NoteIndep) {
        if (Round(FishBarTop) - 18 >= NoteOriginY && Round(FishBarLeft) >= NoteOriginX && (Round(FishBarLeft) - NoteOriginX + CaptureW) <= NoteW)
            NoteFullH := Max(NoteH, Round(FishBarTop) - 18 + CaptureH + 38 + CapExtra - NoteOriginY)
    }
    VarSetCapacity(sc_bmi, 40, 0)
    NumPut(40, sc_bmi, 0, "UInt")
    NumPut(NoteW, sc_bmi, 4, "Int")
    NumPut(-NoteFullH, sc_bmi, 8, "Int")
    NumPut(1, sc_bmi, 12, "UShort")
    NumPut(32, sc_bmi, 14, "UShort")
    hNoteBitmap := DllCall("CreateDIBSection", "Ptr", hNoteMemDC, "Ptr", &sc_bmi, "UInt", 0, "Ptr*", pNoteBits, "Ptr", 0, "UInt", 0, "Ptr")
    hNoteOldBitmap := DllCall("SelectObject", "Ptr", hNoteMemDC, "Ptr", hNoteBitmap, "Ptr")
return
CaptureFishBar:
    CaptureStrip()
    CaptureEdgeStrips()
    LineScanned := false
    GradScanned := false
    RemNatDone := false
    NoiseScanned := false
    CastScanned := false
    RemScanned := false
    RemBarScanned := false
    MiguScanned := false
    MiguBarScanned := false
    HaliBarScanned := false
    TryScanned := false
    DoomScanned := false
    OppScanned := false
    SwScanned := false
return
BuildHud:
    Gosub, HudDestroySurface
    if (HudBuilt)
        Gui, Hud: Destroy
    HudW := Round(TrackRight - TrackLeft)
    if (HudW < 40)
        HudW := 40
    HudH := 34
    Gui, Hud: +AlwaysOnTop -Caption +ToolWindow +E0x80020 +HwndhHudGui
    Gui, Hud: Margin, 0, 0
    Gui, Hud: Color, 010101
    Gui, Hud: Show, Hide NA, VeltrixHud
    HudBuilt := true
    HudGpOk := HudSurfaceMake(HudW, HudH)
    HudFishTgt := -1, HudBarTgt := -1, HudFishCur := -1, HudBarCur := -1
    HudNoteX := -1, HudNote2X := -1
    HudFish2Tgt := -1, HudFish2Cur := -1, HudBar2Tgt := -1, HudBar2Cur := -1
    HudBar2W := 0
    HudZoneShown := false
    BarWTrust := 0
    HudWRing := []
    HudWMed := 0
    HudDirty := true
    HudLastKey := ""
    HudPrevT := 0
return
HudGdipStart() {
    global HudGdipToken
    if (HudGdipToken)
        return true
    if (!DllCall("GetModuleHandle", "Str", "gdiplus", "Ptr")) {
        if (!DllCall("LoadLibrary", "Str", "gdiplus", "Ptr"))
            return false
    }
    VarSetCapacity(input, A_PtrSize = 8 ? 24 : 16, 0)
    NumPut(1, input, 0, "UInt")
    token := 0
    status := DllCall("gdiplus\GdiplusStartup", "Ptr*", token, "Ptr", &input, "Ptr", 0)
    if (status != 0)
        return false
    HudGdipToken := token
    return true
}
HudSurfaceMake(w, h) {
    global hHudDC, hHudBM, hHudOldBM, pHudBits, pHudGfx, pHudBmp, HudSurfW, HudSurfH
    Gosub, HudDestroySurface
    if (!HudGdipStart())
        return false
    scr := DllCall("GetDC", "Ptr", 0, "Ptr")
    hHudDC := DllCall("CreateCompatibleDC", "Ptr", scr, "Ptr")
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", scr)
    if (!hHudDC)
        return false
    VarSetCapacity(bmi, 40, 0)
    NumPut(40, bmi, 0, "UInt")
    NumPut(w, bmi, 4, "Int")
    NumPut(-h, bmi, 8, "Int")
    NumPut(1, bmi, 12, "UShort")
    NumPut(32, bmi, 14, "UShort")
    bits := 0
    hHudBM := DllCall("CreateDIBSection", "Ptr", hHudDC, "Ptr", &bmi, "UInt", 0, "Ptr*", bits, "Ptr", 0, "UInt", 0, "Ptr")
    if (!hHudBM)
        return false
    pHudBits := bits
    hHudOldBM := DllCall("SelectObject", "Ptr", hHudDC, "Ptr", hHudBM, "Ptr")
    bmp := 0
    if (DllCall("gdiplus\GdipCreateBitmapFromScan0", "Int", w, "Int", h, "Int", w * 4, "Int", 0xE200B, "Ptr", pHudBits, "Ptr*", bmp) != 0)
        return false
    pHudBmp := bmp
    gfx := 0
    if (DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", pHudBmp, "Ptr*", gfx) != 0)
        return false
    pHudGfx := gfx
    DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", pHudGfx, "Int", 4)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "Ptr", pHudGfx, "Int", 2)
    HudSurfW := w
    HudSurfH := h
    return true
}
HudWPush(w) {
    global HudWRing, HudWMed
    if (w <= 0)
        return
    if (!IsObject(HudWRing))
        HudWRing := []
    HudWRing.Push(w)
    if (HudWRing.Length() > 5)
        HudWRing.RemoveAt(1)
    sorted := []
    for _, val in HudWRing {
        pos := sorted.Length() + 1
        while (pos > 1 && sorted[pos - 1] > val)
            pos--
        sorted.InsertAt(pos, val)
    }
    n := sorted.Length()
    HudWMed := sorted[n // 2 + 1]
}
HudBarW() {
    global BarWTrust, WhiteBarSize, RunWidth, HudWMed, HudWRing
    if (HudWMed > 8 && IsObject(HudWRing) && HudWRing.Length() >= 3)
        return HudWMed
    if (WhiteBarSize > 8)
        return WhiteBarSize
    if (BarWTrust > 8)
        return BarWTrust
    return (RunWidth > 8) ? RunWidth : 8
}
HudRoundRect(x, y, w, h, r, argb) {
    global pHudGfx
    if (w <= 0 || h <= 0)
        return
    if (2 * r > h)
        r := h / 2
    if (2 * r > w)
        r := w / 2
    if (r < 0.5)
        r := 0.5
    d := 2 * r
    path := 0
    DllCall("gdiplus\GdipCreatePath", "Int", 0, "Ptr*", path)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x, "Float", y, "Float", d, "Float", d, "Float", 180, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x + w - d, "Float", y, "Float", d, "Float", d, "Float", 270, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x + w - d, "Float", y + h - d, "Float", d, "Float", d, "Float", 0, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x, "Float", y + h - d, "Float", d, "Float", d, "Float", 90, "Float", 90)
    DllCall("gdiplus\GdipClosePathFigure", "Ptr", path)
    brush := 0
    DllCall("gdiplus\GdipCreateSolidFill", "UInt", argb, "Ptr*", brush)
    DllCall("gdiplus\GdipFillPath", "Ptr", pHudGfx, "Ptr", brush, "Ptr", path)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", brush)
    DllCall("gdiplus\GdipDeletePath", "Ptr", path)
}
HudRoundOutline(x, y, w, h, r, argb, thick) {
    global pHudGfx
    if (w <= 0 || h <= 0)
        return
    if (2 * r > h)
        r := h / 2
    if (2 * r > w)
        r := w / 2
    if (r < 0.5)
        r := 0.5
    d := 2 * r
    path := 0
    DllCall("gdiplus\GdipCreatePath", "Int", 0, "Ptr*", path)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x, "Float", y, "Float", d, "Float", d, "Float", 180, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x + w - d, "Float", y, "Float", d, "Float", d, "Float", 270, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x + w - d, "Float", y + h - d, "Float", d, "Float", d, "Float", 0, "Float", 90)
    DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", x, "Float", y + h - d, "Float", d, "Float", d, "Float", 90, "Float", 90)
    DllCall("gdiplus\GdipClosePathFigure", "Ptr", path)
    pen := 0
    DllCall("gdiplus\GdipCreatePen1", "UInt", argb, "Float", thick, "Int", 2, "Ptr*", pen)
    DllCall("gdiplus\GdipDrawPath", "Ptr", pHudGfx, "Ptr", pen, "Ptr", path)
    DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
    DllCall("gdiplus\GdipDeletePath", "Ptr", path)
}
HudEllipse(cx, cy, rx, ry, argb) {
    global pHudGfx
    brush := 0
    DllCall("gdiplus\GdipCreateSolidFill", "UInt", argb, "Ptr*", brush)
    DllCall("gdiplus\GdipFillEllipse", "Ptr", pHudGfx, "Ptr", brush, "Float", cx - rx, "Float", cy - ry, "Float", 2 * rx, "Float", 2 * ry)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", brush)
}
HudRender() {
    global pHudGfx, pHudBmp, hHudDC, hHudGui, HudSurfW, HudSurfH, HudGpOk, HudBuilt
    global HudFishCur, HudBarCur, HudNoteX, HudNote2X, HudZoneShown, HudFish2Cur, HudBar2Cur, HudBar2W
    global TrackLeft, TrackRight, FishBarLeft, FishBarRight, MaxLeftBar, MaxRightBar, RunWidth, WhiteBarSize
    if (!HudBuilt || !HudGpOk || !pHudGfx)
        return
    W := HudSurfW, H := HudSurfH

    ; wipe to fully transparent
    DllCall("gdiplus\GdipSetCompositingMode", "Ptr", pHudGfx, "Int", 1)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", pHudGfx, "UInt", 0x00000000)
    DllCall("gdiplus\GdipSetCompositingMode", "Ptr", pHudGfx, "Int", 0)

    trY := 9, trH := 16, trR := trH / 2

    ; track
    HudRoundRect(0, trY, W, trH, trR, 0xDC0A0D13)
    HudRoundOutline(0.75, trY + 0.75, W - 1.5, trH - 1.5, trR, 0x8C3A465A, 1.5)

    ; danger zones at the ends
    if (HudZoneShown) {
        zl := Round(MaxLeftBar - TrackLeft)
        zr := Round(MaxRightBar - TrackLeft)
        if (zl > 2) {
            HudRoundRect(0, trY, zl, trH, trR, 0x4DF59E0B)
            HudRoundRect(zl - 1.25, 7, 2.5, 20, 1.25, 0xE6FBB63C)
        }
        if (zr < W - 2) {
            HudRoundRect(zr, trY, W - zr, trH, trR, 0x4DF59E0B)
            HudRoundRect(zr - 1.25, 7, 2.5, 20, 1.25, 0xE6FBB63C)
        }
    }

    ; reeling bar
    if (HudBarCur >= 0) {
        bw := HudBarW()
        if (bw > W)
            bw := W
        bx := Round(HudBarCur - TrackLeft - bw / 2)
        if (bx < 0)
            bx := 0
        if (bx > W - bw)
            bx := W - bw
        HudRoundRect(bx, 6, bw, 22, 11, 0x4C5EA6FF)
        HudRoundOutline(bx + 1, 7, bw - 2, 20, 10, 0xE64EA1F7, 1.6)
        HudRoundRect(bx + bw / 2 - 0.5, 10, 1, 14, 0.5, 0x805EA6FF)
    }

    ; second reeling bar
    if (HudBar2Cur >= 0 && HudBar2W > 0) {
        bw2 := HudBar2W
        if (bw2 > W)
            bw2 := W
        bx2 := Round(HudBar2Cur - TrackLeft - bw2 / 2)
        if (bx2 < 0)
            bx2 := 0
        if (bx2 > W - bw2)
            bx2 := W - bw2
        HudRoundRect(bx2, 6, bw2, 22, 11, 0x4C5EA6FF)
        HudRoundOutline(bx2 + 1, 7, bw2 - 2, 20, 10, 0xE64EA1F7, 1.6)
        HudRoundRect(bx2 + bw2 / 2 - 0.5, 10, 1, 14, 0.5, 0x805EA6FF)
    }

    ; note markers (secondary first so the main one sits on top)
    if (HudNote2X >= 0) {
        nx := Round(HudNote2X - TrackLeft)
        nx := (nx < 0) ? 0 : (nx > W) ? W : nx
        HudRoundRect(nx - 1.5, 10, 3, 14, 1.5, 0xCC8C1856)
    }
    if (HudNoteX >= 0) {
        nx := Round(HudNoteX - TrackLeft)
        nx := (nx < 0) ? 0 : (nx > W) ? W : nx
        HudRoundRect(nx - 2, 8, 4, 18, 2, 0xF2FF2D9B)
    }

    ; fish markers
    cy := trY + trR
    for _, fv in [HudFishCur, HudFish2Cur] {
        if (fv = "" || fv < 0)
            continue
        fx := fv - TrackLeft
        fx := (fx < 0) ? 0 : (fx > W) ? W : fx
        HudEllipse(fx, cy, 11, 11, 0x2622C55E)
        HudEllipse(fx, cy, 6.5, 6.5, 0x4D22C55E)
        HudRoundRect(fx - 1.5, 4, 3, 26, 1.5, 0xE622C55E)
        HudEllipse(fx, cy, 3.6, 3.6, 0xFF34D96F)
        HudEllipse(fx - 1, cy - 1.2, 1.2, 1.2, 0xB3FFFFFF)
    }

    DllCall("gdiplus\GdipFlush", "Ptr", pHudGfx, "Int", 0)
    VarSetCapacity(sz, 8, 0)
    NumPut(W, sz, 0, "Int")
    NumPut(H, sz, 4, "Int")
    VarSetCapacity(src, 8, 0)
    VarSetCapacity(blend, 4, 0)
    NumPut(0, blend, 0, "UChar")
    NumPut(0, blend, 1, "UChar")
    NumPut(255, blend, 2, "UChar")
    NumPut(1, blend, 3, "UChar")
    DllCall("UpdateLayeredWindow", "Ptr", hHudGui, "Ptr", 0, "Ptr", 0, "Ptr", &sz, "Ptr", hHudDC, "Ptr", &src, "UInt", 0, "Ptr", &blend, "UInt", 2)
}
HudDestroySurface:
    if (pHudGfx)
        DllCall("gdiplus\GdipDeleteGraphics", "Ptr", pHudGfx)
    if (pHudBmp)
        DllCall("gdiplus\GdipDisposeImage", "Ptr", pHudBmp)
    if (hHudDC) {
        if (hHudOldBM)
            DllCall("SelectObject", "Ptr", hHudDC, "Ptr", hHudOldBM)
        DllCall("DeleteDC", "Ptr", hHudDC)
    }
    if (hHudBM)
        DllCall("DeleteObject", "Ptr", hHudBM)
    pHudGfx := 0, pHudBmp := 0, hHudDC := 0, hHudOldBM := 0, hHudBM := 0
    pHudBits := 0
return
ShowHud:
    ; The overlay under the bar has been retired; Extra > Debug > Bar positions
    ; now shows where the macro sees the bar. Just make sure it is hidden.
    Gosub, HideHud
    return
    ; --- old overlay path, no longer reached ---
    if (OverlayHidden) {
        Gosub, HideHud
        return
    }
    if (!HudBuilt)
        Gosub, BuildHud
    sh_need := Max(40, Round(TrackRight - TrackLeft))
    if (sh_need != HudSurfW || !HudGpOk) {
        HudW := sh_need
        HudGpOk := HudSurfaceMake(HudW, 34)
    }
    RobloxClientRect(RobloxHwnd, sh_cx, sh_cy)
    sh_x := sh_cx + Round(TrackLeft)
    sh_y := sh_cy + Round(FishBarTooltipHeight) - 11
    Gui, Hud: Show, x%sh_x% y%sh_y% w%HudW% h34 NA
    HudDirty := true
    HudLastKey := ""
    HudPrevT := 0
    HudRenderAvg := 0
    HudTickMs := 16
    HudTickN := 0
    SetTimer, HudSmooth, 16
return
HideHud:
settimer, HudSmooth, off
if (HudBuilt)
	Gui, Hud:Cancel
return

;====================================================================================================;

HudSmooth:
    if (!HudBuilt || !HudGpOk)
        return
    DllCall("QueryPerformanceCounter", "Int64*", HudNowT)
    HudDt := HudPrevT ? (HudNowT - HudPrevT) / QpcFreq : 0.008
    HudPrevT := HudNowT
    if (HudDt > 0.1)
        HudDt := 0.1
    HudEase := 1 - Exp(-HudDt / 0.030)

    if (HudFishTgt >= 0)
        HudFishCur := (HudFishCur < 0) ? HudFishTgt : HudFishCur + (HudFishTgt - HudFishCur) * HudEase
    if (HudBarTgt >= 0)
        HudBarCur := (HudBarCur < 0) ? HudBarTgt : HudBarCur + (HudBarTgt - HudBarCur) * HudEase
    if (HudFish2Tgt >= 0)
        HudFish2Cur := (HudFish2Cur < 0) ? HudFish2Tgt : HudFish2Cur + (HudFish2Tgt - HudFish2Cur) * HudEase
    if (HudBar2Tgt >= 0)
        HudBar2Cur := (HudBar2Cur < 0) ? HudBar2Tgt : HudBar2Cur + (HudBar2Tgt - HudBar2Cur) * HudEase

    HudKey := Round(HudFishCur) "|" Round(HudBarCur) "|" Round(HudNoteX) "|" Round(HudNote2X) "|" Round(RunWidth)
    HudKey .= "|" (HudZoneShown ? Round(MaxLeftBar) "," Round(MaxRightBar) : "-")
    HudKey .= "|" Round(HudFish2Cur) "|" Round(HudBar2Cur) "|" Round(HudBar2W)
    if (!HudDirty && HudKey = HudLastKey)
        return
    HudLastKey := HudKey
    HudDirty := false

    DllCall("QueryPerformanceCounter", "Int64*", HudR0)
    HudRender()
    DllCall("QueryPerformanceCounter", "Int64*", HudR1)
    HudRenderMs := (HudR1 - HudR0) * 1000 / QpcFreq
    if (HudRenderAvg = 0)
        HudRenderAvg := HudRenderMs
    else
        HudRenderAvg := 0.9 * HudRenderAvg + 0.1 * HudRenderMs

    ; adapt the tick period to how expensive drawing is
    HudTickN += 1
    if (Mod(HudTickN, 30) = 0) {
        if (HudRenderAvg > 4.0)
            HudWant := 50
        else if (HudRenderAvg > 2.0)
            HudWant := 33
        else
            HudWant := 16
        if (HudWant != HudTickMs) {
            HudTickMs := HudWant
            SetTimer, HudSmooth, %HudTickMs%
        }
    }
return
MoveHudFish(wx) {
    global HudBuilt, HudFishTgt, HudFishCur, VxDbgFish, VxDbgFishT
    if (wx >= 0) {
        VxDbgFish := wx
        VxDbgFishT := A_TickCount
    }
    if (!HudBuilt || wx < 0)
        return
    HudFishTgt := wx
    if (HudFishCur < 0 || Abs(wx - HudFishCur) > 150)
        HudFishCur := wx
}
MoveHudFish2(wx) {
    global HudBuilt, HudFish2Tgt, HudFish2Cur
    if (!HudBuilt || wx < 0)
        return
    HudFish2Tgt := wx
    if (HudFish2Cur < 0 || Abs(wx - HudFish2Cur) > 150)
        HudFish2Cur := wx
}
MoveHudBar2Span(l, w) {
    global HudBuilt, HudBar2Tgt, HudBar2Cur, HudBar2W
    if (!HudBuilt || l < 0 || w <= 0)
        return
    HudBar2W := w
    HudBar2Tgt := l + w / 2
    if (HudBar2Cur < 0)
        HudBar2Cur := HudBar2Tgt
}
MoveHudNote(wx) {
    global HudBuilt, HudNoteX, HudDirty
    if (!HudBuilt)
        return
    nv := (wx < 0) ? -1 : wx
    if (nv >= 0 && HudNoteX >= 0 && Abs(nv - HudNoteX) < 2)
        return
    HudNoteX := nv
    HudDirty := true
}
MoveHudNote2(wx) {
    global HudBuilt, HudNote2X, HudDirty
    if (!HudBuilt)
        return
    nv := (wx < 0) ? -1 : wx
    if (nv >= 0 && HudNote2X >= 0 && Abs(nv - HudNote2X) < 2)
        return
    HudNote2X := nv
    HudDirty := true
}
MoveHudBarSpan(l, w) {
    global WhiteBarSize, FishX, HudWMed
    if (l < 0 || w <= 0)
        return
    HudWPush(w)
    ; ignore the position of spans whose width is far from the recent median
    if (HudWMed > 0 && Abs(w - HudWMed) > 0.6 * HudWMed)
        return
    MoveHudBarC(l + w / 2)
}
MoveHudBarC(wx) {
    global HudBuilt, HudBarTgt, HudBarCur, TrackLeft, TrackRight, FishBarLeft, FishBarRight
    global RunWidth, WhiteBarSize, VxDbgBarC, VxDbgBarW, VxDbgBarT
    if (wx >= 0) {
        VxDbgBarC := wx
        VxDbgBarW := HudBarW()
        VxDbgBarT := A_TickCount
    }
    if (!HudBuilt || wx < 0)
        return
    bw := HudBarW()
    lo := TrackLeft + bw / 2
    hi := TrackRight - bw / 2
    if (hi < lo)
        hi := lo
    if (wx < lo)
        wx := lo
    if (wx > hi)
        wx := hi
    if (HudBarCur >= 0) {
        maxStep := 0.15 * (TrackRight - TrackLeft)
        if (maxStep > 8) {
            if (wx > HudBarCur + maxStep)
                wx := HudBarCur + maxStep
            if (wx < HudBarCur - maxStep)
                wx := HudBarCur - maxStep
        }
    }
    HudBarTgt := wx
    if (HudBarCur < 0)
        HudBarCur := wx
}
UpdateHud:
if (!HudBuilt)
	return
HudDirty := true
return

RobloxClientRect(hwnd, ByRef rcx, ByRef rcy, ByRef rcw := "", ByRef rch := "") {
    VarSetCapacity(rc, 16, 0)
    VarSetCapacity(pt, 8, 0)
    if (!hwnd
        || !DllCall("GetClientRect", "Ptr", hwnd, "Ptr", &rc)
        || !DllCall("ClientToScreen", "Ptr", hwnd, "Ptr", &pt)) {
        WinGetPos, rcx, rcy, rcw, rch, ahk_id %hwnd%
        return false
    }
    rcx := NumGet(pt, 0, "Int")
    rcy := NumGet(pt, 4, "Int")
    rcw := NumGet(rc, 8, "Int")
    rch := NumGet(rc, 12, "Int")
    return true
}
CaptureNoteRegion() {
    global hNoteMemDC, hNoteScreenDC, NoteW, NoteFullH, NoteOriginX, NoteOriginY, RobloxHwnd, VxBlt
    if (!hNoteMemDC)
        return
    RobloxClientRect(RobloxHwnd, nwx, nwy)
    DllCall(VxBlt, "Ptr", hNoteMemDC, "Int", 0, "Int", 0, "Int", NoteW, "Int", NoteFullH, "Ptr", hNoteScreenDC, "Int", nwx + NoteOriginX, "Int", nwy + NoteOriginY, "UInt", 0x00CC0020)
}
NoteParseColors() {
    global NoteColor, NoteColorCached, NoteColR, NoteColG, NoteColB, NoteColN
    if (NoteColor == NoteColorCached)
        return NoteColN
    NoteColorCached := NoteColor
    NoteColR := [], NoteColG := [], NoteColB := []
    NoteColN := 0
    Loop, Parse, NoteColor, `,`;%A_Space%, %A_Tab%
    {
        tok := A_LoopField
        if (tok = "")
            continue
        if (SubStr(tok, 1, 2) = "0x")
            tok := SubStr(tok, 3)
        if (!RegExMatch(tok, "i)^[0-9a-f]{6}$"))
            continue
        c := "0x" tok
        c += 0
        NoteColN += 1
        NoteColR.Push((c >> 16) & 0xFF)
        NoteColG.Push((c >> 8) & 0xFF)
        NoteColB.Push(c & 0xFF)
    }
    return NoteColN
}
NoteScanFind(lockX) {
    global pNoteBits, NoteW, NoteH, NoteColorTolerance, NoteColR, NoteColG, NoteColB, NoteColN
    global NoteDbgPx, NoteDbgRun, NoteDbgBest
    NoteDbgPx := 0
    NoteDbgRun := 0
    NoteDbgBest := "-"
    if (!pNoteBits)
        return -1
    if (NoteParseColors() < 1)
        return -1
    tol := NoteColorTolerance
    if (tol < 6)
        tol := 6
    if (tol > 25)
        tol := 25
    locked := (lockX >= 0)
    yStep := locked ? 8 : 16
    xFrom := 0, xTo := NoteW
    if (locked) {
        xFrom := Round(lockX) - 80
        xTo := Round(lockX) + 80
        if (xFrom < 0)
            xFrom := 0
        if (xTo > NoteW)
            xTo := NoteW
    }

    y := NoteH - 13
    while (y >= 0) {
        runL := [], runR := []
        rs := -1
        rowPtr := pNoteBits + y * NoteW * 4
        x := xFrom
        while (x < xTo) {
            p := NumGet(rowPtr + x * 4, "UInt")
            b := p & 0xFF, g := (p >> 8) & 0xFF, r := (p >> 16) & 0xFF
            hit := false
            Loop, %NoteColN%
            {
                if (Abs(r - NoteColR[A_Index]) <= tol && Abs(g - NoteColG[A_Index]) <= tol && Abs(b - NoteColB[A_Index]) <= tol) {
                    hit := true
                    break
                }
            }
            if (hit) {
                NoteDbgPx += 1
                if (rs < 0)
                    rs := x
            } else if (rs >= 0) {
                span := x - rs
                if (span > NoteDbgRun) {
                    NoteDbgRun := span
                    NoteDbgBest := "x" rs "y" y
                }
                if (span >= 8) {
                    runL.Push(rs)
                    runR.Push(x - 1)
                }
                rs := -1
            }
            x += 4
        }
        if (rs >= 0 && xTo - rs >= 8) {
            runL.Push(rs)
            runR.Push(xTo - 1)
        }

        ; merge runs separated by small gaps into marker-sized groups
        cnt := runL.Length()
        i := 1
        while (i <= cnt) {
            gL := runL[i], gR := runR[i]
            j := i + 1
            while (j <= cnt && runL[j] - gR <= 45) {
                gR := runR[j]
                j++
            }
            gw := gR - gL + 1
            if (gw >= 8 && gw <= 120) {
                cx := gL + gw / 2
                if (!locked || Abs(cx - lockX) <= 55)
                    return cx
            }
            i := j
        }
        y -= yStep
    }
    return -1
}
LullRing(rr) {
    global pNoteBits, NoteW, NoteFullH, NoteTop, FishBarTop, CaptureW, LullPivotUp
    out := {}
    if (!pNoteBits || rr < 20)
        return out
    bx := Round(CaptureW / 2)
    by := Round((FishBarTop - LullPivotUp) - NoteTop)
    pi := 3.141592653589793
    d := 180
    while (d <= 360) {
        th := d * pi / 180
        x := Round(bx + rr * Cos(th))
        y := Round(by + rr * Sin(th))
        if (x >= 0 && x < NoteW && y >= 0 && y < NoteFullH) {
            p := NumGet(pNoteBits + (y * NoteW + x) * 4, "UInt")
            out[d] := ((p & 0xFF) + ((p >> 8) & 0xFF) + ((p >> 16) & 0xFF)) // 3
        } else {
            out[d] := -1
        }
        d += 2
    }
    return out
}
LullCalStep() {
    global CaptureW, LullCalN, LullCalLt, LullCalDk, LullCalLs, LullRadiusPct
    Loop, 14
    {
        i := A_Index - 1
        rr := Round(CaptureW * (7 + 1.2 * i) / 100)
        v := LullRing(rr)
        d := 180
        while (d <= 360) {
            lum := v[d]
            if (lum != "" && lum >= 0) {
                key := i * 1000 + d
                if (lum >= 140) {
                    LullCalLt[key] := (LullCalLt[key] = "" ? 0 : LullCalLt[key]) + 1
                    LullCalLs[key] := (LullCalLs[key] = "" ? 0 : LullCalLs[key]) + lum
                } else if (lum < 40) {
                    LullCalDk[key] := (LullCalDk[key] = "" ? 0 : LullCalDk[key]) + 1
                }
            }
            d += 2
        }
    }
    LullCalN += 1
}
LullPickRadius() {
    global CaptureW, LullCalLt, LullCalDk, LullCalLs, LullRadiusPct, LullBg, LullLightLum, LullR
    bestSc := -1, bestI := -1
    Loop, 14
    {
        i := A_Index - 1
        nt := 0, nl := 0, nd := 0
        d := 180
        while (d <= 360) {
            key := i * 1000 + d
            lt := LullCalLt[key] ? LullCalLt[key] : 0
            dk := LullCalDk[key] ? LullCalDk[key] : 0
            if (lt > 0 || dk > 0)
                nt++
            if (lt > dk)
                nl++
            else if (dk > lt)
                nd++
            d += 2
        }
        if (nt >= 30 && nd > bestSc) {
            bestSc := nd
            bestI := i
        }
    }
    if (bestI >= 0) {
        nl2 := 0
        d := 180
        while (d <= 360) {
            if (LullCalLt[bestI * 1000 + d] > 0)
                nl2++
            d += 2
        }
        if (nl2 < 2)
            bestI := -1
    }
    if (bestI < 0) {
        LullR := Round(CaptureW * LullRadiusPct / 100)
        return 0
    }
    LullR := Round(CaptureW * (7 + 1.2 * bestI) / 100)
    LullBg := {}
    d := 180
    while (d <= 360) {
        key := bestI * 1000 + d
        lt := LullCalLt[key] ? LullCalLt[key] : 0
        dk := LullCalDk[key] ? LullCalDk[key] : 0
        LullBg[d] := (lt > dk && lt > 0) ? LullCalLs[key] / lt : 0
        d += 2
    }
    return LullR
}
LullFindSectors() {
    global LullBg, LullLightLum, LullMinDeg, LullSecN, LullSecA, LullSecB
    ll := LullLightLum
    if (ll < 30)
        ll := 30
    if (ll > 220)
        ll := 220
    md := LullMinDeg
    if (md < 2)
        md := 2
    if (md > 60)
        md := 60
    LullSecN := 0
    LullSecA := []
    LullSecB := []
    runS := -1
    d := 180
    while (d <= 362) {
        lit := (d <= 360 && LullBg[d] != "" && LullBg[d] >= ll)
        if (lit) {
            if (runS < 0)
                runS := d
        } else if (runS >= 0) {
            if ((d - 2) - runS >= md - 2) {
                LullSecN += 1
                LullSecA.Push(runS)
                LullSecB.Push(d - 2)
            }
            runS := -1
        }
        d += 2
    }
    return LullSecN
}
LullLearnSeed(now) {
	global LullBg, LullLitOk, LullLitLum, LullLitStart, LullRelT
	LullLitOk := [], LullLitLum := [], LullLitStart := [], LullRelT := now
	d := 180
	while (d <= 360)
		{
		if (LullBg[d] != "" and LullBg[d] > 0)
			LullLitOk[d] := now, LullLitLum[d] := LullBg[d]
		d := d + 2
		}
}

LullLearn(v, now) {
	global LullBg, LullLitOk, LullLitLum, LullLitStart, LullRelT, LullLightLum, LullSecN, LullSecA, LullSecB, LullArmA, LullClrT
	if (!IsObject(LullLitOk))
		LullLearnSeed(now)
	ll := LullLightLum
	ll := (ll < 30) ? 30 : ((ll > 220) ? 220 : ll)
	d := 180
	while (d <= 360)
		{
		if (v[d] != "" and v[d] >= ll)
			{
			if (LullLitStart[d] = "")
				LullLitStart[d] := now
			if (now - LullLitStart[d] >= TA("lulllit", 120))
				LullLitOk[d] := now, LullLitLum[d] := v[d]
			}
		else
			LullLitStart[d] := ""
		d := d + 2
		}
	if (now - LullRelT < 150)
		return
	LullRelT := now
	keep := TA("lullkeep", 600)
	d := 180
	while (d <= 360)
		{
		LullBg[d] := (LullLitOk[d] != "" and now - LullLitOk[d] <= keep) ? LullLitLum[d] : 0
		d := d + 2
		}
	; zones keep their armed state by where they start; a new one starts armed
	oldA := LullArmA, oldC := LullClrT
	LullFindSectors()
	LullArmA := [], LullClrT := []
	i := 1
	while (i <= LullSecN)
		{
		ka := LullSecA[i], best := ""
		if (IsObject(oldA))
		for k, a in oldA
			{
			if (Abs(k - ka) <= 6)
				{
				best := k
				break
				}
			}
		if (best != "")
			LullArmA[ka] := oldA[best], LullClrT[ka] := oldC[best]
		i := i + 1
		}
}

LullScan() {
    global LullFrames, LullCalN, LullR, LullBg, LullSecN, LullSecA, LullSecB, LullArmA, LullClrT
    global LullActive, LullHitSec, LullHitC, LullLastAct, LullArmDelta, LullTrigPct, LullClearMs
    global LullRadiusPct, CaptureW
    LullHitSec := 0
    probe := (LullR > 0) ? LullR : Round(CaptureW * LullRadiusPct / 100)
    v := LullRing(probe)
    vmx := -1
    for _, lum in v {
        if (lum != "" && lum >= 0 && lum > vmx)
            vmx := lum
    }
    if (vmx < 120) {
        LullActive := false
        return false
    }
    now := A_TickCount
    LullActive := true
    LullLastAct := now
    LullFrames += 1

    ; still calibrating: gather samples until the ring and sectors are known
    if (LullR <= 0) {
        LullCalStep()
        if (LullCalN >= 26) {
            LullPickRadius()
            LullFindSectors()
            LullLearnSeed(now)
        }
        return false
    }

    LullLearn(v, now)
    LullHitAge(now)

    dv := LullArmDelta
    if (dv < 15)
        dv := 15
    if (dv > 200)
        dv := 200
    tp := LullTrigPct
    if (tp < 3)
        tp := 3
    if (tp > 90)
        tp := 90
    cm := LullClearMs
    if (cm < 20)
        cm := 20
    if (cm > 2000)
        cm := 2000

    hit := false
    Loop, %LullSecN%
    {
        i := A_Index
        ka := LullSecA[i]
        kb := LullSecB[i]
        n := 0, dk := 0
        d := ka
        while (d <= kb) {
            if (v[d] != "" && v[d] >= 0 && LullBg[d] != "") {
                n++
                if (Abs(v[d] - LullBg[d]) >= dv)
                    dk++
            }
            d += 2
        }
        ; a sector that changed completely at once has moved, it was not hit
        if (n > 0 && dk * 100 >= n * tp && (n < 4 || dk < n)) {
            LullClrT[ka] := 0
            cz := (ka + kb) / 2
            armed := (LullArmA[ka] = "" || LullArmA[ka])
            if (armed && !LullWasHit(cz)) {
                LullArmA[ka] := false
                LullHitSec := i
                LullHitC.Push({c: cz, t: now})
                hit := true
            }
        } else {
            if (LullClrT[ka] = "" || LullClrT[ka] = 0)
                LullClrT[ka] := now
            if (now - LullClrT[ka] >= cm)
                LullArmA[ka] := true
        }
    }
    return hit
}
LullWasHit(cz) {
	global LullHitC
	same := TA("lullsame", 10)
	for i, h in LullHitC
		{
		if (Abs(h.c - cz) <= same)
			return true
		}
	return false
}

; a clicked pillar stays remembered while it is there; once it has been gone a while, one lit at that spot is new
LullHitAge(now) {
	global LullHitC, LullSecN, LullSecA, LullSecB
	if (!IsObject(LullHitC))
		LullHitC := []
	same := TA("lullsame", 10)
	forget := TA("lullforget", 1500)
	i := LullHitC.Length()
	while (i >= 1)
		{
		h := LullHitC[i]
		j := 1
		while (j <= LullSecN)
			{
			if (Abs((LullSecA[j] + LullSecB[j]) / 2 - h.c) <= same)
				{
				h.t := now
				break
				}
			j++
			}
		if (now - h.t > forget)
			LullHitC.RemoveAt(i)
		i--
		}
}

NoteScanAll() {
    global pNoteBits, NoteW, NoteH, NoteColorTolerance, NoteColR, NoteColG, NoteColB, NoteColN
    global NoteAllX, NoteAllY, NoteAllN
    NoteAllX := [], NoteAllY := []
    NoteAllN := 0
    sums := [], cnts := []
    if (!pNoteBits)
        return 0
    if (NoteParseColors() < 1)
        return 0
    tol := NoteColorTolerance
    if (tol < 6)
        tol := 6
    if (tol > 25)
        tol := 25
    pr := NoteColR[1], pg := NoteColG[1], pb := NoteColB[1]
    multi := (NoteColN > 1)

    y := NoteH - 13
    while (y >= 0) {
        runL := [], runR := []
        rs := -1
        rowPtr := pNoteBits + y * NoteW * 4
        x := 0
        while (x < NoteW) {
            p := NumGet(rowPtr + x * 4, "UInt")
            b := p & 0xFF, g := (p >> 8) & 0xFF, r := (p >> 16) & 0xFF
            hit := (Abs(b - pb) <= tol && Abs(g - pg) <= tol && Abs(r - pr) <= tol)
            if (!hit && multi) {
                k := 2
                while (k <= NoteColN) {
                    if (Abs(r - NoteColR[k]) <= tol && Abs(g - NoteColG[k]) <= tol && Abs(b - NoteColB[k]) <= tol) {
                        hit := true
                        break
                    }
                    k++
                }
            }
            if (hit) {
                if (rs < 0)
                    rs := x
            } else if (rs >= 0) {
                if (x - rs >= 8) {
                    runL.Push(rs)
                    runR.Push(x - 1)
                }
                rs := -1
            }
            x += 4
        }
        if (rs >= 0 && NoteW - rs >= 8) {
            runL.Push(rs)
            runR.Push(NoteW - 1)
        }

        cnt := runL.Length()
        i := 1
        while (i <= cnt) {
            gL := runL[i], gR := runR[i]
            j := i + 1
            while (j <= cnt && runL[j] - gR <= 45) {
                gR := runR[j]
                j++
            }
            gw := gR - gL + 1
            if (gw >= 8 && gw <= 120) {
                cx := gL + gw / 2
                dup := false
                Loop, %NoteAllN%
                {
                    di := A_Index
                    if (Abs(cx - NoteAllX[di]) <= 55 && (NoteAllY[di] - y) <= 120) {
                        sums[di] += cx
                        cnts[di] += 1
                        NoteAllX[di] := sums[di] / cnts[di]
                        dup := true
                        break
                    }
                }
                if (!dup && NoteAllN < 2) {
                    NoteAllN += 1
                    NoteAllX[NoteAllN] := cx
                    NoteAllY[NoteAllN] := y
                    sums[NoteAllN] := cx
                    cnts[NoteAllN] := 1
                }
            }
            i := j
        }
        if (NoteAllN >= 2)
            break
        y -= 16
    }
    return NoteAllN
}
NoteScan(refX) {
    global NoteIndep, NoteFresh, NoteLockX, NoteLockY, NoteLockN, NoteMissAt, NoteHandoff
    global NoteOriginX, NoteH, FishBarLeft, FishBarRight, QpcFreq, NoteAllX, NoteAllY, NoteAllN
    global NoteDbgCalls, NoteMissN, NoteNextX, NoteNextY, LastNoteX
    NoteDbgCalls += 1
    ; independent region was not re-grabbed this frame: keep the last lock
    if (NoteIndep && !NoteFresh && NoteLockX >= 0) {
        LastNoteX := NoteLockX
        return NoteLockX
    }
    LastNoteX := -1
    NoteNextX := -1
    NoteNextY := -1

    if (NoteScanAll() < 1) {
        DllCall("QueryPerformanceCounter", "Int64*", now)
        if (!NoteMissAt)
            NoteMissAt := now
        if (NoteLockX >= 0 && (now - NoteMissAt) * 1000 / QpcFreq <= 260) {
            LastNoteX := NoteLockX
            return NoteLockX
        }
        NoteLockX := -1
        NoteLockN := 0
        NoteLockY := -1
        NoteMissAt := 0
        return -1
    }

    NoteMissAt := 0
    sel := 1
    matched := false
    if (NoteLockX >= 0) {
        Loop, %NoteAllN%
        {
            if (Abs((NoteOriginX + NoteAllX[A_Index]) - NoteLockX) <= 55 && (NoteLockY < 0 || NoteAllY[A_Index] <= NoteLockY + 100)) {
                sel := A_Index
                matched := true
                break
            }
        }
    }

    ; the followed marker is about to leave the scan area: move to the next one
    hoff := NoteHandoff
    if (hoff < 0)
        hoff := 0
    if (hoff > 200)
        hoff := 200
    if (NoteAllN > sel && hoff > 0 && NoteAllY[sel] > (NoteH - 13 - hoff)) {
        sel := sel + 1
        matched := false
    }

    newX := NoteOriginX + NoteAllX[sel]
    if (newX < FishBarLeft)
        newX := FishBarLeft
    if (newX > FishBarRight)
        newX := FishBarRight
    if (!matched) {
        NoteLockX := newX
        NoteLockN := 1
    } else {
        NoteLockN += 1
        nAvg := (NoteLockN < 8) ? NoteLockN : 8
        NoteLockX := NoteLockX + (newX - NoteLockX) / nAvg
    }
    NoteLockY := NoteAllY[sel]
    LastNoteX := NoteLockX

    if (NoteAllN > sel) {
        nx := NoteOriginX + NoteAllX[sel + 1]
        if (nx < FishBarLeft)
            nx := FishBarLeft
        if (nx > FishBarRight)
            nx := FishBarRight
        NoteNextX := nx
        NoteNextY := NoteAllY[sel + 1]
    }
    return NoteLockX
}
CapUnionDC(w, h) {
	global hCapUnionDC, hCapUnionBM, CapUW, CapUH, hCaptureScreenDC
	if (hCapUnionDC and w <= CapUW and h <= CapUH)
		return true
	if (hCapUnionDC)
		{
		DllCall("DeleteObject", "Ptr", hCapUnionBM)
		DllCall("DeleteDC", "Ptr", hCapUnionDC)
		hCapUnionDC := 0
		}
	if (!hCaptureScreenDC)
		return false
	hCapUnionDC := DllCall("CreateCompatibleDC", "Ptr", hCaptureScreenDC, "Ptr")
	hCapUnionBM := DllCall("CreateCompatibleBitmap", "Ptr", hCaptureScreenDC, "Int", w, "Int", h, "Ptr")
	if (!hCapUnionDC or !hCapUnionBM)
		{
		if (hCapUnionDC)
			DllCall("DeleteDC", "Ptr", hCapUnionDC)
		hCapUnionDC := 0
		return false
		}
	DllCall("SelectObject", "Ptr", hCapUnionDC, "Ptr", hCapUnionBM)
	CapUW := w
	CapUH := h
	return true
}

CaptureStrip() {
    global VxScanN, hCaptureMemDC, hCaptureScreenDC, CaptureW, CaptureH, CapExtra, FishBarLeft, FishBarTop
    global RobloxHwnd, hNoteMemDC, hNoteScreenDC, NoteW, NoteH, NoteFullH, NoteTop, pNoteBits
    global pCaptureBits, pCaptureOwn, NoteIndep, NoteOriginX, NoteOriginY, NoteNeeded, NoteFresh
    global NoteBlitAt, NoteRefreshMs, QpcFreq, NoteLockX, SwMaxSigns, SpecialRod, hCapUnionDC
    global SwPreset, NoteNowT, VxBlt, VxNatIO
    SRC := 0x00CC0020
    VxScanN += 1
    RobloxClientRect(RobloxHwnd, cwx, cwy)
    bx := cwx + Round(FishBarLeft)
    by := cwy + Round(FishBarTop) - 18
    bh := CaptureH + 38 + CapExtra

    ; no note reader for this rod: just grab the bar
    if (!NoteNeeded) {
        pCaptureBits := pCaptureOwn
        DllCall(VxBlt, "Ptr", hCaptureMemDC, "Int", 0, "Int", 0, "Int", CaptureW, "Int", bh, "Ptr", hCaptureScreenDC, "Int", bx, "Int", by, "UInt", SRC)
        return
    }

    if (NoteIndep && hNoteMemDC) {
        DllCall("QueryPerformanceCounter", "Int64*", NoteNowT)
        nx := cwx + NoteOriginX
        ny := cwy + NoteOriginY

        if (SpecialRod = "Stellarwave Melody" && NoteFullH > NoteH) {
            ; the tall note buffer already covers the bar: one grab serves both
            NoteFresh := true
            NoteBlitAt := NoteNowT
            swIo := VxNatIO && (SwPreset != "Ominous Ouija")
            if (swIo)
                DllCall(VxNatIO, "Int", 1)
            DllCall(VxBlt, "Ptr", hNoteMemDC, "Int", 0, "Int", 0, "Int", NoteW, "Int", NoteFullH, "Ptr", hNoteScreenDC, "Int", nx, "Int", ny, "UInt", SRC)
            if (swIo)
                DllCall(VxNatIO, "Int", 0)
            pCaptureBits := pCaptureOwn
            DllCall(VxBlt, "Ptr", hCaptureMemDC, "Int", 0, "Int", 0, "Int", CaptureW, "Int", bh, "Ptr", hNoteMemDC, "Int", Round(FishBarLeft) - NoteOriginX, "Int", Round(FishBarTop) - 18 - NoteOriginY, "UInt", SRC)
            return
        }

        if (SwMaxSigns && SpecialRod = "Stellarwave Melody")
            NoteRefreshMs := 0
        else if (NoteLockX >= 0)
            NoteRefreshMs := 80
        else
            NoteRefreshMs := 45
        NoteFresh := (!NoteBlitAt || (NoteNowT - NoteBlitAt) * 1000 / QpcFreq >= NoteRefreshMs)

        if (NoteFresh) {
            NoteBlitAt := NoteNowT
            ux := Min(nx, bx)
            uy := Min(ny, by)
            uw := Max(nx + NoteW, bx + CaptureW) - ux
            uh := Max(ny + NoteFullH, by + bh) - uy
            if (uw * uh <= 4 * (NoteW * NoteFullH + CaptureW * bh) && CapUnionDC(uw, uh)) {
                ; one grab of the bounding box, then split it into both buffers
                DllCall(VxBlt, "Ptr", hCapUnionDC, "Int", 0, "Int", 0, "Int", uw, "Int", uh, "Ptr", hCaptureScreenDC, "Int", ux, "Int", uy, "UInt", SRC)
                DllCall(VxBlt, "Ptr", hNoteMemDC, "Int", 0, "Int", 0, "Int", NoteW, "Int", NoteFullH, "Ptr", hCapUnionDC, "Int", nx - ux, "Int", ny - uy, "UInt", SRC)
                pCaptureBits := pCaptureOwn
                DllCall(VxBlt, "Ptr", hCaptureMemDC, "Int", 0, "Int", 0, "Int", CaptureW, "Int", bh, "Ptr", hCapUnionDC, "Int", bx - ux, "Int", by - uy, "UInt", SRC)
                return
            }
            DllCall(VxBlt, "Ptr", hNoteMemDC, "Int", 0, "Int", 0, "Int", NoteW, "Int", NoteFullH, "Ptr", hNoteScreenDC, "Int", nx, "Int", ny, "UInt", SRC)
        }
        pCaptureBits := pCaptureOwn
        DllCall(VxBlt, "Ptr", hCaptureMemDC, "Int", 0, "Int", 0, "Int", CaptureW, "Int", bh, "Ptr", hCaptureScreenDC, "Int", bx, "Int", by, "UInt", SRC)
        return
    }

    if (!NoteIndep && hNoteMemDC && NoteFullH > CaptureH) {
        ; note strip sits directly above the bar: grab both in one go
        DllCall(VxBlt, "Ptr", hNoteMemDC, "Int", 0, "Int", 0, "Int", NoteW, "Int", NoteFullH, "Ptr", hNoteScreenDC, "Int", bx, "Int", cwy + Round(NoteTop), "UInt", SRC)
        if (NoteW = CaptureW && pNoteBits) {
            pCaptureBits := pNoteBits + NoteH * NoteW * 4
        } else {
            pCaptureBits := pCaptureOwn
            DllCall(VxBlt, "Ptr", hCaptureMemDC, "Int", 0, "Int", 0, "Int", CaptureW, "Int", CaptureH + 38, "Ptr", hNoteMemDC, "Int", 0, "Int", NoteH - 18, "UInt", SRC)
        }
        return
    }

    pCaptureBits := pCaptureOwn
    DllCall(VxBlt, "Ptr", hCaptureMemDC, "Int", 0, "Int", 0, "Int", CaptureW, "Int", bh, "Ptr", hCaptureScreenDC, "Int", bx, "Int", by, "UInt", SRC)
}
CaptureEdgeStrips() {
	global UiEdgeOn, pCaptureBits, CaptureW, pUiEdgeBits
	if (!UiEdgeOn || !pCaptureBits)
		return
	rowBytes := CaptureW * 4
	pUiEdgeBits := pCaptureBits - 18 * rowBytes
}

UiEdgeFrac(r, step) {
    global pUiEdgeBits, CaptureW, UiEdgeH
    if (!pUiEdgeBits || r < 2 || r > UiEdgeH - 3 || CaptureW < 8)
        return 0
    stride := 4 * CaptureW
    rowA := pUiEdgeBits + (r - 2) * stride
    rowB := pUiEdgeBits + (r + 2) * stride
    hits := 0, n := 0, x := 0
    while (x < CaptureW) {
        pa := NumGet(rowA + 4 * x, "UInt")
        pb := NumGet(rowB + 4 * x, "UInt")
        la := (((pa >> 16) & 255) + ((pa >> 8) & 255) + (pa & 255)) // 3
        lb := (((pb >> 16) & 255) + ((pb >> 8) & 255) + (pb & 255)) // 3
        if (Abs(la - lb) >= 20)
            hits++
        n++
        x += step
    }
    return (n > 0) ? hits / n : 0
}
UiEdgeBandMax(r0, r1, rstep, cstep, ByRef bestR) {
    best := 0
    bestR := r0
    r := r0
    while (r <= r1) {
        f := UiEdgeFrac(r, cstep)
        if (f > best) {
            best := f
            bestR := r
        }
        r += rstep
    }
    return best
}
TrackEdgesVisible() {
    global UiTopRows, UiBotOff, UiEdgeH, UiGateN
    ; rotate the sampling phase 1,2,3,0,...
    if (UiGateN >= 0 && UiGateN < 3)
        UiGateN := UiGateN + 1
    else
        UiGateN := 0
    topBest := UiEdgeBandMax(2 + Mod(UiGateN, 2), UiTopRows - 3, 2, 8, rt)
    botBest := UiEdgeBandMax(UiBotOff + 2 + UiGateN // 2, UiEdgeH - 3, 2, 8, rb)
    return (topBest >= 0.5 && botBest >= 0.35) || (botBest >= 0.5 && topBest >= 0.35)
}
UiStartGate() {
    global UiPhantomT, QpcFreq, UiEdgesKnownGood
    if (TrackEdgesVisible()) {
        UiPhantomT := 0
        return true
    }
    DllCall("QueryPerformanceCounter", "Int64*", now)
    if (UiPhantomT = 0) {
        UiPhantomT := now
        return false
    }
    grace := UiEdgesKnownGood ? 4.0 : 0.5
    if ((now - UiPhantomT) / QpcFreq >= grace) {
        UiPhantomT := 0
        UiEdgesKnownGood := false
        return true
    }
    return false
}
UiEdgeReset() {
    global UiState, UiArmT, UiFightT0, UiLastGone, UiPhantomT, UiGoneT, UiGreenT, UiCallN
    global UiLearnT, UiLearnN, UiAccT, UiAccB, UiCntT, UiCntB
    global UiEdgeLatch, UiEdgeTY, UiEdgeBY, UiPeakT, UiPeakB, UiThr
    UiState := 0, UiArmT := 0, UiFightT0 := 0, UiLastGone := false
    UiPhantomT := 0, UiGoneT := 0, UiGreenT := 0, UiCallN := 0
    UiLearnT := 0, UiLearnN := 0
    UiAccT := {}, UiAccB := {}, UiCntT := {}, UiCntB := {}
    UiEdgeLatch := false, UiEdgeTY := -1, UiEdgeBY := -1
    UiPeakT := 0, UiPeakB := 0, UiThr := 9
}
UiEdgeStart() {
    global UiEdgeOn, UiState, UiLearnT, UiFightT0
    UiEdgeReset()
    if (!UiEdgeOn) {
        UiState := 3
        return
    }
    DllCall("QueryPerformanceCounter", "Int64*", now)
    UiLearnT := now
    UiFightT0 := UiLearnT
    UiState := 1
}
UiEdgeTick() {
    global UiState, UiLearnT, UiLearnN, UiAccT, UiAccB, UiCntT, UiCntB, UiEdgeTY, UiEdgeBY
    global UiPeakT, UiPeakB, UiThr, UiGoneT, UiGreenT, UiCallN, UiTopRows, UiBotOff, UiEdgeH
    global QpcFreq, UiEdgesKnownGood, UiEdgeLatch, UiTopStart, UiLatchMs, UiFightT0, UiArmT
    global UiResumeF, UiLastGone, UiRelearnRow
    if (UiState = 0)
        return "off"
    DllCall("QueryPerformanceCounter", "Int64*", now)
    UiCallN := UiCallN + 1

    if (UiState = 1) {
        if (Mod(UiCallN, 2) = 0) {
            ph := Mod(UiLearnN, 3)
            r := Max(UiTopStart, 2) + ph
            while (r <= UiTopRows - 3) {
                UiAccT[r] := (UiAccT.HasKey(r) ? UiAccT[r] : 0) + UiEdgeFrac(r, 8)
                UiCntT[r] := (UiCntT.HasKey(r) ? UiCntT[r] : 0) + 1
                r += 3
            }
            r := UiBotOff + 2 + ph
            while (r <= UiEdgeH - 3) {
                UiAccB[r] := (UiAccB.HasKey(r) ? UiAccB[r] : 0) + UiEdgeFrac(r, 8)
                UiCntB[r] := (UiCntB.HasKey(r) ? UiCntB[r] : 0) + 1
                r += 3
            }
            UiLearnN := UiLearnN + 1
        }
        if (UiLearnN >= 9 && (now - UiLearnT) / QpcFreq >= 0.5) {
            bT := -1, bTv := -1
            for row, total in UiAccT {
                avg := total / UiCntT[row]
                if (avg > bTv) {
                    bTv := avg
                    bT := row
                }
            }
            bB := -1, bBv := -1
            for row, total in UiAccB {
                avg := total / UiCntB[row]
                if (avg > bBv) {
                    bBv := avg
                    bB := row
                }
            }
            UiPeakT := (bT >= 0) ? bTv : 0
            UiPeakB := (bB >= 0) ? bBv : 0
            if (UiPeakT < 0.4 || UiPeakB < 0.4) {
                if ((now - UiFightT0) / QpcFreq < 3.0) {
                    UiEdgeRelearn(now)
                    return "learning"
                }
                UiState := 3
                return "present"
            }
            ; refine both rows at a finer column stride
            UiEdgeBandMax(bT - 1, bT + 1, 1, 2, rt)
            UiEdgeBandMax(bB - 1, bB + 1, 1, 2, rb)
            UiEdgeTY := rt
            UiEdgeBY := rb
            UiThr := 0.5 * (UiPeakT + UiPeakB)
            UiState := 2
            UiArmT := now
            UiEdgesKnownGood := true
        }
        return "learning"
    }

    if (UiState = 2 && Mod(UiCallN, 2) = 0) {
        sT := UiEdgeFrac(UiEdgeTY, 3)
        sB := UiEdgeFrac(UiEdgeBY, 3)
        if (sT >= 0.5 * UiPeakT || (sT >= 0.25 * UiPeakT && sB >= 0.5 * UiPeakB)) {
            UiLastGone := false
            if (!UiEdgeLatch) {
                if (UiGoneT = 0
                    || (sT >= UiResumeF * UiPeakT && sB >= UiResumeF * UiPeakB)
                    || (now - UiGoneT) * 1000 / QpcFreq >= 500) {
                    UiGoneT := 0
                    UiGreenT := 0
                }
            }
        } else {
            UiLastGone := true
            if (UiGoneT = 0)
                UiGoneT := now
            else if ((now - UiGoneT) * 1000 / QpcFreq >= UiLatchMs)
                UiEdgeLatch := true
            if (!UiEdgeLatch && (now - UiArmT) / QpcFreq < 1.5) {
                if (UiEdgeBandMax(UiTopStart, UiTopRows - 3, 1, 8, UiRelearnRow) >= 0.5 * UiPeakT
                    || UiEdgeBandMax(UiBotOff + 2, UiEdgeH - 3, 1, 8, UiRelearnRow) >= 0.5 * UiPeakB) {
                    UiEdgeRelearn(now)
                    return "learning"
                }
            }
        }
    }

    if ((UiState = 3 && Mod(UiCallN, 10) = 0) || (UiState = 2 && UiGoneT != 0 && Mod(UiCallN, 3) = 0)) {
        if (GreenCornerPresent()) {
            if (UiGreenT = 0)
                UiGreenT := now
        } else {
            UiGreenT := 0
        }
    }

    goneMs := (UiGoneT != 0) ? (now - UiGoneT) * 1000 / QpcFreq : 0
    greenMs := (UiGreenT != 0) ? (now - UiGreenT) * 1000 / QpcFreq : 0
    if (UiState = 2 && goneMs >= 500 && (UiEdgeLatch || UiLastGone))
        return "gone"
    if (UiState = 2 && goneMs >= 200 && greenMs >= 200)
        return "gone"
    if (UiState = 3 && greenMs >= 800)
        return "gone"
    return "present"
}
UiHandsOff(uhTick) {
    global SpecialRod, UiState, UiCallN, UiGoneT, DarkFlashing, PrecisionDown, PrecisionUpAt
    global MaxLeftToggle, MaxRightToggle, BelDown
    if (SpecialRod = "Tranquility" || SpecialRod = "Lullaby" || SpecialRod = "Stellarwave Melody")
        return false
    if (uhTick && UiState = 2) {
        ; make the next tick land on an even call so tracking runs
        if (Mod(UiCallN, 2) = 0)
            UiCallN := UiCallN + 1
        UiEdgeTick()
    }
    if (UiGoneT = 0)
        return false
    if (SpecialRod = "Darkheart" && (DarkFlashing || FrameIsDark()))
        return false
    if (BarPresent() || FishLineVisible())
        return false
    MaxLeftToggle := false
    MaxRightToggle := false
    if (PrecisionDown || GetKeyState("LButton", "P")) {
        Send, {LButton up}
        PrecisionDown := false
        DllCall("QueryPerformanceCounter", "Int64*", PrecisionUpAt)
    }
    if (SpecialRod = "Bellona's Waraxe" && (BelDown[1] || BelDown[2] || GetKeyState("RButton", "P")))
        BellonaRelease()
    return true
}
UiEdgeRelearn(ut) {
    global UiState, UiLastGone, UiLearnT, UiLearnN, UiAccT, UiAccB, UiCntT, UiCntB
    global UiGoneT, UiGreenT, UiCallN
    UiState := 1
    UiLastGone := false
    UiLearnT := ut
    UiLearnN := 0
    UiAccT := {}, UiAccB := {}, UiCntT := {}, UiCntB := {}
    UiGoneT := 0
    UiGreenT := 0
    UiCallN := 1
}
GreenCornerPresent() {
    global hUiGrnDC, pUiGrnBits, hCaptureScreenDC, UiGrnW, UiGrnH, RobloxHwnd, VxBlt
    if (!hUiGrnDC || !pUiGrnBits)
        return false
    RobloxClientRect(RobloxHwnd, cwx, cwy, cww, cwh)
    DllCall(VxBlt, "Ptr", hUiGrnDC, "Int", 0, "Int", 0, "Int", UiGrnW, "Int", UiGrnH
        , "Ptr", hCaptureScreenDC, "Int", cwx, "Int", cwy + Round(0.90 * cwh), "UInt", 0x00CC0020)
    stride := 4 * UiGrnW
    found := 0
    y := 0
    while (y < UiGrnH) {
        rowP := pUiGrnBits + y * stride
        x := 0
        while (x < UiGrnW) {
            px := NumGet(rowP + 4 * x, "UInt")
            cr := (px >> 16) & 255, cg := (px >> 8) & 255, cb := px & 255
            if (cg >= 240 && cr >= 140 && cr <= 170 && cb >= 140 && cb <= 170) {
                found++
                if (found >= 3)
                    return true
            }
            x += 3
        }
        y += 3
    }
    return false
}
ClampPct(v, lo, hi) {
	if (v = "" or v < lo)
		return lo
	if (v > hi)
		return hi
	return v
}

; Max presses per second - a hard cap on NEW mouse presses while reeling, for every rod and control mode (left and
; right button each). true = the press may go now and is counted; holding or letting go never asks
VxPressOk(btn := "L") {
	global PressGapMs, QpcFreq
	static lastL := 0, lastR := 0
	if (PressGapMs <= 0)
		return true
	DllCall("QueryPerformanceCounter", "Int64*", n)
	last := (btn = "R") ? lastR : lastL
	if (last and (n - last) * 1000.0 / QpcFreq < PressGapMs)
		return false
	if (btn = "R")
		lastR := n
	else
		lastL := n
	return true
}

; holding the bar part of the time (duty 0-1). With the press limit on, each press slot (1 / presses per second)
; gets one press held for the duty's share of it - pressing on and off every scan instead would be cut down by the
; limit and the bar would drift off the line. No limit: on and off every scan, as before.
DutyWant(ByRef acc, duty) {
	global PressGapMs, QpcFreq
	static t0 := 0
	if (PressGapMs > 0)
		{
		DllCall("QueryPerformanceCounter", "Int64*", n)
		ph := (n - t0) * 1000.0 / QpcFreq / PressGapMs
		if (ph >= 1 or ph < 0)
			{
			t0 := n
			ph := 0
			}
		return (ph < duty)
		}
	acc := acc + duty
	if (acc >= 1)
		{
		acc := acc - 1
		return true
		}
	return false
}

; Tools > Speed: the shortest time between two scans and between two presses (0 = no limit)
SpeedCaps:
MidTrim := 0
ScanGapMs := 0
if ScanCap is number
	if (ScanCap > 0)
		ScanGapMs := 1000.0 / ((ScanCap < 5) ? 5 : ScanCap)
PressGapMs := 0
if PressCap is number
	if (PressCap > 0)
		PressGapMs := 1000.0 / ((PressCap < 5) ? 5 : ((PressCap > 60) ? 60 : PressCap))
return

PreciseSleep(ms) {
    global QpcFreq
    if (ms <= 0)
        return
    DllCall("QueryPerformanceCounter", "Int64*", t0)
    target := t0 + Round(ms * QpcFreq / 1000)
    Loop {
        DllCall("QueryPerformanceCounter", "Int64*", cur)
        if (cur >= target)
            return
        Sleep, -1
    }
}
BarLostLim() {
	global AdaptiveCast, AdaptiveCastMs
	lim := TA("barlost", 150)
	ac := AdaptiveCastMs
	if ac is not number
		return lim
	if (AdaptiveCast and ac < 0)
		lim := (lim + ac < 200) ? 200 : lim + ac
	return lim
}

