KeeperPickPos:
Gui, 1:Hide
Sleep, % Tm(250)
CoordMode, Mouse, Screen
CoordMode, ToolTip, Screen
KbPickCancel := false
KbPx := 0
KbPy := 0
Loop
{
    if KeyHeld("Escape")
    {
        KbPickCancel := true
        break
    }
    if KeyHeld("u")
    {
        MouseGetPos, KbPx, KbPy
        while KeyHeld("u")
            Sleep, % Tm(20)
        break
    }
    MouseGetPos, KbMx, KbMy
    VxPickTip(KbPickMsg, KbMx + 26, KbMy + 30)
    Sleep, % Tm(25)
}
VxPickTip("")
CoordMode, Mouse, Client
CoordMode, ToolTip, Relative
if (!KbPickCancel)
{
    if (RobloxHwnd = "" || !WinExist("ahk_id " RobloxHwnd))
    {
        WinGet, RobloxHwnd, ID, ahk_exe RobloxPlayerBeta.exe
        if (RobloxHwnd = "")
            WinGet, RobloxHwnd, ID, Roblox
    }
    if (RobloxHwnd = "")
    {
        MsgBox, 4144, Veltrix, Couldn't find the Roblox window, so the position can't be saved.`n`nStart Roblox first, then set the positions again.
        Gui, 1:Show
        TargetSection := "Keeper"
        gosub ShowSection
        gosub KeeperRefreshSpots
        return
    }
    VarSetCapacity(KbPt, 8, 0)
    NumPut(KbPx, KbPt, 0, "Int")
    NumPut(KbPy, KbPt, 4, "Int")
    DllCall("ScreenToClient", "Ptr", RobloxHwnd, "Ptr", &KbPt)
    KbCliX := NumGet(KbPt, 0, "Int")
    KbCliY := NumGet(KbPt, 4, "Int")
    VarSetCapacity(KbRc, 16, 0)
    DllCall("GetClientRect", "Ptr", RobloxHwnd, "Ptr", &KbRc)
    KbCw := NumGet(KbRc, 8, "Int")
    KbCh := NumGet(KbRc, 12, "Int")
    if (KbCliX < 0 || KbCliY < 0 || KbCliX >= KbCw || KbCliY >= KbCh)
    {
        MsgBox, 4144, Veltrix, That spot is outside the Roblox window, so it wasn't saved.`n`nGame window: %KbCw% x %KbCh%`nPicked point: %KbCliX%, %KbCliY%`n`nPut Roblox on the macro's screen, open the inventory there and pick the button on that screen.
        Gui, 1:Show
        TargetSection := "Keeper"
        gosub ShowSection
        gosub KeeperRefreshSpots
        return
    }
    ; the other positions were set on this size too, or are moved to it now - all of them keep one window size
    KbRefW := (KeeperRefW > 0) ? KeeperRefW : KbCw, KbRefH := (KeeperRefH > 0) ? KeeperRefH : KbCh
    for KbI, KbK in ["Enchant", "Confirm", "Extra"]
    {
        if (Round(Keeper%KbK%X) > 0 && (KbRefW != KbCw || KbRefH != KbCh))
            Keeper%KbK%X := Round(Keeper%KbK%X * KbCw / KbRefW), Keeper%KbK%Y := Round(Keeper%KbK%Y * KbCh / KbRefH)
    }
    KeeperRefW := KbCw, KeeperRefH := KbCh
    if (KbPickWhat = "enchant")
    {
        KeeperEnchantX := KbCliX
        KeeperEnchantY := KbCliY
    }
    else if (KbPickWhat = "extra")
    {
        KeeperExtraX := KbCliX
        KeeperExtraY := KbCliY
    }
    else
    {
        KeeperConfirmX := KbCliX
        KeeperConfirmY := KbCliY
    }
    gosub QueueAutoSave
}
Gui, 1:Show
TargetSection := "Keeper"
gosub ShowSection
gosub KeeperRefreshSpots
return
