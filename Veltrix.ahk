Tm(ms) {
	global TimeOffset, TmDebt, TmDebtT
	if ms is not number
		return ms
	if (ms >= 0 and ms <= 1)
		return ms
	off := TimeOffset
	if off is not number
		off := 0
	if TmDebt is not number
		TmDebt := 0
	d := (TmDebt < 0 and A_TickCount - TmDebtT < 5000) ? TmDebt : 0
	TmDebt := 0
	rem := ms + d
	if (rem < 0)
		{
		TmDebt := rem
		TmDebtT := A_TickCount
		return 0
		}
	v := Round(rem + off)
	return (v < 0) ? 0 : v
}

TmNumOpt(name) {
	return InStr(name, "Delay") ? "" : "+Number"
}

TA(id, def) {
	global AdvancedOn, AdvT
	if (!AdvancedOn)
		return def
	if (!IsObject(AdvT))
		AdvLoad()
	if (AdvT.HasKey(id))
		{
		v := AdvT[id]
		if v is number
			return v
		}
	return def
}

AdvLoad() {
	global AdvT, SettingsFile
	AdvT := {}
	for i, e in AdvRegistry()
		{
		if (e[2] != "L")
			continue
		IniRead, v, %SettingsFile%, Advanced, % e[3], %A_Space%
		if v is number
			AdvT[e[3]] := v + 0
		}
}

