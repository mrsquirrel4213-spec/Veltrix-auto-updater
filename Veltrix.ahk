        CastBarW := bestLen
    }

    if (CastBarW <= 0) {
        tGap := Max(10, Round(0.02 * W))
        nTrk := 0
        tBest := -1, tLen := 0, tRun := -1, tEnd := -1, tG := 0
        Loop % W {
            x := A_Index - 1
            P := NumGet(midP + x * 4, "UInt")
            b := P & 0xFF, g := (P >> 8) & 0xFF, r := (P >> 16) & 0xFF, s := r + g + b
            m := CbxR[r] & CbxG[g] & CbxB[b]
            if ((b - g > 20 && r - g > 5 && s >= 180 && s <= 340) || (m & 0x7FC0000)) {
                nTrk++
                if (tRun >= 0) {
                    tG++
                    if (tG > tGap) {
                        if (tEnd - tRun + 1 > tLen)
                            tBest := tRun, tLen := tEnd - tRun + 1
                        tRun := -1, tG := 0
                    }
                }
            } else {
                if (tRun < 0)
                    tRun := x
                tEnd := x
                tG := 0
            }
        }
        if (tRun >= 0 && tEnd - tRun + 1 > tLen)
            tBest := tRun, tLen := tEnd - tRun + 1
        if (nTrk >= 0.25 * W && tBest >= 0 && tLen >= 0.05 * W && tLen <= 0.90 * W) {
