	return KbFind(kind, fx, fy)
}

KbGone(kind, ms, nearX := -1, nearY := -1) {
	t0 := A_TickCount
	misses := 0
	Loop {
		if (KbFind(kind, gx, gy, "", nearX, nearY)) {
			misses := 0
		} else {
			misses += 1
			if (misses >= 2)
				return true
		}
		if (A_TickCount - t0 >= ms)
			return false
		Sleep, % Tm(TA("kbgonepoll", 35))
	}
}

KbRodOn() {
    global WindowHeight, AqY0, pAqBits, AqW, AqH
    if !AqGrab()
        return false
    top := Round(WindowHeight * 0.923) - AqY0
    bot := Round(WindowHeight * 0.942) - AqY0
    if (top < 0)
        top := 0
    if (bot > AqH - 1)
        bot := AqH - 1
    hits := 0
    y := top
    while (y <= bot) {
        base := y * AqW * 4
        x := 0
        while (x <= AqW - 1) {
            px := NumGet(pAqBits + 0, base + x * 4, "UInt")
            vb := px & 0xFF, vg := (px >> 8) & 0xFF, vr := (px >> 16) & 0xFF
            if (vb > 200 && vr > 130 && vb - vg > 90 && vr - vg > 30)
                hits++
            x += 2
        }
        y++
    }
    return hits >= 40
}
