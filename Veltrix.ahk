    ihh := bE - bS + 1
    ni := bN
    if (iw * 100 < 45 * ih || iw * 100 > 170 * ih || ihh * 100 < 55 * ih || ihh * 100 > 135 * ih)
        return {st: "junk", n: n}
    if (ni * 100 < 10 * iw * ihh || ni * 100 > 92 * iw * ihh)
        return {st: "junk", n: n}

    ; 98th percentile of distance inside the icon box
    dh := []
    Loop 766
        dh[A_Index - 1] := 0
    y := bS
    while (y <= bE) {
        x := a
        while (x <= b) {
            dv := NumGet(dist, (y * bw + x) * 2, "UShort")
            if (dv > 765)
                dv := 765
            dh[dv] += 1
            x++
        }
        y++
    }
    tot := iw * ihh
    acc := 0, pk := 765
    Loop 766 {
        lvl := A_Index - 1
        acc += dh[lvl]
        if (acc * 100 >= 98 * tot) {
            pk := lvl
            break
        }
    }
    dn := Round(pk * 0.35)
    if (dn < D)
        dn := D
    if (pk - dn < 20)
        return {st: "junk", n: n}
    span := pk - dn

    g := []
    gsum := 0
    Loop 12 {
        gi := A_Index - 1
        ry0 := Floor(ihh * gi / 12), ry1 := Floor(ihh * (gi + 1) / 12)
        if (ry1 <= ry0)
            ry1 := ry0 + 1
        Loop 12 {
            gj := A_Index - 1
            rx0 := Floor(iw * gj / 12), rx1 := Floor(iw * (gj + 1) / 12)
            if (rx1 <= rx0)
                rx1 := rx0 + 1
            ct := 0, cn := 0
            py := ry0
            while (py < ry1) {
                qx := rx0
                while (qx < rx1) {
                    dv := NumGet(dist, ((bS + py) * bw + a + qx) * 2, "UShort")
                    f := (dv - dn) / span
                    if (f > 1)
                        f := 1
                    if (f > 0)
                        ct += f
                    cn++
                    qx++
                }
                py++
            }
            cell := Floor(ct / cn * 100)
            g[gi * 12 + gj] := cell
            gsum += cell
        }
    }
    if (gsum < 1)
        return {st: "junk", n: n}
    gmean := gsum / 144
    Loop 144 {
        k := A_Index - 1
        g[k] := Round(g[k] / gmean * 20)
    }

    ; average real colour of the strong pixels
    sumB := 0, sumG := 0, sumR := 0, sc := 0
    y := bS
    while (y <= bE) {
        x := a
        while (x <= b) {
            if (NumGet(dist, (y * bw + x) * 2, "UShort") >= dn) {
                px := NumGet(pTotemBits + 0, ((y0 + y) * TotemW + x0 + x) * 4, "UInt")
                sumB += px & 0xFF, sumG += (px >> 8) & 0xFF, sumR += (px >> 16) & 0xFF
                sc++
            }
            x++
        }
        y++
    }
    if (sc < 4)
        return {st: "junk", n: n}
    ar2 := sumR // sc, ag2 := sumG // sc, ab2 := sumB // sc
    cmx := ar2 > ag2 ? ar2 : ag2
    if (ab2 > cmx)
        cmx := ab2
    cmn := ar2 < ag2 ? ar2 : ag2
    if (ab2 < cmn)
        cmn := ab2
    isat := (cmx = 0) ? 0 : Floor((cmx - cmn) * 100 / cmx)
    hue := (isat >= 12) ? TotemHue(ar2, ag2, ab2) : -1
    return {st: "icon", n: n, g: g, ar: Round(iw * 100 / ihh), hue: hue, sat: isat
        , x0: x0 + a, x1: x0 + b, y0: y0 + bS, y1: y0 + bE}
}
TotemEvtBest(grid, ar100, hue, sat, ByRef bD, ByRef nD) {
    global TotemEvt
    order := []
    best := {}
    for _, rec in TotemEvt {
        if (StrLen(rec.g) < 432)
            continue
        dist := 0
        Loop 144 {
            k := A_Index - 1
            dist += Abs(grid[k] - SubStr(rec.g, 3 * k + 1, 3))
        }
        dist += 8 * Abs(ar100 - rec.a)
        if (rec.h >= 0 && hue >= 0) {
            hd := Abs(rec.h - hue)
            if (hd > 180)
                hd := 360 - hd
            dist += 20 * hd + 15 * Abs(sat - rec.s)
        } else {
            dist += 2000
        }
        nm := rec.n
        if !best.HasKey(nm) {
            best[nm] := dist
            order.Push(nm)
        } else if (dist < best[nm]) {
            best[nm] := dist
        }
    }
    bD := 999999, nD := 999999
    winner := ""
    for _, nm in order {
        pd := best[nm]
        if (pd < bD) {
            nD := bD
            bD := pd
            winner := nm
        } else if (pd < nD) {
            nD := pd
        }
    }
    return winner
}
TotemStripInit() {
    global WindowWidth, WindowHeight, TotemX0, TotemY0, TotemW, TotemH
    global hTotemScreenDC, hTotemMemDC, hTotemBM, pTotemBits
    sx := Round(WindowWidth * 0.836)
    sy := Round(WindowHeight * 0.876)
    sw := Round(WindowWidth * 0.162)
    sh := Round(WindowHeight * 0.048)
    if (sw < 48)
        sw := 48
    if (sh < 20)
        sh := 20
    if (hTotemMemDC && sw = TotemW && sh = TotemH) {
        TotemX0 := sx, TotemY0 := sy
        return true
    }
    if (hTotemMemDC) {
        DllCall("gdi32\DeleteObject", "Ptr", hTotemBM)
        DllCall("gdi32\DeleteDC", "Ptr", hTotemMemDC)
        DllCall("user32\ReleaseDC", "Ptr", 0, "Ptr", hTotemScreenDC)
        hTotemMemDC := 0
    }
    TotemX0 := sx, TotemY0 := sy, TotemW := sw, TotemH := sh
    hTotemScreenDC := DllCall("user32\GetDC", "Ptr", 0, "Ptr")
    hTotemMemDC := DllCall("gdi32\CreateCompatibleDC", "Ptr", hTotemScreenDC, "Ptr")
    VarSetCapacity(bmi, 40, 0)
    NumPut(40, bmi, 0, "UInt")
    NumPut(TotemW, bmi, 4, "Int")
    NumPut(-TotemH, bmi, 8, "Int")
    NumPut(1, bmi, 12, "UShort")
    NumPut(32, bmi, 14, "UShort")
    NumPut(0, bmi, 16, "UInt")
    pTotemBits := 0
    hTotemBM := DllCall("gdi32\CreateDIBSection", "Ptr", hTotemMemDC, "Ptr", &bmi, "UInt", 0
        , "Ptr*", pTotemBits, "Ptr", 0, "UInt", 0, "Ptr")
    if (!hTotemBM) {
        hTotemMemDC := 0
        return false
    }
    DllCall("gdi32\SelectObject", "Ptr", hTotemMemDC, "Ptr", hTotemBM)
    return true
}
TotemCaptureStrip() {
    global hTotemMemDC, hTotemScreenDC, TotemW, TotemH, TotemX0, TotemY0, RobloxHwnd, VxBlt
    if (!hTotemMemDC || !RobloxHwnd)
        return false
    RobloxClientRect(RobloxHwnd, twx, twy)
    DllCall(VxBlt, "Ptr", hTotemMemDC, "Int", 0, "Int", 0, "Int", TotemW, "Int", TotemH
        , "Ptr", hTotemScreenDC, "Int", twx + TotemX0, "Int", twy + TotemY0, "UInt", 0x00CC0020)
    return true
}
KbPixFill(px) {
	r := (px >> 16) & 0xFF
	g := (px >> 8) & 0xFF
	b := px & 0xFF
	return (b >= 215 and r >= 95 and g <= 140 and r > g + 5)
}

KbPixNavy(px) {
	r := (px >> 16) & 0xFF
	g := (px >> 8) & 0xFF
	b := px & 0xFF
	return (Abs(r - 12) <= 14 and Abs(g - 30) <= 14 and Abs(b - 42) <= 16)
}

KbGrab(x, y, w, h, ByRef hdcM, ByRef hbm, ByRef old) {
    ; Balance-the-Nuke minigame: a white needle swings over a red/yellow/green half circle.
    ; Q and E push the needle; the detector sweeps angles around its pivot (just above the
    ; text), keeps the angle with the most white, and presses the key that sends it back to green.
    scr := DllCall("user32\GetDC", "Ptr", 0, "Ptr")
    hdcM := DllCall("gdi32\CreateCompatibleDC", "Ptr", scr, "Ptr")
    VarSetCapacity(bmi, 40, 0)
    NumPut(40, bmi, 0, "UInt")
    NumPut(w, bmi, 4, "Int")
    NumPut(-h, bmi, 8, "Int")
    NumPut(1, bmi, 12, "UShort")
    NumPut(32, bmi, 14, "UShort")
    pBits := 0
    hbm := DllCall("gdi32\CreateDIBSection", "Ptr", hdcM, "Ptr", &bmi, "UInt", 0
        , "Ptr*", pBits, "Ptr", 0, "UInt", 0, "Ptr")
    if (!hbm) {
        DllCall("gdi32\DeleteDC", "Ptr", hdcM)
        DllCall("user32\ReleaseDC", "Ptr", 0, "Ptr", scr)
        return 0
    }
    old := DllCall("gdi32\SelectObject", "Ptr", hdcM, "Ptr", hbm, "Ptr")
    DllCall("gdi32\BitBlt", "Ptr", hdcM, "Int", 0, "Int", 0, "Int", w, "Int", h
        , "Ptr", scr, "Int", x, "Int", y, "UInt", 0x00CC0020)
    DllCall("user32\ReleaseDC", "Ptr", 0, "Ptr", scr)
    return pBits
}
NukeTimerRefresh:
NukeMs := NukeEveryMs
if NukeMs is not number
	NukeMs := 100
NukeMs := (NukeMs < 20) ? 20 : Round(NukeMs)
if (NukeAuto)
	SetTimer, NukeTick, %NukeMs%
else
	SetTimer, NukeTick, Off
return

NukeTick:
gosub, NukeTimerRefresh
if (!NukeAuto or NukeBusy or !RobloxHwnd or !WinActive("ahk_id " . RobloxHwnd))
	return
if (NukeIgnoreUntil and A_TickCount < NukeIgnoreUntil)
	return
NukeBusy := true
NukeA := NukeNeedle()
if (NukeA = "")
	{
	NukeBusy := false
	NukePrevT := 0
	NukeSeen := false
	return
	}
; seen once: look again right away - only a gauge seen twice in a row takes over
Sleep, 40
NukeA := NukeNeedle()
if (NukeA = "")
	{
	NukeBusy := false
	return
	}
gosub, NukeFocus
NukeBusy := false
return

; a nuke outranks everything: this runs on the timer's thread, so whatever was going on (casting, shaking, a fish
; minigame) waits underneath until the nuke is gone. The mouse is let go first.
NukeFocus:
SetTimer, NukeTick, Off
if (PrecisionDown or GetKeyState("LButton"))
	{
	Send {lbutton up}
	PrecisionDown := false
	}
VxTip(7, "Current Task: Balancing the Nuke")
NukeSeen := true
NukePrevT := 0
NukeMiss := 0
NukeFocusT := A_TickCount
NukeP0 := NukePresses
NukeAMin := NukeA, NukeAMax := NukeA
NukeFalse := false
NukeRateV := TA("nukegreenrate", 8)
NukeRateV := (NukeRateV < 1) ? 1 : NukeRateV
Loop
	{
	if (!NukeAuto or !RobloxHwnd or !WinActive("ahk_id " . RobloxHwnd))
		break
	if (NukeA = "")
		{
		; gone for nukegone ms: over (a look or two can miss in the middle of one)
		if (!NukeMiss)
			NukeMiss := A_TickCount
		if (A_TickCount - NukeMiss >= TA("nukegone", 800))
			break
		Sleep, 8
		NukeA := NukeNeedle()
		continue
		}
	NukeMiss := 0
	NukeAMin := (NukeA < NukeAMin) ? NukeA : NukeAMin, NukeAMax := (NukeA > NukeAMax) ? NukeA : NukeAMax
	; pressed several times and the "needle" never moved: not a nuke (something on screen that looks like one)
	if (NukePresses - NukeP0 >= 10 and NukeAMax - NukeAMin < 1.5)
		{
		NukeFalse := true
		NukeIgnoreUntil := A_TickCount + 3000
		break
		}
	; a nuke never takes this long
	if (A_TickCount - NukeFocusT > 30000)
		break
	gosub, NukeStep
	Sleep, 4
	NukeA := NukeNeedle()
	}
NukeSeen := false
NukePrevT := 0
; the nuke puts the rod away: end the fishing step that was going on, the rod comes out again before the next cast
; (only after a real one - a false alarm leaves the fishing alone)
if (MacroRunning and !NukeFalse)
	{
	NukeAfter := true
	ForceReset := true
	WhEvent("Nuke balanced", "The gauge closed after " . Round((A_TickCount - NukeFocusT) / 1000) . " s.", "good")
	}
gosub, NukeTimerRefresh
return

; one look at the needle: press Q or E when it leans out of the green (at most NukeRateV presses a second)
NukeStep:
DllCall("QueryPerformanceCounter", "Int64*", NukeNowQ)
NukeNow := NukeNowQ / QpcFreq
; where it is about to be: its drift since the last look (a press throws that off, so not right after one)
NukePred := NukeA
if (NukePrevT and NukeNow - NukePrevT < 0.4 and NukeNow - NukePressT > 0.15)
	NukePred := NukeA + (NukeA - NukePrevA) / (NukeNow - NukePrevT) * TA("nukelead", 80) / 1000.0
NukePrevA := NukeA
NukePrevT := NukeNow
NukeZoneD := NukeZone
if NukeZoneD is not number
	NukeZoneD := 8
; no press while it is near the middle (NukeZone degrees either side)
if (NukePred > NukeZoneD)
	NukeKey := NukeSwap ? "e" : "q"
else if (NukePred < -NukeZoneD)
	NukeKey := NukeSwap ? "q" : "e"
else
	return
; in the green: gentle taps (nukegreenrate a second at most). Out of the green (yellow / red): no limit at all
NukeGHv := (NukeGH > 0) ? NukeGH : 40
if (Abs(NukeA) <= NukeGHv and NukePressT and (NukeNow - NukePressT) * NukeRateV < 1)
	return
NukeTap := NukeTapMs
if NukeTap is not number
	NukeTap := 30
Send, {%NukeKey% down}
Sleep, % (NukeTap < 5) ? 5 : Round(NukeTap)
Send, {%NukeKey% up}
NukePressT := NukeNow
NukePrevT := 0
NukePresses := NukePresses + 1
NukeLast := Format("needle {:+d} deg - pressed {} ({} presses)", Round(NukeA), Format("{:U}", NukeKey), NukePresses)
return

; the needle's angle in degrees (0 = straight up, + = leaning right), "" when the Nuke minigame is not up
NukeNeedle() {
	global RobloxHwnd, NukeGeo, VxNatNK, NatOff
	static wideT := 0
	RobloxClientRect(RobloxHwnd, wx, wy, ww, wh)
	if (ww < 200 or wh < 200)
		return ""
	if (VxNatNK and !NatOff)
		return NukeRingRead(wx, wy, ww, wh)
	if (IsObject(NukeGeo) and (NukeGeo.ww != ww or NukeGeo.wh != wh))
		NukeGeo := ""
	if (IsObject(NukeGeo))
		{
		a := NukeNeedleAt(wx, wy, NukeGeo.px, NukeGeo.py, NukeGeo.s)
		if (a != "")
			return a
		NukeGeo := ""
		}
	a := NukeNeedleAt(wx, wy, ww * 0.501, wh * 0.8352, wh)
	if (a != "")
		{
		NukeGeo := {ww: ww, wh: wh, px: ww * 0.501, py: wh * 0.8352, s: wh}
		return a
		}
	if (A_TickCount - wideT < 1000)
		return ""
	wideT := A_TickCount
	if (!NukeFindGauge(wx, wy, ww, wh, gpx, gpy, gs))
		return ""
	a := NukeNeedleAt(wx, wy, gpx, gpy, gs)
	if (a != "")
		NukeGeo := {ww: ww, wh: wh, px: gpx, py: gpy, s: gs}
	return a
}

; the gauge read in VeltrixNative: the ring (circle through its red and yellow), where its green and yellow end, and
; the needle's angle (0 = straight up, + = leaning right; "" when there is no gauge). Once found, only the area round
; the ring is grabbed; while it is not found, the lower middle of the window (at most every 0.25 s while idle).
NukeRingRead(wx, wy, ww, wh) {
	global VxNatNK, NukeRing, NukeGH, NukeYH
	static tab := "", na := 401, a0 := -100.0, da := 0.5, wideT := 0
	if (tab = "")
		{
		VarSetCapacity(tab, na * 16, 0)
		Loop % na
			{
			a := (a0 + (A_Index - 1) * da) * 0.0174532925
			NumPut(Sin(a), tab, (A_Index - 1) * 16, "Double"), NumPut(Cos(a), tab, (A_Index - 1) * 16 + 8, "Double")
			}
		}
	if (IsObject(NukeRing) and (NukeRing.ww != ww or NukeRing.wh != wh))
		NukeRing := ""
	if (IsObject(NukeRing))
		{
		r := NukeRing.r
		gx := Round(NukeRing.cx - 1.35 * r), gy := Round(NukeRing.cy - 1.35 * r)
		gw := Round(2.7 * r), gh := Round(1.7 * r)
		}
	else
		{
		if (A_TickCount - wideT < 250)
			return ""
		wideT := A_TickCount
		gx := Round(ww * 0.15), gy := Round(wh * 0.40), gw := Round(ww * 0.70), gh := wh - gy
		}
	gx := (gx < 0) ? 0 : gx, gy := (gy < 0) ? 0 : gy
	gw := (gx + gw > ww) ? ww - gx : gw, gh := (gy + gh > wh) ? wh - gy : gh
	if (gw < 20 or gh < 20)
		{
		NukeRing := ""
		return ""
		}
	pBits := KbGrab(wx + gx, wy + gy, gw, gh, hdcM, hbm, old)
	if (!pBits)
		return ""
	st := IsObject(NukeRing) ? Round(NukeRing.r / 150) : Round(wh / 720)
	st := (st < 1) ? 1 : st
	VarSetCapacity(o, 64, 0)
	; the gauge does not move: a ring found before is used as it is (only checked and read) - the red glow or the
	; character over the gauge cannot throw it off then
	if (IsObject(NukeRing))
		NumPut(2, o, 0, "Double"), NumPut(NukeRing.cx - gx, o, 8, "Double"), NumPut(NukeRing.cy - gy, o, 16, "Double"), NumPut(NukeRing.r, o, 24, "Double")
	DllCall(VxNatNK, "Ptr", pBits, "Int", gw, "Int", gh, "Int", st, "Ptr", &tab, "Int", na, "Double", a0, "Double", da, "Ptr", &o, "Int")
	KbGrabEnd(hdcM, hbm, old)
	if (NumGet(o, 0, "Double") < 1 or NumGet(o, 32, "Double") = -999)
		{
		; not read this time: keep the ring a while (a flash, the needle hidden), then look for the gauge anew
		if (IsObject(NukeRing))
			{
			if (!NukeRing.lost)
				NukeRing.lost := A_TickCount
			else if (A_TickCount - NukeRing.lost > 1500)
				NukeRing := ""
			}
		return ""
		}
	if (IsObject(NukeRing))
		NukeRing.lost := 0
	else
		NukeRing := {ww: ww, wh: wh, cx: gx + NumGet(o, 8, "Double"), cy: gy + NumGet(o, 16, "Double"), r: NumGet(o, 24, "Double"), lost: 0}
	g := NumGet(o, 40, "Double"), y := NumGet(o, 48, "Double")
	; the borders can be hidden for a moment (the character stands over the gauge): keep the last ones read
	if (g > 0)
		NukeGH := g
	if (y > 0)
		NukeYH := y
	return NumGet(o, 32, "Double")
}

; the gauge's green half circle anywhere in the lower middle of the window: its pivot (bottom middle) and its size,
; given as the window height it would have at the usual layout (the half circle is about 0.15 of that each side)
NukeFindGauge(wx, wy, ww, wh, ByRef gpx, ByRef gpy, ByRef gs) {
	global VxNatGX, NatOff, MgInPlay
	; without VeltrixNative this big look is slow in script - not while a fish is being reeled
	if ((!VxNatGX or NatOff) and MgInPlay)
		return false
	gx := Round(ww * 0.2), gy := Round(wh * 0.45), gw := Round(ww * 0.6), gh := Round(wh * 0.53)
	pBits := KbGrab(wx + gx, wy + gy, gw, gh, hdcM, hbm, old)
	if (!pBits)
		return false
	st := (wh >= 1400) ? 4 : (wh >= 900) ? 3 : 2
	x0 := gw, x1 := -1, y0 := gh, y1 := -1, n := 0
	if (VxNatGX and !NatOff)
		{
		VarSetCapacity(gb, 16, 0)
		n := DllCall(VxNatGX, "Ptr", pBits, "Int", gw, "Int", gh, "Int", st, "Ptr", &gb, "Int")
		x0 := NumGet(gb, 0, "Int"), x1 := NumGet(gb, 4, "Int"), y0 := NumGet(gb, 8, "Int"), y1 := NumGet(gb, 12, "Int")
		}
	y := (VxNatGX and !NatOff) ? gh : 0
	while (y < gh)
		{
		x := 0
		while (x < gw)
			{
			v := NumGet(pBits + (y * gw + x) * 4, 0, "UInt")
			b := v & 0xFF, g := (v >> 8) & 0xFF, r := (v >> 16) & 0xFF
			if (g > 170 and r < 150 and b < 150)
				{
				n++
				x0 := (x < x0) ? x : x0, x1 := (x > x1) ? x : x1
				y0 := (y < y0) ? y : y0, y1 := (y > y1) ? y : y1
				}
			x += st
			}
		y += st
		}
	KbGrabEnd(hdcM, hbm, old)
	; a half circle: about twice as wide as tall, and big enough to be the gauge
	if (n < 20 or x1 - x0 < 40)
		return false
	asp := (x1 - x0) / ((y1 - y0 > 0) ? (y1 - y0) : 1)
	if (asp < 1.3 or asp > 3.2)
		return false
	gpx := gx + (x0 + x1) / 2.0
	gpy := gy + y1
	gs := ((x1 - x0) / 2.0) / 0.15
	return true
}

; the needle's angle around a pivot at (px, py) for a gauge of size s (the window height of the usual layout)
NukeNeedleAt(wx, wy, px, py, s) {
	half := Round(s * 0.17), up := Round(s * 0.15), dn := Round(s * 0.03)
	gx := Round(px) - half, gy := Round(py) - up, gw := 2 * half, gh := up + dn
	pBits := KbGrab(wx + gx, wy + gy, gw, gh, hdcM, hbm, old)
	if (!pBits)
		return ""
	; the half circle is there: enough of its green
	gn := 0, n := 0, y := 0
	while (y < gh)
		{
		x := 0
		while (x < gw)
			{
			v := NumGet(pBits + (y * gw + x) * 4, 0, "UInt")
			b := v & 0xFF, g := (v >> 8) & 0xFF, r := (v >> 16) & 0xFF
			gn += (g > 170 and r < 150 and b < 150)
			n++
			x += 6
			}
		y += 6
		}
	best := -1, bestA := 0
	if (n and gn * 100 >= n * TA("nukegreen", 4))
		{
		cx := px - gx, cy := py - gy
		r0 := s * 0.035, r1 := s * 0.14
		a := -85
		while (a <= 85)
			{
			s := Sin(a * 0.0174533), c := Cos(a * 0.0174533), w := 0
			Loop 24
				{
				rr := r0 + (r1 - r0) * (A_Index - 1) / 23
				x := Round(cx + rr * s), y := Round(cy - rr * c)
				if (x < 0 or y < 0 or x >= gw or y >= gh)
					continue
				v := NumGet(pBits + (y * gw + x) * 4, 0, "UInt")
				b := v & 0xFF, g := (v >> 8) & 0xFF, r := (v >> 16) & 0xFF
				w += ((r < g ? (r < b ? r : b) : (g < b ? g : b)) >= 220)
				}
			if (w > best)
				best := w, bestA := a
			a += 1
			}
		}
	KbGrabEnd(hdcM, hbm, old)
	; a real needle is white most of the way along
	return (best >= 18) ? bestA : ""
}

NukeStatusTick:
if (!NukeAuto)
	NukeLine := "Off."
else if (!NukeSeen)
	NukeLine := "Watching for the Nuke minigame (every " . NukeMs . " ms)."
else
	NukeLine := "Balancing - " . NukeLast
GuiControl, 1:, NukeStatLine, %NukeLine%
return

KbGrabEnd(hdcM, hbm, old) {
	DllCall("SelectObject", "Ptr", hdcM, "Ptr", old)
	DllCall("DeleteObject", "Ptr", hbm)
	DllCall("DeleteDC", "Ptr", hdcM)
}

; finds the Keeperbound power bar (purple fill + dark navy track) on its own - no setup
KbAutoFind() {
	global RobloxHwnd, KbBarY, KbBarL, KbBarR, KbBarWW, KbBarWH, KbBarTop, KbBarBot
	KbBarY := -1
	if (!RobloxHwnd)
		return false
	RobloxClientRect(RobloxHwnd, wx, wy, ww, wh)
	if (ww < 200 or wh < 200)
		return false
	y0 := Round(wh * 0.45)
	h := wh - y0
	w := ww
	pBits := KbGrab(wx, wy + y0, w, h, hdcM, hbm, old)
	if (!pBits)
		return false
	; the bar is about 960 px wide at every window size, so the limits are in pixels - a gap measured as a share
	; of the window let the bar run on into dark water past its end on a 4K screen (99.8% read as 70%)
	gap := 30
	minRun := Round(w * 0.18)
	if (minRun > 450)
		minRun := 450
	rows := []
	Loop % h
		{
		y := A_Index - 1
		base := pBits + y * w * 4
		hits := 0
		hx := -1
		Loop 9
			{
			x := Round(w * (0.30 + 0.05 * (A_Index - 1)))
			px := NumGet(base + 0, x * 4, "UInt")
			if (KbPixFill(px) or KbPixNavy(px))
				{
				hits++
				hx := x
				}
			}
		if (hits < 2)
			continue
		L := hx
		R := hx
		good := 1
		fills := KbPixFill(NumGet(base + 0, hx * 4, "UInt")) ? 1 : 0
		miss := 0
		x := hx - 1
		while (x >= 0)
			{
			px := NumGet(base + 0, x * 4, "UInt")
			f := KbPixFill(px)
			if (f or KbPixNavy(px))
				{
				L := x
				good++
				fills += f
				miss := 0
				}
			else if (++miss > gap)
				break
			x--
			}
		miss := 0
		x := hx + 1
		while (x < w)
			{
			px := NumGet(base + 0, x * 4, "UInt")
			f := KbPixFill(px)
			if (f or KbPixNavy(px))
				{
				R := x
				good++
				fills += f
				miss := 0
				}
			else if (++miss > gap)
				break
			x++
			}
		; 45%: a fish or effect drifting over part of the bar must not hide it
		if (R - L + 1 >= minRun and good >= 0.45 * (R - L + 1))
			rows.Push([y, L, R, fills])
		}
	KbGrabEnd(hdcM, hbm, old)
	if (rows.Length() < 3)
		return false
	; candidates are runs of 3+ rows in a row. Dark water looks just like the empty (navy) track, so the bar is
	; the run with the most purple fill - not the tallest one. No purple anywhere (empty bar): the lowest run.
	bs := 0
	bn := 0
	bScore := -1
	cs := 1
	n := rows.Length()
	Loop % n
		{
		i := A_Index
		if (i < n and rows[i + 1][1] = rows[i][1] + 1)
			continue
		len := i - cs + 1
		if (len >= 3)
			{
			sc := 0
			Loop % len
				sc += rows[cs + A_Index - 1][4]
			if (sc > bScore or (sc = 0 and bScore = 0))
				{
				bScore := sc
				bs := cs
				bn := len
				}
			}
		cs := i + 1
		}
	if (bn < 3)
		return false
	ls := []
	rs := []
	Loop % bn
		{
		ls.Push(rows[bs + A_Index - 1][2])
		rs.Push(rows[bs + A_Index - 1][3])
		}
	KbBarY := y0 + rows[bs + (bn // 2)][1]
	KbBarTop := y0 + rows[bs][1]
	KbBarBot := y0 + rows[bs + bn - 1][1]
	KbBarL := MedianOf(ls)
	KbBarR := MedianOf(rs)
	KbBarWW := ww
	KbBarWH := wh
	return true
}

; reads how full the power bar is, 0-100. false if the bar is not on screen
; The "45.0% Power" text sits on top of the middle of the bar with a thick navy outline (the same navy as
; the empty track), so the fill edge cannot just be "where the navy starts". Instead every pixel is evidence:
; purple = filled here, navy that is NOT part of a letter outline = empty here. The reading is the split point
; that best separates the two (a step fit), which also sees through the gaps between the letters.
KbAutoRead(ByRef pct, ByRef lo := "", ByRef hi := "") {
	global RobloxHwnd, KbBarY, KbBarL, KbBarR, KbBarWW, KbBarWH, KbBarTop, KbBarBot, KbLastFill
	pct := -1
	lo := -1
	hi := -1
	if (!RobloxHwnd)
		return false
	Loop 2
		{
		RobloxClientRect(RobloxHwnd, wx, wy, ww, wh)
		fresh := false
		if (KbBarY = "" or KbBarY < 0 or KbBarTop = "" or ww != KbBarWW or wh != KbBarWH)
			{
			if (!KbAutoFind())
				return false
			fresh := true
			}
		w := Round(KbBarR - KbBarL + 1)
		nr := KbBarBot - KbBarTop + 1
		if (w < 20 or nr < 3)
			{
			KbBarY := -1
			continue
			}
		pBits := KbGrab(wx + Round(KbBarL), wy + KbBarTop, w, nr, hdcM, hbm, old)
		if (!pBits)
			return false
		; 1 = fill, 2 = navy, 3 = letter
		VarSetCapacity(cls, w * nr, 0)
		rowF := []
		rowN := []
		Loop % nr
			{
			r := A_Index - 1
			base := pBits + r * w * 4
			ob := r * w
			fc := 0
			nc := 0
			x := 0
			while (x < w)
				{
				px := NumGet(base + 0, x * 4, "UInt")
				cr := (px >> 16) & 0xFF
				cg := (px >> 8) & 0xFF
				cb := px & 0xFF
				if (cb >= 215 and cr >= 95 and cg <= 140 and cr > cg + 5)
					{
					NumPut(1, cls, ob + x, "UChar")
					fc++
					}
				else if (cr <= 26 and cg >= 16 and cg <= 44 and cb >= 26 and cb <= 58)
					{
					NumPut(2, cls, ob + x, "UChar")
					nc++
					}
				else if (cr >= 150 and cg >= 145 and cb >= 190)
					NumPut(3, cls, ob + x, "UChar")
				x++
				}
			rowF.Push(fc)
			rowN.Push(nc)
			}
		KbGrabEnd(hdcM, hbm, old)
		; drop the purple border rows at the top and bottom of the bar
		maxN := 0
		for i, v in rowN
			maxN := (v > maxN) ? v : maxN
		r0 := 2
		r1 := nr - 1
		if (nr <= 4)
			{
			r0 := 1
			r1 := nr
			}
		while (r0 < r1 and maxN > 0.05 * w and rowN[r0] < 0.02 * w and rowF[r0] > 0.9 * w)
			r0++
		while (r1 > r0 and maxN > 0.05 * w and rowN[r1] < 0.02 * w and rowF[r1] > 0.9 * w)
			r1--
		ih := r1 - r0 + 1
		d := Round(ih * 0.25)
		if (d < 2)
			d := 2
		; navy within d px of a letter is outline, not empty track
		VarSetCapacity(nh, w * nr, 0)
		r := r0
		while (r <= r1)
			{
			ob := (r - 1) * w
			last := -100000
			x := 0
			while (x < w)
				{
				if (NumGet(cls, ob + x, "UChar") = 3)
					last := x
				if (x - last <= d)
					NumPut(1, nh, ob + x, "UChar")
				x++
				}
			last := 100000
			x := w - 1
			while (x >= 0)
				{
				if (NumGet(cls, ob + x, "UChar") = 3)
					last := x
				if (last - x <= d)
					NumPut(1, nh, ob + x, "UChar")
				x--
				}
			r++
			}
		VarSetCapacity(fe, w * 8, 0)
		totF := 0
		totE := 0
		x := 0
		while (x < w)
			{
			f := 0
			e := 0
			r := r0
			while (r <= r1)
				{
				c := NumGet(cls, (r - 1) * w + x, "UChar")
				if (c = 1)
					f++
				else if (c = 2)
					{
					near := false
					rr := (r - d < r0) ? r0 : r - d
					re := (r + d > r1) ? r1 : r + d
					while (rr <= re)
						{
						if (NumGet(nh, (rr - 1) * w + x, "UChar"))
							{
							near := true
							break
							}
						rr++
						}
					if (!near)
						e++
					}
				r++
				}
			NumPut(f, fe, x * 8, "UInt")
			NumPut(e, fe, x * 8 + 4, "UInt")
			totF += f
			totE += e
			x++
			}
		if (totF + totE < 0.3 * w * ih)
			{
			; not the bar any more (menu open, rod swapped, window moved) - look for it again
			KbBarY := -1
			continue
			}
		if (totF = 0 and !fresh)
			{
			; no purple at all where the bar was seen before - it may have locked onto dark water; look again
			KbBarY := -1
			continue
			}
		if (totF = 0 and !(KbLastFill != "" and KbLastFill < 30))
			{
			; no purple at all and the bar was never seen nearly empty: dark water or a night scene (or a rod with
			; no power bar), not an empty bar - read as 0% it held up every catch checking a recharge
			KbBarY := -1
			return false
			}
		costL := 0
		costR := totF
		best := 0x7FFFFFFF
		bx0 := 0
		bx1 := 0
		x := 0
		while (x <= w)
			{
			cost := costL + costR
			if (cost < best)
				{
				best := cost
				bx0 := x
				bx1 := x
				}
			else if (cost = best)
				bx1 := x
			if (x < w)
				{
				costL += NumGet(fe, x * 8 + 4, "UInt")
				costR -= NumGet(fe, x * 8, "UInt")
				}
			x++
			}
		lo := bx0 * 100.0 / w
		hi := bx1 * 100.0 / w
		pct := (lo + hi) / 2
		if (totF > 0)
			KbLastFill := pct
		return true
		}
	return false
}

; a few frames, median - steadier than one frame
KbAutoReadStable(ByRef pct, n := 3) {
	vals := []
	Loop % n
		{
		if (KbAutoRead(v))
			vals.Push(v)
		if (A_Index < n)
			Sleep, 40
		}
	if (vals.Length() < (n + 1) // 2)
		return false
	pct := MedianOf(vals)
	return true
}

; is the power bar showing where it was last found? 1 = yes (the rod is in hand), 0 = no purple there,
; -1 = not known (never found yet, or the window changed) - one row of pixels, so it is cheap to poll
KbBarShown() {
	global RobloxHwnd, KbBarY, KbBarL, KbBarR, KbBarWW, KbBarWH, KbBarTop, KbBarBot
	if (!RobloxHwnd or KbBarY = "" or KbBarY < 0 or KbBarTop = "")
		return -1
	RobloxClientRect(RobloxHwnd, wx, wy, ww, wh)
	if (ww != KbBarWW or wh != KbBarWH)
		return -1
	w := Round(KbBarR - KbBarL + 1)
	if (w < 20)
		return -1
	pBits := KbGrab(wx + Round(KbBarL), wy + KbBarTop + (KbBarBot - KbBarTop) // 2, w, 1, hdcM, hbm, old)
	if (!pBits)
		return -1
	f := 0
	x := 0
	while (x < w)
		{
		if (KbPixFill(NumGet(pBits + 0, x * 4, "UInt")))
			f++
		x += 2
		}
	KbGrabEnd(hdcM, hbm, old)
	return (f * 2 >= 0.3 * w) ? 1 : 0
}

; is any minigame on screen? (bar, fish line, the minigame frame, Tranquility notes, Stellarwave signs)
; the full check - only used when a recharge is actually about to start
MgOnScreenChk:
gosub, CaptureFishBar
MgOnScreen := (BarPresent() or FishLineVisible())
; after a few postponements in a row only trust the two strongest signals, so a look-alike cannot block recharging
if (!MgOnScreen and KbPostponeN < 3)
	{
	MgOnScreen := MinigameVisible(6)
	if (!MgOnScreen and SpecialRod = "Tranquility")
		MgOnScreen := ManiaVisible()
	if (!MgOnScreen and SpecialRod = "Stellarwave Melody")
		MgOnScreen := (SwPreset = "Ominous Ouija") ? OjSeen() : SwSeen()
	}
return

; reads the power bar while the bobber is out (casting). KbPreState: 0 = no reading or it looked low (the
; restart after the catch reads it the old way and decides), 1 = read and fine - no read needed after the catch
; the power bar read while casting - once per cast (KbPreTried is cleared when a cast starts)
KbPreMaybe:
if (KbPreTried or !KeeperAuto or !KeeperAutoBar or KbBusy)
	return
KbPreTried := true
if (KbPreSkip > 0)
	KbPreSkip := KbPreSkip - 1
else if (KbOcrCatches >= ((Round(KeeperOcrEvery) < 1) ? 1 : Round(KeeperOcrEvery)))
	gosub, KbPreRead
return

KbPreRead:
KbPreOld := KbOcrCatches
KbOcrCatches := 0
KbPreState := 0
KbPreLow := false
KbAutoAt := KeeperAutoPct
if KbAutoAt is not number
	KbAutoAt := 15
KbPreOk := false
Loop 2
	{
	if (KbAutoRead(KbPct))
		{
		KbPreOk := true
		break
		}
	if (A_Index < 2)
		Sleep, 30
	}
if (!KbPreOk)
	{
	; not on screen right now - the restart reads it instead; after 3 misses in a row stop trying here for a while
	KbOcrCatches := KbPreOld
	KbPreFailN := KbPreFailN + 1
	if (KbPreFailN >= 3)
		{
		KbPreFailN := 0
		KbPreSkip := 10
		}
	return
	}
KbPreFailN := 0
if (KbPct < KbAutoAt + 4)
	{
	; the hotbar can be dimmed while the bobber flies, which reads far too low (0% on a full bar) - a low
	; reading here never starts a recharge, the bar is read again after the catch when the UI is steady
	KbOcrCatches := 9999
	KbPreLow := true
	KbOcrLast := "power bar " . Round(KbPct, 1) . "% while casting - checking again after the catch"
	return
	}
KbMissN := 0
KbPreState := 1
KbGoodPct := KbPct
KbSuspect := false
KbOcrLast := "power bar " . Round(KbPct, 1) . "%"
return

; before reading the power bar (every catch): one cheap frame, goes on at once when the bar is gone
KbWaitUiClear:
KbUiClear := false
KbWcT := A_TickCount
Loop
	{
	gosub, CaptureFishBar
	if (SpecialRod = "Tranquility")
		KbWcVis := ManiaVisible()
	else
		KbWcVis := (BarPresent() or FishLineVisible())
	if (!KbWcVis and !MgInPlay)
		{
		KbUiClear := true
		break
		}
	if (A_TickCount - KbWcT >= 600)
		break
	Sleep, 20
	}
return

; right before a recharge: full check, 2 clear frames in a row, at most 1 s - otherwise it is postponed
KbGuardClear:
KbUiClear := false
KbWcT := A_TickCount
KbWcN := 0
Loop
	{
	gosub, MgOnScreenChk
	KbWcN := (MgOnScreen or MgInPlay) ? 0 : KbWcN + 1
	if (KbWcN >= 2)
		{
		KbUiClear := true
		break
		}
	if (A_TickCount - KbWcT >= 1000)
		break
	Sleep, 25
	}
return

KbLineNeed(tot) {
	return 3
}

KbLineCheck(ByRef miss, ByRef tot) {
	global RobloxHwnd, KeeperLineX, KeeperLineY1, KeeperLineY2, KeeperLineColor, KeeperLineTol
	miss := 0
	tot := 0
	col := KeeperLineColor
	if col is not number
		return -1
	if (!RobloxHwnd or col < 0)
		return -1
	y1 := Round(KeeperLineY1)
	y2 := Round(KeeperLineY2)
	if (y2 < y1)
		{
		t := y1
		y1 := y2
		y2 := t
		}
	w := y2 - y1 + 1
	if (w < 3)
		return -1
	tol := KeeperLineTol
	if tol is not number
		tol := 40
	cr := (col >> 16) & 0xFF
	cg := (col >> 8) & 0xFF
	cb := col & 0xFF
	RobloxClientRect(RobloxHwnd, wx, wy)
	hdcS := DllCall("GetDC", "Ptr", 0, "Ptr")
	hdcM := DllCall("CreateCompatibleDC", "Ptr", hdcS, "Ptr")
	VarSetCapacity(bi, 40, 0)
	NumPut(40, bi, 0, "UInt")
	NumPut(1, bi, 4, "Int")
	NumPut(-w, bi, 8, "Int")
	NumPut(1, bi, 12, "UShort")
	NumPut(32, bi, 14, "UShort")
	hbm := DllCall("CreateDIBSection", "Ptr", hdcM, "Ptr", &bi, "UInt", 0, "Ptr*", pBits, "Ptr", 0, "UInt", 0, "Ptr")
	if (!hbm)
		{
		DllCall("DeleteDC", "Ptr", hdcM)
		DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcS)
		return -1
		}
	old := DllCall("SelectObject", "Ptr", hdcM, "Ptr", hbm, "Ptr")
	DllCall(VxBlt, "Ptr", hdcM, "Int", 0, "Int", 0, "Int", 1, "Int", w, "Ptr", hdcS, "Int", wx + Round(KeeperLineX), "Int", wy + y1, "UInt", 0x00CC0020)
	Loop % w
		{
		px := NumGet(pBits + 0, (A_Index - 1) * 4, "UInt")
		b := px & 0xFF
		g := (px >> 8) & 0xFF
		r := (px >> 16) & 0xFF
		if (Abs(r - cr) > tol or Abs(g - cg) > tol or Abs(b - cb) > tol)
			miss++
		}
	DllCall("SelectObject", "Ptr", hdcM, "Ptr", old)
	DllCall("DeleteObject", "Ptr", hbm)
	DllCall("DeleteDC", "Ptr", hdcM)
	DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcS)
	tot := w
	return (miss >= KbLineNeed(w)) ? 1 : 0
}

KbKeyStep(key, ByRef t0) {
	if (!KeyHeld(key))
		{
		t0 := 0
		return false
		}
	if (!t0)
		{
		t0 := A_TickCount
		return true
		}
	return (A_TickCount - t0 >= 300)
}

KbIsEdge(vb, vg, vr, kind) {
    if (kind = "enchant")
        return (vb - vg >= 35 && vr - vg >= 5 && vb > vr && vb >= 90)
    if (kind = "confirm")
        return (vg - vb >= 45 && vg - vr >= 25 && vg >= 110)
    if (kind = "red")
        return (vr - vg >= 60 && vr - vb >= 60 && vr >= 100)
    return false
}
KbRuns(ry, kind, minW, ByRef starts, ByRef ends) {
    global pAqBits, AqW, AqH
    starts := [], ends := []
    if (ry < 0 || ry >= AqH)
        return 0
    inRun := false
    rowBase := ry * AqW * 4
    x := 0
    while (x <= AqW) {
        hit := false
        if (x < AqW) {
            px := NumGet(pAqBits + 0, rowBase + x * 4, "UInt")
            hit := KbIsEdge(px & 0xFF, (px >> 8) & 0xFF, (px >> 16) & 0xFF, kind)
        }
        if (hit && !inRun) {
            inRun := true
            rs := x
        } else if (!hit && inRun) {
            inRun := false
            if (x - rs >= minW)
                starts.Push(rs), ends.Push(x)
        }
        x++
    }
    return starts.Length()
}
KbBoxes(kind, ByRef bL, ByRef bR, ByRef bT, ByRef bB, yFrom := 0, yTo := -1) {
    global pAqBits, AqW, AqH
    bL := [], bR := [], bT := [], bB := []
    if (!pAqBits || AqW < 120 || AqH < 60)
        return 0
    isRed := (kind = "red")
    minW := isRed ? 24 : 45
    kstep := isRed ? 3 : 8
    maxW := Round(AqW * 0.45)
    minH := 16
    maxH := 70

    yStart := yFrom > 0 ? yFrom : 0
    yEnd := (yTo >= 0 && yTo < AqH) ? yTo + 1 : AqH
    ; inline colour test with early exit (a function call per pixel was too slow at 4K)
    cand := []
    y := yStart
    while (y < yEnd) {
        base := y * AqW * 4
        hits := 0
        x := 0
        while (x < AqW) {
            px := NumGet(pAqBits + 0, base + x * 4, "UInt")
            vb := px & 0xFF, vg := (px >> 8) & 0xFF, vr := (px >> 16) & 0xFF
            if (kind = "enchant")
                ok := (vb - vg >= 35 && vr - vg >= 5 && vb > vr && vb >= 90)
            else if (kind = "confirm")
                ok := (vg - vb >= 45 && vg - vr >= 25 && vg >= 110)
            else if isRed
                ok := (vr - vg >= 60 && vr - vb >= 60 && vr >= 100)
            else
                ok := false
            if (ok) {
                hits++
                if (hits >= 5)
                    break
            }
            x += kstep
        }
        if (hits >= 5)
            cand.Push(y)
        y++
    }
    if (cand.Length() < 1)
        return 0

    lines := []
    prev := -1000
    for _, cy in cand {
        if (cy - prev > 2)
            lines.Push(cy)
        prev := cy
    }

    nL := lines.Length()
    Loop % nL {
        ia := A_Index
        ya := lines[ia]
        KbRuns(ya, kind, minW, sa, ea)
        ib := ia + 1
        while (ib <= nL) {
            yb := lines[ib]
            gap := yb - ya
            ib++
            if (gap < minH)
                continue
            if (gap > maxH)
                break
            KbRuns(yb, kind, minW, sb, eb)
            for i, s1 in sa {
                if (ea[i] - s1 > maxW)
                    continue
                for j, s2 in sb {
                    if (Abs(s1 - s2) <= 8 && Abs(ea[i] - eb[j]) <= 8)
                        bL.Push(s1), bR.Push(ea[i]), bT.Push(ya), bB.Push(yb)
                }
            }
        }
    }
    return bL.Length()
}
KbFind(kind, ByRef fx, ByRef fy, want := "", nearX := -1, nearY := -1) {
    global AqX0, AqY0
    fx := -1, fy := -1
    if !AqGrab()
        return false
    if (KbBoxes(kind, kL, kR, kT, kB) < 1)
        return false
    yA := kT[1], yB := kB[1]
    for i, t in kT {
        if (t < yA)
            yA := t
        if (kB[i] > yB)
            yB := kB[i]
    }
    if (KbBoxes("red", rL, rR, rT, rB, yA - 8, yB + 8) < 1)
        return false
    for i, leftK in kL {
        for j, leftR in rL {
            if (Abs(kT[i] - rT[j]) > 5 || Abs(kB[i] - rB[j]) > 5)
                continue
            if (kind = "enchant") {
                if !(leftR > kR[i])
                    continue
            } else if !(rR[j] < leftK) {
                continue
            }
            if (nearX >= 0) {
                cx := AqX0 + (leftK + kR[i]) // 2
                cy := AqY0 + (kT[i] + kB[i]) // 2
                if (Abs(cx - nearX) > 15 || Abs(cy - nearY) > 15)
                    continue
            }
            if (want = "red") {
                fx := AqX0 + (leftR + rR[j]) // 2
                fy := AqY0 + (rT[j] + rB[j]) // 2
            } else {
                fx := AqX0 + (leftK + kR[i]) // 2
                fy := AqY0 + (kT[i] + kB[i]) // 2
            }
            return true
        }
    }
    return false
}
KbFastClose(x, y, col) {
	global KeeperInvKey
	; the confirm box can still be fading out over the button - give the inventory a moment to show again
	; instead of falling back to the slow way (a full screen search per check)
	t0 := A_TickCount
	while (!KbPixNear(x, y, col))
		{
		if (A_TickCount - t0 >= TA("kbfastwait", 400))
			return 0
		Sleep, 10
		}
	SetKeyDelay, 25, 40
	Send, %KeeperInvKey%
	SetKeyDelay, -1, -1
	t0 := A_TickCount
	gone := 0
	while (A_TickCount - t0 < 1200)
		{
		if (!KbPixNear(x, y, col))
			{
			gone++
			if (gone >= 2)
				return 1
			}
		else
			gone := 0
		Sleep, 10
		}
	return 2
}

; the colour at x,y once two reads a moment apart agree (the inventory is still animating otherwise), -1 if not
KbSteadyCol(x, y) {
	PixelGetColor, c1, %x%, %y%, RGB
	if (ErrorLevel)
		return -1
	Loop 4
		{
		Sleep, 40
		PixelGetColor, c2, %x%, %y%, RGB
		if (ErrorLevel)
			return -1
		if (Abs(((c1 >> 16) & 0xFF) - ((c2 >> 16) & 0xFF)) + Abs(((c1 >> 8) & 0xFF) - ((c2 >> 8) & 0xFF)) + Abs((c1 & 0xFF) - (c2 & 0xFF)) <= 12)
			return c2
		c1 := c2
		}
	return -1
}

KbPixNear(x, y, col) {
	PixelGetColor, c, %x%, %y%, RGB
	if (ErrorLevel)
		return false
	d := Abs(((c >> 16) & 0xFF) - ((col >> 16) & 0xFF)) + Abs(((c >> 8) & 0xFF) - ((col >> 8) & 0xFF)) + Abs((c & 0xFF) - (col & 0xFF))
	return (d <= 40)
}

KbWaitFor(kind, ByRef fx, ByRef fy, ms) {
    t0 := A_TickCount
    Loop {
        if KbFind(kind, fx, fy)
            return true
        if (A_TickCount - t0 >= ms)
            return false
        Sleep % Tm(TA("kbpoll", 40))
    }
}
KbKey(k) {
