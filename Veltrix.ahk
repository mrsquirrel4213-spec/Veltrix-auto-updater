		AdvY += 20
		}
	AdvIdx++
	AdvMap[AdvIdx] := e
	AdvUL := StrSplit(e[5], "|")
	AdvLbl := AdvUL[2] . ((e[2] = "V") ? "  *" : "")
	Gui, Font, s9 Norm c%ColorText%, Segoe UI
	Gui, Add, Text, x%CX% y%AdvY% w380 h20 +0x200 HwndhC, %AdvLbl%
