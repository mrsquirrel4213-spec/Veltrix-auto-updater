        pBot := NoiseBandT - 2
        if (pBot - pTop >= 4) {
            pr0 := Floor((pTop + pBot) / 2), pr1 := pTop + 1, pr2 := pBot - 1
            kept := []
            for k, cxv in fX {
                ok := true
                for q, ry in [pr0, pr1, pr2] {
                    px := NumGet(pCaptureBits + ry * stride + 4 * cxv, "UInt")
                    cr := (px >> 16) & 255, cg := (px >> 8) & 255, cb := px & 255
                    if !(cb <= 52 && cr <= 12 && cg >= 40 && cg <= 80 && cg >= cb + 8) {
