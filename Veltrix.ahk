FreezePick:
    if (FreezeActive)
        return
    FreezeActive := true
    FreezePicked := ""
    FrzGrad := []

    ; virtual desktop rectangle
    SysGet, FrzVX, 76
    SysGet, FrzVY, 77
    SysGet, FrzVW, 78
    SysGet, FrzVH, 79
    if (FrzVW < 1)
    {
        FrzVX := 0
        FrzVY := 0
        FrzVW := A_ScreenWidth
        FrzVH := A_ScreenHeight
    }

    Gui, 1:Hide

    ; drop the previous snapshot, if any
    if (hFullMemDC)
        DllCall("DeleteDC", "Ptr", hFullMemDC)
    if (hFullBM)
        DllCall("DeleteObject", "Ptr", hFullBM)
    hFullMemDC := 0
    hFullBM := 0

    ; capture the whole virtual screen into a 32-bit top-down DIB
    hFrzScreenDC := DllCall("GetDC", "Ptr", 0, "Ptr")
    hFullMemDC := DllCall("CreateCompatibleDC", "Ptr", hFrzScreenDC, "Ptr")
    VarSetCapacity(FrzBmi, 40, 0)
    NumPut(40, FrzBmi, 0, "UInt")
    NumPut(FrzVW, FrzBmi, 4, "Int")
    NumPut(-FrzVH, FrzBmi, 8, "Int")
    NumPut(1, FrzBmi, 12, "UShort")
    NumPut(32, FrzBmi, 14, "UShort")
    NumPut(0, FrzBmi, 16, "UInt")
    pFullBits := 0
    hFullBM := DllCall("CreateDIBSection", "Ptr", hFrzScreenDC, "Ptr", &FrzBmi, "UInt", 0, "Ptr*", pFullBits, "Ptr", 0, "UInt", 0, "Ptr")
    DllCall("SelectObject", "Ptr", hFullMemDC, "Ptr", hFullBM)
    DllCall(VxBlt, "Ptr", hFullMemDC, "Int", 0, "Int", 0, "Int", FrzVW, "Int", FrzVH
        , "Ptr", hFrzScreenDC, "Int", FrzVX, "Int", FrzVY, "UInt", 0x00CC0020)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", hFrzScreenDC)

    Gui, Frz:New, -Caption +AlwaysOnTop +ToolWindow +HwndhFrzGui
    Gui, Frz:Color, 000000
    Gui, Frz:Margin, 0, 0
    Gui, Frz:Show, NoActivate x%FrzVX% y%FrzVY% w%FrzVW% h%FrzVH%

    FrzWhat := CMTargetLabel.HasKey(FreezeTarget) ? CMTargetLabel[FreezeTarget] : FreezeTarget
    gosub FrzBuildMenu

    if (RobloxHwnd = "")
        gosub ResolveRoblox

    ; banner goes on the monitor holding the Roblox window (primary by default)
    FrzMonL := 0
    FrzMonT := 0
    FrzMonW := A_ScreenWidth
    FrzMonH := A_ScreenHeight
    if (RobloxHwnd)
    {
        RobloxClientRect(RobloxHwnd, FrzRx, FrzRy, FrzRw, FrzRh)
        FrzRcx := FrzRx + FrzRw // 2
        FrzRcy := FrzRy + FrzRh // 2
        SysGet, FrzMonCount, MonitorCount
        Loop, %FrzMonCount%
        {
            SysGet, FrzMon, Monitor, %A_Index%
            if (FrzRcx >= FrzMonLeft && FrzRcx < FrzMonRight && FrzRcy >= FrzMonTop && FrzRcy < FrzMonBottom)
            {
                FrzMonL := FrzMonLeft
                FrzMonT := FrzMonTop
                FrzMonW := FrzMonRight - FrzMonLeft
                FrzMonH := FrzMonBottom - FrzMonTop
                break
            }
        }
    }

    FrzBW := FrzMonW - 220
    if (FrzBW < 420)
        FrzBW := 420
    if (FrzBW > 1060)
        FrzBW := 1060
    FrzBX := FrzMonL + (FrzMonW - FrzBW) // 2 - FrzVX
    FrzBY := FrzMonT + 54 - FrzVY
    FrzTX := FrzBX + 28
    FrzTW := FrzBW - 56
    FrzR1 := FrzBY + 22
    FrzR2 := FrzBY + 62
    FrzR3 := FrzBY + 92
    FrzR4 := FrzBY + 122

    Gui, Frz:Add, Picture, x0 y0 w%FrzVW% h%FrzVH%, HBITMAP:*%hFullBM%
    Gui, Frz:Add, Progress, x%FrzBX% y%FrzBY% w%FrzBW% h158 Background0A0E16, 0
    FrzExitW := 268
    FrzHintW := FrzTW - 268
    FrzExitX := FrzTX + FrzHintW

    Gui, Frz:Font, s9 bold cFF6B6B
    Gui, Frz:Add, Text, x%FrzTX% y%FrzR1% w%FrzTW% h20 BackgroundTrans, ❄  SCREEN FROZEN
    Gui, Frz:Font, s20 bold cFF4D4D
    Gui, Frz:Add, Text, x%FrzTX% y%FrzR2% w%FrzTW% h34 BackgroundTrans vFrzTitle, % FrzWhat
    Gui, Frz:Font, s10 bold cFFD479
    Gui, Frz:Add, Text, x%FrzTX% y%FrzR3% w%FrzTW% h22 BackgroundTrans vFrzMenuTx, % FrzMenu
    Gui, Frz:Font, s10 norm c9FB4D0
    Gui, Frz:Add, Text, x%FrzTX% y%FrzR4% w%FrzHintW% h24 BackgroundTrans vFrzCount, % (CMGradOn ? "Gradient: click its colors in order  ·  number keys switch" : "Click the color in game  ·  number keys switch")
    Gui, Frz:Font, s10 bold cFF4D4D
    Gui, Frz:Add, Text, x%FrzExitX% y%FrzR4% w%FrzExitW% h24 BackgroundTrans, Right-click or Esc to finish
    Gui, Frz:Show, x%FrzVX% y%FrzVY% w%FrzVW% h%FrzVH%, VeltrixFreeze

    ; magnifier window
    LoupeSrc := 25
    LoupeZoom := 7
    LoupeImgW := LoupeSrc * LoupeZoom
    LoupeW := LoupeImgW + 12
    LoupeH := LoupeImgW + 12 + 28

    Gui, Loupe:New, -Caption +AlwaysOnTop +ToolWindow +E0x8000020 +HwndhLoupeGui
    Gui, Loupe:Color, 0B0E14
    Gui, Loupe:Show, NoActivate x0 y0 w%LoupeW% h%LoupeH%
    hLoupeRgn := DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", LoupeW + 1, "Int", LoupeH + 1, "Int", 12, "Int", 12, "Ptr")
    DllCall("SetWindowRgn", "Ptr", hLoupeGui, "Ptr", hLoupeRgn, "Int", 1)

    hLoupeDC := DllCall("GetDC", "Ptr", hLoupeGui, "Ptr")
    hLoupeMem := DllCall("CreateCompatibleDC", "Ptr", hLoupeDC, "Ptr")
    hLoupeBM := DllCall("CreateCompatibleBitmap", "Ptr", hLoupeDC, "Int", LoupeW, "Int", LoupeH, "Ptr")
    hLoupeOldBM := DllCall("SelectObject", "Ptr", hLoupeMem, "Ptr", hLoupeBM, "Ptr")
    DllCall("ReleaseDC", "Ptr", hLoupeGui, "Ptr", hLoupeDC)
    hLoupeFont := DllCall("CreateFont", "Int", -14, "Int", 0, "Int", 0, "Int", 0, "Int", 700
        , "UInt", 0, "UInt", 0, "UInt", 0, "UInt", 1, "UInt", 0, "UInt", 0, "UInt", 0, "UInt", 0
        , "Str", "Consolas", "Ptr")

    CoordMode, Mouse, Screen
    FrzCancelled := false
    FrzAdded := 0
    FrzForceZ := true

    Loop
    {
        if (KeyHeld("Escape") || KeyHeld("RButton"))
        {
            FrzCancelled := (FrzAdded = 0)
            while KeyHeld("RButton")
                Sleep, % Tm(5)
            break
        }

        ; number keys 1-9 jump to another colour of the set
        FrzSwitch := 0
        Loop % CMTargetKeys.Length()
        {
            if (A_Index <= 9 && KeyHeld(A_Index))
            {
                FrzSwitch := A_Index
                break
            }
        }
        if (FrzSwitch)
        {
            while KeyHeld(FrzSwitch)
                Sleep, % Tm(5)
            FreezeTarget := CMTargetKeys[FrzSwitch]
            CMSel := FreezeTarget
            FrzWhat := CMTargetLabel[FreezeTarget]
            FrzAdded := 0
            gosub FrzBuildMenu
            GuiControl, Frz:, FrzTitle, % FrzWhat
            GuiControl, Frz:, FrzMenuTx, % FrzMenu
            GuiControl, Frz:, FrzCount, % FrzWhat . " already has " . ColCount(%FreezeTarget%) . "  ·  click to add more"
            FrzForceZ := true
        }

        MouseGetPos, FrzMx, FrzMy
        FreezePaintLoupe(FrzMx, FrzMy, FrzForceZ)
        FrzForceZ := false

        if (KeyHeld("LButton"))
        {
            while KeyHeld("LButton")
                Sleep, % Tm(5)
            FrzForceZ := true
            FrzHex := FreezePixelAt(FrzMx, FrzMy)
            if (FrzHex != "" && FreezeTarget != "" && CMGradOn && FreezeMode = "add")
            {
                ; a gradient: each pick is its next colour, saved as one when the picker closes
                FrzGrad.Push(FrzHex)
                FreezePicked := FrzHex
                GuiControl, Frz:, FrzCount, % "gradient: " . FrzGrad.Length() . " colors   last " . FrzHex . "   - pick the next, or right-click / Esc to save it"
            }
            else if (FrzHex != "" && FreezeTarget != "")
            {
                FrzBefore := ColCount(%FreezeTarget%)
                if (FreezeMode = "add")
                    CMStore(FreezeTarget, ColListAdd(%FreezeTarget%, FrzHex))
                else
                    CMStore(FreezeTarget, FrzHex)
                FrzAfter := ColCount(%FreezeTarget%)
                FreezePicked := FrzHex
                if (FrzAfter > FrzBefore)
                {
                    FrzAdded += 1
                    GuiControl, Frz:, FrzCount, % "added " . FrzAdded . "   (" . FrzAfter . " on this color)   last " . FrzHex
                }
                else
                    GuiControl, Frz:, FrzCount, % "added " . FrzAdded . "   " . FrzHex . " was already in the list"
            }
        }

        Sleep, % Tm(12)
    }

    CoordMode, Mouse, Client

    ; the gradient picked, its colours in the order picked (a single colour goes in as a plain colour)
    if (IsObject(FrzGrad) && FrzGrad.Length() && FreezeTarget != "")
    {
        FrzG := ""
        for FrzI, FrzC in FrzGrad
            FrzG .= ((FrzG = "") ? "" : "-") . FrzC
        CMStore(FreezeTarget, ColListAdd(%FreezeTarget%, FrzG))
    }
    FrzGrad := []

    Gui, Loupe:Destroy
    Gui, Frz:Destroy
    hFrzGui := 0
    Gui, 1:Default
    Gui, 1:Show

    ; release the magnifier GDI objects (snapshot is kept until the next pick)
    if (hLoupeMem)
    {
        DllCall("SelectObject", "Ptr", hLoupeMem, "Ptr", hLoupeOldBM)
        DllCall("DeleteDC", "Ptr", hLoupeMem)
    }
    if (hLoupeBM)
        DllCall("DeleteObject", "Ptr", hLoupeBM)
    if (hLoupeFont)
        DllCall("DeleteObject", "Ptr", hLoupeFont)
    hLoupeMem := 0
    hLoupeBM := 0
    hLoupeFont := 0

    FreezeActive := false
    TargetSection := "Minigame"
    MiniTab := "Setup"
    gosub ShowSection
return
FrzBuildMenu:
