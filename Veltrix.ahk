            tcL := -1, tcW := 0
            if (BarByTrackContrast(row, tcL, tcW) && tcW >= 1.3 * (r - l + 1) && tcW <= 0.75 * W
                && tcL <= l + 10 && (tcL + tcW - 1) >= r - 10) {
                l := tcL
                r := tcL + tcW - 1
                tcUsed := true
            }
        }
    }

    if (l < 0 || r < 0 || r <= l || (r - l + 1) > 0.75 * W) {
        LastBarL := -1, LastBarR := -1
        BarLiveMiss += 1
        if (BarLiveMiss > 12) {
            BarLiveL := -1, BarLiveR := -1
            BarWLive := -1
            BarLiveOnlyAt := 0
        }
        return false
    }
    LastBarL := l, LastBarR := r
    if (tcUsed)
        LastBarL := -1, LastBarR := -1
    RunLeft := l
    RunWidth := r - l + 1
    if (!tcUsed) {
        if (!IsObject(BarColRing))
            BarColRing := []
        BarColRing.Push(RunWidth)
        if (BarColRing.Length() > 5)
            BarColRing.RemoveAt(1)
