NfLoadBlob(hex) {
    if (A_PtrSize != 8)
        return 0
    size := StrLen(hex) // 2
    mem := DllCall("kernel32\VirtualAlloc", "Ptr", 0, "UPtr", size, "UInt", 0x3000, "UInt", 0x04, "Ptr")
    if (!mem)
        return 0
    Loop % size
        NumPut("0x" SubStr(hex, 2 * A_Index - 1, 2), mem + 0, A_Index - 1, "UChar")
    oldProt := 0
    if !DllCall("kernel32\VirtualProtect", "Ptr", mem, "UPtr", size, "UInt", 0x20, "UInt*", oldProt) {
        DllCall("kernel32\VirtualFree", "Ptr", mem, "UPtr", 0, "UInt", 0x8000)
        return 0
    }
    return mem
}
NfNativeInit() {
    global NfNativeReady, pNfDiffRow, pNfIconHist, VxNatND, VxNatNI, NatOff
    if (NfNativeReady)
        return
    NfNativeReady := true
    pNfDiffRow := 0
    pNfIconHist := 0
    ; the two routines are in VeltrixNative (vx_nf_diffrow, vx_nf_iconhist)
    p1 := NatOff ? 0 : VxNatND
    p2 := NatOff ? 0 : VxNatNI

    ; --- diff-row self test ---
    VarSetCapacity(cur, 40 * 8, 0)
    VarSetCapacity(ref, 40 * 8, 0)
    Loop 40 {
        v := Mod(7 * A_Index, 200)
        off := (A_Index - 1) * 8
        NumPut(v, cur, off, "UChar"), NumPut(v + 3, cur, off + 1, "UChar"), NumPut(v + 1, cur, off + 2, "UChar")
        first := (A_Index >= 11 && A_Index <= 20) ? Mod(v + 90, 256) : v
        NumPut(first, ref, off, "UChar"), NumPut(v + 3, ref, off + 1, "UChar"), NumPut(v + 1, ref, off + 2, "UChar")
    }
    VarSetCapacity(prm, 24, 0)
    VarSetCapacity(o1, 24, 0)
    VarSetCapacity(o2, 24, 0)
    NumPut(36, prm, 0, "Int")
    NumPut(8, prm, 4, "Int")
    NumPut(&o1, prm, 16, "Ptr")
    rvN := p1 ? DllCall(p1, "Ptr", &cur, "Ptr", &ref, "Int", 40, "Ptr", &prm, "Int") : -9
    NumPut(&o2, prm, 16, "Ptr")
    rvA := NfDiffRowAhk(&cur, &ref, 40, &prm)
    ok1 := (p1 && rvN = rvA && rvA = 1)
    Loop 5 {
        if (NumGet(o1, (A_Index - 1) * 4, "Int") != NumGet(o2, (A_Index - 1) * 4, "Int"))
            ok1 := false
    }
    if (ok1)
        pNfDiffRow := p1

    ; --- icon-histogram self test ---
    VarSetCapacity(img, 30 * 12 * 4, 0)
    Loop % 30 * 12 {
        k := A_Index - 1
        px := Mod(k, 30), py := k // 30
        lvl := ((px >= 8 && px <= 18 && py >= 3 && py <= 9) || (px = 24 && py >= 2)) ? 230 : 40
        NumPut(lvl | (lvl << 8) | (lvl << 16), img, k * 4, "UInt")
    }
    VarSetCapacity(h1, 30 * 6 * 4, 0)
    VarSetCapacity(h2, 30 * 6 * 4, 0)
    VarSetCapacity(prm2, 24, 0)
    NumPut(200, prm2, 0, "Int")
    NumPut(5, prm2, 4, "Int")
    NumPut(3, prm2, 8, "Int")
    NumPut(3, prm2, 12, "Int")
    NumPut(&h1, prm2, 16, "Ptr")
    if (p2)
        DllCall(p2, "Ptr", &img, "Int", 30, "Int", 12, "Ptr", &prm2)
    NumPut(&h2, prm2, 16, "Ptr")
    NfIconHistAhk(&img, 30, 12, &prm2)
    ok2 := (p2 && NumGet(h2, 12 * 4, "Int") = 3 && NumGet(h2, (3 * 30 + 12) * 4, "Int") = 3
        && NumGet(h2, (3 * 30 + 24) * 4, "Int") = 0)
    Loop 180 {
        if (NumGet(h1, (A_Index - 1) * 4, "Int") != NumGet(h2, (A_Index - 1) * 4, "Int"))
            ok2 := false
    }
    if (ok2)
        pNfIconHist := p2
}
NfDiffRowAhk(pCur, pRef, n, pPrm) {
    T := NumGet(pPrm + 0, 0, "Int")
    step := NumGet(pPrm + 0, 4, "Int")
    pOut := NumGet(pPrm + 0, 16, "Ptr")
    sr := 0, first := -1, last := -1
    Loop % n {
        i := A_Index - 1
        oc := pCur + i * step, orf := pRef + i * step
        d := Abs(NumGet(oc + 0, 0, "UChar") - NumGet(orf + 0, 0, "UChar"))
           + Abs(NumGet(oc + 0, 1, "UChar") - NumGet(orf + 0, 1, "UChar"))
           + Abs(NumGet(oc + 0, 2, "UChar") - NumGet(orf + 0, 2, "UChar"))
        sr := ((sr * 2) & 15) | (d > T ? 1 : 0)
        bits := (sr & 1) + ((sr >> 1) & 1) + ((sr >> 2) & 1) + ((sr >> 3) & 1)
        if (bits >= 3) {
            if (first < 0)
                first := (i - 3 > 0) ? i - 3 : 0
            last := i
        }
    }
    if (first < 0)
        return 0
    tint := 0, sl := 0, slr := 0
    j := first
    while (j <= last) {
        oc := pCur + j * step, orf := pRef + j * step
        cb := NumGet(oc + 0, 0, "UChar"), cg := NumGet(oc + 0, 1, "UChar"), cr := NumGet(oc + 0, 2, "UChar")
        tint += cg - (cb > cr ? cb : cr)
        sl += cb + cg + cr
        slr += NumGet(orf + 0, 0, "UChar") + NumGet(orf + 0, 1, "UChar") + NumGet(orf + 0, 2, "UChar")
        j++
    }
    NumPut(first, pOut + 0, 0, "Int")
    NumPut(last, pOut + 0, 4, "Int")
    NumPut(tint, pOut + 0, 8, "Int")
    NumPut(sl, pOut + 0, 12, "Int")
    NumPut(slr, pOut + 0, 16, "Int")
    return 1
}
NfIconHistAhk(pBits, w, h, pPrm) {
    thr := NumGet(pPrm + 0, 0, "Int")
    minrun := NumGet(pPrm + 0, 4, "Int")
    y0 := NumGet(pPrm + 0, 8, "Int")
    rpb := NumGet(pPrm + 0, 12, "Int")
    pOut := NumGet(pPrm + 0, 16, "Ptr")
    Loop 3 {
        band := A_Index - 1
        rawRow := pOut + band * w * 4
        solRow := pOut + (3 + band) * w * 4
        Loop % rpb {
            y := y0 + band * rpb + (A_Index - 1)
            rowPtr := pBits + y * w * 4
            runAt := -1
            Loop % w {
                x := A_Index - 1
                px := NumGet(rowPtr + 0, x * 4, "UInt")
                white := ((px & 0xFF) >= thr && ((px >> 8) & 0xFF) >= thr && ((px >> 16) & 0xFF) >= thr)
                if (white) {
                    NumPut(NumGet(rawRow + 0, x * 4, "Int") + 1, rawRow + 0, x * 4, "Int")
                    if (runAt < 0)
                        runAt := x
                } else if (runAt >= 0) {
                    if (x - runAt >= minrun) {
                        k := runAt
                        while (k < x) {
                            NumPut(NumGet(solRow + 0, k * 4, "Int") + 1, solRow + 0, k * 4, "Int")
                            k++
                        }
                    }
                    runAt := -1
                }
            }
            if (runAt >= 0 && w - runAt >= minrun) {
                k := runAt
                while (k < w) {
                    NumPut(NumGet(solRow + 0, k * 4, "Int") + 1, solRow + 0, k * 4, "Int")
                    k++
                }
            }
        }
    }
}
NoiseWarnKind() {
    global pNoteBits, NoteW, NoteH, FishBarLeft, NoteTop, WindowWidth, WindowHeight, QpcFreq
    global NfNativeReady, NfKS, NfRing, NfRingT, NfRingN, NfRingIdx, NfRowBytes, NfLatchKind, NfLatchT
    global NoiseWNow, NfWhy
    NoiseWNow := ""
    if (!pNoteBits || NoteH < 80 || NoteW < 100)
        return ""
    if (!NfNativeReady)
        NfNativeInit()
    if (!IsObject(NfKS))
        NfKS := [-0.9, -0.8, -0.6, -0.4, -0.2, 0, 0.2, 0.4, 0.6, 0.8, 0.9]

    ; icon centre and radius, note-relative
    rad := 0.139 * WindowHeight
    icx := 0.5 * WindowWidth - FishBarLeft
    icy := 0.52 * WindowHeight - NoteTop
    colA := Round(icx - 1.7 * rad)
    if (colA < 0)
        colA := 0
    colB := Round(icx + 1.7 * rad)
    if (colB > NoteW - 1)
        colB := NoteW - 1
    cnt := Floor((colB - colA) / 2)
    if (cnt < 60)
        return ""

    bytesPerRow := 8 * cnt
    if (bytesPerRow != NfRowBytes || !IsObject(NfRingT)) {
        VarSetCapacity(NfRing, 32 * 11 * bytesPerRow, 0)
        NfRowBytes := bytesPerRow
        NfRingT := []
        NfRingN := 0
        NfRingIdx := 0
        NfLatchKind := ""
        NfLatchT := 0
    }

    tNow := NfNow()
    slot := NfRingIdx
    if (NfRingN > 0) {
        prevSlot := Mod(slot + 31, 32)
        if ((tNow - NfRingT[prevSlot]) / QpcFreq < 0.040)
            slot := prevSlot
    }

    ; copy the 11 sample rows into the ring slot
    Loop 11 {
        ry := Round(icy + rad * NfKS[A_Index])
        if (ry < 0)
            ry := 0
        else if (ry > NoteH - 1)
            ry := NoteH - 1
        DllCall("RtlMoveMemory", "Ptr", &NfRing + (slot * 11 + A_Index - 1) * bytesPerRow
            , "Ptr", pNoteBits + (ry * NoteW + colA) * 4, "Ptr", bytesPerRow)
    }
    if (slot = NfRingIdx) {
        NfRingT[slot] := tNow
        NfRingIdx := Mod(slot + 1, 32)
        if (NfRingN < 32)
            NfRingN += 1
    }

    strong := false, weak := false
    kind := NfSingle(strong, weak)
    if (kind != "") {
        NfWhy := "single " kind
    } else {
        for _, lo in [0.12, 0.80] {
            refSlot := -1
            Loop % NfRingN - 1 {
                s := Mod(slot - A_Index + 64, 32)
                age := (tNow - NfRingT[s]) / QpcFreq
                if (age >= lo && age <= lo + 0.45) {
                    refSlot := s
                    break
                }
            }
            if (refSlot < 0)
                continue
            kind := NfClassify(slot, refSlot, cnt, rad, icx - colA, strong)
            if (kind != "")
                break
        }
    }
    if (kind = "")
        return ""

    if (weak) {
        if (NfLatchKind = kind && (tNow - NfLatchT) / QpcFreq <= 0.4) {
            NfLatchT := tNow
            NoiseWNow := kind
            return kind
        }
        return ""
    }
    latched := strong || (NfLatchKind = kind && (tNow - NfLatchT) / QpcFreq <= 0.4)
    NfLatchKind := kind
    NfLatchT := tNow
    if (!latched)
        return ""
    NoiseWNow := kind
    return kind
}
NfClassify(slot, ref, n, R, cxs, ByRef strong) {
    global NfRing, NfRowBytes, NfKS, pNfDiffRow, NfPrm, NfOut, NfWhy, NfPrmBuf, NfOutBuf
    strong := false
    if (!NfPrm) {
        VarSetCapacity(NfPrmBuf, 24, 0)
        VarSetCapacity(NfOutBuf, 24, 0)
        NfPrm := &NfPrmBuf
        NfOut := &NfOutBuf
        NumPut(36, NfPrm + 0, 0, "Int")
        NumPut(8, NfPrm + 0, 4, "Int")
        NumPut(NfOut, NfPrm + 0, 16, "Ptr")
    }

    ; band limits in index units (one index = 2 pixels)
    mA := Round((cxs - 1.2 * R) / 2)
    mB := Round((cxs + 1.2 * R) / 2)
    lA := 0
    lB := Round((cxs - 1.25 * R) / 2)
    rA := Round((cxs + 1.25 * R) / 2)
    rB := n - 1
    if (mA < 0)
        mA := 0
    if (mB > n - 1)
        mB := n - 1
    if (lB < 4 || rB - rA < 4 || mB - mA < 20)
        return ""

    sides := [[lA, lB], [rA, rB]]
    ringP := &NfRing
    rb := NfRowBytes
    w := [], fl := [], fr := []
    gchg := 0, tint := 0, sl := 0, slr := 0, cnt := 0

    Loop 11 {
        k := A_Index - 1
        pc := ringP + (slot * 11 + k) * rb
        pr := ringP + (ref * 11 + k) * rb
        for _, bd in sides {
            len := bd[2] - bd[1] + 1
            if (pNfDiffRow)
                got := DllCall(pNfDiffRow, "Ptr", pc + bd[1] * 8, "Ptr", pr + bd[1] * 8, "Int", len, "Ptr", NfPrm, "Int")
            else
                got := NfDiffRowAhk(pc + bd[1] * 8, pr + bd[1] * 8, len, NfPrm)
            if (got) {
                ra := NumGet(NfOut + 0, 0, "Int"), rbE := NumGet(NfOut + 0, 4, "Int")
                if (rbE - ra >= 4) {
                    gchg += 1
                    break
                }
            }
        }
        len := mB - mA + 1
        if (pNfDiffRow)
            got := DllCall(pNfDiffRow, "Ptr", pc + mA * 8, "Ptr", pr + mA * 8, "Int", len, "Ptr", NfPrm, "Int")
        else
            got := NfDiffRowAhk(pc + mA * 8, pr + mA * 8, len, NfPrm)
        if (got) {
            ra := mA + NumGet(NfOut + 0, 0, "Int")
            rbE := mA + NumGet(NfOut + 0, 4, "Int")
            w[k + 1] := 2 * (rbE - ra) / R
            fl[k + 1] := ra
            fr[k + 1] := rbE
            tint += NumGet(NfOut + 0, 8, "Int")
            sl += NumGet(NfOut + 0, 12, "Int")
            slr += NumGet(NfOut + 0, 16, "Int")
            cnt += rbE - ra + 1
        } else {
            w[k + 1] := 0
            fl[k + 1] := -1
            fr[k + 1] := -1
        }
    }
    if (cnt < 1)
        return ""

    dl := (sl - slr) / (3 * cnt)
    if (gchg >= 5) {
        ; broad change across many rows: only a dark triangle profile may pass
        if (dl > -6)
            return ""
        tok := 0, bok := 0
        Loop 3
            if (w[A_Index] <= 1.5)
                tok += 1
        Loop 3 {
            v := w[A_Index + 8]
            if (v >= 1.9 && v <= 2.3)
                bok += 1
        }
        if (tok < 2 || bok < 2)
            return ""
    }

    shape := NfShape(w)
    gm := tint / cnt
    if (shape = "" && gm >= 40) {
        mid := 0
        Loop 5 {
            v := w[A_Index + 3]
            if (v >= 1.5 && v <= 2.4)
                mid += 1
        }
        if (mid >= 3)
            shape := "CIR"
    }
    if (shape = "")
        return ""

    kind := ""
    if (shape = "CIR" && gm >= 25) {
        kind := "GREEN", strong := (gm >= 45)
    } else if (shape = "SQ" && dl >= 10) {
        kind := "WHITE", strong := (dl >= 20)
    } else if (shape = "TRI" && dl <= -6) {
        kind := "BLACK", strong := (dl <= -15)
    }
    if (kind = "")
        return ""

    if (gchg >= 5) {
        if (kind != "BLACK") {
            strong := false
            return ""
        }
        gext := 0
        Loop 11 {
            k := A_Index - 1
            pc := ringP + (slot * 11 + k) * rb
            pr := ringP + (ref * 11 + k) * rb
            for _, bd in sides {
                len := bd[2] - bd[1] + 1
                if (pNfDiffRow)
                    got := DllCall(pNfDiffRow, "Ptr", pc + bd[1] * 8, "Ptr", pr + bd[1] * 8, "Int", len, "Ptr", NfPrm, "Int")
                else
                    got := NfDiffRowAhk(pc + bd[1] * 8, pr + bd[1] * 8, len, NfPrm)
                if (got) {
                    ra := NumGet(NfOut + 0, 0, "Int"), rbE := NumGet(NfOut + 0, 4, "Int")
                    if ((rbE - ra + 1) * 2 >= len) {
                        gext += 1
                        break
                    }
                }
            }
        }
        if (gext >= 5) {
            strong := false
            return ""
        }
    }

    if (kind = "BLACK") {
        ; the triangle body must have darkened against the reference frame
        tot := 0, dk := 0
        for idx, yv in [-0.2, 0.0, 0.2, 0.4, 0.6] {
            k := idx + 3
            pc := ringP + (slot * 11 + k) * rb
            pr := ringP + (ref * 11 + k) * rb
            hw := 0.40 + 0.6 * yv
            for _, sg in [-1, 1] {
                ja := Round((cxs + sg * 0.2 * R) / 2)
                jb := Round((cxs + sg * hw * R) / 2)
                j := Min(ja, jb), jEnd := Max(ja, jb)
                while (j <= jEnd) {
                    vc := NumGet(pc + j * 8, "UInt")
                    vr := NumGet(pr + j * 8, "UInt")
                    sc := (vc & 0xFF) + ((vc >> 8) & 0xFF) + ((vc >> 16) & 0xFF)
                    sr := (vr & 0xFF) + ((vr >> 8) & 0xFF) + ((vr >> 16) & 0xFF)
                    tot += 1
                    if (sr - sc >= 36 && 5 * sc <= 4 * sr)
                        dk += 1
                    j += 2
                }
            }
        }
        if (tot < 1 || dk * 10 < tot * 6) {
            strong := false
            return ""
        }
    }

    ; colour check across each changed run
    okr := 0
    Loop 11 {
        ra := fl[A_Index], rbE := fr[A_Index]
        if (ra < 0 || rbE - ra < 4)
            continue
        pc := ringP + (slot * 11 + A_Index - 1) * rb
        firstHit := -1, lastHit := -1
        j := ra
        while (j <= rbE) {
            v := NumGet(pc + j * 8, "UInt")
            cb := v & 0xFF, cg := (v >> 8) & 0xFF, cr := (v >> 16) & 0xFF
            hi := Max(cb, cg, cr), lo := Min(cb, cg, cr)
            if (kind = "BLACK")
                hit := (hi <= 95)
            else if (kind = "WHITE")
                hit := (lo >= 200 && hi - lo <= 40)
            else
                hit := (cg >= 150 && cg - Max(cb, cr) >= 50)
            if (hit) {
                if (firstHit < 0)
                    firstHit := j
                lastHit := j
            }
            j += 1
        }
        span := rbE - ra
        if (firstHit >= 0 && firstHit - ra <= 0.35 * span && rbE - lastHit <= 0.35 * span)
            okr += 1
    }
    if (okr < 5) {
        strong := false
        return ""
    }
    NfWhy := shape " g" Round(gm) " dL" Round(dl)
    return kind
}
NfShape(w) {
    global NfKS
    sq := 0
    Loop 11 {
        v := w[A_Index]
        if (v >= 1.9 && v <= 2.3)
            sq += 1
    }
    if (sq >= 9)
        return "SQ"

    cen := [w[4], w[5], w[6], w[7], w[8]]
    cok := 0
    for _, v in cen
        if (v >= 1.75 && v <= 2.3)
            cok += 1
    cmed := NfMedian(cen)
    tnar := (w[1] >= 0.7 && w[1] <= 1.85 && w[2] >= 0.7 && w[2] <= 1.85)
        && (cmed - (w[1] + w[2]) / 2 >= 0.3)
    bnar := (w[10] >= 0.7 && w[10] <= 1.85 && w[11] >= 0.7 && w[11] <= 1.85)
        && (cmed - (w[10] + w[11]) / 2 >= 0.3)
    if (cok >= 3 && (tnar || bnar))
        return "CIR"

    tok := 0, bok := 0
    Loop 3 {
        if (w[A_Index] <= 1.5)
            tok += 1
        v := w[A_Index + 8]
        if (v >= 1.9 && v <= 2.3)
            bok += 1
    }
    upm := NfMedian([w[4], w[5]])
    dnm := NfMedian([w[7], w[8]])
    topm := NfMedian([w[1], w[2], w[3]])
    botm := NfMedian([w[9], w[10], w[11]])
    if (tok >= 2 && bok >= 2 && dnm - upm >= 0.15 && botm - topm >= 0.6)
        return "TRI"
    return ""
}
NfMedian(arr) {
    a := []
    for _, v in arr
        a.Push(v)
    cnt := a.Length()
    Loop % cnt {
        i := A_Index
        j := i + 1
        while (j <= cnt) {
            if (a[j] < a[i]) {
                t := a[i], a[i] := a[j], a[j] := t
            }
            j += 1
        }
    }
    if (Mod(cnt, 2) = 1)
        return a[(cnt + 1) // 2]
    return (a[cnt // 2] + a[cnt // 2 + 1]) / 2
}
NfSingle(ByRef strong, ByRef weak) {
    global pNoteBits, NoteW, NoteH, FishBarLeft, NoteTop, WindowWidth, WindowHeight, NfSP, NfSPR
    strong := false, weak := false
    if (!pNoteBits || NoteH < 80 || NoteW < 100)
        return ""
    R := 0.139 * WindowHeight
    cx := 0.5 * WindowWidth - FishBarLeft
    cy := 0.52 * WindowHeight - NoteTop
    if (!IsObject(NfSP) || NfSPR != R)
        NfBuildPts(R)

    ; green circle: filled disc, no green just outside it
    gn := 0
    for _, p in NfSP.disc
        if NfIsGreen(cx + p[1], cy + p[2])
            gn += 1
    gi := gn / NfSP.disc.Length()
    if (gi >= 0.7) {
        ge := 0
        for _, p in NfSP.edge
            if NfIsGreen(cx + p[1], cy + p[2])
                ge += 1
        if (ge <= 1) {
            strong := (gi >= 0.85)
            return "GREEN"
        }
    }

    ; white square: bright inside, darker ring outside
    li := 0, wi := 0
    for _, p in NfSP.sq {
        v := NfPx(cx + p[1], cy + p[2])
        cb := v & 0xFF, cg := (v >> 8) & 0xFF, cr := (v >> 16) & 0xFF
        l := (cb + cg + cr) / 3
        li += l
        if (l >= 130 && Max(cb, cg, cr) - Min(cb, cg, cr) <= 50)
            wi += 1
    }
    nS := NfSP.sq.Length()
    li := li / nS
    if (wi / nS >= 0.85) {
        lo := 0, wo := 0
        for _, p in NfSP.sqo {
            v := NfPx(cx + p[1], cy + p[2])
            cb := v & 0xFF, cg := (v >> 8) & 0xFF, cr := (v >> 16) & 0xFF
            l := (cb + cg + cr) / 3
            lo += l
            if (l >= 130 && Max(cb, cg, cr) - Min(cb, cg, cr) <= 50)
                wo += 1
        }
        nO := NfSP.sqo.Length()
        lo := lo / nO
        if (li - lo >= 40 && wo / nO <= 0.5) {
            gc := 0, gs := 0
            for _, yv in [-0.40, -0.30, -0.20] {
                gc += NfLum(cx, cy + yv * R)
                gs += NfLum(cx - 0.25 * R, cy + yv * R) + NfLum(cx + 0.25 * R, cy + yv * R)
            }
            if (gs / 6 - gc / 3 >= 12)
                strong := (li - lo >= 80)
            else
                weak := true
            return "WHITE"
        }
    }

    ; black triangle: dark body against a lighter surround
    m := 0, ki := 0
    for _, p in NfSP.tri {
        l := NfLum(cx + p[1], cy + p[2])
        m += l
        if (l <= 110)
            ki += 1
    }
    nT := NfSP.tri.Length()
    m := m / nT
    if (ki / nT >= 0.85) {
        tout := 0
        for _, p in NfSP.tout
            tout += NfLum(cx + p[1], cy + p[2])
        tout := tout / NfSP.tout.Length()
        sadd := 0.5 * m
        if (sadd < 20)
            sadd := 20
        else if (sadd > 40)
            sadd := 40
        if ((tout >= 50 && m <= 0.70 * tout) || (tout >= 15 && m <= 0.50 * tout)) {
            side := 0, corn := 0
            for _, p in NfSP.side
                if (NfLum(cx + p[1], cy + p[2]) >= m + sadd)
                    side += 1
            for _, p in NfSP.corn
                if (NfLum(cx + p[1], cy + p[2]) <= 110)
                    corn += 1
            if (side >= 4 && corn >= 3) {
                gl := 0
                for _, p in NfSP.glyph
                    if (NfLum(cx + p[1], cy + p[2]) >= m + 30)
                        gl += 1
                if (gl >= 4) {
                    strong := (m <= 0.55 * tout) || (side >= 5 && m <= 0.70 * tout)
                    return "BLACK"
                }
            }
        }
    }
    return ""
}
NfPx(x, y) {
    global pNoteBits, NoteW, NoteH
    px := Round(x), py := Round(y)
    if (px < 0)
        px := 0
    else if (px > NoteW - 1)
        px := NoteW - 1
    if (py < 0)
        py := 0
    else if (py > NoteH - 1)
        py := NoteH - 1
    return NumGet(pNoteBits + (py * NoteW + px) * 4, "UInt")
}
NfLum(x, y) {
	v := NfPx(x, y)
	return ((v & 0xFF) + ((v >> 8) & 0xFF) + ((v >> 16) & 0xFF)) / 3
}

NfIsGreen(x, y) {
	c := NfPx(x, y)
	bl := c & 0xFF
	gr := (c >> 8) & 0xFF
	rd := (c >> 16) & 0xFF
	return (gr >= 110 && gr - rd >= 60 && gr - bl >= 15) ? 1 : 0
}

NfBuildPts(R) {
    global NfSP, NfSPR
    disc := [], edge := [], sq := [], sqo := [], tri := []
    side := [], corn := [], tout := [], glyph := []

    Loop 9 {
        xx := (A_Index - 5) * 0.2
        Loop 9 {
            yy := (A_Index - 5) * 0.2
            if (xx * xx + yy * yy <= 0.7225 + 1e-9 && Abs(xx) > 0.12)
                disc.Push([xx * R, yy * R])
        }
    }
    pi := 3.141592653589793
    Loop 8 {
        ang := (A_Index - 1) * pi / 4
        edge.Push([1.12 * R * Cos(ang), 1.12 * R * Sin(ang)])
    }
    Loop 7 {
        xx := (A_Index - 4) * 0.25
        if (Abs(xx) <= 0.15)
            continue
        Loop 7 {
            yy := (A_Index - 4) * 0.25
            sq.Push([xx * R, yy * R])
        }
    }
    Loop 7 {
        v := (A_Index - 4) * 0.3
        sqo.Push([-1.25 * R, v * R])
        sqo.Push([1.25 * R, v * R])
        sqo.Push([v * R, -1.25 * R])
        sqo.Push([v * R, 1.25 * R])
    }
    Loop 7 {
        yy := -0.5 + (A_Index - 1) * 0.2
        hw := Max(0.65 + 0.5 * yy, 0.05)
        Loop 11 {
            xx := (A_Index - 6) * 0.2
            if (Abs(xx) <= hw - 0.2 + 1e-9 && Abs(xx) > 0.15)
                tri.Push([xx * R, yy * R])
        }
    }
    for _, yv in [-0.6, -0.35, -0.1] {
        hw := 0.65 + 0.5 * yv
        side.Push([-(hw + 0.25) * R, yv * R])
        side.Push([(hw + 0.25) * R, yv * R])
    }
    for _, p in [[-0.65, 0.55], [0.65, 0.55], [-0.45, 0.70], [0.45, 0.70]]
        corn.Push([p[1] * R, p[2] * R])
    for _, p in [[0, -0.40], [0, -0.25], [0, -0.10], [0, 0.05], [0, 0.20], [0, 0.50]
            , [-0.05, -0.20], [0.05, -0.20], [-0.05, 0.10], [0.05, 0.10]]
        glyph.Push([p[1] * R, p[2] * R])
    for _, p in [[-0.8, -0.85], [0.8, -0.85], [-1.1, -0.5], [1.1, -0.5]
            , [-1.25, 0], [1.25, 0], [-0.45, -1.05], [0.45, -1.05]]
        tout.Push([p[1] * R, p[2] * R])

    NfSPR := R
    NfSP := {disc: disc, edge: edge, sq: sq, sqo: sqo, tri: tri, side: side, corn: corn, tout: tout, glyph: glyph}
}
NoiseZoneIcons() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, WindowHeight, WindowWidth, NfNativeReady
    global NfHistW, NfHist, NfHPrm, NfHistBuf, NfHPrmBuf, pNfIconHist
    global NoiseZWx, NoiseZGx, NoiseZKx, NfIconN
    NoiseZWx := -1, NoiseZGx := -1, NoiseZKx := -1
    NfIconN := 0
    if (!pCaptureBits || CaptureW < 200 || CaptureH < 12)
        return false
    if (!NfNativeReady)
        NfNativeInit()
    cw := CaptureW
    if (NfHistW != cw) {
        VarSetCapacity(NfHistBuf, cw * 6 * 4, 0)
        NfHist := &NfHistBuf
        VarSetCapacity(NfHPrmBuf, 24, 0)
        NfHPrm := &NfHPrmBuf
        NfHistW := cw
    }

    D := 0.018 * WindowHeight
    minrun := Max(Round(0.25 * D), 5)
    NfZoneHist(cw, 0, Floor(CaptureH / 3), minrun)

    ; candidate column runs (histogram rows 3..5 as the "on" test)
    cands := [], sumw := 0, runSt := -1
    x := 0
    while (x <= cw) {
        on := false
        if (x < cw)
            on := (NumGet(NfHist + (3 * cw + x) * 4, "Int") + NumGet(NfHist + (4 * cw + x) * 4, "Int")
                + NumGet(NfHist + (5 * cw + x) * 4, "Int")) > 0
        if (on) {
            if (runSt < 0)
                runSt := x
        } else if (runSt >= 0) {
            wid := x - runSt
            if (wid >= 0.45 * D && wid <= 1.7 * D) {
                cands.Push([runSt, x - 1, -1])
                sumw += wid
                if (cands.Length() >= 4)
                    break
            }
            runSt := -1
        }
        x += 1
    }
    nc := cands.Length()
    if (nc < 2)
        return false

    ; bottom row of each candidate: lowest row with a long enough bright run
    for _, c in cands {
        y := CaptureH - 1
        while (y >= 0) {
            rowP := pCaptureBits + y * CaptureW * 4
            longest := 0, run := 0
            xx := c[1]
            while (xx <= c[2]) {
                v := NumGet(rowP + xx * 4, "UInt")
                if ((v & 0xFF) >= 200 && ((v >> 8) & 0xFF) >= 200 && ((v >> 16) & 0xFF) >= 200) {
                    run += 1
                    if (run > longest)
                        longest := run
                } else
                    run := 0
                xx += 1
            }
            if (longest >= minrun)
                break
            y -= 1
        }
        c[3] := y
    }

    ybot := -1
    for i, ci in cands {
        if (ci[3] < 4)
            continue
        agree := 0
        for j, cj in cands
            if (j != i && cj[3] >= 0 && Abs(cj[3] - ci[3]) <= 3)
                agree += 1
        if (agree >= 1 && ci[3] > ybot)
            ybot := ci[3]
    }
    if (ybot < 4)
        return false

    rpb := Max(1, Round(1.1 * (sumw / nc) / 3))
    y0 := Max(0, ybot - 3 * rpb + 1)
    NfZoneHist(cw, y0, rpb, minrun)

    sep := 0.035 * WindowWidth
    for _, c in cands {
        if (c[3] < 4 || Abs(c[3] - ybot) > 3)
            continue
        cT := 0, cM := 0, cB := 0
        xx := c[1]
        while (xx <= c[2]) {
            cT += NumGet(NfHist + xx * 4, "Int")
            cM += NumGet(NfHist + (cw + xx) * 4, "Int")
            cB += NumGet(NfHist + (2 * cw + xx) * 4, "Int")
            xx += 1
        }
        cmax := Max(cT, cM, cB), cmin := Min(cT, cM, cB)
        if (cmax < 1)
            continue
        kind := ""
        if (cT <= 0.45 * cB)
            kind := "TRI"
        else if (cmin >= 0.75 * cmax)
            kind := "SQ"
        else if (cT >= 0.35 * cM && cT <= 0.75 * cM && cB >= 0.45 * cM && cB <= 0.90 * cM)
            kind := "CIR"
        icx := Round(FishBarLeft + (c[1] + c[2]) / 2)
        if ((NoiseZWx >= 0 && Abs(icx - NoiseZWx) < sep)
            || (NoiseZGx >= 0 && Abs(icx - NoiseZGx) < sep)
            || (NoiseZKx >= 0 && Abs(icx - NoiseZKx) < sep))
            continue
        if (kind = "SQ" && NoiseZWx < 0)
            NoiseZWx := icx
        else if (kind = "CIR" && NoiseZGx < 0)
            NoiseZGx := icx
        else if (kind = "TRI" && NoiseZKx < 0)
            NoiseZKx := icx
    }
    NfIconN := (NoiseZWx >= 0) + (NoiseZGx >= 0) + (NoiseZKx >= 0)
    return NfIconN >= 2
}
NfZoneHist(w, y0, rpb, minrun) {
    global pCaptureBits, CaptureH, NfHist, NfHPrm, pNfIconHist
    DllCall("RtlZeroMemory", "Ptr", NfHist, "Ptr", w * 6 * 4)
    NumPut(200, NfHPrm + 0, 0, "Int")
    NumPut(minrun, NfHPrm + 0, 4, "Int")
    NumPut(y0, NfHPrm + 0, 8, "Int")
    NumPut(rpb, NfHPrm + 0, 12, "Int")
    NumPut(NfHist, NfHPrm + 0, 16, "Ptr")
    if (pNfIconHist)
        DllCall(pNfIconHist, "Ptr", pCaptureBits, "Int", w, "Int", CaptureH, "Ptr", NfHPrm)
    else
        NfIconHistAhk(pCaptureBits, w, CaptureH, NfHPrm)
}
HalibutCircleX() {
    global QpcFreq, HaliLastX, HaliLastT
    DllCall("QueryPerformanceCounter", "Int64*", hnow)
    hx := HalibutFindCircle()
    if (hx >= 0) {
        HaliLastX := hx
        HaliLastT := hnow
        return hx
    }
    if (HaliLastT && (hnow - HaliLastT) / QpcFreq < 0.15)
        return HaliLastX
    HaliLastT := 0
    return -1
}
HalibutBlue(px) {
	b := px & 0xFF, g := (px >> 8) & 0xFF, r := (px >> 16) & 0xFF
	return (b >= 90 and b - r >= 45 and b - g >= 45 and r <= 90 and g <= 90)
}

HalibutFindCircle() {
    global pNoteBits, NoteW, NoteH, FishBarLeft, WindowHeight
    if (!pNoteBits || NoteH < 20 || NoteW < 20)
        return -1
    D := 0.040 * WindowHeight
    gapMax := Round(0.3 * D)
    xEnd := NoteW + gapMax + 2
    for _, frac in [0.55, 0.45, 0.65] {
        y := Round(NoteH * frac)
        rowP := pNoteBits + y * NoteW * 4
        runS := -1, runE := -1
        x := 0
        while (x <= xEnd) {
            if (x < NoteW && HalibutBlue(NumGet(rowP + x * 4, "UInt"))) {
                if (runS < 0)
                    runS := x
                runE := x
            } else if (runS >= 0 && x - runE > gapMax) {
                wid := runE - runS + 1
                if (wid >= 0.35 * D && wid <= 1.5 * D) {
                    ccx := HalibutVerify(runS, runE, D)
                    if (ccx >= 0)
                        return FishBarLeft + ccx
                }
                runS := -1
            }
            x += 2
        }
    }
    return -1
}
HalibutVerify(s, e, D) {
    global pNoteBits, NoteW, NoteH
    pad := Round(0.3 * D)
    xa := s - pad
    if (xa < 0)
        xa := 0
    xb := e + pad
    if (xb > NoteW - 1)
        xb := NoteW - 1

    hits := 0, minX := 0, maxX := 0, minY := 0, maxY := 0
    y := 0
    while (y <= NoteH - 1) {
        rowP := pNoteBits + y * NoteW * 4
        x := xa
        while (x <= xb) {
            if HalibutBlue(NumGet(rowP + x * 4, "UInt")) {
                if (hits = 0) {
                    minX := x, maxX := x, minY := y
                } else {
                    if (x < minX)
                        minX := x
                    if (x > maxX)
                        maxX := x
                }
                maxY := y
                hits += 1
            }
            x += 2
        }
        y += 2
    }
    if (hits < 4)
        return -1

    bw := maxX - minX + 2
    bh := maxY - minY + 2
    if (bw < 0.45 * D || bw > 1.4 * D || bh < 0.45 * D || bh > 1.4 * D)
        return -1
    if (Abs(bw - bh) > 0.3 * Max(bw, bh))
        return -1
    if ((4 * hits) / (0.7854 * bw * bh) < 0.6)
        return -1
    midY := (minY + maxY) / 2
    if (midY < 0.3 * NoteH || midY > 0.8 * NoteH || maxY >= NoteH - 3)
        return -1
    return (minX + maxX) / 2
}
NoiseGimmickTarget() {
    global QpcFreq, NoiseZoneTgt, NoiseZoneT, NoiseZoneKind, NoiseZScanT, NoiseZWx, NoiseZGx, NoiseZKx
    global NoiseZOK, NoiseZFreshT, NoisePendKind, NoisePendT, NoiseZPrevOK, WindowWidth, NfIconN
    global NfCW, NfCG, NfCK, NfPW, NfPG, NfPK, NfGoneN, NoiseOnZoneN
    DllCall("QueryPerformanceCounter", "Int64*", gnow)
    gk := NoiseWarnKind()

    seq := (NoisePendT > 0) && ((gnow - NoisePendT) / QpcFreq < 2.0)
    if (gk != "") {
        if (gk != "BLACK") {
            NoisePendKind := gk
            NoisePendT := gnow
        } else if (NoisePendKind = "" || NoisePendKind = "BLACK" || !seq) {
            NoisePendKind := "BLACK"
            NoisePendT := gnow
        }
    }
    pend := (NoisePendT > 0) && ((gnow - NoisePendT) / QpcFreq < 2.20)

    zgone := false
    gint := (pend || NoiseZoneTgt >= 0) ? 0.15 : 1.00
    if (NoiseZScanT < 1 || (gnow - NoiseZScanT) / QpcFreq >= gint) {
        NoiseZScanT := gnow
        NoiseZoneIcons()
        tolX := 0.015 * WindowWidth
        all3 := (NfIconN = 3)
        NfCW := (NoiseZWx >= 0 && (all3 || Abs(NoiseZWx - NfPW) <= tolX)) ? NoiseZWx : -1
        NfCG := (NoiseZGx >= 0 && (all3 || Abs(NoiseZGx - NfPG) <= tolX)) ? NoiseZGx : -1
        NfCK := (NoiseZKx >= 0 && (all3 || Abs(NoiseZKx - NfPK) <= tolX)) ? NoiseZKx : -1
        NfPW := NoiseZWx, NfPG := NoiseZGx, NfPK := NoiseZKx
        if (NfIconN >= 2) {
            NoiseZFreshT := gnow
            NfGoneN := 0
        } else if (NoiseZoneTgt >= 0 && (gnow - NoiseZoneT) / QpcFreq >= 1.2) {
            NfGoneN += 1
            if (NfGoneN >= 2)
                zgone := true
        }
    }

    NoiseZPrevOK := NoiseZOK
    NoiseZOK := (NoiseZFreshT > 0) && ((gnow - NoiseZFreshT) / QpcFreq < 0.60)

    if (NoiseZoneTgt >= 0) {
        zage := (gnow - NoiseZoneT) / QpcFreq
        zgap := (NoiseZFreshT > 0) ? (gnow - NoiseZFreshT) / QpcFreq : 99
        if (!zgone && zage < 1.85 && zgap < 1.00)
            return NoiseZoneTgt
        if (!zgone && zage < 4.00 && NoiseZOK)
            return NoiseZoneTgt
        NoiseZoneTgt := -1
        NoiseZoneKind := ""
        NoisePendKind := ""
        NoisePendT := 0
    }

    if (!pend || !NoiseZOK)
        return -1
    gz := -1
    if (NoisePendKind = "WHITE")
        gz := NfCW
    else if (NoisePendKind = "GREEN")
        gz := NfCG
    else if (NoisePendKind = "BLACK")
        gz := NfCK
    if (gz < 0)
        return -1

    NoiseZoneTgt := gz
    NoiseZoneT := gnow
    NfGoneN := 0
    NoiseZoneKind := NoisePendKind
    NoisePendT := 0
    return gz
}
PinionPlan(fishX, noteX, ByRef isNote) {
    global RunLeft, RunWidth, WindowWidth, WindowHeight, QpcFreq, NoteBias, NoteLockY, NoteH, NoteFresh
    global NoteAllN, NoteAllX, NoteAllY, NoteOriginX, NoteMissAt
    global PnState, PnImpactAt, PnCoverX, PnNoteX, PnFall, PnFallN, PnPrevY, PnPrevT, PnPrevX, PnProg, PnWhy
    global PnRes, PnGlueAt, PnGlueLo, PnGlueHi, PnAwayAt, PnTwoN, PnResBlockUntil, PnSeenY, PnSeenAt
    global PnLandAt, PnLeaveAt, PnGone
    isNote := false
    DllCall("QueryPerformanceCounter", "Int64*", tNow)
    prog := PinProgress()
    if (prog >= 0)
        PnProg := prog
    if (RunWidth <= 0)
        return fishX

    winW := WindowWidth, winH := WindowHeight
    halfW := RunWidth / 2
    barC := RunLeft + halfW
    margin := Max(0.30 * RunWidth, 14)
    reach := Max(halfW - margin, 4)

    ; how long the fish has stayed glued to / away from the bar centre
    if (fishX >= 0) {
        if (Abs(fishX - barC) <= 0.010 * winW) {
            if (!PnGlueAt) {
                PnGlueAt := tNow
                PnGlueLo := barC, PnGlueHi := barC
            } else {
                if (barC < PnGlueLo)
                    PnGlueLo := barC
                if (barC > PnGlueHi)
                    PnGlueHi := barC
            }
        } else
            PnGlueAt := 0
        if (Abs(fishX - barC) > 0.06 * winW) {
            if (!PnAwayAt)
                PnAwayAt := tNow
        } else
            PnAwayAt := 0
    }

    vDrop := (PnFallN >= 3 && PnFall > 0) ? PnFall : 0.60 * winH
    if (NoteFresh) {
        twoOk := NoteAllN >= 2
        if (twoOk && fishX >= 0) {
            Loop % NoteAllN {
                if (NoteAllY[A_Index] >= NoteH - 0.07 * winH
                    && Abs(NoteOriginX + NoteAllX[A_Index] - fishX) <= 0.02 * winW)
                    twoOk := false
            }
        }
        if (twoOk)
            PnTwoN += 1
        else
            PnTwoN := 0

        if ((PnState = 1 || PnRes) && PnNoteX >= 0) {
            if (!NoteMissAt && NoteLockY >= 0 && noteX >= 0 && Abs(noteX - PnNoteX) <= 60 && NoteLockY > PnSeenY) {
                PnGone := false
                PnSeenY := NoteLockY
                PnSeenAt := tNow
                PnPrevY := NoteLockY, PnPrevT := tNow, PnPrevX := noteX
                PnLandAt := tNow + (NoteH - NoteLockY) / vDrop * QpcFreq
                PnLeaveAt := PnLandAt + 0.08 * QpcFreq
                landAt := PnLandAt + 0.15 * QpcFreq
                if (landAt > PnImpactAt)
                    PnImpactAt := landAt
            } else if (NoteMissAt || noteX < 0 || Abs(noteX - PnNoteX) > 60 || NoteLockY < PnSeenY
                || (tNow - PnSeenAt) / QpcFreq >= 0.06) {
                PnGone := true
            }
        }
    }

    ; resonance mode on/off
    if (!PnRes) {
        glued := PnGlueAt && (tNow - PnGlueAt) / QpcFreq >= 0.30 && (PnGlueHi - PnGlueLo) >= 0.08 * winW
        paired := PnTwoN >= 3 && fishX >= 0 && Abs(fishX - barC) <= 0.03 * winW && tNow >= PnResBlockUntil
        if (glued || paired) {
            PnRes := 1
            PnState := 0
            PnNoteX := -1
            PnGone := false
        }
    } else if (PnAwayAt && (tNow - PnAwayAt) / QpcFreq >= 0.25) {
        PnRes := 0
        PnGlueAt := 0
        PnTwoN := 0
        PnNoteX := -1
        PnGone := false
        PnResBlockUntil := tNow + 1.5 * QpcFreq
    }

    if (PnRes = 1) {
        if (noteX >= 0) {
            if (NoteFresh && !NoteMissAt && NoteLockY >= 0
                && (PnNoteX < 0 || Abs(noteX - PnNoteX) > 60 || NoteLockY < PnSeenY)) {
                PnNoteX := noteX
                PnSeenY := NoteLockY
                PnSeenAt := tNow
                PnLandAt := tNow + (NoteH - NoteLockY) / vDrop * QpcFreq
                PnLeaveAt := PnLandAt + 0.08 * QpcFreq
                PnGone := false
            }
            if (!PnGone || tNow < PnLeaveAt) {
                isNote := true
                PnWhy := "resonance: note"
                return noteX
            }
            PnWhy := "resonance: no note"
            return (fishX >= 0) ? fishX : barC
        }
        PnNoteX := -1
        PnGone := false
        PnWhy := "resonance: no note"
        return (fishX >= 0) ? fishX : barC
    }

    ; committed to a note: hold the cover position until it lands
    if (PnState = 1) {
        if (tNow >= PnImpactAt || (PnGone && tNow >= PnLeaveAt)) {
            PnState := 0
        } else {
            if (fishX >= 0)
                PnCoverX := (fishX >= PnNoteX - reach && fishX <= PnNoteX + reach) ? fishX : PnNoteX
            isNote := (PnCoverX != fishX) && Abs(barC - PnCoverX) <= NoteHoldZone(RunWidth)
            PnWhy := "hold"
            return PnCoverX
        }
    }

    if (noteX < 0 || NoteBias <= 0) {
        PnWhy := "no note"
        return fishX
    }

    ; fall speed estimate from consecutive sightings of the same note
    if (NoteFresh && NoteLockY >= 0 && !(NoteMissAt && Abs(noteX - PnNoteX) <= 60 && tNow >= PnLeaveAt)) {
        if (PnPrevT && Abs(noteX - PnPrevX) <= 60 && NoteLockY > PnPrevY) {
            dtS := (tNow - PnPrevT) / QpcFreq
            if (dtS > 0.02 && dtS < 0.4) {
                spd := (NoteLockY - PnPrevY) / dtS
                if (spd < 0.45 * winH)
                    spd := 0.45 * winH
                else if (spd > 0.80 * winH)
                    spd := 0.80 * winH
                PnFall := (PnFall <= 0) ? spd : 0.8 * PnFall + 0.2 * spd
                PnFallN += 1
            }
        }
        PnPrevY := NoteLockY
        PnPrevT := tNow
        PnPrevX := noteX
    }
    if (NoteLockY < 0 || PnPrevT = 0)
        return fishX

    vFall := (PnFallN >= 3 && PnFall > 0) ? PnFall : 0.60 * winH
    tti := (NoteH - NoteLockY) / vFall - (tNow - PnPrevT) / QpcFreq
    if (tti < -0.05) {
        PnWhy := "no note"
        return fishX
    }

    cover := (fishX >= 0 && fishX >= noteX - reach && fishX <= noteX + reach) ? fishX : noteX
    vBar := 0.30 * winW
    tGo := Abs(cover - barC) / vBar
    if (tGo + 0.15 > tti + 0.05) {
        PnWhy := "skip: too far"
        return fishX
    }
    tTravel := tGo + 0.90

    if (fishX >= 0 && cover != fishX) {
        tOff := tti + Abs(cover - fishX) / vBar + 0.10
        minProg := 0.12 + 0.005 * (100 - NoteBias)
        if (PnProg >= 0) {
            if (PnProg - 0.092 * tOff < minProg) {
                PnWhy := "skip: progress " Round(100 * PnProg) "%"
                return fishX
            }
        } else if (tOff > 1.6) {
            PnWhy := "skip: progress unknown"
            return fishX
        }
    }

    if (tti > tTravel + 0.10) {
        PnWhy := "wait " Round(tti - tTravel, 1) "s"
        return fishX
    }

    PnState := 1
    PnNoteX := noteX
    PnCoverX := cover
    PnSeenY := NoteLockY
    PnSeenAt := PnPrevT
    PnGone := false
    PnLandAt := tNow + tti * QpcFreq
    PnLeaveAt := PnLandAt + 0.08 * QpcFreq
    PnImpactAt := PnLandAt + 0.15 * QpcFreq
    isNote := (cover != fishX) && Abs(barC - cover) <= NoteHoldZone(RunWidth)
    PnWhy := "go " Round(Abs(cover - barC)) "px"
    return cover
}
PinProgress() {
    global pCaptureBits, CaptureW, PnProgRow, PnPrmW, PnPrmWI, PnPrmP, PnPrmPI
    if (!pCaptureBits || PnProgRow < 4 || CaptureW < 40)
        return -1
    best := -1, bestN := 0
    for _, dr in [-4, -2, 0, 2, 4] {
        rowP := pCaptureBits + (PnProgRow + dr) * CaptureW * 4
        ww := 0, pw := 0
        i0 := PcFind(rowP + (0) * 4, CaptureW, 4, PnPrmW)
        if (i0 >= 0) {
            i1 := PcFind(rowP + (i0 + 1) * 4, CaptureW - i0 - 1, 4, PnPrmWI)
            ww := (i1 < 0) ? CaptureW - i0 : i1 + 1
            after := i0 + ww
            j0 := PcFind(rowP + (after) * 4, CaptureW - after, 4, PnPrmP)
            if (j0 >= 0 && j0 <= 6) {
                js := after + j0
                j1 := PcFind(rowP + (js + 1) * 4, CaptureW - js - 1, 4, PnPrmPI)
                pw := (j1 < 0) ? CaptureW - js : j1 + 1
            }
        } else {
            j0 := PcFind(rowP + (0) * 4, CaptureW, 4, PnPrmP)
            if (j0 >= 0) {
                j1 := PcFind(rowP + (j0 + 1) * 4, CaptureW - j0 - 1, 4, PnPrmPI)
                pw := (j1 < 0) ? CaptureW - j0 : j1 + 1
            }
        }
        if (ww + pw > bestN) {
            bestN := ww + pw
            best := ww / (ww + pw)
        }
    }
    if (bestN < 0.15 * CaptureW)
        return -1
    return best
}
