            fx2++
            continue
        }
        fw := fx2 - fst
        if (fw < 3 || fw > fwmax)
            continue
        fcx := fst + fw // 2
        fhits := 0
        Loop 5 {
            fy := Floor(H * (2 * A_Index - 1) / 10)
            if (fy > H - 1)
                fy := H - 1
            if (NoiseIsCore(NumGet(pCaptureBits + fy * stride + 4 * fcx, "UInt"), tB, tG, tR, ftol))
                fhits++
        }
        if (fhits < fneed || Abs(fcx - barA) <= edgeM || Abs(fcx - barB) <= edgeM)
            continue
        gs := 0, gn := 0
        y := 2
        while (y <= H - 3) {
            gs += (NumGet(pCaptureBits + y * stride + 4 * fcx, "UInt") >> 8) & 255
            gn++
            y++
        }
        ownG := (gn > 0) ? gs / gn : 0
        maxL := 0, maxR := 0
        Loop 4 {
            gl := (NumGet(rowP + 4 * Max(0, fst - A_Index), "UInt") >> 8) & 255
            gr := (NumGet(rowP + 4 * Min(W - 1, fx2 - 1 + A_Index), "UInt") >> 8) & 255
            maxL := Max(maxL, gl)
            maxR := Max(maxR, gr)
        }
        if (maxL >= ownG + 80 && maxR >= ownG + 80) {
            nf++
            fX[nf] := fcx
        }
    }
    }

    ; keep only candidates sitting in the band-tone strip above the band
    if (NoiseBandT > -99 && VxNatNFB && !NatOff) {
        VarSetCapacity(nfi, 1024 * 4, 0), VarSetCapacity(nfo, 1024 * 4, 0)
        Loop, % Min(nf, 1024)
            NumPut(fX[A_Index], nfi, (A_Index - 1) * 4, "Int")
        nq := DllCall(VxNatNFB, "Ptr", pCaptureBits, "Int", W, "Int", H, "Int", NoiseBandT
            , "Ptr", &nfi, "Int", Min(nf, 1024), "Ptr", &nfo, "Int", 1024, "Int")
        fX := [], nf := 0
        Loop, % nq
            nf++, fX[nf] := NumGet(nfo, (A_Index - 1) * 4, "Int")
    } else if (NoiseBandT > -99) {
