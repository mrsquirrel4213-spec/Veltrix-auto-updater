ScanRowBar(y, minRun) {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, RunLeft, RunWidth, VxNatRB, NatOff
    if (y < 0 || y >= CaptureH)
        return false
    if (VxNatRB && !NatOff && VxNatArgs(minRun, y)) {
        VarSetCapacity(rbo, 8, 0)
        if !DllCall(VxNatRB, "Ptr", pCaptureBits, "Int", CaptureW, "Int", y, "Double", minRun
            , "Int", Max(6, Round(0.06 * CaptureW)), "Ptr", &rbo, "Int")
            return false
        RunLeft := FishBarLeft + NumGet(rbo, 0, "Int")
        RunWidth := NumGet(rbo, 4, "Int")
        return true
    }
    rowP := pCaptureBits + y * 4 * CaptureW
    lum := []
    lo := 999999, hi := -1
    x := 0
    while (x < CaptureW) {
        px := NumGet(rowP + 4 * x, "UInt")
        v := (((px >> 16) & 255) + ((px >> 8) & 255) + (px & 255)) // 3
        lum[x] := v
        if (v < lo)
            lo := v
        if (v > hi)
            hi := v
        x++
    }
    if (hi - lo < 40)
        return false
    thr := lo + 0.55 * (hi - lo)
    maxGap := Max(6, Round(0.06 * CaptureW))
    bestS := 0, bestLen := 0
    spS := -1, spE := -1, gap := 0
    x := 0
    while (x < CaptureW) {
        if (lum[x] > thr) {
            if (spS < 0)
                spS := x
            spE := x
            gap := 0
        } else if (spS >= 0) {
            gap++
            if (gap > maxGap) {
                len := spE - spS + 1
                if (len > bestLen) {
                    bestLen := len
                    bestS := spS
                }
                spS := -1, spE := -1, gap := 0
            }
        }
        x++
    }
    if (spS >= 0) {
        len := spE - spS + 1
        if (len > bestLen) {
            bestLen := len
            bestS := spS
        }
    }
    if (bestLen < minRun)
        return false
    RunLeft := FishBarLeft + bestS
    RunWidth := bestLen
    return true
}
CalibrateBarRow(minRun) {
    global CaptureH, CaptureW, BarRowAgreement, BarScanRow, RunLeft, RunWidth
    lefts := [], widths := []
    have := false
    bestRow := -1, bestLeft := 0, bestLen := -1
    y := 0
    while (y < CaptureH) {
        if (ScanRowBar(y, minRun)) {
            lefts.Push(RunLeft)
            widths.Push(RunWidth)
            if (!have || RunWidth > bestLen) {
                bestRow := y
                bestLeft := RunLeft
                bestLen := RunWidth
            }
            have := true
        }
        y++
    }
    if (!have) {
        BarRowAgreement := 0
        return false
    }
    mid := bestLeft + bestLen / 2
    agreeN := 0
    for i, lf in lefts {
        w := widths[i]
        if (Abs(lf + w / 2 - mid) <= 0.15 * CaptureW && w >= 0.5 * bestLen && w <= 1.5 * bestLen)
            agreeN++
    }
    BarRowAgreement := agreeN
    BarScanRow := bestRow
    RunLeft := bestLeft
    RunWidth := bestLen
    return true
}
ToBGR(rgbHex) {
	v := rgbHex + 0
	return ((v & 0xFF) << 16) | (v & 0xFF00) | ((v >> 16) & 0xFF)
}

ColSpread(x0, x1, fishX) {
    global pCaptureBits, CaptureW, CaptureH, NatOff, VxNatCP
    if (x0 < 0)
        x0 := 0
    if (x1 > CaptureW)
        x1 := CaptureW
    if (CaptureH < 22) {
        ya := CaptureH // 3
        yz := CaptureH
    } else {
        ya := 8
        yz := 22
    }
    if (VxNatCP && !NatOff && VxNatArgs(fishX, x0, x1)) {
        VarSetCapacity(cpo, 8, 0)
        DllCall(VxNatCP, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Int", x0, "Int", x1
            , "Double", fishX, "Ptr", &cpo, "Int")
        return NumGet(cpo, 0, "Double")
    }
    loR := 999999, loG := 999999, loB := 999999
    hiR := -1, hiG := -1, hiB := -1
    n := 0
    x := x0
    while (x < x1) {
        if (Abs(x - fishX) > 14) {
            sR := 0, sG := 0, sB := 0
            y := ya
            while (y < yz) {
                px := NumGet(pCaptureBits + (y * CaptureW + x) * 4, "UInt")
                sB += px & 255
                sG += (px >> 8) & 255
                sR += (px >> 16) & 255
                y += 2
            }
            loR := Min(loR, sR), hiR := Max(hiR, sR)
            loG := Min(loG, sG), hiG := Max(hiG, sG)
            loB := Min(loB, sB), hiB := Max(hiB, sB)
            n++
        }
        x += 2
    }
    if (n < 10)
        return -1
    return ((hiR - loR) + (hiG - loG) + (hiB - loB)) / 7
}
FrameIsDark() {
    global pCaptureBits, CaptureW, CaptureH, VxNatFD, NatOff
    if (VxNatFD && !NatOff)
        return DllCall(VxNatFD, "Ptr", pCaptureBits, "Int", CaptureW, "Int", CaptureH, "Int") != 0
    dark := 0, n := 0
    stride := 4 * CaptureW
    y := 0
    while (y < CaptureH) {
        rowP := pCaptureBits + y * stride
        x := 0
        while (x < CaptureW) {
            px := NumGet(rowP + 4 * x, "UInt")
            if ((((px >> 16) & 255) + ((px >> 8) & 255) + (px & 255)) // 3 < 40)
                dark++
            n++
            x += 4
        }
        y += 2
    }
    if (n < 1)
        return false
    return (dark * 100) // n >= 85
}
TqResetAll() {
    global TqHazeK, TqHitY, TqRingTop, TqRef
    TqHazeK := 1.0
    TqHitY := -1
    TqRingTop := -1
    TqRef := [[89, 217, 221], [119, 92, 221], [227, 222, 153], [211, 105, 169]]
    TqResetFight(0)
}
TqResetFight(t0) {
    global WindowHeight, TqV, TqVs, TqNoteD, TqDs, TqNotes, TqLastRing, TqLastLive
    global TqStarted, TqT0, TqExpired, TqPrevT, TqDl
    TqV := 0.645 * WindowHeight
    TqVs := []
    TqNoteD := 0.098 * WindowHeight
    TqDs := []
    TqNotes := [[], [], [], []]
    TqLastRing := -1
    TqLastLive := -1
    TqStarted := false
    TqT0 := t0
    TqExpired := false
    TqPrevT := -1
    TqDl := 0
}
TqMedian(arr) {
    s := arr.Clone()
    n := s.Length()
    i := 2
    while (i <= n) {
        v := s[i]
        j := i - 1
        while (j >= 1 && s[j] > v) {
            s[j + 1] := s[j]
            j--
        }
        s[j + 1] := v
        i++
    }
    if (Mod(n, 2) = 1)
        return s[(n + 1) // 2]
    return (s[n // 2] + s[n // 2 + 1]) / 2
}
TqRing(cx, ByRef cc, ByRef rtop, ByRef pr, ByRef pg, ByRef pb) {
    global pNoteBits, NoteW, NoteH, WindowHeight, TqBgR, TqBgG, TqBgB, TqBgT, VxNatTQ, NatOff
    TqLaneBg(cx)
    hh := WindowHeight
    expect := NoteH - 0.0767 * hh
    win := 0.0625 * hh + 0.08 * hh
    ya := Round(expect - win)
    if (ya < 0)
        ya := 0
    yb := Round(expect + win)
    if (yb > NoteH - 1)
        yb := NoteH - 1
    smin := 0.004 * hh, smax := Max(0.02 * hh, 24)
    gmin := 0.045 * hh, gmax := Max(0.12 * hh, 150)
    stride := 4 * NoteW

    ; collect runs of note-coloured rows in this column
    rs := [], re := []
    if (VxNatTQ && !NatOff) {
        VarSetCapacity(tqo, 2048 * 8, 0)
        nq := DllCall(VxNatTQ, "Ptr", pNoteBits, "Int", NoteW, "Int", cx, "Int", ya, "Int", yb
            , "Double", TqBgR, "Double", TqBgG, "Double", TqBgB, "Double", TqBgT
            , "Double", TA("tqhaze", 70), "Double", TA("tqlift", 30), "Double", TA("tqdist", 120)
            , "Ptr", &tqo, "Int", 2048, "Int")
        Loop, % nq
            rs.Push(NumGet(tqo, (A_Index - 1) * 8, "Int")), re.Push(NumGet(tqo, (A_Index - 1) * 8 + 4, "Int"))
    } else {
    open := -1
    y := ya
    while (y <= yb) {
        px := NumGet(pNoteBits + y * stride + 4 * cx, "UInt")
        if (TqNotePx((px >> 16) & 255, (px >> 8) & 255, px & 255)) {
            if (open < 0)
                open := y
        } else if (open >= 0) {
            rs.Push(open), re.Push(y - 1)
            open := -1
        }
        y++
    }
    if (open >= 0)
        rs.Push(open), re.Push(yb)
    }

    nr := rs.Length()
    i := 1
    while (i < nr) {
        s1 := rs[i], e1 := re[i], s2 := rs[i + 1], e2 := re[i + 1]
        h1 := e1 - s1 + 1, h2 := e2 - s2 + 1, gp := s2 - e1 - 1
        if (h1 >= smin && h1 <= smax && h2 >= smin && h2 <= smax && gp >= gmin && gp <= gmax) {
            hollow := 0
            y := e1 + 1
            while (y <= s2 - 1) {
                px := NumGet(pNoteBits + y * stride + 4 * cx, "UInt")
                cr := (px >> 16) & 255, cg := (px >> 8) & 255, cb := px & 255
                if (Max(cr, cg, cb) < 70 || Abs(cr - TqBgR) + Abs(cg - TqBgG) + Abs(cb - TqBgB) <= 60)
                    hollow++
                y++
            }
            if (hollow * 4 >= gp * 3) {
                c0 := (s1 + e2) / 2
                if (Abs(c0 - expect) <= 0.0625 * hh) {
                    px := NumGet(pNoteBits + ((s1 + e1) // 2) * stride + 4 * cx, "UInt")
                    pr := (px >> 16) & 255
                    pg := (px >> 8) & 255
                    pb := px & 255
                    cc := c0
                    rtop := s1
                    return true
                }
            }
        }
        i++
    }
    return false
}
TqRings(ByRef agree) {
    global NoteW, TqHitY, TqRingTop, TqRef
    fracs := [0.1230, 0.3740, 0.6220, 0.8750]
    cs := [], tops := [], lanes := [], cols := []
    for li, f in fracs {
        if (TqRing(Round(NoteW * f), cc, rtop, pr, pg, pb)) {
            cs.Push(cc)
            tops.Push(rtop)
            lanes.Push(li)
            cols.Push([pr, pg, pb])
        }
    }
    n := cs.Length()
    agree := 0
    if (n >= 1) {
        md := TqMedian(cs)
        aC := [], aT := [], aL := [], aCol := []
        for k, c in cs {
            if (Abs(c - md) <= 8) {
                aC.Push(c), aT.Push(tops[k]), aL.Push(lanes[k]), aCol.Push(cols[k])
            }
        }
        agree := aC.Length()
        if (agree >= 2) {
            c0 := TqMedian(aC)
            tp := TqMedian(aT)
            TqHitY := (TqHitY < 0) ? c0 : 0.8 * TqHitY + 0.2 * c0
            TqRingTop := (TqRingTop < 0) ? tp : 0.8 * TqRingTop + 0.2 * tp
            for k, ln in aL {
                ref := TqRef[ln], smp := aCol[k]
                Loop 3
                    ref[A_Index] := 0.8 * ref[A_Index] + 0.2 * smp[A_Index]
            }
        }
    }
    return n
}
TqLaneBg(cx) {
	global pNoteBits, NoteW, NoteH, TqBgR, TqBgG, TqBgB, TqBgT, TqHazeK
	static cache := {}
	; it changes slowly (a boss's tint fading in): measured again every 150 ms
	c := cache[cx]
	if (IsObject(c) and A_TickCount - c.t < 150 and A_TickCount >= c.t)
		{
		TqBgR := c.r, TqBgG := c.g, TqBgB := c.b, TqBgT := c.k, TqHazeK := c.h
		return
		}
	rs := [], gs := [], bs := [], ms := []
	base := pNoteBits + (cx * 4)
	rowb := NoteW * 4
	st := (NoteH > 300) ? 10 : 4
	; a lane packed with notes would give the notes' colour as its median: the background is the darkest 30%
	; of the column (notes are always lighter than their lane)
	lst := ""
	y := 0
	while (y < NoteH)
		{
		v := NumGet(base + 0, y * rowb, "UInt")
		b := v & 0xFF, g := (v >> 8) & 0xFF, r := (v >> 16) & 0xFF
		mx := (r > g) ? ((r > b) ? r : b) : ((g > b) ? g : b)
		lst .= mx . "," . v . "`n"
		y += st
		}
	Sort, lst, N
	ln := StrSplit(Trim(lst, "`n"), "`n")
	keep := Floor(ln.Length() * 0.3)
	keep := (keep < 3) ? ln.Length() : keep
	Loop % keep
		{
		p := StrSplit(ln[A_Index], ",")
		v := p[2] + 0
		rs.Push((v >> 16) & 0xFF), gs.Push((v >> 8) & 0xFF), bs.Push(v & 0xFF), ms.Push(p[1] + 0)
		}
	TqBgR := TqMedian(rs), TqBgG := TqMedian(gs), TqBgB := TqMedian(bs)
	TqBgT := TqMedian(ms) + TA("tqbright", 45)
	if (TqBgT < 90)
		TqBgT := 90
	; a light lane is a haze (dust) over it: 1 = clear, down to 0.45 - how much of a note's contrast is left
	sm := TqBgR + TqBgG + TqBgB
	TqHazeK := (sm <= 250) ? 1.0 : 1.0 - (sm - 250) / 400.0
	TqHazeK := (TqHazeK < 0.45) ? 0.45 : TqHazeK
	cache[cx] := {t: A_TickCount, r: TqBgR, g: TqBgG, b: TqBgB, k: TqBgT, h: TqHazeK}
}

; a note / ring pixel: bright for this lane, coloured, and well away from the lane's background colour
TqNotePx(cr, cg, cb) {
	global TqBgR, TqBgG, TqBgB, TqBgT, TqHazeK
	d := Abs(cr - TqBgR) + Abs(cg - TqBgG) + Abs(cb - TqBgB)
	; through a haze (a boss washing the screen out): a note still stands well clear of its lane and lighter than it
	if (d >= TA("tqhaze", 70) * TqHazeK and (cr + cg + cb) - (TqBgR + TqBgG + TqBgB) >= TA("tqlift", 30))
		return true
	mx := (cr > cg) ? ((cr > cb) ? cr : cb) : ((cg > cb) ? cg : cb)
	mn := (cr < cg) ? ((cr < cb) ? cr : cb) : ((cg < cb) ? cg : cb)
	if (mx <= 90 or (mx - mn) <= 35)
		return false
	; far from the lane's colour (on a dark lane: any coloured note), or clearly brighter than it (a note on a lane
	; tinted near its own colour)
	return (d > TA("tqdist", 120) or mx > TqBgT)
}

; a note's colour by how it differs from its lane's background - a haze over both cancels out: the lane's colour
; (the share of red / green / blue close to its ring's), or red
TqDiffOk(pr, pg, pb, rf) {
	global TqBgR, TqBgG, TqBgB
	dr := pr - TqBgR, dg := pg - TqBgG, db := pb - TqBgB
	dr := (dr < 0) ? 0 : dr, dg := (dg < 0) ? 0 : dg, db := (db < 0) ? 0 : db
	sd := dr + dg + db
	if (sd < TA("tqlift", 30))
		return false
	if (dr >= 40 and dr > dg + 40 and dr > db + 20)
		return true
	; the same direction of colour as the lane's (cosine of the two)
	nd := Sqrt(dr * dr + dg * dg + db * db), nr := Sqrt(rf[1] * rf[1] + rf[2] * rf[2] + rf[3] * rf[3])
	if (nd <= 0 or nr <= 0)
		return false
	return ((dr * rf[1] + dg * rf[2] + db * rf[3]) / (nd * nr) >= TA("tqhue", 85) / 100.0)
}

; in a haze a note shows its ring: its top or bottom edge clearly lighter than its middle (a dust cloud does not)
TqEdgeOk(base, rowb, st, ye) {
	global TqNoteD
	e := Round(0.15 * TqNoteD)
	e := (e < 4) ? 4 : e
	if (ye - st + 1 < 3 * e)
		return true
	edge := 0, mids := []
	y := st
	while (y <= ye)
		{
		v := NumGet(base + 0, y * rowb, "UInt")
		s := ((v >> 16) & 0xFF) + ((v >> 8) & 0xFF) + (v & 0xFF)
		if (y < st + e or y > ye - e)
			edge := (s > edge) ? s : edge
		else
			mids.Push(s)
		y += (y < st + e or y >= ye - e) ? 1 : 3
		}
	return (edge - TqMedian(mids) >= 30)
}

; the red notes some fights send down any lane
TqRed(r, g, b) {
	return (r >= 110 and r > g + 60 and r > b + 30)
}

TqPurple(r, g, b) {
	return (b > g + 50 and r > g + 20 and b >= r * 0.75 and r >= b * 0.45 and b >= 100)
}

ManiaVisible() {
    global pNoteBits, NoteH
    if (!pNoteBits || NoteH < 120)
        return false
    TqRings(agree)
    return agree >= 3
}
ManiaStep(t) {
    global TqBgR, TqBgG, TqBgB, TqBgT, pNoteBits, NoteW, NoteH, WindowHeight, ManiaLead
    global BarCalculationFailsafe, TqHitY, TqRingTop, TqV, TqVs, TqNoteD, TqDs, TqNotes, TqRef
    global TqLastRing, TqLastLive, TqStarted, TqT0, TqExpired, TqPrevT, TqDl, TqHazeK, VxNatTQ, NatOff

    ; scan interval tracking
    gapT := (TqPrevT >= 0) ? t - TqPrevT : 0
    TqPrevT := t
    if (gapT > 0 && gapT < 0.1)
        TqDl := (TqDl <= 0) ? gapT : 0.9 * TqDl + 0.1 * gapT
    ts := t
    if (gapT > 0 && gapT < 0.1)
        ts := t - Min(gapT, 1 / 60) / 2

    if (!pNoteBits || NoteH < 120) {
        if (!TqStarted && (t - TqT0) > BarCalculationFailsafe) {
            TqExpired := true
            return false
        }
        return true
    }

    hh := WindowHeight
    nring := TqRings(agree)
    if (!TqStarted) {
        if (agree < 3) {
            if ((t - TqT0) > BarCalculationFailsafe) {
                TqExpired := true
                return false
            }
            return true
        }
        TqStarted := true
        TqLastRing := t
        TqLastLive := t
        if (TqDs.Length() = 0 && TqRingTop >= 0 && TqHitY >= 0)
            TqNoteD := 2 * (TqHitY - TqRingTop)
    }
    if (nring >= 1) {
        TqLastRing := t
        TqLastLive := t
    }

    hitY := (TqHitY >= 0) ? TqHitY : NoteH - 0.0767 * hh
    ringR := (TqRingTop >= 0) ? hitY - TqRingTop : 0.049 * hh
    top := hitY - 1.6 * ringR - 3
    rd := 2 * ringR
    minH := 0.5 * TqNoteD
    maxOne := 1.35 * TqNoteD
    lead := ManiaLead / 1000
    rowb := 4 * NoteW
    moving := false
    fracs := [0.1230, 0.3740, 0.6220, 0.8750]
    keys := ["d", "f", "j", "k"]

    Loop 4 {
        li := A_Index
        x := Round(NoteW * fracs[li])
        TqLaneBg(x)
        rf := TqRef[li]
        sr := rf[1] + rf[2] + rf[3]

        ; runs of note-coloured rows down the whole column
        runS := [], runE := []
        if (VxNatTQ && !NatOff) {
            VarSetCapacity(tqo, 2048 * 8, 0)
            nq := DllCall(VxNatTQ, "Ptr", pNoteBits, "Int", NoteW, "Int", x, "Int", 0, "Int", NoteH - 1
                , "Double", TqBgR, "Double", TqBgG, "Double", TqBgB, "Double", TqBgT
                , "Double", TA("tqhaze", 70) * TqHazeK, "Double", TA("tqlift", 30), "Double", TA("tqdist", 120)
                , "Ptr", &tqo, "Int", 2048, "Int")
            Loop, % nq
                runS.Push(NumGet(tqo, (A_Index - 1) * 8, "Int")), runE.Push(NumGet(tqo, (A_Index - 1) * 8 + 4, "Int"))
        } else {
        open := -1
        y := 0
        while (y < NoteH) {
            px := NumGet(pNoteBits + y * rowb + 4 * x, "UInt")
            if (TqNotePx((px >> 16) & 255, (px >> 8) & 255, px & 255)) {
                if (open < 0)
                    open := y
            } else if (open >= 0) {
                runS.Push(open), runE.Push(y - 1)
                open := -1
            }
            y++
        }
        if (open >= 0)
            runS.Push(open), runE.Push(NoteH - 1)
        }

        ; turn accepted runs into note bottoms
        bots := [], hts := []
        for k, st in runS {
            ye := runE[k]
            rh := ye - st + 1
            if !(ye < top && rh >= minH && (TqHazeK >= 1 || TqEdgeOk(pNoteBits + 4 * x, rowb, st, ye)))
                continue
            yc := Floor(ye - TqNoteD / 2)
            if (yc < st)
                yc := st
            px := NumGet(pNoteBits + yc * rowb + 4 * x, "UInt")
            pr := (px >> 16) & 255, pg := (px >> 8) & 255, pb := px & 255
            sp := pr + pg + pb
            if (sp > 0 && sr > 0) {
                kr := sp / sr
                dmax := Max(Abs(pr / sp - rf[1] / sr), Abs(pg / sp - rf[2] / sr), Abs(pb / sp - rf[3] / sr))
                if ((kr >= 0.35 && kr <= 0.90 && dmax <= 0.06) || TqPurple(pr, pg, pb) || TqRed(pr, pg, pb) || TqDiffOk(pr, pg, pb, rf)) {
                    if (rh <= maxOne) {
                        bots.Push(ye), hts.Push(rh)
                    } else {
                        kk := Max(2, Round(rh / TqNoteD))
                        j := 0
                        while (j < kk) {
                            bots.Push(ye - (rh - TqNoteD) * j / (kk - 1))
                            hts.Push(0)
                            j++
                        }
                    }
                }
            }
        }

        ; sort bottoms descending, heights follow
        nb := bots.Length()
        i := 2
        while (i <= nb) {
            vb := bots[i], vh := hts[i]
            j := i - 1
            while (j >= 1 && bots[j] < vb) {
                bots[j + 1] := bots[j], hts[j + 1] := hts[j]
                j--
            }
            bots[j + 1] := vb, hts[j + 1] := vh
            i++
        }

        ; match detections against tracked notes
        lane := TqNotes[li]
        used := []
        Loop % lane.Length()
            used[A_Index] := false
        for k, bot in bots {
            rh := hts[k]
            pick := 0, pickD := 0
            for i, nt in lane {
                if (used[i])
                    continue
                dtt := t - nt.tb
                d := Abs(bot - (nt.bot + TqV * dtt))
                lim := Max(0.012 * hh, 0.3 * TqV * dtt) + TqV / 30
                if (d <= lim && (pick = 0 || d < pickD)) {
                    pick := i
                    pickD := d
                }
            }
            if (pick = 0) {
                nn := {bot: bot, tb: ts, ta: ts + (hitY + TqNoteD / 2 - bot) / TqV, n: 1, nm: 0, v: 0, fired: false}
                if (rh >= rd * 0.85 && rh <= rd * 1.15) {
                    nn.b0 := bot, nn.t0 := ts
                } else {
                    nn.b0 := -1, nn.t0 := -1
                }
                lane.Push(nn)
                used[lane.Length()] := true
                continue
            }
            used[pick] := true
            nt := lane[pick]
            dt := ts - nt.tb
            disp := bot - nt.bot
            nt.n := nt.n + 1
            if (Abs(disp) < 1)
                continue
            single := (rh >= 0.85 * rd && rh <= 1.15 * rd)
            if (single && nt.t0 < 0) {
                nt.b0 := bot
                nt.t0 := ts
            } else if (single && ts - nt.t0 >= 0.25) {
                vs := (bot - nt.b0) / (ts - nt.t0)
                if (vs >= 0.25 * hh && vs <= 1.6 * hh) {
                    TqVs.Push(vs)
                    while (TqVs.Length() > 25)
                        TqVs.RemoveAt(1)
                    if (TqVs.Length() >= 3)
                        TqV := TqMedian(TqVs)
                }
            }
            if (rh > 0 && rh >= 0.6 * rd && rh <= 1.4 * rd) {
                TqDs.Push(rh)
                while (TqDs.Length() > 25)
                    TqDs.RemoveAt(1)
                if (TqDs.Length() >= 5)
                    TqNoteD := TqMedian(TqDs)
            }
            if (dt > 0.004 && disp >= 0.7 * TqV * dt - 3 && disp <= 3.0 * TqV * dt + 3) {
                nt.nm := nt.nm + 1
                vn := disp / dt
                nt.v := (nt.v <= 0) ? vn : 0.5 * nt.v + 0.5 * vn
                if (nt.nm >= 2)
                    moving := true
            }
            nt.bot := bot
            nt.tb := ts
            vv := (nt.v > 1.15 * TqV) ? nt.v : TqV
            if (!nt.fired)
                nt.ta := ts + (hitY + TqNoteD / 2 - bot) / vv
        }

        ; order by arrival time
        nl := lane.Length()
        i := 2
        while (i <= nl) {
            cur := lane[i]
            j := i - 1
            while (j >= 1 && lane[j].ta > cur.ta) {
                lane[j + 1] := lane[j]
                j--
            }
            lane[j + 1] := cur
            i++
        }

        half := (TqDl < 0.05) ? TqDl / 2 : 0
        for i, nt in lane {
            if (!nt.fired && (nt.nm >= 2 || (nt.nm >= 1 && nt.v > 1.15 * TqV)) && t + half >= nt.ta - lead) {
                key := keys[li]
                Send, {%key%}
                nt.fired := true
                break
            }
        }

        ; drop expired notes and stale duplicates
        kept := []
        for i, nt in lane {
            if (nt.ta < t - 0.30)
                continue
            if (!nt.fired && t - nt.tb > 0.15) {
                pp := nt.bot + TqV * (t - nt.tb)
                if (pp < top) {
                    dup := false
                    for j, o in lane {
                        if (j != i && o.tb = ts && Abs(pp - o.bot) <= TqNoteD) {
                            dup := true
                            break
                        }
                    }
                    if (dup)
                        continue
                }
            }
            kept.Push(nt)
        }
        TqNotes[li] := kept
    }

    if (moving)
        TqLastLive := t
    return (t - TqLastLive) <= 0.5 && (t - TqLastRing) <= 2.0
}
NoiseHasMark(arr, n, x, tol) {
    Loop % n {
        if (Abs(arr[A_Index] - x) <= tol)
            return true
    }
    return false
}
NoiseScan() {
    global pCaptureBits, CaptureW, CaptureH, FishBarLeft, QpcFreq, FishColor, FishBarColorTolerance
    global NoiseBarL, NoiseBarW, NoiseFishX, NoiseFound, NoiseScanned, NoiseFishFresh, NoisePrevC
    global NoisePrevT, NoiseFishPrev, NoiseFishT, NoiseStillX, NoiseStillC, NoiseWCal, NoiseJumpN
    global NoiseWCnt, NoiseWVote, NoiseZOK, NoiseZoneTgt, NoiseLastD, NoiseOscN, NoiseVelC
    global NoiseRowOff, NoiseCoastN, NoiseEHist, NoiseJumpHold, NoiseRate, NoiseRateT
    global NoiseN6, NoiseN8, NoiseN15, NoiseN45, NoiseAltW, NoiseAltN, NoiseZSeenT
    global NoiseBandT, NoiseBandB, NoiseRlW, NoiseRlN, NatOff, VxNatNE, VxNatNA, VxNatNB, VxNatNF, VxNatNFB

    ; --- A. once per cycle, frame-rate estimate ---
    if (NoiseScanned)
        return NoiseFound
    NoiseScanned := true
    DllCall("QueryPerformanceCounter", "Int64*", rtnow)
    rdt := (NoiseRateT = 0) ? 0 : (rtnow - NoiseRateT) / QpcFreq
    NoiseRateT := rtnow
    if (rdt > 0 && rdt < 0.25) {
        rnow := Max(1, rdt / 0.040)
        NoiseRate := 0.8 * NoiseRate + 0.2 * rnow
    }
    NoiseRate := Max(1, NoiseRate)
    NoiseN6 := (NoiseRate <= 1) ? 6 : Max(2, Round(6 / NoiseRate))
    NoiseN8 := (NoiseRate <= 1) ? 8 : Max(2, Round(8 / NoiseRate))
    NoiseN15 := (NoiseRate <= 1) ? 15 : Max(3, Round(15 / NoiseRate))
    NoiseN45 := (NoiseRate <= 1) ? 45 : Max(8, Round(45 / NoiseRate))
    NoiseFound := false
    NoiseFishX := -1
    NoiseFishFresh := false

    ; --- B. windows ---
    y0 := Round(0.10 * CaptureH), y1 := Round(0.35 * CaptureH)
    if (y1 - y0 < 2)
        y0 := 0, y1 := CaptureH
    step := 1
    ncol := CaptureW
    if (ncol < 40)
        return false
    W := CaptureW, H := CaptureH
    stride := 4 * W
    bmWmax := Round(0.008 * W) + 2
    bvStep := Max(1, H // 13)
    bvTot := (H + bvStep - 1) // bvStep
    bvNeed := Max(3, Round(0.60 * bvTot))

    ; --- C. dark marks ---
    bmX := [], bmN := 0
    if (NoiseBandT > -99) {
        if (VxNatNE && !NatOff) {
            VarSetCapacity(nzo, 1024 * 4, 0)
            nq := DllCall(VxNatNE, "Ptr", pCaptureBits, "Int", W, "Int", H, "Int", 1, "Int", NoiseBandT, "Int", NoiseBandB
                , "Int", bvStep, "Int", bvTot, "Int", bvNeed, "Int", bmWmax, "Ptr", &nzo, "Int", 1024, "Int")
            Loop, % nq
                bmN++, bmX[bmN] := NumGet(nzo, (A_Index - 1) * 4, "Int")
        } else {
        runSt := -1
        bx := 0
        while (bx <= W) {
            isEdge := false
            if (bx < W) {
                px := NumGet(pCaptureBits + (NoiseBandT + 2) * stride + 4 * bx, "UInt")
                if (((px >> 16) & 255) <= 6 && ((px >> 8) & 255) <= 10 && (px & 255) <= 6) {
                    missT := 0, missB := 0, done := 0
                    k := 0
                    while (k <= 4) {
                        if (k != 2) {
                            px := NumGet(pCaptureBits + (NoiseBandT + k) * stride + 4 * bx, "UInt")
                            if !(((px >> 16) & 255) <= 6 && ((px >> 8) & 255) <= 10 && (px & 255) <= 6)
                                missT++
                        }
                        px := NumGet(pCaptureBits + (NoiseBandB - 4 + k) * stride + 4 * bx, "UInt")
                        if !(((px >> 16) & 255) <= 6 && ((px >> 8) & 255) <= 10 && (px & 255) <= 6)
                            missB++
                        if (missT > 1 || missB > 1)
                            break
                        done++
                        k++
                    }
                    isEdge := (done = 5)
                }
            }
            if (isEdge) {
                if (runSt < 0)
                    runSt := bx
            } else if (runSt >= 0) {
                if (bx - runSt <= bmWmax) {
                    bmN++
                    bmX[bmN] := (runSt + bx - 1) // 2
                }
                runSt := -1
            }
            bx++
        }
        }
    }
    if (bmN = 0) {
        if (VxNatNE && !NatOff) {
            VarSetCapacity(nzo, 1024 * 4, 0)
            nq := DllCall(VxNatNE, "Ptr", pCaptureBits, "Int", W, "Int", H, "Int", 0, "Int", 0, "Int", 0
                , "Int", bvStep, "Int", bvTot, "Int", bvNeed, "Int", bmWmax, "Ptr", &nzo, "Int", 1024, "Int")
            Loop, % nq
                bmN++, bmX[bmN] := NumGet(nzo, (A_Index - 1) * 4, "Int")
        } else {
        runSt := -1
        bx := 0
        while (bx <= W) {
            isEdge := false
            if (bx < W) {
                hits := 0, left := bvTot
                y := 0
                while (y < H) {
                    left--
                    px := NumGet(pCaptureBits + y * stride + 4 * bx, "UInt")
                    if (((px >> 16) & 255) <= 6 && ((px >> 8) & 255) <= 10 && (px & 255) <= 6)
                        hits++
                    if (hits + left < bvNeed)
                        break
                    y += bvStep
                }
                isEdge := (hits >= bvNeed)
            }
            if (isEdge) {
                if (runSt < 0)
                    runSt := bx
            } else if (runSt >= 0) {
                if (bx - runSt <= bmWmax) {
                    bmN++
                    bmX[bmN] := (runSt + bx - 1) // 2
                }
                runSt := -1
            }
            bx++
        }
        }
        ; try to discover the dark band that frames the bar
        if (bmN >= 2) {
            lmid := H // 2
            lPT := "", lPB := ""
            for mi, mx in bmX {
                px := NumGet(pCaptureBits + lmid * stride + 4 * mx, "UInt")
                if !(((px >> 16) & 255) <= 6 && ((px >> 8) & 255) <= 10 && (px & 255) <= 6)
                    continue
                lt := lmid
                while (lt > -17) {
                    px := NumGet(pCaptureBits + (lt - 1) * stride + 4 * mx, "UInt")
                    if !(((px >> 16) & 255) <= 6 && ((px >> 8) & 255) <= 10 && (px & 255) <= 6)
                        break
                    lt--
                }
                lb := lmid
                while (lb < H + 18) {
                    px := NumGet(pCaptureBits + (lb + 1) * stride + 4 * mx, "UInt")
                    if !(((px >> 16) & 255) <= 6 && ((px >> 8) & 255) <= 10 && (px & 255) <= 6)
                        break
                    lb++
                }
                bandH := lb - lt + 1
                if (lt > -18 && lt < 0 && lb >= H && lb < H + 19 && bandH >= 1.2 * H && bandH <= 1.7 * H) {
                    if (lPT != "" && Abs(lt - lPT) <= 1 && Abs(lb - lPB) <= 1) {
                        NoiseBandT := Max(lt, lPT)
                        NoiseBandB := Min(lb, lPB)
                        break
                    }
                    lPT := lt, lPB := lb
                }
            }
        }
    }

    ; mark history and removal of marks that never move
    if !IsObject(NoiseEHist)
        NoiseEHist := []
    NoiseEHist.Push(bmX.Clone())
    while (NoiseEHist.Length() > 20)
        NoiseEHist.RemoveAt(1)
    if (bmN >= 2 && NoiseEHist.Length() >= 20) {
        keep := []
        Loop % bmN {
            sx := bmX[A_Index]
            scnt := 0
            for hi, hl in NoiseEHist {
                for hj, hv in hl {
                    if (Abs(hv - sx) <= 2) {
                        scnt++
                        break
                    }
                }
            }
            nearEdge := (NoisePrevC >= 0 && NoiseWCal >= 40
                && (Abs(sx - (NoisePrevC - NoiseWCal / 2)) <= 4 || Abs(sx - (NoisePrevC + NoiseWCal / 2)) <= 4))
            if (scnt < 18 || nearEdge)
                keep.Push(sx)
        }
        if (keep.Length() >= 2) {
            bmN := keep.Length()
            bmX := keep
        }
    }

    ; --- D. width learning ---
    if !IsObject(NoiseWCnt)
        NoiseWCnt := {}
    if (bmN >= 2 && !NoiseZOK && bmX[1] > 3 && bmX[bmN] < W - 4) {
        wobs := bmX[bmN] - bmX[1]
        if (wobs >= 0.15 * W && wobs <= 0.45 * W) {
            wq := (wobs // 4) * 4
            NoiseWCnt[wq] := Min(40, (NoiseWCnt.HasKey(wq) ? NoiseWCnt[wq] : 0) + 1)
            if (NoiseWCal >= 40 && wq != NoiseWCal)
                NoiseWCnt[NoiseWCal] := Max(0, (NoiseWCnt.HasKey(NoiseWCal) ? NoiseWCnt[NoiseWCal] : 0) - 1)
            wLead := 0
            if (NoiseWCal >= 40)
                wLead := NoiseWCnt.HasKey(NoiseWCal) ? NoiseWCnt[NoiseWCal] : 0
            if (NoiseWCal < 40 || NoiseWCnt[wq] > wLead) {
                NoiseWVote := NoiseWCnt[wq]
                NoiseWCal := wq
            }
        }
    }
    wexp := (NoiseWCal >= 40) ? NoiseWCal : 0.303 * W
    wtol := Max(10, Round(0.016 * W))
    pairOK := false
    i := 1
    while (i < bmN && !pairOK) {
        j := i + 1
        while (j <= bmN) {
            if (Abs((bmX[j] - bmX[i]) - wexp) <= wtol) {
